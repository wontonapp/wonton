<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 核心里的 iroh 隧道连家里的服务器。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络变了马上告诉核心重连（ADR-0032）。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 新消息的系统通知；Android 13 起要在运行时申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务的 specialUse 类型：两个服务都用——“保持连接”（ADR-0003）和端口映射（ADR-0072）。
         FOREGROUND_SERVICE：后台不被挂起，隧道和 Matrix 同步照常。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 推送唤醒后，取消息期间不让手机睡回去。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 扫家里服务器上的配对二维码。没有相机的设备也能装，粘贴配对码即可。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- 插件网页（通话等）要麦克风；和相机一样没有也不挡安装，网页拿到拒绝。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- M0 的网关和插件网页只有 http（HTTPS 方案在 M1 定），WebView 要放开明文。 -->
    <application
        android:name=".WontonApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wonton"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wonton" />
            </intent-filter>
            <!-- 分享一句话给默认 Agent（iOS 快捷指令“问 Bot”同）：发给 Action.AskAgent。 -->
            <intent-filter android:label="@string/shortcut_agent_chat">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- 下载好的文件交给系统打开（ADR-0020）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 应用语言：Android 12 及以下由 AppCompat 把用户选的语言存下来（autoStoreLocales），启动时套用。 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <service
            android:name="app.wonton.media.PageMediaService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- UnifiedPush 分发器转来的推送和推送地址，由连接库经它交给 App。 -->
        <service
            android:name=".push.WontonPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <!-- “保持连接”的前台服务（ADR-0003）。subtype 写给 Google Play 的 specialUse 声明用，也写进了 ADR-0003。 -->
        <service
            android:name=".keepalive.KeepaliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the tunnel to the user's self-hosted home server connected while the app is in the background, so new end-to-end-encrypted messages keep arriving." />
        </service>
        <!-- 端口映射的前台服务（ADR-0072）。subtype 同样写给 Google Play 的 specialUse 声明用。 -->
        <service
            android:name=".portmapping.PortMappingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maps ports of plugins on the user's self-hosted home server onto this device's loopback interface while the user has the mapping switched on, so other apps on the phone can connect to them." />
        </service>
        <!-- 插件页在 Custom Tabs 里打开时浏览器绑定它，App 不被冻结（ADR-0033）。浏览器在别的进程，所以要导出；
             绑定它只让 App 的进程多留一会儿，不给任何能力。 -->
        <service
            android:name=".browser.BrowserKeepAliveService"
            android:exported="true" />
    </application>

</manifest>
