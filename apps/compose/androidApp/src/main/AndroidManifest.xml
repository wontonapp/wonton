<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 核心里的 iroh 隧道连家里的服务器。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络变了马上告诉核心重连（ADR-0032）。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 新消息的系统通知；Android 13 起要在运行时申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 推送唤醒后，取消息期间不让手机睡回去。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 扫家里服务器上的配对二维码。没有相机的设备也能装，粘贴配对码即可。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- M0 的网关和插件网页只有 http（HTTPS 方案在 M1 定），WebView 要放开明文。 -->
    <application
        android:name=".WontonApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wonton"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wonton" />
            </intent-filter>
        </activity>
        <!-- 下载好的文件交给系统打开（ADR-0020）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 应用语言：Android 12 及以下由 AppCompat 把用户选的语言存下来（autoStoreLocales），启动时套用。 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <!-- UnifiedPush 分发器转来的推送和推送地址，由连接库经它交给 App。 -->
        <service
            android:name=".push.WontonPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
