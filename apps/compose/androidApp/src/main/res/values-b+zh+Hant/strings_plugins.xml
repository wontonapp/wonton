<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 「連接埠映射」前台服務的常駐通知渠道名（ADR-0072），顯示在系統的通知設定裡。 -->
    <string name="mapping_channel_name">連接埠映射</string>
    <!-- 連接埠映射的常駐通知標題：只有一個應用程式開著映射。參數是應用程式名稱。 -->
    <string name="mapping_notification_title">正在映射 %1$s 的連接埠</string>
    <!-- 連接埠映射的常駐通知標題：不止一個應用程式開著映射。參數是應用程式個數。 -->
    <string name="mapping_notification_title_multiple">正在映射 %1$d 個應用程式的連接埠</string>
</resources>
