<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- enableEdgeToEdge 启动后接管系统栏，这几项只影响 Activity 起来之前的启动窗口。 -->
    <style name="Base.Theme.Wonton" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/launch_light_system_bars</item>
    </style>

    <!-- Android 12 以下没有 SplashScreen，启动窗口只有纯色：windowBackground 在 Activity 起来后还在，
         放字形的话，StartupFailure 这种不铺背景的页面会透出来。 -->
    <style name="Theme.Wonton" parent="Base.Theme.Wonton" />
</resources>
