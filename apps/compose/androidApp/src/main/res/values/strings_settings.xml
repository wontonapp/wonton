<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Notification text when a message is in a group room: sender name, then the message. -->
    <string name="push_in_room">%1$s: %2$s</string>
    <!-- Shown as the sender when the push didn't say who sent the message. -->
    <string name="push_unknown_sender">Someone</string>
    <!-- Notification text when someone invites you to a room. -->
    <string name="push_invite">Invited you to join</string>
    <!-- Notification text when the message arrived but this device can't load or decrypt it yet. -->
    <string name="push_unavailable">New message (can\'t load it right now)</string>
    <!-- Lock screen version of a notification when sensitive content is hidden: no sender, no text. -->
    <string name="push_hidden">New message</string>
    <!-- Push status detail: the user denied the notification permission. -->
    <string name="push_no_permission">No notification permission: new messages can\'t show while Wonton is closed or the screen is locked</string>
    <!-- Push status detail: no UnifiedPush distributor app (such as ntfy) is installed. -->
    <string name="push_no_distributor">No UnifiedPush distributor installed (such as ntfy): new messages can\'t arrive while Wonton is closed or the screen is locked</string>
    <!-- Push status detail: the distributor gave no Web Push public key. -->
    <string name="push_no_public_key">The distributor gave no Web Push public key, so pushes can\'t be encrypted</string>
    <!-- Push status detail: the distributor rejected the registration. Argument: the reason UnifiedPush reported. -->
    <string name="push_registration_rejected">The distributor rejected the registration: %1$s</string>
    <!-- Push status detail: the distributor unregistered the app. -->
    <string name="push_unregistered">The distributor unregistered Wonton</string>
    <!-- Notification text: a bot asks to be your bot's contact. -->
    <string name="push_contact_request">Wants to be your bot\'s contact</string>
    <!-- Same, when the asking bot belongs to someone. Argument: that person's name. -->
    <string name="push_contact_request_keeper">%1$s\'s bot wants to be your bot\'s contact</string>
    <!-- Lock screen placeholder for a hidden confirmation card notification. -->
    <string name="push_hidden_confirmation">Waiting for your confirmation</string>
    <!-- Lock screen placeholder for a hidden plugin notice. -->
    <string name="push_hidden_notice">New notice</string>
    <!-- Notification action button: reply to the message right in the notification. -->
    <string name="push_reply">Reply</string>
    <!-- Progress while a notification reply is being persisted to the shared pending outbox, not delivered. -->
    <string name="push_reply_queuing">Saving reply…</string>
    <!-- Reply enqueue result is uncertain. Argument: core reason; inspect/retry only in the conversation. -->
    <string name="push_reply_failed">Reply needs checking: %1$s. Open the conversation in Wonton to check pending messages and retry there if needed</string>
    <!-- Replaces the notification text while a notification action is being sent. -->
    <string name="push_sending">Sending…</string>
    <!-- Notification text when an action couldn't be sent. Argument: the reason. -->
    <string name="push_action_failed">Couldn\'t confirm sending: %1$s</string>
    <!-- Notification action failed without a usable core error. Tap opens the original target. -->
    <string name="push_action_unavailable">Open Wonton to check the result and try again</string>
    <!-- Sending exceeded the action deadline; delivery may already have reached the server. -->
    <string name="push_action_timeout">No result yet. Open Wonton to check before trying again</string>
    <!-- Android stopped the action; never automatically send it again. -->
    <string name="push_action_interrupted">Sending was interrupted. Open Wonton to check the result</string>
    <!-- Name of the ongoing notification about tasks waiting for the owner's confirmation (ADR-0101). -->
    <string name="push_tasks_channel">Waiting for you</string>
    <!-- Title of the ongoing notification when one card waits for the owner. Argument: the card title. -->
    <string name="push_task_waiting_title">%1$s is waiting for you</string>
    <!-- Same with several waiting cards. Arguments: count, the earliest card's title. -->
    <string name="push_task_waiting_title_many">%1$d tasks are waiting for you, first %2$s</string>
</resources>
