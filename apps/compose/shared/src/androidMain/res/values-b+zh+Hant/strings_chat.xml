<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button that dismisses a tip or a dialog without doing anything. -->
    <!-- Accessibility label for a Bot's avatar: the Bot's name, then what it is doing right now. -->
    <string name="bot_avatar_label">%1$s，%2$s</string>
    <!-- Button under the large avatar on the Bot profile: pick a new profile picture. -->
    <string name="bot_avatar_choose">選擇圖片</string>
    <!-- Sheet action on a status avatar cell: pick a new picture or video. -->
    <string name="bot_avatar_choose_media">選擇圖片或影片</string>
    <!-- Text inside an empty status avatar cell; tapping it picks a picture or video. -->
    <string name="bot_avatar_add">新增</string>
    <!-- Sheet action that removes the Bot's static avatar or one status avatar. -->
    <string name="bot_avatar_remove">移除</string>
    <!-- Section on an installed Agent app's page: the Bot's name, avatar and status avatars. -->
    <string name="bot_profile_title">個人資料</string>
    <!-- Label of the field for editing the Bot's name. -->
    <string name="bot_name_title">名字</string>
    <!-- The Bot name was empty. -->
    <string name="bot_name_empty">名字不能空白</string>
    <!-- The Bot name was longer than the limit; the number isn\'t shown. -->
    <string name="bot_name_too_long">這個名字太長了</string>
    <!-- The Bot name contains line breaks or control characters. -->
    <string name="bot_name_control">名字裡有不能用的字元</string>
    <!-- The Bot name collides with Wonton\'s or the owner\'s name, so Bots can\'t use it. -->
    <string name="bot_name_reserved">Bot 不能叫 Wonton 或你的名字</string>
    <!-- The Bot name failed validation for another reason. -->
    <string name="bot_name_other">這個名字不行</string>
    <!-- Saving the Bot profile failed because the home server couldn\'t be reached. -->
    <string name="bot_problem_transport">連不上家用伺服器</string>
    <!-- Saving failed because the app isn\'t installed, has no Bot, or its Matrix login isn\'t ready. -->
    <string name="bot_problem_not_ready">應用程式還沒準備好</string>
    <!-- Saving failed because the home server or Matrix reported an error. -->
    <string name="bot_problem_upstream">家用伺服器出錯了</string>
    <string name="bot_problem_owner_only">只有主人能改 Bot 的資料</string>
    <!-- Saving the Bot profile failed for another reason. -->
    <string name="bot_problem_other">資料沒儲存上</string>
    <!-- The picked avatar file is in a format the home server doesn\'t accept. -->
    <string name="bot_media_format">這個檔案不是支援的格式</string>
    <!-- The picked avatar file exceeds the size limit; the number isn\'t shown. -->
    <string name="bot_media_too_large">這個檔案太大了</string>
    <!-- The picked avatar image is larger in pixels than the home server accepts. -->
    <string name="bot_media_too_big">這張圖片尺寸超過上限</string>
    <!-- The picked avatar image isn\'t square. -->
    <string name="bot_media_not_square">這張圖片不是正方形</string>
    <!-- The picked avatar animation or video exceeds the duration limit; the number isn\'t shown. -->
    <string name="bot_media_too_long">這個動態圖片或影片太長了</string>
    <!-- The home server couldn\'t read the picked avatar file. -->
    <string name="bot_media_unreadable">讀不出這個檔案</string>
    <!-- The picked file failed for another reason. -->
    <string name="bot_media_other">這個檔案不能用作大頭貼</string>
    <!-- An animated GIF or WebP was too large to send as-is; the Bot profile accepts videos instead. -->
    <string name="bot_media_use_video">這張動態圖片太大了，改用一段影片吧</string>
    <!-- The four states of a Bot, shown as status avatar grid labels and read out for the avatar. -->
    <string name="bot_state_idle">待機</string>
    <!-- Status: the Bot has model requests, tool calls, or is typing. -->
    <string name="bot_state_working">工作中</string>
    <!-- Status: a confirmation card from the Bot is waiting for the owner. -->
    <string name="bot_state_waiting">等你確認</string>
    <!-- Status: the app isn\'t running, or is installing, updating or starting. -->
    <string name="bot_state_offline">離線</string>
    <string name="timeline_new_messages_below">以下是新訊息</string>
    <string name="room_scroll_to_bottom">回到底部</string>
    <string name="room_scroll_to_bottom_count">回到底部，還有 %1$d 條新訊息</string>
    <string name="timeline_start">以上是聊天的開頭</string>
    <string name="timeline_edited">已編輯</string>
    <string name="timeline_sending">傳送中</string>
    <string name="timeline_read">已讀</string>
    <string name="timeline_send_failed_retrying">傳送失敗，會自動重試</string>
    <string name="timeline_send_failed">傳送失敗：%1$s</string>
    <string name="timeline_resend">重新傳送</string>
    <string name="timeline_undecryptable">無法解密：這支裝置還沒有這則訊息的金鑰</string>
    <string name="timeline_undecryptable_notice">這台裝置讀不了先前的加密訊息。</string>
    <string name="timeline_redacted">訊息已收回</string>
    <string name="timeline_unsupported">暫不支援顯示的訊息（%1$s）</string>
    <!-- Timeline note: someone renamed themselves. Arguments: the old and the new name. -->
    <string name="timeline_profile_rename">%1$s 改名為 %2$s</string>
    <!-- Timeline note: someone changed their avatar. Argument: their name. -->
    <string name="timeline_profile_avatar">%1$s 換了大頭貼</string>
    <!-- Status line on an approval request card: the request expired, so nothing was carried out. -->
    <string name="confirmation_card_expired">已過期，沒有執行</string>
    <!-- Status line on an approval request card: the action ran but failed. Argument: the home server's result message, shown as is. -->
    <string name="confirmation_card_failed_result">沒有成功：%1$s</string>
    <!-- Status line on an approval request card: it was denied, so nothing was carried out. -->
    <string name="confirmation_card_rejected">已拒絕，沒有執行</string>
    <!-- Status line on an approval request card while the action is being carried out, next to a spinner. -->
    <string name="confirmation_card_running">正在執行</string>
    <!-- Button on an approval request card: stop the approval window during which further actions run without asking. -->
    <string name="confirmation_card_stop_window">停止</string>
    <!-- Status line on an approval request card: the action ran, but whether it worked is unknown. Argument: the home server's result message, shown as is. -->
    <string name="confirmation_card_uncertain_result">結果不確定：%1$s</string>
    <!-- Line on an approval request card: further actions run without asking until the approval window closes. Argument: the closing time, already formatted as a time. -->
    <string name="confirmation_card_window_until">允許至 %1$s</string>
    <string name="bot_avatar_pick_state">更換%1$s頭像</string>
    <string name="timeline_sending_progress">傳送中 %1$s</string>
    <string name="timeline_cancel_send">取消傳送</string>
</resources>
