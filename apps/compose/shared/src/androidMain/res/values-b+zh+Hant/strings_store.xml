    <string name="store_update_batch_clear">清除結果</string>
    <string name="store_update_batch_target">目標版本：%1$s</string>
    <string name="store_update_batch_queued">等待更新</string>
    <string name="store_update_batch_checking">正在檢查更新</string>
    <string name="store_update_batch_needs_decision">需要確認</string>
    <string name="store_update_batch_review">檢視並確認</string>
    <string name="store_update_batch_review_app">檢視並確認 %1$s 的更新</string>
