<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dialog button that closes the dialog without doing anything. -->
    <string name="common_cancel">取消</string>
    <!-- Collapsed disclosure that shows the raw technical details of a problem when tapped. -->
    <string name="common_details">詳細資訊</string>
    <!-- Button that loads the page's data again after it failed. -->
    <string name="common_retry">重試</string>
    <!-- Toolbar button that saves the page's settings. Short, fits a small pill button. -->
    <string name="common_save">儲存</string>
    <!-- Section title and text field label for the proxy address (like http://192.0.2.10:7890). -->
    <string name="egress_address">代理伺服器位址</string>
    <!-- Radio option: type a proxy address by hand instead of using an app's proxy. -->
    <string name="egress_address_enter">輸入代理伺服器位址</string>
    <!-- Radio option: use the proxy that an installed app provides. Argument: that app's name. -->
    <string name="egress_address_use_provider">使用 %1$s</string>
    <!-- Row title on the Internet proxy page: whether apps on the home server can reach the internet through the proxy. The value on the right is a reachability status. -->
    <string name="egress_path_apps">應用程式</string>
    <!-- Status value: the internet can't be reached through the proxy. A reason is shown below the row. -->
    <string name="egress_path_failed">無法連線</string>
    <!-- Row title on the Internet proxy page: whether the home server itself can reach the internet through the proxy. -->
    <string name="egress_path_home_server">家用伺服器</string>
    <!-- Status value next to Apps / Home Server while the proxy is being checked. -->
    <string name="egress_path_probing">檢查中…</string>
    <!-- Status value: the internet can be reached through the proxy. -->
    <string name="egress_path_reachable">可連線</string>
    <!-- Status value: the check couldn't tell whether the proxy works. A reason is shown below the row. -->
    <string name="egress_path_uncertain">無法確定</string>
    <!-- Section title and text field label for network ranges (CIDR, like 100.64.0.0/10) that skip the proxy and are reached directly. -->
    <string name="egress_ranges">直接連線網段</string>
    <!-- Note under the bypass ranges field. Argument: the computer's own network ranges (CIDR), comma-separated. -->
    <string name="egress_ranges_host">主機所在網段：%1$s</string>
    <!-- Explanation under the bypass ranges field. -->
    <string name="egress_ranges_note">這些網段不經過代理伺服器，可以上網的應用程式都能連線。</string>
    <!-- Confirmation dialog title before turning off the Internet proxy; the message lists the apps on the home server that will restart. -->
    <string name="egress_restart_cancel_title">取消代理伺服器需要重新啟動這些應用程式</string>
    <!-- Primary button in the proxy confirmation dialog: restart the listed apps. -->
    <string name="egress_restart_confirm">重新啟動</string>
    <!-- Body of the proxy restart confirmation. Argument: the names of the apps that restart, already formatted as a list. The second line says their data is kept. -->
    <string name="egress_restart_message">%1$s\n資料不會變動。</string>
    <!-- Confirmation dialog title before turning on the Internet proxy; the message lists the apps on the home server that will restart. -->
    <string name="egress_restart_set_title">設定代理伺服器需要重新啟動這些應用程式</string>
    <!-- Note under the proxy address when the installer detected it on the computer. -->
    <string name="egress_source_detected">安裝時偵測到的。</string>
    <!-- Note under the proxy address when it was set by an environment variable at install time. Keep WONTON_EGRESS_PROXY as is. -->
    <string name="egress_source_env">位址由 WONTON_EGRESS_PROXY 指定。要變更的話，修改安裝目錄裡的設定，再執行一次安裝指令碼。</string>
    <!-- Note under the proxy address when the proxy comes from an installed app. Argument: that app's name. -->
    <string name="egress_source_provider">來自 %1$s</string>
    <!-- Title of the Internet proxy settings page and its row in Settings > Home Server. The proxy is what apps on the home server use to reach the internet. -->
    <string name="egress_title">代理伺服器</string>
    <!-- Destructive full-width button that stops using the Internet proxy. -->
    <string name="egress_turn_off">停用代理伺服器</string>
    <!-- Label before an address that a third-party client uses to connect to the app. -->
    <string name="lan_client_address">位址</string>
    <!-- Label before the password a third-party client uses to sign in to the app. -->
    <string name="lan_client_password">密碼</string>
    <!-- Label before the username a third-party client uses to sign in to the app. -->
    <string name="lan_client_username">帳號</string>
    <!-- Note under the Open on Local Network switch. First argument: number of ports; second: the port numbers, comma-separated. -->
    <plurals name="lan_webui_ports">
        <item quantity="other">連接埠 %1$s</item>
    </plurals>
    <!-- Switch on an app's page: make the app's web page reachable from other devices on the local network. The ports are listed below. -->
    <string name="lan_webui_toggle">在區域網路開放</string>
    <!-- Radio option for typing a mirror address that isn't in the list. -->
    <string name="registry_mirror_custom">自訂</string>
    <!-- Text field label for a custom mirror address (like mirror.example.com:5000). -->
    <string name="registry_mirror_custom_address">自訂鏡像站位址</string>
    <!-- Row title for the speed test result of Docker Hub reached directly, without a mirror. Keep Docker Hub as is. -->
    <string name="registry_mirror_docker_hub_direct">Docker Hub 直接連線</string>
    <!-- Speed test result: the mirror works but no latency was measured. -->
    <string name="registry_mirror_probe_available">可用</string>
    <!-- Speed test result: the mirror returned content whose digest doesn't match. -->
    <string name="registry_mirror_probe_digest_mismatch">摘要不符</string>
    <!-- Speed test result: some other failure; details are collapsed below. -->
    <string name="registry_mirror_probe_other">其他錯誤</string>
    <!-- Speed test result: the mirror refused the request. -->
    <string name="registry_mirror_probe_rejected">遭拒絕</string>
    <!-- Speed test result when this address hasn't been tested. -->
    <string name="registry_mirror_probe_unknown">不確定</string>
    <!-- Speed test result: the mirror can't be reached. -->
    <string name="registry_mirror_probe_unreachable">無法連線</string>
    <!-- Warning on the Download Mirror page when Docker Hub can't be reached directly. Keep Docker Hub as is. -->
    <string name="registry_mirror_recommended">無法連上 Docker Hub，建議開啟下載鏡像站。</string>
    <!-- Explanation under the Download Mirror switch: the mirrors are run by third parties, can see what is downloaded, but can't tamper with it because every image is checked against its digest. -->
    <string name="registry_mirror_risk">這些是第三方的公益服務，能看到你下載了哪些映像檔，但無法修改映像檔的內容，因為每個映像檔的摘要都會逐一核對。</string>
    <!-- Problem title when the typed mirror address is invalid and wasn't saved. The server's reason is in the collapsed details. -->
    <string name="registry_mirror_save_failed">鏡像站位址沒有儲存</string>
    <!-- Button that measures how fast each mirror and Docker Hub respond. -->
    <string name="registry_mirror_test">測速</string>
    <!-- Title of the Download Mirror settings page, its row in Settings > Home Server, and the switch that turns it on. A mirror makes the home server download apps faster. -->
    <string name="registry_mirror_title">下載鏡像站</string>
</resources>
