<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Problem title: the server refused an action although this device is still signed in. -->
    <string name="problem_forbidden_title">請求被拒絕了</string>
    <!-- Accessibility label of the skeleton list placeholder while content loads. -->
    <string name="problem_loading">正在載入</string>
    <!-- Problem title when the core says the action can't run yet; the core's own reason is shown as the next step. -->
    <string name="problem_not_ready_title">目前還無法執行</string>
    <!-- Problem title: the app changed after the owner approved the install. -->
    <string name="problem_plugin_changed_title">應用程式在你確認後有變動</string>
    <!-- Problem title: the home server is updating itself right now. -->
    <string name="problem_plugin_core_upgrading_title">家用伺服器正在更新</string>
    <!-- Next step: look at the devices again and choose one that's available. -->
    <string name="problem_plugin_device_unavailable_next_step">重新查看裝置後再試。</string>
    <!-- Problem title: a port the app opens on the local network is used by another container or program. -->
    <string name="problem_plugin_lan_port_taken_title">連接埠被佔用</string>
    <!-- Next step: choose an interface or address in the local network settings, then try again. -->
    <string name="problem_plugin_lan_unavailable_next_step">在區域網路設定裡選好網卡或位址後再試。</string>
    <!-- Problem title: no local network address could be picked for the app. -->
    <string name="problem_plugin_lan_unavailable_title">找不到可用的區域網路位址</string>
    <!-- Problem title: the app is gone from its source. -->
    <string name="problem_plugin_not_found_title">找不到這個應用程式</string>
    <!-- Next step: look at the proxy settings again once the server is reachable. -->
    <string name="problem_plugin_save_uncertain_next_step">連上家用伺服器後再檢查一次。</string>
    <!-- Problem title after saving the internet proxy while offline: whether it saved isn't known. -->
    <string name="problem_plugin_save_uncertain_title">無法確定是否已儲存</string>
    <!-- Problem title: the community source is switched off, so its apps are missing. -->
    <string name="problem_store_disabled_title">社群來源已關閉</string>
    <!-- Problem title: the store's index is newer than the home server understands. -->
    <string name="problem_store_index_too_new_title">應用程式清單比家用伺服器新</string>
    <!-- Problem title shown above the store list: the app's source can't be reached, the list may be stale. -->
    <string name="problem_store_unreachable_title">連不上應用程式的來源，清單可能不是最新的</string>
    <!-- Problem title used for plugin, chat and connection failures: the home server can't be reached. -->
    <string name="problem_transport_unavailable_title">連不上家用伺服器</string>
</resources>
