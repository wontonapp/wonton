<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Section title and text field label for the proxy address (like http://192.0.2.10:7890). -->
    <string name="egress_address">代理伺服器位址</string>
    <!-- Radio option: type a proxy address by hand instead of using an app's proxy. -->
    <string name="egress_address_enter">輸入代理伺服器位址</string>
    <!-- Radio option: use the proxy that an installed app provides. Argument: that app's name. -->
    <string name="egress_address_use_provider">使用 %1$s</string>
    <!-- Row title on the Internet proxy page: whether apps on the home server can reach the internet through the proxy. The value on the right is a reachability status. -->
    <string name="egress_path_apps">應用程式</string>
    <!-- Status value: the internet can't be reached through the proxy. A reason is shown below the row. -->
    <string name="egress_path_failed">無法連線</string>
    <!-- Row title on the Internet proxy page: whether the home server itself can reach the internet through the proxy. -->
    <string name="egress_path_home_server">家用伺服器</string>
    <!-- Status value next to Apps / Home Server while the proxy is being checked. -->
    <string name="egress_path_probing">檢查中…</string>
    <!-- Status value: the internet can be reached through the proxy. -->
    <string name="egress_path_reachable">可連線</string>
    <!-- Status value: the check couldn't tell whether the proxy works. A reason is shown below the row. -->
    <string name="egress_path_uncertain">無法確定</string>
    <!-- Section title and text field label for network ranges (CIDR, like 100.64.0.0/10) that skip the proxy and are reached directly. -->
    <string name="egress_ranges">直接連線網段</string>
    <!-- Note under the bypass ranges field. Argument: the computer's own network ranges (CIDR), comma-separated. -->
    <string name="egress_ranges_host">主機所在網段：%1$s</string>
    <!-- Explanation under the bypass ranges field. -->
    <string name="egress_ranges_note">這些網段不經過代理伺服器，可以上網的應用程式都能連線。</string>
    <!-- Confirmation dialog title before turning off the Internet proxy; the message lists the apps on the home server that will restart. -->
    <string name="egress_restart_cancel_title">取消代理伺服器需要重新啟動這些應用程式</string>
    <!-- Primary button in the proxy confirmation dialog: restart the listed apps. -->
    <string name="egress_restart_confirm">重新啟動</string>
    <!-- Body of the proxy restart confirmation. Argument: the names of the apps that restart, already formatted as a list. The second line says their data is kept. -->
    <string name="egress_restart_message">%1$s\n資料不會變動。</string>
    <!-- Confirmation dialog title before turning on the Internet proxy; the message lists the apps on the home server that will restart. -->
    <string name="egress_restart_set_title">設定代理伺服器需要重新啟動這些應用程式</string>
    <!-- Note under the proxy address when the installer detected it on the computer. -->
    <string name="egress_source_detected">安裝時偵測到的。</string>
    <!-- Note under the proxy address when it was set by an environment variable at install time. Keep WONTON_EGRESS_PROXY as is. -->
    <string name="egress_source_env">位址由 WONTON_EGRESS_PROXY 指定。要變更的話，修改安裝目錄裡的設定，再執行一次安裝指令碼。</string>
    <!-- Note under the proxy address when the proxy comes from an installed app. Argument: that app's name. -->
    <string name="egress_source_provider">來自 %1$s</string>
    <!-- Title of the Internet proxy settings page and its row in Settings > Home Server. The proxy is what apps on the home server use to reach the internet. -->
    <string name="egress_title">代理伺服器</string>
    <!-- Destructive full-width button that stops using the Internet proxy. -->
    <string name="egress_turn_off">停用代理伺服器</string>
</resources>
