<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the add-friend sheet. -->
    <string name="friends_add_title">加好友</string>
    <!-- Keep this prompt short; the fictional format example belongs in the wrapping help. -->
    <string name="friends_add_placeholder">貼上位址或連結</string>
    <!-- Submit button under the Matrix ID field. -->
    <string name="friends_add_submit">傳送邀請</string>
    <!-- Tag on a received request that is a friend request rather than a plain chat invite. -->
    <string name="friends_request_label">好友邀請</string>
    <!-- Subtitle on a request I sent: it stays until they answer. -->
    <string name="friends_request_waiting">等對方同意</string>
    <!-- Row subtitle for a server blocked for the whole server. -->
    <string name="friends_block_federation">已封鎖伺服器</string>
    <!-- Row subtitle for a blocked target this version doesn't know. -->
    <string name="friends_block_unknown">已封鎖</string>
    <!-- Undo button on a blocked row. -->
    <string name="friends_unblock">復原</string>
    <!-- Failure title when the session is no longer signed in. -->
    <string name="friends_error_unauthorized">登入已失效</string>
    <!-- Next step under the unauthorized failure. -->
    <string name="friends_error_unauthorized_next">重新登入後再開啟好友。</string>
    <!-- Failure title when the server refused a friend action although the sign-in is valid. -->
    <string name="friends_error_forbidden">請求被拒絕了</string>
    <!-- Failure title when the typed ID isn't a full Matrix ID. -->
    <string name="friends_error_invalid_user_id">不是 Matrix ID</string>
    <!-- Failure title when the request was already accepted or rejected elsewhere. -->
    <string name="friends_error_request_not_found">這則邀請已經處理過了</string>
    <!-- Neutral failure title when the operation could not be completed. -->
    <string name="friends_error_upstream">暫時無法完成操作，請稍後再試。</string>

    <!-- 公網訪問總開關關著時，好友頁頂上掛的橫幅標題。 -->
    <string name="friends_public_access_off">公網訪問已關</string>
</resources>
