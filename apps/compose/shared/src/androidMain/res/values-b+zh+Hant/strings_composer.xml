<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label. -->
    <string name="composer_attach">附件</string>
    <!-- Title of the problem shown when the file picker fails. The detail is the system's reason. -->
    <string name="composer_choose_failed">無法選擇這個檔案</string>
    <!-- Item in the composer's attachment menu: pick files to send. -->
    <string name="composer_file">檔案</string>
    <!-- Placeholder in the chat composer's empty text field. -->
    <string name="composer_message">訊息</string>
    <!-- Item in the composer's attachment menu: pick a photo to send. -->
    <string name="composer_photo">照片</string>
    <!-- Screen-reader label of the round send button at the right of the chat composer. -->
    <string name="composer_send">傳送</string>
    <string name="composer_edit_confirm">確認</string>
    <string name="composer_file_unreadable">無法讀取這個檔案。請重新複製，或選擇其他檔案。</string>
    <string name="composer_tray_full">一次最多傳送 %1$d 個附件。</string>
    <string name="composer_attachment_remove">移除 %1$s</string>
    <string name="composer_attachment_paused">等連上家裡的伺服器</string>
    <string name="composer_attachment_failed">傳不上去</string>
    <string name="composer_attachment_retry">重新上傳</string>
    <string name="composer_attachment_too_large">照片超過了家裡伺服器的大小上限，可以改用檔案傳送。</string>
    <string name="composer_attachment_source_unavailable">原檔案讀不了了，請重新選一次。</string>
    <string name="composer_attachment_storage_full">家裡伺服器的磁碟滿了。</string>
    <string name="composer_attachment_rejected">家裡的伺服器拒收了這個附件。</string>
    <string name="composer_attachment_upstream">家裡的伺服器出錯了。</string>
    <string name="composer_attachment_local_storage">手機上存不下了。</string>
    <!-- 輸入欄裡迴紋針左邊的圖示按鈕：開啟 Bot 命令選單。也是讀屏標籤。 -->
    <string name="composer_commands">指令</string>
    <!-- 命令選單末尾：某個 Bot 還有幾條沒有列出。參數：條數。 -->
    <string name="composer_commands_more">還有 %1$d 條指令沒列出</string>
    <!-- Round button in the chat composer while the bot is working on a turn: stops that turn. Also its screen-reader label. -->
    <string name="composer_stop">停止</string>
    <!-- Screen-reader label of the composer's stop button while the stop request is on its way; the button shows a spinner. -->
    <string name="composer_stopping">正在停止</string>
    <!-- One-line note above the chat composer right after the home server confirmed the bot's turn was stopped. -->
    <string name="composer_stopped">已停止</string>
    <!-- One-line note above the chat composer: the home server did not stop the bot's turn. The stop button stays for another try. -->
    <string name="composer_stop_failed">沒停下來，可以再試一次。</string>
    <!-- One-line note above the chat composer: this person isn't allowed to stop this bot's turn. -->
    <string name="composer_stop_forbidden">你沒有權限停下這一輪。</string>
    <!-- One-line note above the chat composer: the stop request may not have reached the home server, so it is unknown whether the bot's turn stopped. The stop button stays for another try. -->
    <string name="composer_stop_uncertain">沒連上家裡的伺服器，不確定停下沒有。可以再試一次。</string>
    <!-- 附件格式伺服器送不了時的說明列。無參數。 -->
    <string name="composer_attachment_unsupported_type">這個格式傳不上去</string>
    <!-- 要回覆的那則不在了、回覆被去掉時的說明列。無參數。 -->
    <string name="composer_attachment_reply_target">要回覆的那則不在了，去掉回覆</string>

</resources>
