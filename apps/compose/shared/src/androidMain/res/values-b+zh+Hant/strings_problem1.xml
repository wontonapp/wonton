<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Problem title when the core rejected the input; the core's own reason is shown as the next step. -->
    <string name="problem_appearance_title">無法儲存外觀設定</string>
    <!-- Next step under the refused problem: the sign-in is fine; the server refused this one action. -->
    <string name="problem_forbidden_next_step">登入沒有問題。可能是沒有權限、對方封鎖了你，或者對方的伺服器還不能和家用伺服器互通。</string>
    <!-- Next step: check the proxy on the home server, or change the address in the internet proxy settings. -->
    <string name="problem_plugin_egress_proxy_unavailable_next_step">檢查家用伺服器上的代理伺服器，或在代理伺服器設定裡修改位址後再試。</string>
    <!-- Problem title: the app can't reach the internet through the internet proxy. -->
    <string name="problem_plugin_egress_proxy_unavailable_title">連不上代理伺服器</string>
    <!-- Problem title: the app and the home server versions don't match. -->
    <string name="problem_plugin_protocol_title">雲吞和家用伺服器的版本不相符</string>
    <!-- Next step: uninstall the app (its data can be kept) and install it again. -->
    <string name="problem_plugin_record_unusable_next_step">解除安裝這個應用程式（資料可以保留）後重新安裝。</string>
    <!-- Problem title when the proxy settings were rejected as invalid; the core's own reason is shown as the next step. -->
    <string name="problem_plugin_save_invalid_title">填寫的內容不正確</string>
    <!-- Problem title: the home server is older than this app needs. -->
    <string name="problem_plugin_server_too_old_title">家用伺服器版本太舊</string>
    <!-- Problem title: some apps couldn't be loaded into the list. -->
    <string name="problem_store_incomplete_title">有幾個應用程式沒有載入</string>
    <!-- Next step: wait a few minutes and try again. -->
    <string name="problem_store_rate_limited_next_step">過幾分鐘再試。</string>
    <!-- Problem title: the app's source answered too slowly, the list may be stale. -->
    <string name="problem_store_timeout_title">應用程式的來源回應太慢，清單可能不是最新的</string>
    <!-- Next step under the not-recognized problem: pair again by scanning the code. -->
    <string name="problem_unauthorized_next_step">請重新掃描配對碼。</string>
    <!-- Problem title: the home server no longer accepts this device. -->
    <string name="problem_unauthorized_title">家用伺服器不認得這台裝置</string>
    <!-- Next step under the server-error problem. Also used for other problems that only say to try later. -->
    <string name="problem_upstream_next_step">稍後再試。</string>
</resources>
