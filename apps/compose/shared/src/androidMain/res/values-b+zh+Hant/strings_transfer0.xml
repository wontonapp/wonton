<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button on a downloaded transfer: opens the dialog asking what to clean up. -->
    <string name="transfer_clean_up">清理</string>
    <!-- Destructive action in the cleanup dialog: remove the record and also delete the downloaded file on this phone. -->
    <string name="transfer_cleanup_delete_file">連手機上的檔案一起刪</string>
    <!-- Action in the cleanup dialog: remove the transfer record, keep the downloaded file. -->
    <string name="transfer_cleanup_record_only">只清記錄</string>
    <!-- Icon button on a transfer: remove it from the strip without deleting anything. -->
    <string name="transfer_clear">清除</string>
    <!-- Line under an upload: it finished, but the link never reached the room. Argument: the home server's reason, shown as is. -->
    <string name="transfer_link_not_sent">已傳完，連結沒發出：%1$s</string>
    <!-- Icon button on a downloaded transfer: open the file. -->
    <string name="transfer_open">開啟</string>
    <!-- Line under a paused transfer without a reason. Argument: the transferred size, already formatted as a byte count. -->
    <string name="transfer_paused_waiting">等連線恢復後接著傳，已傳 %1$s</string>
    <!-- Text button on a finished upload whose link wasn't sent: send the link again. -->
    <string name="transfer_resend_link">重發連結</string>
    <!-- Line under a transfer that lives in another room: that room isn't in the home server's room list. -->
    <string name="transfer_room_missing">目標房間不在這台伺服器的清單裡</string>
    <!-- Icon button on a downloaded transfer: share the file. -->
    <string name="transfer_share">分享</string>
    <string name="transfer_upload">上傳</string>
    <string name="transfer_download">下載</string>
</resources>
