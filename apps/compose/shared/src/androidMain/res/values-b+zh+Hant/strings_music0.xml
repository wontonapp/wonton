<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Entry and section title in the native music library: the playlists. -->
    <string name="music_playlists">播放列表</string>
    <!-- Entry and section title in the native music library: the albums. -->
    <string name="music_albums">專輯</string>
    <!-- Row title on the music library home: albums played the most. -->
    <string name="music_most_played">常聽</string>
    <!-- Button next to a row title on the music library home: open the full list. -->
    <string name="music_see_all">全部</string>
    <!-- Toolbar button and page title: search the music library. -->
    <string name="music_search">搜尋</string>
    <!-- Shown when a music search finds nothing. Argument: what the person typed. -->
    <string name="music_no_results">找不到「%1$s」</string>
    <!-- Album order: newest additions first. -->
    <string name="music_sort_newest">最近加入</string>
    <!-- Album order: most recently played first. -->
    <string name="music_sort_recent">最近播放</string>
    <!-- Menu item on the native music library: open the plugin's own web page instead. -->
    <string name="music_web_version">網頁版</string>
    <!-- Menu item: remove a song, album or artist from favorites. -->
    <string name="music_unstar">取消收藏</string>
    <!-- How long an album or playlist plays. Argument: whole minutes. -->
    <plurals name="music_minutes">
        <item quantity="other">%1$d 分鐘</item>
    </plurals>
    <!-- Line under an album or playlist. Arguments: the song count text and the minutes text. -->
    <string name="music_summary">%1$s，%2$s</string>
    <!-- Problem title: the music library plugin is not running yet. -->
    <string name="music_problem_not_ready_title">音樂庫還沒準備好</string>
    <!-- Next step under the not-ready problem. -->
    <string name="music_problem_not_ready_next_step">等它啟動完再試。</string>
    <!-- Problem title: the music library refused to show this to this person. -->
    <string name="music_problem_forbidden_title">音樂庫不讓看這些內容</string>
    <!-- Next step under the refused problem. -->
    <string name="music_problem_forbidden_next_step">請管音樂庫的人給你開權限。</string>
    <!-- Next step under the not-found problem. -->
    <string name="music_problem_not_found_next_step">可能已經被刪掉了，返回重新整理看看。</string>
    <!-- Problem title: the music library returned an error code this app does not know. -->
    <string name="music_problem_unknown_title">音樂庫回了一個沒見過的錯誤</string>
    <!-- Problem title: the music library's reply could not be understood. -->
    <string name="music_problem_protocol_title">看不懂音樂庫的回覆</string>
</resources>
