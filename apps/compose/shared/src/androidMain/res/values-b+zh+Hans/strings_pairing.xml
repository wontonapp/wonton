<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the page that pairs this phone with the home server by scanning. -->
    <string name="pairing_title">配对</string>
    <!-- Title of the page for pairing the same phone again from the server settings. -->
    <string name="pairing_title_again">重新配对</string>
    <!-- Explanation above the paste field: where the pairing QR code lives. May wrap. -->
    <string name="pairing_instructions">在家里的局域网里，用浏览器打开服务器的 IP 地址（装好时终端里给出），页面上有配对二维码。</string>
    <!-- Placeholder of the field to paste the pairing code when scanning is not possible. -->
    <string name="pairing_paste_placeholder">粘贴配对码</string>
    <string name="pairing_paste_label">配对码</string>
    <!-- Button under the paste field: pair with the code. -->
    <string name="pairing_submit">配对</string>
    <!-- Shown next to a spinner while pairing is in progress. -->
    <string name="pairing_in_progress">正在配对…</string>
    <string name="pairing_still_connecting">还在连接…</string>
    <string name="pairing_still_confirming">还在等服务器确认…</string>
    <!-- Label of the field for this device's name. -->
    <string name="pairing_device_name">这台设备的名字</string>
    <!-- Failure title when the server rejected the pairing code. -->
    <string name="pairing_failure_rejected">服务器不认这个配对码</string>
    <!-- Failure title when the pairing code ran out of time. -->
    <string name="pairing_failure_expired">配对码过期了</string>
    <!-- Failure title when the pairing code was deactivated. -->
    <string name="pairing_failure_closed">这个配对码已经停用</string>
    <!-- Failure title when none of the pairing code's server addresses can be reached. No arguments. -->
    <string name="pairing_failure_transport">连不上配对码里的服务器</string>
    <!-- Button under the failed notice: retry pairing with the same code. -->
    <string name="pairing_next_new_code">换一个新码：在已配对的设备上“添加设备”出码，或在主机上执行 sudo wonton pair。</string>
    <string name="pairing_next_closed">这台服务器已经有配对的设备，首次配对码不能再用；请在已配对的设备上添加，或在主机上执行 sudo wonton pair 另发一个码。</string>
    <string name="pairing_retry_same_code">用这个码再试一次</string>
    <!-- Failure title when the app and the server speak different versions. -->
    <string name="pairing_failure_protocol">App 和服务器的版本对不上</string>
    <!-- Next step under the transport failure. May wrap. -->
    <string name="pairing_hint_transport">确认家里的服务器已开机并联网，再试一次。</string>
    <!-- Next step under the protocol failure. May wrap. -->
    <string name="pairing_hint_protocol">请把 App 和服务器都更新到最新版本。</string>
</resources>
