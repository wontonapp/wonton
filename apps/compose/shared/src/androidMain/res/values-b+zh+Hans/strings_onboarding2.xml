<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary button that finishes setup. -->
    <string name="onboarding_done">完成</string>
    <!-- Primary button after setup finished: leave setup and open chat. -->
    <string name="onboarding_enter_chat">进入聊天</string>
    <!-- Button that keeps the agent that a new one replaces. -->
    <string name="onboarding_keep">保留</string>
    <!-- Label of the field for the provider's API base URL (like https://api.example.com/v1). -->
    <string name="onboarding_model_form_base_url">Base URL</string>
    <!-- Warning under a model provider row: testing couldn't reach the provider, but it's saved anyway when setup finishes. -->
    <string name="onboarding_model_unreachable">连不上服务商，完成时照样保存。</string>
    <!-- Problem title in setup: the home server can't be reached. -->
    <string name="onboarding_problem_model_transport_unavailable">连不上家里的服务器，请检查网络后重试。</string>
    <!-- Problem title while installing: the home server is older than the app needs. -->
    <string name="onboarding_problem_plugin_server_too_old">家里的服务器版本太旧，请先升级服务器。</string>
    <!-- Problem title while installing: the home server can't be reached. -->
    <string name="onboarding_problem_plugin_transport_unavailable">连不上家里的服务器，检查网络后重试。</string>
    <!-- Problem title in setup: some recommendations didn't load. -->
    <string name="onboarding_problem_store_incomplete">部分推荐清单没有加载出来，可以重试或跳过。</string>
    <!-- Problem title in setup: recommendations are unavailable for another reason. -->
    <string name="onboarding_problem_store_other">取不到推荐清单，可以重试或跳过。</string>
    <!-- Problem title in setup: the recommendation source responds too slowly. -->
    <string name="onboarding_problem_store_timeout">推荐清单的来源响应太慢，可以重试或跳过。</string>
    <!-- Problem title in setup: the recommendation source can't be reached. -->
    <string name="onboarding_problem_store_unreachable">连不上推荐清单的来源，可以重试或跳过。</string>
    <!-- Fallback when the core gives no reason why an app can't be installed. -->
    <string name="onboarding_review_blocked">装不了</string>
    <!-- Row description in the review step: the already-configured models are kept. -->
    <string name="onboarding_review_keep_current">用现在的</string>
    <!-- Row description in the review step: finishing will not touch this. -->
    <string name="onboarding_review_unchanged">不变</string>
    <!-- Row description in the review step: the model couldn't be reached during the test. -->
    <string name="onboarding_review_unreachable">测试时没连上</string>
    <!-- Busy label while a setup step or an install task is running. -->
    <string name="onboarding_running">进行中</string>
    <!-- Dismissable tip above the chat input: confirm approval requests on the card in chat. -->
    <string name="onboarding_tip_confirmation_card">需要确认时，在聊天里的卡片上点确认。</string>
</resources>
