<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label. -->
    <string name="composer_attach">附件</string>
    <!-- Title of the problem shown when the file picker fails. The detail is the system's reason. -->
    <string name="composer_choose_failed">选不了这个文件</string>
    <!-- Item in the composer's attachment menu: pick files to send. -->
    <string name="composer_file">文件</string>
    <!-- Placeholder in the chat composer's empty text field. -->
    <string name="composer_message">消息</string>
    <!-- Item in the composer's attachment menu: pick a photo to send. -->
    <string name="composer_photo">照片</string>
    <!-- Screen-reader label of the round send button at the right of the chat composer. -->
    <string name="composer_send">发送</string>
    <string name="composer_edit_confirm">确认</string>
    <string name="composer_file_unreadable">无法读取这个文件。请重新复制，或选择其他文件。</string>
    <string name="composer_tray_full">一次最多发 %1$d 个附件。</string>
    <string name="composer_attachment_remove">移除 %1$s</string>
    <string name="composer_attachment_paused">等连上家里的服务器</string>
    <string name="composer_attachment_failed">传不上去</string>
    <string name="composer_attachment_retry">重新上传</string>
    <string name="composer_attachment_too_large">照片超过了家里服务器的大小上限，可以改用文件发。</string>
    <string name="composer_attachment_source_unavailable">原文件读不了了，请重新选一次。</string>
    <string name="composer_attachment_storage_full">家里服务器的磁盘满了。</string>
    <string name="composer_attachment_rejected">家里的服务器拒收了这个附件。</string>
    <string name="composer_attachment_upstream">家里的服务器出错了。</string>
    <string name="composer_attachment_local_storage">手机上存不下了。</string>
    <!-- Round button in the chat composer while the bot is working on a turn: stops that turn. Also its screen-reader label. -->
    <string name="composer_stop">停止</string>
    <!-- Screen-reader label of the composer's stop button while the stop request is on its way; the button shows a spinner. -->
    <string name="composer_stopping">正在停止</string>
    <!-- One-line note above the chat composer right after the home server confirmed the bot's turn was stopped. -->
    <string name="composer_stopped">已停止</string>
    <!-- One-line note above the chat composer: the home server did not stop the bot's turn. The stop button stays for another try. -->
    <string name="composer_stop_failed">没停下来，可以再试一次。</string>
    <!-- One-line note above the chat composer: this person isn't allowed to stop this bot's turn. -->
    <string name="composer_stop_forbidden">你没有权限停下这一轮。</string>
    <!-- One-line note above the chat composer: the stop request may not have reached the home server, so it is unknown whether the bot's turn stopped. The stop button stays for another try. -->
    <string name="composer_stop_uncertain">没连上家里的服务器，不确定停下没有。可以再试一次。</string>
    <!-- 输入栏里回形针左边的图标按钮：打开 Bot 命令菜单。也是读屏标签。 -->
    <string name="composer_commands">命令</string>
    <!-- 命令菜单末尾：某个 Bot 还有几条没有列出。参数：条数。 -->
    <string name="composer_commands_more">还有 %1$d 条命令没列出</string>
    <!-- 附件格式服务器发不了时的说明行。无参数。 -->
    <string name="composer_attachment_unsupported_type">这个格式传不上去</string>
    <!-- 要回复的那条不在了、回复被去掉时的说明行。无参数。 -->
    <string name="composer_attachment_reply_target">要回复的那条不在了，去掉回复</string>

</resources>
