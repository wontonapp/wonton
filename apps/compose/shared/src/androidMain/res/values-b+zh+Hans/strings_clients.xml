<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the HTTPS and domain settings page and its settings row. -->
    <string name="clients_domain_title">HTTPS 和域名</string>
    <!-- Label of the domain field. -->
    <string name="clients_domain_suffix">域名</string>
    <!-- Shown under a changeable domain: third-party apps must re-enter the address. -->
    <string name="clients_domain_suffix_note">改了以后第三方 App 都要重填地址</string>
    <!-- Heading of the DNS provider choice list. -->
    <string name="clients_domain_provider">DNS 服务商</string>
    <!-- Last provider row: type the lego code yourself. -->
    <string name="clients_domain_other">其他</string>
    <!-- Label of the lego provider code field. -->
    <string name="clients_domain_other_code">lego 服务商代码</string>
    <!-- Placeholder of the free-form credentials field. -->
    <string name="clients_domain_other_hint">一行一个“键=值”</string>
    <!-- Label of the credentials field. -->
    <string name="clients_domain_credentials">凭据</string>
    <!-- Shown when credentials are already stored on the server; values are never read back. -->
    <string name="clients_domain_credentials_set">已填写</string>
    <!-- Link to the provider\'s sign-up page. -->
    <string name="clients_domain_signup">去注册</string>
    <!-- Checkbox for the Let\'s Encrypt subscriber agreement. -->
    <string name="clients_domain_terms">我同意 Let\'s Encrypt 的订户协议</string>
    <!-- Link to the Let\'s Encrypt agreement page. -->
    <string name="clients_domain_terms_open">查看协议</string>
    <!-- Heading of the certificate section. -->
    <string name="clients_domain_certificate">证书</string>
    <!-- Certificate is valid; argument is the expiry date. -->
    <string name="clients_domain_cert_valid">%1$s 到期</string>
    <!-- Renewal failed; the old certificate is still in use. -->
    <string name="clients_domain_cert_renewing">续期失败，还在用旧证书</string>
    <!-- The certificate expired; connections fail. -->
    <string name="clients_domain_cert_expired">证书已过期，连接会失败</string>
    <!-- A certificate is being issued. -->
    <string name="clients_domain_cert_issuing">正在签发</string>
    <!-- No certificate has been requested yet. -->
    <string name="clients_domain_cert_none">还没有证书</string>
    <!-- Button to retry certificate issuance. -->
    <string name="clients_domain_retry">重试</string>
    <!-- Heading of the CAA record section. -->
    <string name="clients_domain_caa">CAA</string>
    <!-- CAA record limits issuance to this home\'s account. -->
    <string name="clients_domain_caa_bound">已限定到这台服务器的账号</string>
    <!-- No CAA record; adding one is recommended. -->
    <string name="clients_domain_caa_missing">建议加上这一条</string>
    <!-- A CAA record exists but does not name this home\'s account. -->
    <string name="clients_domain_caa_mismatch">有记录，但没限定到这台服务器的账号</string>
    <!-- The CAA record could not be checked. -->
    <string name="clients_domain_caa_unknown">查不出来</string>
    <!-- Button that copies the record line. -->
    <string name="clients_domain_copy">复制</string>
    <!-- Shown after copying; the button ticks meanwhile. -->
    <string name="clients_domain_copied">已复制</string>
    <!-- Heading of the LAN record section. -->
    <string name="clients_domain_lan">局域网记录</string>
    <!-- The LAN record already points to this host. -->
    <string name="clients_domain_lan_ok">已经指向这台主机</string>
    <!-- The LAN record is missing. -->
    <string name="clients_domain_lan_missing">还没有这一条</string>
    <!-- The LAN record points elsewhere; argument is the current address. -->
    <string name="clients_domain_lan_wrong">现在指向 %1$s</string>
    <!-- The LAN record could not be checked. -->
    <string name="clients_domain_lan_unknown">查不出来</string>
    <!-- Placeholder where the line needs this host\'s LAN address. -->
    <string name="clients_domain_lan_address">这台的局域网地址</string>
    <!-- Heading of the collapsed deSEC instructions. -->
    <string name="clients_domain_desec">deSEC 令牌</string>
    <!-- Steps to create a deSEC token limited to the two challenge records. -->
    <string name="clients_domain_desec_steps">去 desec.io 注册，再建一个只能写 _acme-challenge 和 _acme-challenge.lan 两个 TXT 记录的令牌。</string>
    <!-- Generic save failure title. -->
    <string name="clients_domain_problem_failed">没保存成功</string>
    <!-- Title when the form needs fixing; the detail says what. -->
    <string name="clients_domain_problem_invalid">有地方要改</string>
    <!-- Title when this device may not change the domain. -->
    <string name="clients_domain_problem_unauthenticated">这台设备不能改</string>
    <!-- Next step for the unauthenticated case. -->
    <string name="clients_domain_problem_unauthenticated_next">用主人的设备、经隧道连接再试</string>
    <!-- Title when the core or plugin is not ready. -->
    <string name="clients_domain_problem_not_ready">家里的服务还没准备好</string>
    <!-- Next step when the core or plugin is not ready. -->
    <string name="clients_domain_problem_not_ready_next">等插件或应用就绪后再试</string>
    <!-- Title when the provider or relay failed. -->
    <string name="clients_domain_problem_upstream">服务商那边没成功</string>
    <!-- Next step when the provider failed. -->
    <string name="clients_domain_problem_upstream_next">稍后重试，详情里是服务商的原话</string>
    <!-- Title when the LAN record is wrong. -->
    <string name="clients_domain_problem_lan">局域网记录有问题</string>
    <!-- Next step when the LAN record is wrong. -->
    <string name="clients_domain_problem_lan_next">照提示补上或改掉这一条</string>
</resources>
