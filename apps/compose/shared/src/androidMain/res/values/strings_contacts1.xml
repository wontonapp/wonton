<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar button and sheet title for adding a contact to this bot. -->
    <string name="contacts_add">Add contact</string>
    <!-- Choice in the add-contact sheet: the other side is a bot. -->
    <string name="contacts_add_kind_bot">A bot</string>
    <!-- Shown on an incoming contact request: what approving means. -->
    <string name="contacts_incoming_warning">Its messages will be handled like messages to your bot, and sensitive tools will ask you every time.</string>
    <!-- Approve button on an incoming contact request. -->
    <string name="contacts_approve">Approve</string>
    <!-- Button that withdraws a request I sent and they haven't answered. -->
    <string name="contacts_withdraw">Withdraw</string>
    <!-- Button that clears a declined or failed request row. -->
    <string name="contacts_clear">Remove</string>
    <!-- Content description of the button that removes an added contact. -->
    <string name="contacts_remove">Remove contact</string>
    <!-- Confirmation title for removing a contact. Argument: the contact's name. -->
    <string name="contacts_remove_title">Remove “%1$s”?</string>
    <!-- Confirmation body: what removing a contact does. -->
    <string name="contacts_remove_message">Your bot stops handling their messages. Existing chats stay.</string>
    <!-- Row status: waiting for the other bot's keeper to approve. -->
    <string name="contacts_status_waiting_bot">Waiting for them to approve</string>
    <!-- Row status: they declined. -->
    <string name="contacts_status_declined">They declined</string>
    <!-- Under a bot contact's name: whose bot it is. Argument: the keeper's name. -->
    <string name="contacts_keeper">%1$s\'s bot</string>
    <!-- Empty contacts page: the one sentence above the add button. -->
    <string name="contacts_empty">No contacts yet</string>
    <!-- Failure title: not a full Matrix ID, or the bot itself. -->
    <string name="contacts_error_invalid_user_id">Not a valid Matrix ID</string>
    <!-- Next step under that failure. -->
    <string name="contacts_error_not_paired_next">Connect it in Other servers first.</string>
    <!-- Failure title: that row was already handled elsewhere. -->
    <string name="contacts_error_contact_not_found">That was already handled</string>
    <!-- Failure title: only the bot's keeper can manage contacts. -->
    <string name="contacts_error_not_keeper">Only this bot\'s keeper can manage its contacts</string>
    <!-- Failure title: the home server failed to save it. -->
    <string name="contacts_error_upstream">Your home server couldn\'t save this</string>
</resources>
