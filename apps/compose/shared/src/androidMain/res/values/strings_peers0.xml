<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Empty page: the one sentence above the two add actions. -->
    <string name="peers_empty">Not connected to any other servers yet</string>
    <!-- Row subtitle when the other server can't be reached. -->
    <string name="peers_status_offline">The other server is unreachable</string>
    <!-- Under the offline subtitle. Argument: relative time like "3 hours ago". -->
    <string name="peers_last_connected">Last connected %1$s</string>
    <!-- Approve button on a request row. -->
    <string name="peers_request_approve">Approve</string>
    <!-- Confirmation dialog title for removing a paired server. Argument: the other owner's display name. -->
    <string name="peers_remove_title">Remove “%1$s”?</string>
    <!-- Failure title when the other server can't be reached. -->
    <string name="peers_error_peer_unreachable">Can\'t reach the other server</string>
    <!-- Failure title when the two servers are already paired. -->
    <string name="peers_error_already_paired">Already connected to this server</string>
    <!-- Failure title when the other server can't take more requests right now. -->
    <string name="peers_error_too_many_requests">The other server can\'t take requests right now. Try again later.</string>
    <!-- Notice when the request just handled was already processed elsewhere; the list refreshes itself. -->
    <string name="peers_error_request_not_found">That request was already handled</string>
</resources>
