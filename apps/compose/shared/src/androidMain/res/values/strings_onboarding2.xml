<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary button that finishes setup. -->
    <string name="onboarding_done">Done</string>
    <!-- Primary button after setup finished: leave setup and open chat. -->
    <string name="onboarding_enter_chat">Go to chat</string>
    <!-- Button that keeps the agent that a new one replaces. -->
    <string name="onboarding_keep">Keep</string>
    <!-- Label of the field for the provider's API base URL (like https://api.example.com/v1). -->
    <string name="onboarding_model_form_base_url">Base URL</string>
    <!-- Warning under a model provider row: testing couldn't reach the provider, but it's saved anyway when setup finishes. -->
    <string name="onboarding_model_unreachable">Can\'t reach the provider. It will still be saved when you finish.</string>
    <!-- Problem title in setup: the home server can't be reached. -->
    <string name="onboarding_problem_model_transport_unavailable">Can\'t reach your home server. Check your network and try again.</string>
    <!-- Problem title while installing: the home server is older than the app needs. -->
    <string name="onboarding_problem_plugin_server_too_old">Your home server is too old for this app. Update the server first.</string>
    <!-- Problem title while installing: the home server can't be reached. -->
    <string name="onboarding_problem_plugin_transport_unavailable">Can\'t reach your home server. Check your network and try again.</string>
    <!-- Problem title in setup: some recommendations didn't load. -->
    <string name="onboarding_problem_store_incomplete">Some recommendations didn\'t load. Try again or skip.</string>
    <!-- Problem title in setup: recommendations are unavailable for another reason. -->
    <string name="onboarding_problem_store_other">Can\'t load the recommendations. Try again or skip.</string>
    <!-- Problem title in setup: the recommendation source responds too slowly. -->
    <string name="onboarding_problem_store_timeout">The recommendation source is responding too slowly. Try again or skip.</string>
    <!-- Problem title in setup: the recommendation source can't be reached. -->
    <string name="onboarding_problem_store_unreachable">Can\'t reach the recommendation source. Try again or skip.</string>
    <!-- Fallback when the core gives no reason why an app can't be installed. -->
    <string name="onboarding_review_blocked">Can\'t install</string>
    <!-- Row description in the review step: the already-configured models are kept. -->
    <string name="onboarding_review_keep_current">Keep current</string>
    <!-- Row description in the review step: the model couldn't be reached during the test. -->
    <string name="onboarding_review_unreachable">Unreachable when tested</string>
    <!-- Busy label while a setup step or an install task is running. -->
    <string name="onboarding_running">In progress</string>
    <!-- Dismissable tip above the chat input: confirm approval requests on the card in chat. -->
    <string name="onboarding_tip_confirmation_card">Approve requests from the card in chat.</string>
</resources>
