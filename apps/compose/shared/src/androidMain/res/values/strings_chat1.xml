<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button that copies the recovery key to the local clipboard only. -->
    <!-- Empty chat list while the account is synced. No arguments. -->
    <string name="chat_empty">No chats yet</string>
    <!-- Notice while the account is signed out. No arguments. -->
    <string name="chat_signed_out">Not connected to your home server yet</string>
    <!-- Preview prefix for a message the user sent. Argument: the message preview. -->
    <string name="chat_own_preview">You: %1$s</string>
    <!-- Room list time for messages from yesterday. No arguments. -->
    <string name="chat_yesterday">Yesterday</string>
    <!-- Invite row text for a room. Argument: the inviter's name. -->
    <string name="chat_invite_room">%1$s invited you to a room</string>
    <!-- Button on an invite row that leaves the invite. No arguments; short label. -->
    <string name="chat_invite_decline">Decline</string>
    <!-- Navigation title of the page that starts a direct chat. No arguments. -->
    <string name="chat_start_direct">Start a direct chat</string>
    <!-- Placeholder of the field for a username or Matrix ID. No arguments. -->
    <string name="chat_peer_placeholder">Username or Matrix ID</string>
    <!-- Install row subtitle while images are downloaded. No arguments. -->
    <string name="chat_install_stage_pulling_images">Pulling images</string>
    <!-- Install row subtitle while networks, volumes and data folders are set up. No arguments. -->
    <string name="chat_install_stage_preparing">Preparing</string>
    <!-- Button on an install row when the source is unknown or the result is uncertain; opens the app's page. No arguments; short label. -->
    <string name="chat_install_open_page">Open app page</string>
    <!-- Explanation when the backup status can't be confirmed because the server isn't reachable. -->
    <string name="chat_backup_detail_unknown">Connect to your home server to confirm.</string>
    <!-- Primary button under the recovery key field: fetch past messages with the entered key. -->
    <string name="chat_backup_recover">Restore past messages</string>
    <!-- Banner in the chat list asking the owner to save their recovery key. -->
    <string name="chat_backup_reminder_save_key">Save your recovery key — you\'ll need it when you switch phones</string>
    <!-- Danger button that confirms the reset in the dialog. -->
    <string name="chat_backup_reset_confirm">Reset</string>
    <!-- Title of the reset confirmation dialog. -->
    <string name="chat_backup_reset_title">Reset chat backup?</string>
    <!-- Note under the freshly issued recovery key: it is only shown once. -->
    <string name="chat_backup_save_key_note">You\'ll need it when you switch phones. It\'s only shown once; after \"Saved\" this device keeps no copy.</string>
    <string name="chat_backup_saved_confirm_message">After this, this device no longer shows the key. Make sure you have a copy before you continue.</string>
    <!-- Page heading when chat backup hasn't been set up. -->
    <string name="chat_backup_status_disabled">Chat backup isn\'t set up yet</string>
    <!-- Page heading when the backup status isn't known (offline). -->
    <string name="chat_backup_status_unknown">Backup status isn\'t known yet</string>
    <!-- Value on the Settings row: backup is off. -->
    <string name="chat_backup_value_disabled">Off</string>
    <!-- Value on the Settings row for chat backup: backup is on. -->
    <string name="chat_backup_value_enabled">On</string>
    <!-- Value on the Settings row: backup or recovery is running. -->
    <string name="chat_backup_value_in_progress">Working</string>
    <!-- 按钮：看恢复密钥前先请求系统验证（ADR-0102、盲测 11-12）。 -->
    <string name="chat_backup_reveal_key">View recovery key</string>
</resources>
