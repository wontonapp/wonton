<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the add-friend sheet. -->
    <string name="friends_add_title">Add friend</string>
    <!-- Placeholder of the Matrix ID field; the example is a full Matrix ID. -->
    <string name="friends_add_placeholder">@bob:example.org</string>
    <!-- Submit button under the Matrix ID field. -->
    <string name="friends_add_submit">Send request</string>
    <!-- Tag on a received request that is a friend request rather than a plain chat invite. -->
    <string name="friends_request_label">Friend request</string>
    <!-- Subtitle on a request I sent: it stays until they answer. -->
    <string name="friends_request_waiting">Waiting for them to accept</string>
    <!-- Row subtitle for a server blocked for the whole server. -->
    <string name="friends_block_federation">Server blocked</string>
    <!-- Row subtitle for a blocked target this version doesn't know. -->
    <string name="friends_block_unknown">Blocked</string>
    <!-- Undo button on a blocked row. -->
    <string name="friends_unblock">Undo</string>
    <!-- Failure title when the session is no longer signed in. -->
    <string name="friends_error_unauthorized">Your session expired</string>
    <!-- Next step under the unauthorized failure. -->
    <string name="friends_error_unauthorized_next">Sign in again, then open Friends.</string>
    <!-- Failure title when the server refused a friend action although the sign-in is valid. -->
    <string name="friends_error_forbidden">The request was refused</string>
    <!-- Failure title when the typed ID isn't a full Matrix ID. -->
    <string name="friends_error_invalid_user_id">Not a Matrix ID</string>
    <!-- Failure title when the request was already accepted or rejected elsewhere. -->
    <string name="friends_error_request_not_found">That request was already handled</string>
    <!-- Failure title when the server refused the change. -->
    <string name="friends_error_upstream">The server refused it</string>
</resources>
