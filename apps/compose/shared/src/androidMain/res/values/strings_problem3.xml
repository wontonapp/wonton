<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the skeleton list placeholder while content loads. -->
    <string name="problem_loading">Loading</string>
    <!-- Problem title when the core says the action can't run yet; the core's own reason is shown as the next step. -->
    <string name="problem_not_ready_title">Not available right now</string>
    <!-- Problem title: the app changed after the owner approved the install. -->
    <string name="problem_plugin_changed_title">The app changed after you approved it</string>
    <!-- Problem title: the home server is updating itself right now. -->
    <string name="problem_plugin_core_upgrading_title">Your home server is updating</string>
    <!-- Next step: look at the devices again and choose one that's available. -->
    <string name="problem_plugin_device_unavailable_next_step">Check your devices and try again.</string>
    <!-- Problem title: a port the app opens on the local network is used by another container or program. -->
    <string name="problem_plugin_lan_port_taken_title">Port in use</string>
    <!-- Next step: choose an interface or address in the local network settings, then try again. -->
    <string name="problem_plugin_lan_unavailable_next_step">Pick an interface or address in the local network settings, then try again.</string>
    <!-- Problem title: no local network address could be picked for the app. -->
    <string name="problem_plugin_lan_unavailable_title">No local network address available</string>
    <!-- Problem title: the app is gone from its source. -->
    <string name="problem_plugin_not_found_title">This app wasn\'t found</string>
    <!-- Next step: look at the proxy settings again once the server is reachable. -->
    <string name="problem_plugin_save_uncertain_next_step">Check it again once your home server is reachable.</string>
    <!-- Problem title after saving the internet proxy while offline: whether it saved isn't known. -->
    <string name="problem_plugin_save_uncertain_title">Couldn\'t confirm it was saved</string>
    <!-- Problem title: the community source is switched off, so its apps are missing. -->
    <string name="problem_store_disabled_title">The community source is turned off</string>
    <!-- Problem title: the store's index is newer than the home server understands. -->
    <string name="problem_store_index_too_new_title">The app list is newer than your home server</string>
    <!-- Problem title shown above the store list: the app's source can't be reached, the list may be stale. -->
    <string name="problem_store_unreachable_title">Can\'t reach the app\'s source. The list may be out of date</string>
    <!-- Problem title used for plugin, chat and connection failures: the home server can't be reached. -->
    <string name="problem_transport_unavailable_title">Can\'t reach your home server</string>
</resources>
