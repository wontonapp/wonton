<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar button that opens the Add Source page. -->
    <string name="store_add_source">Add source</string>
    <!-- Button on a store row to install an app you don't have. -->
    <string name="store_get">Get</string>
    <!-- Small tag on a store row for an app that asks for risky permissions. -->
    <string name="store_high_permissions">High permissions</string>
    <!-- Shown when a store search found nothing. -->
    <string name="store_no_results">No results</string>
    <!-- Button on a store row to open an installed app. -->
    <string name="store_open">Open</string>
    <!-- Problem title in the store with the source it came from. Arguments: the provider's name, the problem title from the core. -->
    <string name="store_problem_from_source">%1$s: %2$s</string>
    <!-- Placeholder under an added source whose list hasn't been fetched yet. Argument: the source's provider name. -->
    <string name="store_reading">Loading %1$s…</string>
    <!-- Placeholder of the search field on the Store screen. -->
    <string name="store_search_prompt">Search</string>
    <!-- Section title above community apps in the store. -->
    <string name="store_section_community">Community</string>
    <!-- Section title above reviewed apps in the store. -->
    <string name="store_section_reviewed">Reviewed</string>
    <!-- Chip that clears the tag filter in the store. -->
    <string name="store_tag_all">All</string>
    <!-- Title of the Store screen and of the row that opens it. -->
    <string name="store_title">Store</string>
    <!-- Notice for an app in a source whose manifest can't be read. Arguments: the source address, the reason from the core. -->
    <string name="store_unreadable">Can\'t read %1$s: %2$s</string>
    <!-- Button on a store row to update an installed app. -->
    <string name="store_update">Update</string>
    <!-- Caption on a store row whose listing comes through an index. Argument: the index's name. -->
    <string name="store_via_index">via %1$s</string>
    <!-- Sheet title before updating every app that has an update at once. Argument: the count. -->
    <plurals name="store_update_all_title">
        <item quantity="one">Update %1$d app</item>
        <item quantity="other">Update %1$d apps</item>
    </plurals>
    <!-- Button in that sheet that starts all the updates. -->
    <string name="store_update_all">Update all</string>
    <!-- Content description of the toolbar download icon that opens that sheet. -->
    <string name="store_update_all_a11y">Update all, %1$d apps</string>
</resources>
