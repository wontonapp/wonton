<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Problem title when the core rejected the input; the core's own reason is shown as the next step. -->
    <string name="problem_invalid_input_title">This can\'t be done</string>
    <!-- Next step: look at the app again and approve it again. -->
    <string name="problem_plugin_changed_next_step">Review and approve it again.</string>
    <!-- Next step: the app is installed or installing, updating or uninstalling; wait for that to finish. -->
    <string name="problem_plugin_conflict_next_step">It\'s already installed, or installing, updating or uninstalling. Wait for that to finish.</string>
    <!-- Next step: try after the update finishes. -->
    <string name="problem_plugin_core_upgrading_next_step">Try again after the update finishes.</string>
    <!-- Next step: contact the app's author. -->
    <string name="problem_plugin_invalid_next_step">Contact the app\'s author.</string>
    <!-- Problem title: the app's package is broken. -->
    <string name="problem_plugin_invalid_title">This app\'s package has a problem</string>
    <!-- Next step: stop the container or program using this port, then try again. -->
    <string name="problem_plugin_lan_port_taken_next_step">Stop the container or program using this port, then try again.</string>
    <!-- Next step: refresh the store and try again. -->
    <string name="problem_plugin_not_found_next_step">Refresh the store and try again.</string>
    <!-- Next step: update the app or the home server. -->
    <string name="problem_plugin_protocol_next_step">Update Wonton or your home server.</string>
    <!-- Next step: the home server can't reach the app's source, try later. -->
    <string name="problem_plugin_source_unavailable_next_step">Your home server can\'t reach the app\'s source. Try again later.</string>
    <!-- Problem title: the home server is too old for this app. -->
    <string name="problem_plugin_unsupported_title">Your home server doesn\'t support this app</string>
    <!-- Problem title: the app list may be incomplete for an unknown reason. -->
    <string name="problem_store_other_title">The app list may be incomplete</string>
    <!-- Problem title: the source is answering too many requests. -->
    <string name="problem_store_rate_limited_title">Too many requests</string>
    <!-- Next step under the can't-reach-the-server problem. -->
    <string name="problem_transport_unavailable_next_step">Check your network and try again once you\'re connected.</string>
    <!-- Next step: update the home server first. Used when the server is too old. -->
    <string name="problem_upgrade_server_next_step">Update your home server first.</string>
    <!-- Problem title used for plugin, chat and connection failures: the home server itself reported an error. -->
    <string name="problem_upstream_title">Your home server ran into a problem</string>
</resources>
