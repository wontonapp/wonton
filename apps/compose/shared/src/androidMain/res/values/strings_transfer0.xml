<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button on a downloaded transfer: opens the dialog asking what to clean up. -->
    <string name="transfer_clean_up">Remove</string>
    <!-- Destructive action in the cleanup dialog: remove the record and also delete the downloaded file on this phone. -->
    <string name="transfer_cleanup_delete_file">Also delete the file on this phone</string>
    <!-- Action in the cleanup dialog: remove the transfer record, keep the downloaded file. -->
    <string name="transfer_cleanup_record_only">Remove record only</string>
    <!-- Icon button on a transfer: remove it from the strip without deleting anything. -->
    <string name="transfer_clear">Clear</string>
    <!-- Line under an upload: it finished, but the link never reached the room. Argument: the home server's reason, shown as is. -->
    <string name="transfer_link_not_sent">Uploaded, but the link wasn\'t sent: %1$s</string>
    <!-- Icon button on a downloaded transfer: open the file. -->
    <string name="transfer_open">Open</string>
    <!-- Line under a paused transfer without a reason. Argument: the transferred size, already formatted as a byte count. -->
    <string name="transfer_paused_waiting">Resumes when the connection is back, %1$s transferred</string>
    <!-- Text button on a finished upload whose link wasn't sent: send the link again. -->
    <string name="transfer_resend_link">Resend link</string>
    <!-- Line under a transfer that lives in another room: that room isn't in the home server's room list. -->
    <string name="transfer_room_missing">The target room isn\'t in the home server\'s list</string>
    <!-- Icon button on a downloaded transfer: share the file. -->
    <string name="transfer_share">Share</string>
    <!-- Content description of the direction icon on an upload. -->
    <string name="transfer_upload">Upload</string>
    <!-- Content description of the direction icon on a download. -->
    <string name="transfer_download">Download</string>
</resources>
