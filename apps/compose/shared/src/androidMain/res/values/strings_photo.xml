<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Detail of the photo problem: the GIF's header is invalid. Android only. -->
    <string name="photo_gif_unreadable">Can\'t read this GIF</string>
    <!-- Title of the photo problem: photo number N of a bunch failed and the rest were not tried; a single photo is number 1. -->
    <string name="photo_failed_at">Photo %1$d could not be sent</string>
    <!-- The failed photo and the reason the core gave, joined into the title. -->
    <string name="photo_failed_at_reason">%1$s: %2$s</string>
    <!-- Next step under a photo problem when the core gave no reason: pick a different photo. -->
    <string name="photo_try_another">Try another photo.</string>
    <!-- Title of the photo problem on iOS, detail on Android: the photo was decoded but couldn't be re-encoded for sending. -->
    <string name="photo_unencodable">Can\'t convert this photo</string>
    <!-- Title of the photo problem: the picked photo can't be read or decoded. -->
    <string name="photo_unreadable">Can\'t read this photo</string>
</resources>
