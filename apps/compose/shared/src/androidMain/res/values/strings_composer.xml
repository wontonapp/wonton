<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label. -->
    <string name="composer_attach">Attach</string>
    <!-- Title of the problem shown when the file picker fails. The detail is the system's reason. -->
    <string name="composer_choose_failed">Can\'t access that file</string>
    <!-- Item in the composer's attachment menu: pick files to send. -->
    <string name="composer_file">File</string>
    <!-- Placeholder in the chat composer's empty text field. -->
    <string name="composer_message">Message</string>
    <!-- Item in the composer's attachment menu: pick a photo to send. -->
    <string name="composer_photo">Photo</string>
    <!-- Screen-reader label of the round send button at the right of the chat composer. -->
    <string name="composer_send">Send</string>
    <string name="composer_file_unreadable">Couldn\'t read this file. Copy it again or choose another file.</string>
    <!-- Shown when the attachment tray is full. Argument: the most attachments one message can carry. -->
    <string name="composer_tray_full">You can send up to %1$d attachments at a time.</string>
    <!-- Accessibility label of the button that takes an attachment out of the tray. Argument: file name. -->
    <string name="composer_attachment_remove">Remove %1$s</string>
    <!-- Accessibility label of an attachment whose upload waits for the connection to the home server. -->
    <string name="composer_attachment_paused">Waiting to reach your home server</string>
    <!-- An attachment could not be uploaded; also the fallback when the core gives an unknown reason. -->
    <string name="composer_attachment_failed">Couldn\'t upload</string>
    <!-- Button: upload a failed attachment again. -->
    <string name="composer_attachment_retry">Upload Again</string>
    <!-- Upload failure: the photo is over the home server's limit. -->
    <string name="composer_attachment_too_large">This photo is over your home server\'s size limit. Send it as a file instead.</string>
    <!-- Upload failure: the original file on the phone can no longer be read. -->
    <string name="composer_attachment_source_unavailable">The original file can\'t be read anymore. Choose it again.</string>
    <!-- Upload failure: the home server's disk is full. -->
    <string name="composer_attachment_storage_full">Your home server is out of space.</string>
    <!-- Upload failure: the home server refused the upload. -->
    <string name="composer_attachment_rejected">Your home server refused this upload.</string>
    <!-- Upload failure: the home server ran into an error. -->
    <string name="composer_attachment_upstream">Your home server ran into a problem.</string>
    <!-- Upload failure: the phone has no room to keep the attachment. -->
    <string name="composer_attachment_local_storage">There isn\'t enough space on this phone.</string>
</resources>
