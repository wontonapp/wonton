<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dialog title for choosing the default agent. -->
    <string name="onboarding_default_agent_title">Default assistant</string>
    <!-- Loading spinner shown while setup data loads. -->
    <string name="onboarding_loading">Loading</string>
    <!-- Banner when one approval card is waiting. Argument: the card's title. -->
    <string name="onboarding_pending_card_one">%1$s needs your approval</string>
    <!-- Problem title while installing: the device the app needs is unavailable. -->
    <string name="onboarding_problem_plugin_device_unavailable">The device you picked is unavailable. Pick another one.</string>
    <string name="onboarding_problem_plugin_egress_proxy_waiting">The server\'s Internet proxy isn\'t ready yet. Retry once it is up; nothing to change.</string>
