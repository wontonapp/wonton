    <string name="onboarding_review_preparing">Getting ready</string>
    <!-- Dismissable tip after an app installed: it can be pinned to the bottom navigation bar. -->
    <string name="onboarding_tip_app_installed">Installed apps show up in My Apps in the sidebar.</string>
    <!-- Card title of the setup step where the owner names their assistant. -->
    <string name="onboarding_step_assistant">Your assistant</string>
    <!-- Second line of the model row in the review step: the last test got a real reply. -->
    <string name="onboarding_review_model_ok">Tested and working</string>
