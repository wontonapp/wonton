    <string name="photo_library_create">Create</string>
    <!-- Photo library: screen-reader name of the mark on an album cover saying the album is shared. -->
    <string name="photo_library_shared_mark">Shared</string>
    <!-- Photo library: shown when the library has no photos. -->
    <string name="photo_library_empty_title">No photos yet</string>
