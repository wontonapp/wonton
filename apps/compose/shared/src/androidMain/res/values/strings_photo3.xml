<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The failed photo and the reason the core gave, joined into the title. -->
    <string name="photo_failed_at_reason">%1$s: %2$s</string>
    <!-- Photo library: screen-reader name of a photo in the grid. Argument: when it was taken. -->
    <string name="photo_library_photo_from">Photo, %1$s</string>
    <!-- Photo library: action that takes the selected items out of the open album (the items stay in the library). -->
    <string name="photo_library_remove_from_album">Remove from album</string>
    <!-- Photo library: tile, row and dialog title for creating an album. -->
    <string name="photo_library_new_album">New album</string>
