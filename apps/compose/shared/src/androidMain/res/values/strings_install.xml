<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Confirm button and title of the page that installs an app from the Store or a file. -->
    <string name="install_action_install">Install</string>
    <!-- Confirm button and title of the page that updates an installed app to a newer version. -->
    <string name="install_action_upgrade">Update</string>
    <!-- Warning under the Always Allow switches in the install preview. -->
    <string name="install_always_allowed_risk">These bots can use this app\'s tools without asking, including tools added in newer versions.</string>
    <!-- Title of the page that switches an installed app to a version from another source or a file. -->
    <string name="install_change_version">Change version</string>
    <!-- Status when the install succeeded. -->
    <string name="install_completion_done">Installed</string>
    <!-- Status while the app installs. -->
    <string name="install_completion_installing">Installing…</string>
    <!-- Title of the page that stays open while the app installs. -->
    <string name="install_completion_title">Install app</string>
    <!-- Problem title when the core couldn't confirm the install result. -->
    <string name="install_completion_uncertain">Installation result is uncertain</string>
    <!-- Shown in the devices section when the app asks for whole disks and the home server lists none to tick. -->
    <string name="install_device_disks_none">No disks to choose on this server</string>
    <!-- Label above the serial ports to pick one from. %1$s is the name of the app's service that gets the port. -->
    <string name="install_device_serial_for">Serial port for %1$s</string>
    <!-- Shown in the devices section when the app asks for a serial port and the home server has none plugged in. -->
    <string name="install_device_serial_none">No serial devices on this server</string>
    <!-- Warning tag on a disk that holds the home server's system or Wonton's data. -->
    <string name="install_device_system_disk">System disk</string>
    <!-- Shown under a device of a kind this app version does not know, which cannot be picked. -->
    <string name="install_device_update_app">Update the app to choose this device</string>
    <!-- Row in the devices section saying the app gets every USB device on the home server, not one picked device. -->
    <string name="install_device_usb_all">All USB devices on this server</string>
    <!-- Section title above the serial ports, USB access, and disks an app asks for, on the install page and on confirmation cards. -->
    <string name="install_devices">Devices</string>
    <!-- Button that closes the install page. -->
    <string name="install_done">Done</string>
    <!-- Button in the install preview when the app needs profile details you haven't filled in yet. -->
    <string name="install_fill_profile">Complete profile</string>
    <!-- Section title above the permissions the app asks for, in the install preview and the detail page. -->
    <string name="install_permissions">Permissions</string>
    <!-- Section title above the release notes in the install preview. -->
    <string name="install_release_notes">What\'s new</string>
    <string name="install_audience_admin">Administrators</string>
    <string name="install_audience_family">Family</string>
    <string name="install_audience_child">Children</string>
    <string name="install_audience_friend">Friends</string>
    <string name="install_audience_title">Who can open this app</string>
    <string name="install_audience_shared_data">This app does not separate accounts. People with access may see and change the same data.</string>
    <string name="install_request_admin">Ask an administrator to install</string>
</resources>
