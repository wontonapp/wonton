    <string name="install_device_disks_none">このサーバーには選べるディスクがありません</string>
    <!-- Label above the serial ports to pick one from. %1$s is the name of the app's service that gets the port. -->
    <string name="install_device_serial_for">%1$s 用のシリアルポート</string>
