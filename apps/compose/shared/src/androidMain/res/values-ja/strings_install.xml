<resources>
    <!-- Confirm button and title of the page that installs an app from the Store or a file. -->
    <string name="install_action_install">インストール</string>
    <!-- Confirm button and title of the page that updates an installed app to a newer version. -->
    <string name="install_action_upgrade">アップデート</string>
    <!-- Warning under the Always Allow switches in the install preview. -->
    <string name="install_always_allowed_risk">これらのボットは、このアプリのツールを確認なしで使えます。新しいバージョンで追加されたツールも含まれます。</string>
    <!-- Title of the page that switches an installed app to a version from another source or a file. -->
    <string name="install_change_version">バージョンを変更</string>
    <!-- Status when the install succeeded. -->
    <string name="install_completion_done">インストール完了</string>
    <!-- Status while the app installs. -->
    <string name="install_completion_installing">インストール中…</string>
    <!-- Title of the page that stays open while the app installs. -->
    <string name="install_completion_title">アプリをインストール</string>
    <!-- Problem title when the core couldn't confirm the install result. -->
    <string name="install_completion_uncertain">インストール結果が不確定です</string>
