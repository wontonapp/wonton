    <string name="install_device_update_app">このデバイスを選ぶにはアプリを更新してください</string>
    <!-- Row in the devices section saying the app gets every USB device on the home server, not one picked device. -->
    <string name="install_device_usb_all">このサーバーのすべての USB デバイス</string>
    <!-- Section title above the serial ports, USB access, and disks an app asks for, on the install page and on confirmation cards. -->
    <string name="install_devices">デバイス</string>
