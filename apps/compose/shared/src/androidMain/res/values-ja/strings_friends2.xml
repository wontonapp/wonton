<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the fictional example in wrapping help, not the single-line input prompt. -->
    <string name="friends_add_help">相手に完全な友だちアドレスを送ってもらってください。Wonton なら「友だち」ページの読み込みに成功した後、「追加 → 自分のQRコード」からリンクをコピーできます。\n形式の例（実際のアカウントではありません）：@bob:example.org</string>
    <!-- Title of the friends page and the settings row that opens it. -->
    <string name="friends_title">友だち</string>
    <string name="friends_scan_code">相手のコードをスキャン</string>
    <!-- Reject button on a received request. -->
    <string name="friends_request_reject">拒否</string>
    <!-- Row subtitle: how many plugins this friend can open. -->
    <plurals name="friends_shared_plugins">
        <item quantity="other">%1$d 個のプラグインを共有中</item>
    </plurals>
    <string name="friends_block_user">招待をブロック</string>
    <!-- Confirmation dialog title for removing a friend. Argument: the friend. -->
    <string name="friends_remove_title">「%1$s」を削除しますか？</string>
    <!-- Failure title when the server asks to wait but didn't say how long. -->
    <string name="friends_error_rate_limited_later">リクエストが多すぎます。後でもう一度お試しください。</string>
    <string name="friends_request_bot_contact">ボットの連絡先リクエスト</string>
</resources>
