<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accessibility label of the menu on a downloaded item. -->
    <string name="video_downloaded">ダウンロード済み</string>
    <!-- Shown when a library or the video page has nothing in it. -->
    <string name="video_empty">まだ何もありません</string>
    <!-- In the facts line of a season: how many episodes. Argument: the count. -->
    <plurals name="video_episodes">
        <item quantity="other">%d エピソード</item>
    </plurals>
    <!-- Under the download progress: downloads only continue while the app is open. -->
    <string name="video_keep_app_open">ダウンロードが終わるまで Wonton を開いたままにしてください。</string>
    <!-- Accessibility label: mark as watched. -->
    <string name="video_mark_played">視聴済みにする</string>
    <!-- Accessibility label: mark as not watched. -->
    <string name="video_mark_unplayed">未視聴にする</string>
    <!-- Main button on a movie or episode: start playing. -->
    <string name="video_play">再生</string>
    <!-- Next step for the problem above. -->
    <string name="video_problem_no_service_next_step">サーバーで Jellyfin などの動画プラグインをインストールまたは起動してください。</string>
    <!-- Next step for the problem above. -->
    <string name="video_problem_sign_in_next_step">オーナーに動画プラグインへのアクセスを確認してもらってください。</string>
    <!-- Problem title: the video service doesn't accept this person's account. -->
    <string name="video_problem_sign_in_title">動画サービスがアカウントを認識できません</string>
    <!-- Button that continues a paused download. -->
    <string name="video_resume_download">再開</string>
    <!-- Under a person's photo. -->
    <string name="video_role_producer">プロデューサー</string>
    <!-- Under a person's photo. -->
    <string name="video_role_writer">脚本</string>
    <!-- Button at the end of a row header that opens the full list. -->
    <string name="video_see_all">すべて表示</string>
    <!-- Row of recently added movies and shows. -->
    <string name="video_shelf_latest">最近追加した項目</string>
    <!-- Title of the sort picker on the poster wall. -->
    <string name="video_sort">並べ替え</string>
    <!-- Sort option: highest rated first. -->
    <string name="video_sort_rating">評価</string>
    <!-- Sort option: newest release first. -->
    <string name="video_sort_released">公開日</string>
    <!-- Title of the subtitle picker. -->
    <string name="video_subtitles">字幕</string>
    <!-- Subtitle picker option: no subtitles. -->
    <string name="video_subtitles_off">オフ</string>
    <!-- Filter toggle: show only what the person hasn't watched. -->
    <string name="video_unplayed_only">未視聴のみ</string>
    <!-- Menu item on the video page that opens the plugin's own web page. -->
    <string name="video_web_version">Web 版</string>
</resources>
