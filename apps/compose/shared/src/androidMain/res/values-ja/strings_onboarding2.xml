<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary button that finishes setup and starts the installs. -->
    <string name="onboarding_done">これらのアプリをインストール</string>
    <!-- Primary button after setup finished: leave setup and open chat. -->
    <string name="onboarding_enter_chat">チャットへ</string>
    <!-- Problem title while installing: the home server is older than the app needs. -->
    <string name="onboarding_problem_plugin_server_too_old">自宅サーバーのバージョンが古すぎます。先にサーバーをアップデートしてください。</string>
    <!-- Problem title while installing: the home server can't be reached. -->
    <string name="onboarding_problem_plugin_transport_unavailable">自宅サーバーに接続できません。ネットワークを確認して再試行してください。</string>
    <!-- Problem title in setup: some recommendations didn't load. -->
    <string name="onboarding_problem_store_incomplete">一部のおすすめを読み込めませんでした。再試行するかスキップできます。</string>
    <!-- Problem title in setup: recommendations are unavailable for another reason. -->
    <string name="onboarding_problem_store_other">おすすめを読み込めません。再試行するかスキップできます。</string>
    <!-- Problem title in setup: the recommendation source responds too slowly. -->
    <string name="onboarding_problem_store_timeout">おすすめの提供元の応答に時間がかかっています。再試行するか、スキップしてください。</string>
    <!-- Problem title in setup: the recommendation source can't be reached. -->
    <string name="onboarding_problem_store_unreachable">おすすめの提供元に接続できません。再試行するかスキップできます。</string>
    <!-- Fallback when the core gives no reason why an app can't be installed. -->
    <string name="onboarding_review_blocked">このアプリはインストールできません</string>
    <!-- Row description in the review step: finishing will not touch this. -->
    <string name="onboarding_review_unchanged">変更しません</string>
    <!-- Row description in the review step: the model couldn't be reached during the test. -->
    <string name="onboarding_review_unreachable">テスト時に接続できませんでした</string>
    <!-- Busy label while a setup step or an install task is running. -->
    <string name="onboarding_running">処理中</string>
    <!-- Dismissable tip above the chat input: confirm approval requests on the card in chat. -->
    <string name="onboarding_tip_confirmation_card">確認が必要なときは、チャットのカードで確認してください。</string>
</resources>
