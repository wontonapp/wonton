<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Problem title when the core rejected the input; the core's own reason is shown as the next step. -->
    <string name="problem_appearance_title">外観設定を保存できませんでした</string>
    <!-- Next step under the refused problem: the sign-in is fine; the server refused this one action. -->
    <string name="problem_forbidden_next_step">ログインは有効です。権限がないか、相手にブロックされているか、相手のサーバーがまだ自宅サーバーとつながっていない可能性があります。</string>
    <!-- Next step: check the proxy on the home server, or change the address in the internet proxy settings. -->
    <string name="problem_plugin_egress_proxy_unavailable_next_step">自宅サーバー上のプロキシを確認するか、プロキシ設定でアドレスを変えてから、もう一度お試しください。</string>
    <!-- Problem title: the app can't reach the internet through the internet proxy. -->
    <string name="problem_plugin_egress_proxy_unavailable_title">プロキシに接続できません</string>
    <!-- Problem title: the app and the home server versions don't match. -->
    <string name="problem_plugin_protocol_title">Wontonと自宅サーバーのバージョンが合っていません</string>
    <!-- Next step: uninstall the app (its data can be kept) and install it again. -->
    <string name="problem_plugin_record_unusable_next_step">このアプリをアンインストール（データは残せます）して、もう一度インストールしてください。</string>
    <!-- Problem title when the proxy settings were rejected as invalid; the core's own reason is shown as the next step. -->
    <string name="problem_plugin_save_invalid_title">入力内容が正しくありません</string>
    <!-- Problem title: the home server is older than this app needs. -->
    <string name="problem_plugin_server_too_old_title">自宅サーバーのバージョンが古すぎます</string>
    <!-- Problem title: some apps couldn't be loaded into the list. -->
    <string name="problem_store_incomplete_title">一部のアプリが読み込まれていません</string>
    <!-- Next step: wait a few minutes and try again. -->
    <string name="problem_store_rate_limited_next_step">数分待ってからもう一度お試しください。</string>
    <!-- Problem title: the app's source answered too slowly, the list may be stale. -->
    <string name="problem_store_timeout_title">アプリの提供元の応答が遅すぎます。一覧が最新でない可能性があります</string>
    <!-- Next step under the not-recognized problem: pair again by scanning the code. -->
    <string name="problem_unauthorized_next_step">ペアリングコードをもう一度スキャンしてください。</string>
    <!-- Problem title: the home server no longer accepts this device. -->
    <string name="problem_unauthorized_title">自宅サーバーがこのデバイスを認識していません</string>
    <!-- Next step under the server-error problem. Also used for other problems that only say to try later. -->
    <string name="problem_upstream_next_step">しばらくしてからもう一度お試しください。</string>
</resources>
