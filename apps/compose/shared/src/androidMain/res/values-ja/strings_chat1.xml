    <!-- Value on the Settings row: backup is off. -->
    <string name="chat_backup_value_disabled">オフ</string>
    <!-- Value on the Settings row for chat backup: backup is on. -->
    <string name="chat_backup_value_enabled">オン</string>
    <!-- Value on the Settings row: backup or recovery is running. -->
    <string name="chat_backup_value_in_progress">処理中</string>
