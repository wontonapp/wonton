<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar button that opens the Add Source page. -->
    <string name="store_add_source">提供元を追加</string>
    <!-- Button on a store row to install an app you don't have. -->
    <string name="store_get">入手</string>
    <!-- Small tag on a store row for an app that asks for risky permissions. -->
    <string name="store_high_permissions">高い権限</string>
    <!-- Button that requests store content when it has not been loaded. -->
    <string name="store_load">ストアを読み込む</string>
    <!-- Shown when a store search found nothing. -->
    <string name="store_no_results">見つかりません</string>
    <!-- Store state before any store load has been requested. -->
    <string name="store_not_requested">ストアはまだ読み込まれていません</string>
    <!-- Button on a store row to open an installed app. -->
    <string name="store_open">開く</string>
    <!-- Shown after five seconds of loading without claiming a cause. -->
    <string name="store_pending">ストアの内容をまだ取得できていません。原因は不明です。</string>
    <!-- Problem title in the store with the source it came from. Arguments: the provider's name, the problem title from the core. -->
    <string name="store_problem_from_source">%1$s：%2$s</string>
    <!-- Placeholder under an added source whose list hasn't been fetched yet. Argument: the source's provider name. -->
    <string name="store_reading">%1$sを読み込み中…</string>
    <!-- Button that requests a new store load after loading takes a while. -->
    <string name="store_reload">再読み込み</string>
    <!-- Placeholder of the search field on the Store screen. -->
    <string name="store_search_prompt">検索</string>
    <!-- Section title above community apps in the store. -->
    <string name="store_section_community">コミュニティ</string>
    <!-- Section title above reviewed apps in the store. -->
    <string name="store_section_reviewed">審査済み</string>
    <!-- Chip that clears the tag filter in the store. -->
    <string name="store_tag_all">すべて</string>
    <!-- Title of the Store screen and of the row that opens it. -->
    <string name="store_title">ストア</string>
    <!-- Notice for an app in a source whose manifest can't be read. Arguments: the source address, the reason from the core. -->
    <string name="store_unreadable">%1$sを読み込めません：%2$s</string>
    <!-- Button on a store row to update an installed app. -->
    <string name="store_update">アップデート</string>
    <!-- Caption on a store row whose listing comes through an index. Argument: the index's name. -->
    <string name="store_via_index">%1$s経由</string>
    <!-- Store load is waiting for a connection; connection controls remain in the status line. -->
    <string name="store_waiting_for_connection">接続を待ってからストアを読み込みます</string>
    <!-- アップデートのあるアプリをまとめて更新する前のボトムシートのタイトル。 -->
    <plurals name="store_update_all_title">
        <item quantity="other">%1$d個のアプリをアップデート</item>
    </plurals>
    <!-- そのシートですべてのアップデートを始めるボタン。 -->
    <string name="store_update_all">すべてアップデート</string>
    <!-- そのシートを開くツールバーのダウンロードアイコンの読み上げ。 -->
    <string name="store_update_all_a11y">すべてアップデート、%1$d件</string>
    <string name="store_update_batch_running">アプリを更新中 · %1$d/%2$d件完了</string>
    <string name="store_update_batch_finished">更新結果：成功 %1$d件 · 失敗 %2$d件 · 要確認 %3$d件</string>
    <string name="store_update_batch_clear">結果を消去</string>
    <string name="store_update_batch_target">更新先バージョン：%1$s</string>
    <string name="store_update_batch_queued">更新待ち</string>
    <string name="store_update_batch_checking">アップデートを確認中</string>
    <string name="store_update_batch_needs_decision">確認が必要です</string>
    <string name="store_update_batch_review">内容を確認</string>
    <string name="store_update_batch_review_app">%1$sの更新内容を確認</string>
</resources>
