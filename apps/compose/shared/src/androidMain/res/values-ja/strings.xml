<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 资源实际落到的语言标签，App 靠它知道界面用的是哪种语言，再告诉核心（见 AppLanguage.kt）。
         每种语言的这一条都保留原值，不要翻译。 -->
    <string name="language_tag">ja</string>
    <!-- Label before an address that a third-party client uses to connect to the app. -->
    <string name="lan_client_address">アドレス</string>
    <!-- Label before the password a third-party client uses to sign in to the app. -->
    <string name="lan_client_password">パスワード</string>
    <!-- Label before the username a third-party client uses to sign in to the app. -->
    <string name="lan_client_username">ユーザー名</string>
    <!-- Note under the Open on Local Network switch. First argument: number of ports; second: the port numbers, comma-separated. -->
    <plurals name="lan_webui_ports">
        <item quantity="other">ポート：%1$s</item>
    </plurals>
    <!-- Switch on an app's page: make the app's web page reachable from other devices on the local network. The ports are listed below. -->
    <string name="lan_webui_toggle">ローカルネットワークに公開</string>
    <!-- Row in the server list that opens signing in with an existing Matrix account. No arguments; short label. -->
    <string name="matrix_login_entry">Matrix アカウントでログイン</string>
    <!-- Navigation title of the Matrix sign-in page. No arguments; fits a phone navigation bar. -->
    <string name="matrix_login_title">Matrix にログイン</string>
    <!-- Field label for the Matrix server to sign in to, a server name like matrix.org or an https URL. No arguments; short label. -->
    <string name="matrix_login_server">サーバー</string>
    <!-- Button that asks the core to check the server and list the ways to sign in. No arguments; short button label. -->
    <string name="matrix_login_continue">次へ</string>
    <!-- Progress line while the core contacts the server to discover the sign-in methods. Argument: the server name or URL the user chose. -->
    <string name="matrix_login_contacting">%1$s に接続中</string>
    <!-- Button for the password method in the list of ways the server supports. No arguments; short button label. -->
    <string name="matrix_login_method_password">パスワードでログイン</string>
    <!-- Button for the server's own OIDC sign-in, which opens in the system browser. No arguments; short button label. -->
    <string name="matrix_login_method_oidc">ブラウザで続行</string>
    <!-- Field label for the full Matrix user ID, like @user:example.org. No arguments; short label. -->
    <string name="matrix_login_user_id">Matrix ユーザー ID</string>
    <!-- Field label for the account password. No arguments; short label. -->
    <string name="matrix_login_password">パスワード</string>
    <!-- Button that submits the user ID and password to the server. No arguments; short button label. -->
    <string name="matrix_login_sign_in">ログイン</string>
    <!-- Progress line while the core signs in with the password. No arguments. -->
    <string name="matrix_login_signing_in">ログイン中</string>
    <!-- Progress line while the core stores the signed-in session on this phone. No arguments. -->
    <string name="matrix_login_saving">セッションを保存中</string>
    <!-- Progress line while the user finishes the sign-in in the system browser. No arguments. -->
    <string name="matrix_login_finish_in_browser">ブラウザでログインを完了してください</string>
    <!-- Button that opens the browser again for the pending OIDC sign-in. No arguments; short button label. -->
    <string name="matrix_login_open_browser">ブラウザを開く</string>
    <!-- Notice when the phone has no app that can open the browser link. No arguments. -->
    <string name="matrix_login_no_browser">ログインページを開けるブラウザアプリがありません</string>
    <!-- Failure title: the server name or URL doesn't point to a Matrix homeserver. No arguments. -->
    <string name="matrix_login_failed_invalid_homeserver">このアドレスに Matrix サーバーが見つかりません</string>
    <!-- Failure title: the server couldn't be reached to discover the sign-in methods. No arguments. -->
    <string name="matrix_login_failed_discovery">サーバーに接続できません</string>
    <!-- Failure title: the server offers none of the sign-in methods this app supports. No arguments. -->
    <string name="matrix_login_failed_unsupported_method">このサーバーには利用可能なログイン方法がありません</string>
    <!-- Failure title: the network is unavailable. No arguments. -->
    <string name="matrix_login_failed_transport">ネットワークに接続できません</string>
    <!-- Failure title: the server rejected the user ID or password. No arguments. -->
    <string name="matrix_login_failed_invalid_credentials">ユーザー ID またはパスワードが違います</string>
    <!-- Failure title: the server rejected the browser sign-in. No arguments. -->
    <string name="matrix_login_failed_oidc_rejected">サーバーがブラウザでのログインを拒否しました</string>
    <!-- Failure title: the browser came back without a complete sign-in result. No arguments. -->
    <string name="matrix_login_failed_invalid_callback">ブラウザから返されたログイン結果が不完全です</string>
    <!-- Failure title: the sign-in took too long or expired on the server. No arguments. -->
    <string name="matrix_login_failed_expired">ログインの有効期限が切れました。最初からやり直してください</string>
    <!-- Failure title: signing in worked but saving the session on this phone failed. No arguments. -->
    <string name="matrix_login_failed_storage">ログインできましたが、この端末への保存に失敗しました</string>
    <!-- Failure title: the homeserver or its sign-in service returned an error (5xx, rate limiting, an unexpected reply), not a problem with the credentials or input. No arguments. -->
    <string name="matrix_login_failed_upstream">サーバーかそのログインサービスで問題が発生しました</string>
    <!-- Failure title for every category the app doesn't know. No arguments. -->
    <string name="matrix_login_failed_other">ログインに失敗しました</string>
    <!-- Notice when the core reports a state the app doesn't know. No arguments. -->
    <string name="matrix_login_unknown_state">現在ログインを続けられません</string>
    <!-- Section title, field label and accessibility label for the owner's email address. -->
    <string name="owner_profile_email">メールアドレス</string>
    <!-- Placeholder in the empty email field. -->
    <string name="owner_profile_email_optional">任意</string>
    <!-- Section title, field label and accessibility label for the owner's display name. -->
    <string name="owner_profile_name">名前</string>
    <!-- Title of the owner profile page (name and email) and its entry point in Settings. -->
    <string name="owner_profile_title">プロフィール</string>
    <!-- Row label for the account name the home server assigned; shown under the form. -->
    <string name="owner_profile_username">ユーザー名</string>
    <!-- Name of the notification channel for audio playing in plugin pages. -->
    <string name="page_media_channel">再生</string>
    <!-- Log when the media foreground service cannot be started from the background. Arguments: reason, foreground service reason. -->
    <string name="page_media_start_failed">バックグラウンドでサービスを開始できません。再生は続け、後で再試行します：%1$s（フォアグラウンドサービス：%2$s）</string>
    <string name="pin_to_bar">ナビゲーションバーに追加</string>
    <!-- サイドバーの行を長押しして、アプリのページをナビゲーションバーから外す。 -->
    <string name="unpin_from_bar">ナビゲーションバーから外す</string>
    <string name="widget_recent_chats_label">最近のチャット</string>
    <string name="widget_agent_status_label">ボットの状態</string>
    <string name="widget_open_to_start">Wontonを開いて始めましょう</string>
    <string name="widget_open_to_pair">Wontonを開いてペアリング</string>
    <string name="widget_open_to_sign_in">サインアウトしました。Wontonを開いてサインインしてください。</string>
    <string name="widget_open_to_refresh">Wontonを開いて更新</string>
    <string name="widget_choose_agent">Wontonでデフォルトのエージェントを選んでください</string>
    <string name="widget_agent_status_unknown">状態不明</string>
    <string name="widget_updated_at">%1$s に更新</string>
    <string name="widget_status_at">%1$s · %2$s</string>
    <string name="side_chat">サイドチャット</string>
    <string name="side_chat_new">新しいサイドチャット</string>
