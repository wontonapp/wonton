<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Empty page: the one sentence above the two add actions. -->
    <string name="peers_empty">ほかのサーバとはまだ接続していません</string>
    <!-- Row subtitle when the other server can't be reached. -->
    <string name="peers_status_offline">相手のサーバーに接続できません</string>
    <!-- Under the offline subtitle. Argument: relative time like "3 hours ago". -->
    <string name="peers_last_connected">最終接続：%1$s</string>
    <!-- Approve button on a request row. -->
    <string name="peers_request_approve">承認</string>
    <!-- Confirmation dialog title for removing a paired server. Argument: the other owner's display name. -->
    <string name="peers_remove_title">「%1$s」を削除しますか？</string>
    <!-- Failure title when the other server can't be reached. -->
    <string name="peers_error_peer_unreachable">相手のサーバーに接続できません</string>
    <!-- Failure title when the two servers are already paired. -->
    <string name="peers_error_already_paired">このサーバーにはすでに接続しています</string>
    <!-- Failure title when the other server can't take more requests right now. -->
    <string name="peers_error_too_many_requests">相手は現在リクエストを受け付けられません。しばらくしてからもう一度お試しください。</string>
    <!-- Notice when the request just handled was already processed elsewhere; the list refreshes itself. -->
    <string name="peers_error_request_not_found">このリクエストはすでに処理されています</string>
</resources>
