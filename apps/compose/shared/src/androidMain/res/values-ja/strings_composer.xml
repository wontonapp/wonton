<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label. -->
    <string name="composer_attach">添付</string>
    <!-- Title of the problem shown when the file picker fails. The detail is the system's reason. -->
    <string name="composer_choose_failed">このファイルを選択できません</string>
    <!-- Item in the composer's attachment menu: pick files to send. -->
    <string name="composer_file">ファイル</string>
    <!-- Placeholder in the chat composer's empty text field. -->
    <string name="composer_message">メッセージ</string>
    <!-- Item in the composer's attachment menu: pick a photo to send. -->
    <string name="composer_photo">写真</string>
    <!-- Screen-reader label of the round send button at the right of the chat composer. -->
    <string name="composer_send">送信</string>
    <string name="composer_edit_confirm">確定</string>
    <string name="composer_file_unreadable">このファイルを読み込めませんでした。もう一度コピーするか、別のファイルを選んでください。</string>
    <string name="composer_tray_full">一度に送れる添付は %1$d 個までです。</string>
    <string name="composer_attachment_remove">%1$s を外す</string>
    <string name="composer_attachment_paused">自宅のサーバーへの接続を待っています</string>
    <string name="composer_attachment_failed">アップロードできませんでした</string>
    <string name="composer_attachment_retry">もう一度アップロード</string>
    <string name="composer_attachment_too_large">写真が自宅のサーバーのサイズ上限を超えています。ファイルとして送ってください。</string>
    <string name="composer_attachment_source_unavailable">元のファイルを読み込めなくなりました。もう一度選んでください。</string>
    <string name="composer_attachment_storage_full">自宅のサーバーの容量がいっぱいです。</string>
    <string name="composer_attachment_rejected">自宅のサーバーがこのアップロードを拒否しました。</string>
    <string name="composer_attachment_upstream">自宅のサーバーでエラーが起きました。</string>
    <string name="composer_attachment_local_storage">このスマートフォンの空き容量が足りません。</string>
    <!-- Round button in the chat composer while the bot is working on a turn: stops that turn. Also its screen-reader label. -->
    <string name="composer_stop">停止</string>
    <!-- Screen-reader label of the composer's stop button while the stop request is on its way; the button shows a spinner. -->
    <string name="composer_stopping">停止中</string>
    <!-- One-line note above the chat composer right after the home server confirmed the bot's turn was stopped. -->
    <string name="composer_stopped">停止しました</string>
    <!-- One-line note above the chat composer: the home server did not stop the bot's turn. The stop button stays for another try. -->
    <string name="composer_stop_failed">停止できませんでした。もう一度お試しください。</string>
    <!-- One-line note above the chat composer: this person isn't allowed to stop this bot's turn. -->
    <string name="composer_stop_forbidden">これを停止する権限がありません。</string>
    <!-- One-line note above the chat composer: the stop request may not have reached the home server, so it is unknown whether the bot's turn stopped. The stop button stays for another try. -->
    <string name="composer_stop_uncertain">自宅サーバに接続できず、停止できたか分かりません。もう一度お試しください。</string>
    <!-- 入力欄のクリップの左にあるアイコンボタン：Bot のコマンド一覧を開く。読み上げラベルも兼ねる。 -->
    <string name="composer_commands">コマンド</string>
    <!-- コマンド一覧の末尾：一覧に出ていない件数。引数：件数。 -->
    <string name="composer_commands_more">ほか %1$d 件のコマンドは表示していません</string>
    <!-- 添付の形式をサーバーが受け取れないときの説明行。引数なし。 -->
    <string name="composer_attachment_unsupported_type">この形式はアップロードできません</string>
    <!-- 返信元がないので返信を外したときの説明行。引数なし。 -->
    <string name="composer_attachment_reply_target">返信元がありません。返信を外してください</string>

</resources>
