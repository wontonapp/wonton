<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button in the video player's failure view: download the file, then open it in another app. -->
    <string name="file_download_and_open">ダウンロードしてほかのアプリで開く</string>
    <!-- Title of the problem shown when no installed app can open a downloaded file. Android only. -->
    <string name="file_no_app_opens_it">このファイルを開けるアプリがありません</string>
    <!-- Link under a file card: open the downloaded file with another app. -->
    <string name="file_open_elsewhere">ほかのアプリで開く</string>
    <!-- Line under a file card while its download is paused. Argument: the home server's reason, shown as is. -->
    <string name="file_paused">一時停止：%1$s</string>
    <!-- Line under a file card while its download is paused without a reason: it resumes when the connection recovers. -->
    <string name="file_paused_waiting">接続の回復後にダウンロードを再開</string>
    <!-- Caption under a file card: which bot sent the file. First argument: the bot's name; second: the plugin's name. -->
    <string name="file_source_bot">%1$s（%2$s）から</string>
    <!-- Caption under a file card: the sender is unknown. -->
    <string name="file_source_unknown">提供元不明</string>
    <!-- Reason in the collapsed details of an upload problem: the system didn't provide the picked file. Android only. -->
    <string name="file_system_no_file">システムがこのファイルを提供しませんでした</string>
    <!-- Fallback name for an uploaded file when the system doesn't provide one. Shown as the file's name. Android only. -->
    <string name="file_unnamed">ファイル</string>
</resources>
