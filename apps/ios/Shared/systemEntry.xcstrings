    "systemEntry.updatedLabel": {
      "comment": "Footer of the recent chats widget, followed by a live relative time like “5 minutes ago” rendered by the system. The label and the time are separate segments, so this is a label, not a sentence. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次更新于"
          }
        },
        "zh-Hant": {
