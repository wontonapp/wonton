{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "systemEntry.recentChats": {
      "comment": "Name of the home screen widget showing recent chats, shown in the widget gallery. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent chats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のチャット"
          }
        }
      }
    },
    "systemEntry.recentChatsDescription": {
      "comment": "Description of the recent chats widget in the widget gallery. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your latest chats and unread counts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的会话和未读数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的會話和未讀數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のチャットと未読数を表示します。"
          }
        }
      }
    },
    "systemEntry.botStatus": {
      "comment": "Name of the home screen widget showing the default bot's status, shown in the widget gallery. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot 状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot 狀態"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットの状態"
          }
        }
      }
    },
    "systemEntry.botStatusDescription": {
      "comment": "Description of the bot status widget in the widget gallery. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your default bot is up to."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Bot 在做什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 Bot 在做什麼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのボットの状態を表示します。"
          }
        }
      }
    },
    "systemEntry.askBot": {
      "comment": "Name of the ask-bot widget and control, and the label under its icon. Opens the chat with the default bot. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに質問"
          }
        }
      }
    },
    "systemEntry.askBotDescription": {
      "comment": "Description of the ask-bot widget and control in the galleries. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the chat with your default bot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开和默认 Bot 的聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開和預設 Bot 的聊天。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのボットとのチャットを開きます。"
          }
        }
      }
    },
    "systemEntry.openToStart": {
      "comment": "Widget text before Wonton has been opened once since install. Tapping opens the app. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton to get started"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开云吞开始使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開雲吞開始使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonを開いて始めましょう"
          }
        }
      }
    },
    "systemEntry.openToPair": {
      "comment": "Widget text when the app isn't paired with a home server. Tapping opens the app. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton to pair"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开云吞完成配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開雲吞完成配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonを開いてペアリング"
          }
        }
      }
    },
    "systemEntry.openToSignIn": {
      "comment": "Widget text when the session was signed out or revoked. Tapping opens the app. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out. Open Wonton to sign in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出登录，打开云吞重新登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已登出，打開雲吞重新登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトしました。Wontonを開いてサインインしてください。"
          }
        }
      }
    },
    "systemEntry.openToRefresh": {
      "comment": "Widget text when the app is switching servers or the widget data can't be read. Tapping opens the app. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton to refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开云吞刷新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開雲吞重新整理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonを開いて更新"
          }
        }
      }
    },
    "systemEntry.chooseAgent": {
      "comment": "Bot status widget when no default agent is set. Tapping opens the app. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a default agent in Wonton"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在云吞里选一个默认 Agent"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在雲吞裡選一個預設 Agent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonでデフォルトのエージェントを選んでください"
          }
        }
      }
    },
    "systemEntry.noChats": {
      "comment": "Recent chats widget when the account has no rooms yet. No arguments.",
      "extractionState": "manual",
      "localizations": {
