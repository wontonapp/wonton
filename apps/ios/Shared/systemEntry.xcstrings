            "value": "更新於"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終更新:"
          }
        }
      }
    },
    "systemEntry.unreadCount": {
      "comment": "Lock screen widgets: the inline recent-chats widget shows the total unread across all chats, the rectangular bot-status widget shows the agent chat's count. Argument: a decimal number of unread messages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld unread"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条未读"
          }
        },
        "zh-Hant": {
