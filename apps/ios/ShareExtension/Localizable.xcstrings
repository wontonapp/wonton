{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "shareExtension.cannotOpen": {
      "comment": "Shown in the share sheet when Wonton couldn't be opened after copying what was shared; nothing was sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open Wonton"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打不开云吞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打不開雲吞"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton を開けませんでした"
          }
        }
      }
    },
    "shareExtension.cannotOpenNextStep": {
      "comment": "Next step under the message above.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton, then share again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先打开云吞，再分享一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先打開雲吞，再分享一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton を開いてから、もう一度共有してください。"
          }
        }
      }
    },
    "shareExtension.close": {
      "comment": "Button that closes Wonton's share screen after an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "shareExtension.unreadable": {
      "comment": "Shown in the share sheet when what was shared couldn't be read or copied; nothing was sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read what you shared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不了分享的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不了分享的內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された内容を読み込めませんでした"
          }
        }
      }
    },
    "shareExtension.unreadableNextStep": {
      "comment": "Next step under the message above.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try sharing it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再分享一次试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再分享一次試試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度共有してみてください。"
          }
        }
      }
    }
  }
}
