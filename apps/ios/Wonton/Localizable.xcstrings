    "toolPolicy.allowAll.risk": {
      "comment": "Warning under the allow-all switches.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot can use every app's tools without asking, including apps installed later. A prompt injection could make it change data, delete things, or send content out without your approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Bot 用所有插件的工具都不再问，以后装的也算。提示注入能让它不经确认改数据、删东西、往外发内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Bot 用所有 App 的工具都不再問，以後裝的也算。提示注入能讓它不經確認改資料、刪東西、往外發內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットは、すべてのアプリのツールを確認なしで使えます。あとからインストールしたアプリも含まれます。プロンプトインジェクションによって、確認なしでデータの変更や削除、外部への送信が行われるおそれがあります。"
          }
        }
      }
    },
    "toolPolicy.allowAll.title": {
      "comment": "Section title for bots that may use every app's tools without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow (All Apps)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一律允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に許可（すべてのアプリ）"
          }
        }
      }
    },
    "toolPolicy.always.risk": {
      "comment": "Warning under the Always Allow switches.",
      "extractionState": "manual",
      "localizations": {
