    "chatBackup.resetMessage": {
      "comment": "Body of the reset confirmation dialog: a new recovery key is issued, the old one stops working.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a new recovery key and the old one stops working. Old messages may become unreadable, and your other devices will need the new key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会换一把新的恢复密钥，旧的作废。重置后旧消息可能读不了，其他设备要输入新密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會產生新的復原金鑰，舊的會失效。重置後可能無法讀取舊訊息，其他裝置也要輸入新金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい復旧キーが発行され、古いキーは使えなくなります。リセット後は過去のメッセージが読めなくなることがあり、他のデバイスでは新しいキーの入力が必要です。"
          }
        }
      }
    },
    "chatBackup.resetTitle": {
      "comment": "Title of the reset confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
