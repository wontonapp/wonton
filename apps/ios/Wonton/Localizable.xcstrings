    "pairing.instructions": {
      "comment": "Explanation above the paste field: where the pairing QR code lives. May wrap.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your home network, open your home server's IP address in a browser (the installer prints it on the computer), then scan the pairing QR code on that page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のローカルネットワークで、ブラウザーで自宅サーバのIPアドレス（インストール時にホストのターミナルに表示されます）を開くと、ペアリング用QRコードが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家里的局域网里，用浏览器打开家里服务器的 IP 地址（装好时主机的终端里会给出），页面上有配对二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在家用區域網路裡，用瀏覽器開啟家用伺服器的 IP 位址（安裝時主機的終端機裡會給出），頁面上有配對 QR 碼。"
          }
        }
      }
    },
    "pairing.nextStep.closed": {
      "comment": "Next step when the first-pairing code was already used up: this server has paired devices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server already has paired devices, so its first-pairing code can't be used again. Use Add Device on a paired device, or run `sudo wonton pair` on the computer for a new code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバにはペアリング済みのデバイスがあるため、初回ペアリング用のコードは使えません。ペアリング済みのデバイスで「デバイスを追加」を使うか、ホストで `sudo wonton pair` を実行して新しいコードを発行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器已经有配对的设备，首次配对码不能再用；在已配对的设备上用“添加设备”，或在主机上执行 `sudo wonton pair` 另发一个码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器已經有配對的裝置，首次配對碼不能再用；在已配對的裝置上用「新增裝置」，或在主機上執行 `sudo wonton pair` 另發一個碼。"
          }
        }
      }
    },
    "pairing.nextStep.newCode": {
      "comment": "Next step after a rejected or expired code: get another one. Names both ways.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a new code: use Add Device on a paired device, or run `sudo wonton pair` on the computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコードを発行してください：ペアリング済みのデバイスで「デバイスを追加」を使うか、ホストで `sudo wonton pair` を実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一个新码：在已配对的设备上用“添加设备”出码，或在主机上执行 `sudo wonton pair`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換一個新碼：在已配對的裝置上用「新增裝置」取得新碼，或在主機上執行 `sudo wonton pair`。"
          }
        }
      }
    },
