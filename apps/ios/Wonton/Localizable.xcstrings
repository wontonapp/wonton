    "Ask a Bot": {
      "comment": "App Intent title in Siri and Shortcuts: send a sentence to the default agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a Bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに聞く"
          }
        }
      }
    },
    "Sends a sentence to your default agent and opens the direct chat.": {
      "comment": "App Intent description under the title in Shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a sentence to your default agent and opens the direct chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一句话发给默认 Agent，并打开私聊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把一句話傳給預設 Agent，並開啟私訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのエージェントに一言送り、ダイレクトチャットを開きます。"
          }
        }
      }
    },
    "Message": {
      "comment": "Typed parameter title of the Ask a Bot action.",
