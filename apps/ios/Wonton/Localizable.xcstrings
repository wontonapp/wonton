    "chatBackup.saveKeyNote": {
      "comment": "Note under the freshly issued recovery key: it is only shown once.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need it when you switch phones. It's only shown once; after \"Saved\" this device keeps no copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换手机时要用它。只显示这一次，点“已保存”后本机不再留着它。"
