    "chatBackup.resetConfirm": {
      "comment": "Danger button that confirms the reset in the dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        },
        "ja": {
