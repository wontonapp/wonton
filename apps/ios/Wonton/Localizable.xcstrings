    "confirmationCard.expired": {
      "comment": "Status line on an approval request card: the request expired, so nothing was carried out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired, not carried out"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れのため実行されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期，没有执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已過期，沒有執行"
          }
        }
      }
    },
    "confirmationCard.failedResult": {
      "comment": "Status line on an approval request card: the action ran but failed. Argument: the home server's result message, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't go through: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行できませんでした：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有成功：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有成功：%1$@"
          }
        }
      }
    },
    "confirmationCard.rejected": {
      "comment": "Status line on an approval request card: it was denied, so nothing was carried out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied, not carried out"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否したため実行されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝，没有执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕，沒有執行"
          }
        }
      }
    },
    "confirmationCard.running": {
      "comment": "Status line on an approval request card while the action is being carried out, next to a spinner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在執行"
          }
        }
      }
    },
    "confirmationCard.stopWindow": {
      "comment": "Button on an approval request card: stop the approval window during which further actions run without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "confirmationCard.uncertainResult": {
      "comment": "Status line on an approval request card: the action ran, but whether it worked is unknown. Argument: the home server's result message, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's unclear whether it worked: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を確認できません：%1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定：%1$@"
          }
        }
      }
    },
    "confirmationCard.windowUntil": {
      "comment": "Line on an approval request card: further actions run without asking until the approval window closes. Argument: the closing time, already formatted as a time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved until %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@まで許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允許至 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許至 %1$@"
          }
        }
      }
    },
    "egress.address": {
      "comment": "Section title and text field label for the proxy address (like http://192.0.2.10:7890).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシのアドレス"
          }
        }
      }
    },
    "egress.address.enter": {
      "comment": "Radio option: type a proxy address by hand instead of using an app's proxy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter Proxy Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写代理地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入代理伺服器位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシのアドレスを入力"
          }
        }
      }
    },
    "egress.address.useProvider": {
      "comment": "Radio option: use the proxy that an installed app provides. Argument: that app's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を使用"
          }
        }
      }
    },
    "egress.path.apps": {
      "comment": "Row title on the Internet proxy page: whether apps on the home server can reach the internet through the proxy. The value on the right is a reachability status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        }
      }
    },
    "egress.path.failed": {
      "comment": "Status value: the internet can't be reached through the proxy. A reason is shown below the row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreachable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不通"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続不可"
          }
        }
      }
    },
    "egress.path.homeServer": {
      "comment": "Row title on the Internet proxy page: whether the home server itself can reach the internet through the proxy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバ"
          }
        }
      }
    },
    "egress.path.probing": {
      "comment": "Status value next to Apps / Home Server while the proxy is being checked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探测中"
          }
        },
        "zh-Hant": {
