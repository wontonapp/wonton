    "toolPolicy.readOnlyHint": {
      "comment": "Explanation shown when the tool list is expanded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools switched on here count as read-only. Every bot can call them without asking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开的工具算只读，所有 Bot 调它都不再问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟的工具算唯讀，所有 Bot 呼叫它都不再問"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしたツールは読み取り専用として扱われ、すべてのボットが確認なしで呼び出せます"
