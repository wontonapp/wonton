    "verification.incoming.message": {
      "comment": "Body of the confirmation prompt on the already-verified device. Argument: the other device's name, or its ID when it has none.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify “%@” with this device?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで「%@」を確認しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这台设备确认「%@」？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用這部裝置確認「%@」？"
          }
        }
      }
    },
    "verification.requested": {
      "comment": "Status while waiting for the other device to accept the request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your other device to accept…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスの承認を待っています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一台设备接受…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一部裝置接受…"
          }
        }
      }
    },
    "verification.requested.hint": {
      "comment": "Shown under the waiting status: the other phone only sees the request when its app is open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton on your other phone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のスマホでWontonを開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你另一台手机上的云吞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開你另一支手機上的雲吞。"
          }
        }
      }
    },
