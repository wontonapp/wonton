{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "app.launchFailed": {
      "comment": "ContentUnavailableView title when the core couldn't start and the app shows no UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch Failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動できませんでした"
          }
        }
      }
    },
    "app.coreLaunchFailed": {
      "comment": "ContentUnavailableView description: the core couldn't start. Argument: the developer description from the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton couldn't start: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞启动失败：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞啟動失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonを起動できませんでした：%@"
          }
        }
      }
    },
    "app.devCodeRejected": {
      "comment": "Development-only error: the pairing code passed in by the developer build was rejected. Argument: the core's description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dev pairing code was rejected: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发时传入的配对码被拒绝：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發時傳入的配對碼被拒絕：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発用のペアリングコードが拒否されました：%@"
          }
        }
      }
    },
    "Page": {
      "comment": "Entity type name of a page in Siri and Shortcuts. Also the parameter title of the Open Page action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ"
          }
        }
      }
    },
    "Ask a bot: %@": {
      "comment": "Parameter summary of the Ask a Bot action. Argument: the message parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a bot: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 Bot：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問 Bot：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに聞く：%@"
          }
        }
      }
    },
    "Ask a bot with %@": {
      "comment": "Siri phrase for the Ask a Bot action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a bot with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用%1$@问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用%1$@問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でボットに聞く"
          }
        }
      }
    },
    "Ask a bot in %@": {
      "comment": "Second Siri phrase for the Ask a Bot action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a bot in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@里问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@裡問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でボットに聞く"
          }
        }
      }
    },
    "New chat in %@": {
      "comment": "Siri phrase for the New Chat action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New chat in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@里新建会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@裡新增聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で新しいチャット"
          }
        }
      }
    },
    "Start a chat with %@": {
      "comment": "Second Siri phrase for the New Chat action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a chat with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用%1$@发起私聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用%1$@發起私訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でチャットを開始"
          }
        }
      }
    },
    "Open %@ with %@": {
      "comment": "Siri phrase for the Open Page action. Arguments: the page, then the app name filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用%2$@打开 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用%2$@開啟 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@で%1$@を開く"
          }
        }
      }
    },
    "Open %@ in %@": {
      "comment": "Second Siri phrase for the Open Page action. Arguments: the page, then the app name filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%2$@里打开 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%2$@裡開啟 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@で%1$@を開く"
          }
        }
      }
    },
    "Ask a Bot": {
      "comment": "App Intent title in Siri and Shortcuts: send a sentence to the default agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a Bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに聞く"
          }
        }
      }
    },
    "Sends a sentence to your default agent and opens the direct chat.": {
      "comment": "App Intent description under the title in Shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a sentence to your default agent and opens the direct chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一句话发给默认 Agent，并打开私聊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把一句話傳給預設 Agent，並開啟私訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのエージェントに一言送り、ダイレクトチャットを開きます。"
          }
        }
      }
    },
    "Message": {
      "comment": "Typed parameter title of the Ask a Bot action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想问的话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想問的話"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞きたいこと"
          }
        }
      }
    },
    "What do you want to ask the bot?": {
      "comment": "Value dialog of the Message parameter: what Siri asks when no value was given.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to ask the bot?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想问 Bot 什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你想問 Bot 什麼？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに何を聞きますか？"
          }
        }
      }
    },
    "Open Page": {
      "comment": "App Intent title in Siri and Shortcuts: open one page of Wonton.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを開く"
          }
        }
      }
    },
    "Opens a page in Wonton.": {
      "comment": "App Intent description under the title in Shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a page in Wonton."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开云吞里的页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟雲吞裡的頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonのページを開きます。"
          }
        }
      }
    },
    "New Chat": {
      "comment": "App Intent title in Siri and Shortcuts: start a direct chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャット"
          }
        }
      }
    },
    "Opens Wonton's start-a-chat page.": {
      "comment": "App Intent description under the title in Shortcuts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Wonton's start-a-chat page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开云吞的发起私聊页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟雲吞的發起私訊頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonのチャット開始ページを開きます。"
          }
        }
      }
    },
    "Open %@": {
      "comment": "Parameter summary of the Open Page action. Argument: the page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を開く"
          }
        }
      }
    },
    "myapp.add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to My apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイアプリに追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加进我的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加進我的應用"
          }
        }
      }
    },
    "myapp.addMore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增應用"
          }
        }
      }
    },
    "myapp.autoAdd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add new apps automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく入れたアプリを自動で追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新装的应用自动加入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新裝的應用自動加入"
          }
        }
      }
    },
    "myapp.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from My apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイアプリから外す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从我的应用移出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從我的應用移出"
          }
        }
      }
    },
    "myapp.syncStale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes not synced yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期がまだ完了していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改动还没同步上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改動還沒同步上"
          }
        }
      }
    },
    "myapp.syncStaleRetry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on this device. They sync automatically once connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には保存済み。接続後に自動で同期します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机已存好；连上服务器后自动同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機已存好；連上伺服器後自動同步。"
          }
        }
      }
    }
  }
}
