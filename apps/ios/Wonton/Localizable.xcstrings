            "state": "translated",
            "value": "%1$@でチャットを開始"
          }
        }
      }
    },
    "Open %@ with %@": {
      "comment": "Siri phrase for the Open Page action. Arguments: the page, then the app name filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@ with %@"
