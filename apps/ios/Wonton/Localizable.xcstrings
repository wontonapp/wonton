          "stringUnit": {
            "state": "translated",
            "value": "このファイルを選択できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选不了这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法選擇這個檔案"
          }
        }
      }
    },
    "composer.file": {
