    "egress.source.env": {
      "comment": "Note under the proxy address when it was set by an environment variable at install time. Keep WONTON_EGRESS_PROXY as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set by WONTON_EGRESS_PROXY. To change it, edit the settings in the install folder and run the install script again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスはWONTON_EGRESS_PROXYで指定されています。変更するには、インストール先の設定を変更してから、インストールスクリプトをもう一度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址由 WONTON_EGRESS_PROXY 指定。要改的话，改安装目录的设置，再运行一次安装脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址由 WONTON_EGRESS_PROXY 指定。要變更的話，修改安裝目錄裡的設定，再執行一次安裝指令碼。"
          }
        }
      }
