        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Bot 用這個 App 的工具不再問，包括會改資料的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットは、このアプリのツールを確認なしで使えます。データを変更するツールも含まれます。"
          }
        }
      }
    },
    "toolPolicy.always.title": {
