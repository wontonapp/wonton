          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家里的局域网里，用浏览器打开家里服务器的 IP 地址（装好时主机的终端里会给出），页面上有配对二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在家用區域網路裡，用瀏覽器開啟家用伺服器的 IP 位址（安裝時主機的終端機裡會給出），頁面上有配對 QR 碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のローカルネットワークで、ブラウザーで自宅サーバのIPアドレス（インストール時にホストのターミナルに表示されます）を開くと、ペアリング用QRコードが表示されます。"
