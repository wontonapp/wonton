    "chatBackup.detail.enabled": {
      "comment": "Explanation under the heading when backup is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you switch to a new phone, enter your recovery key to see your past messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换手机或新设备时，输入恢复密钥就能看到以前的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換手機或新裝置時，輸入復原金鑰就能看到以前的訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機種変更などの際に復旧キーを入力すると、過去のメッセージが表示されます。"
          }
        }
      }
    },
    "chatBackup.detail.incomplete": {
      "comment": "Explanation when the recovery key is missing on this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery key you saved when you turned on backup. If you lost it, reset the backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入开启备份时保存的恢复密钥。密钥丢了，就重置备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入開啟備份時儲存的復原金鑰。如果金鑰遺失了，就重置備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを有効にしたときに保存した復旧キーを入力してください。キーを紛失した場合はバックアップをリセットしてください。"
          }
        }
      }
    },
    "chatBackup.detail.unknown": {
      "comment": "Explanation when the backup status can't be confirmed because the server isn't reachable.",
      "extractionState": "manual",
