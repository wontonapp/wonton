    },
    "verification.cancelled.acceptedElsewhere": {
      "comment": "Result: another of the user's devices took over the verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another of your devices took over the verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスがこの確認を引き継ぎました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次确认由你的另一台设备接手了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次確認由你的另一部裝置接手了。"
          }
        }
      }
    },
    "verification.cancelled.byMe": {
      "comment": "Result: the user cancelled on this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled the verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認を取り消しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你取消了确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你取消了確認。"
          }
        }
      }
    },
    "verification.cancelled.byOther": {
      "comment": "Result: the user cancelled on the other device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device cancelled the verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスが確認を取り消しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备取消了确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一部裝置取消了確認。"
          }
        }
      }
    },
    "verification.cancelled.concurrentRequest": {
      "comment": "Result: a second verification request arrived at the same time and both were cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another verification request arrived at the same time. Both were cancelled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に別の確認リクエストが届いたため、両方取り消しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时收到了另一个确认请求，两个都取消了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時收到另一個確認請求，兩個都取消了。"
          }
        }
      }
    },
    "verification.cancelled.failed": {
      "comment": "Result: the verification failed for another reason; the details are in the problem dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification didn't finish because of a problem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生したため、確認が完了しませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认没有完成，出了点问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認沒有完成，出了點問題。"
          }
        }
      }
    },
    "verification.cancelled.keysMissing": {
      "comment": "Result: not all keys came through from the other device (it may not have them, or a request got lost), so older messages stay locked. Verify again or enter the recovery key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all keys came through from the other device, so older messages stay locked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスから鍵をすべて受け取れなかったため、以前のメッセージは開けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能从另一台设备取全密钥，以前的消息还是解不开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能從另一部裝置取全金鑰，以前的訊息還是解不開。"
          }
        }
      }
    },
    "verification.cancelled.mismatch": {
      "comment": "Result: the two devices showed different emoji, so the verification was cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The devices showed different emoji. The verification was cancelled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスで絵文字が一致しなかったため、確認を取り消しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备上的表情对不上，确认已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩部裝置上的表情對不上，確認已取消。"
          }
        }
      }
    },
    "verification.cancelled.other": {
      "comment": "Result: the verification didn't finish, for an unknown reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification didn't finish."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が完了しませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认没有完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認沒有完成。"
          }
        }
      }
    },
    "verification.cancelled.timeout": {
      "comment": "Result: the other device didn't respond within 10 minutes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device didn't respond in time. The verification was cancelled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスが時間内に応答しなかったため、確認を取り消しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备太久没有回应，确认已取消。"
