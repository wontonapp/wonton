          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "composer.attach": {
      "comment": "Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach"
