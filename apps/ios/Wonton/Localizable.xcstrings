            "value": "頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ"
          }
        }
      }
    },
    "Ask a bot: %@": {
      "comment": "Parameter summary of the Ask a Bot action. Argument: the message parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a bot: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问 Bot：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問 Bot：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに聞く：%@"
          }
        }
      }
    },
    "Ask a bot with %@": {
      "comment": "Siri phrase for the Ask a Bot action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a bot with %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用%1$@问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用%1$@問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でボットに聞く"
          }
        }
      }
    },
    "Ask a bot in %@": {
      "comment": "Second Siri phrase for the Ask a Bot action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a bot in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@里问 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@裡問 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@でボットに聞く"
          }
        }
      }
    },
    "New chat in %@": {
      "comment": "Siri phrase for the New Chat action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New chat in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@里新建会话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%1$@裡新增聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で新しいチャット"
          }
        }
      }
    },
    "Start a chat with %@": {
      "comment": "Second Siri phrase for the New Chat action. Argument: the app name, filled in by the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a chat with %@"
