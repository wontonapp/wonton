{
  "sourceLanguage": "en",
  "strings": {
    "common.cancel": {
      "comment": "Dialog button that closes the dialog without doing anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "common.close": {
      "comment": "Icon button that dismisses a tip or a dialog without doing anything.",
