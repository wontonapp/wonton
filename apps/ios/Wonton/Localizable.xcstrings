  "strings": {
    "Ask a Bot": {
      "comment": "App Intent title in Siri and Shortcuts: send a sentence to the default agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットに聞く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
