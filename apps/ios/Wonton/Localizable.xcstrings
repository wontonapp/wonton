    "appearance.previewMessage": {
      "comment": "Sample chat bubble on the appearance page, hidden from accessibility; it shows how the theme looks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's for dinner tonight?"
