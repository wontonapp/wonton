{
  "sourceLanguage": "en",
  "strings": {
    "common.cancel": {
      "comment": "Dialog button that closes the dialog without doing anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "common.close": {
      "comment": "Icon button that dismisses a tip or a dialog without doing anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "common.retry": {
      "comment": "Button that loads the page's data again after it failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        }
      }
    },
    "common.save": {
      "comment": "Toolbar button that saves the page's settings. Short, fits a small pill button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "egress.address": {
      "comment": "Section title and text field label for the proxy address (like http://192.0.2.10:7890).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシのアドレス"
          }
        }
      }
    },
    "egress.address.enter": {
      "comment": "Radio option: type a proxy address by hand instead of using an app's proxy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter Proxy Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写代理地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入代理伺服器位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシのアドレスを入力"
          }
        }
      }
    },
    "egress.address.useProvider": {
      "comment": "Radio option: use the proxy that an installed app provides. Argument: that app's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を使用"
          }
        }
      }
    },
    "egress.path.apps": {
      "comment": "Row title on the Internet proxy page: whether apps on the home server can reach the internet through the proxy. The value on the right is a reachability status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        }
      }
    },
    "egress.path.failed": {
      "comment": "Status value: the internet can't be reached through the proxy. A reason is shown below the row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreachable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不通"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続不可"
          }
        }
      }
    },
    "egress.path.homeServer": {
      "comment": "Row title on the Internet proxy page: whether the home server itself can reach the internet through the proxy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバ"
          }
        }
      }
    },
    "egress.path.probing": {
      "comment": "Status value next to Apps / Home Server while the proxy is being checked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探测中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查中…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中…"
          }
        }
      }
    },
    "egress.path.reachable": {
      "comment": "Status value: the internet can be reached through the proxy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reachable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続可能"
          }
        }
      }
    },
    "egress.path.uncertain": {
      "comment": "Status value: the check couldn't tell whether the proxy works. A reason is shown below the row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明"
          }
        }
      }
    },
    "egress.ranges": {
      "comment": "Section title and text field label for network ranges (CIDR, like 100.64.0.0/10) that skip the proxy and are reached directly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bypass Ranges"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连网段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連線網段"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシを経由しないネットワーク"
          }
        }
      }
    },
    "egress.ranges.host": {
      "comment": "Note under the bypass ranges field. Argument: the computer's own network ranges (CIDR), comma-separated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server's network: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机所在网段：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機所在網段：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバのネットワーク：%@"
          }
        }
      }
    },
    "egress.ranges.note": {
      "comment": "Explanation under the bypass ranges field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These ranges skip the proxy. Every app with internet access can reach them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些网段不经代理，出网应用都能连。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些網段不經過代理伺服器，可以上網的 App 都能連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのネットワークにはプロキシを経由せずに接続します。インターネットに接続できるアプリはすべてアクセスできます。"
          }
        }
      }
    },
    "egress.restart.cancelTitle": {
      "comment": "Confirmation dialog title before turning off the Internet proxy; the message lists the apps on the home server that will restart.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off the proxy restarts these apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消代理要重启这些应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消代理伺服器需要重新啟動這些 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシを解除すると、次のアプリが再起動します"
          }
        }
      }
    },
    "egress.restart.confirm": {
      "comment": "Primary button in the proxy confirmation dialog: restart the listed apps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動"
          }
        }
      }
    },
    "egress.restart.message": {
      "comment": "Body of the proxy restart confirmation. Argument: the names of the apps that restart, already formatted as a list. The second line says their data is kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nYour data stays as it is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n数据不动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n資料不會變動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nデータはそのまま残ります。"
          }
        }
      }
    },
    "egress.restart.setTitle": {
      "comment": "Confirmation dialog title before turning on the Internet proxy; the message lists the apps on the home server that will restart.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the proxy restarts these apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配上代理要重启这些应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定代理伺服器需要重新啟動這些 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシを設定すると、次のアプリが再起動します"
          }
        }
      }
    },
    "egress.source.detected": {
      "comment": "Note under the proxy address when the installer detected it on the computer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected during installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装时检测到的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝時偵測到的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール時に検出されました。"
          }
        }
      }
    },
    "egress.source.env": {
      "comment": "Note under the proxy address when it was set by an environment variable at install time. Keep WONTON_EGRESS_PROXY as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set by WONTON_EGRESS_PROXY. To change it, edit the settings in the install folder and run the install script again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址由 WONTON_EGRESS_PROXY 指定。要改的话，改安装目录的设置，再运行一次安装脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址由 WONTON_EGRESS_PROXY 指定。要變更的話，修改安裝目錄裡的設定，再執行一次安裝指令碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスはWONTON_EGRESS_PROXYで指定されています。変更するには、インストール先の設定を変更してから、インストールスクリプトをもう一度実行してください。"
          }
        }
      }
    },
    "egress.source.provider": {
      "comment": "Note under the proxy address when the proxy comes from an installed app. Argument: that app's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元：%@"
          }
        }
      }
    },
    "egress.title": {
      "comment": "Title of the Internet proxy settings page and its row in Settings > Home Server. The proxy is what apps on the home server use to reach the internet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet Proxy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出网代理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシ"
          }
        }
      }
    },
    "egress.turnOff": {
      "comment": "Destructive full-width button that stops using the Internet proxy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off Proxy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消代理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用代理伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシを解除"
          }
        }
      }
    },
    "lanWebui.ports": {
      "comment": "Note under the Open on Local Network switch. First argument: number of ports; second: the port numbers, comma-separated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@ %2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Port"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Ports"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@ %2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "端口"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@ %2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "連接埠"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@%2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "ポート："
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "lanWebui.toggle": {
      "comment": "Switch on an app's page: make the app's web page reachable from other devices on the local network. The ports are listed below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open on Local Network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在局域网开放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在區域網路開放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークに公開"
          }
        }
      }
    },
    "onboarding.agent.connectionKey": {
      "comment": "Description of an agent row in setup when it has no account login.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        }
      }
    },
    "onboarding.agent.connectionLogins": {
      "comment": "Description of an agent row in setup: how it connects to a model. The argument is the account-login names, already formatted as a list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ or an API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@或 key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@或 API 金鑰"
