{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "confirmationCard.tool.changesData": {
      "comment": "Risk note for a tool that changes data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个操作会改动数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個操作會改動資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はデータを変更します"
          }
        }
      }
    },
    "confirmationCard.tool.destructiveTarget": {
      "comment": "Verified name of the object being deleted. Argument: name supplied by the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Will delete: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除する対象：%1$@"
          }
        }
      }
    },
    "confirmationCard.tool.destructive": {
      "comment": "Warning for a destructive tool call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个操作会删除数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個操作會刪除資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はデータを削除します"
          }
        }
      }
    },
    "confirmationCard.expired": {
      "comment": "Status line on an approval request card: the request expired, so nothing was carried out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired, not carried out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期，没有执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已過期，沒有執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れのため実行されていません"
          }
        }
      }
    },
    "confirmationCard.failedResult": {
      "comment": "Status line on an approval request card: the action ran but failed. Argument: the home server's result message, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't go through: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有成功：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有成功：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行できませんでした：%1$@"
          }
        }
      }
    },
    "confirmationCard.rejected": {
      "comment": "Status line on an approval request card: it was denied, so nothing was carried out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied, not carried out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝，没有执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕，沒有執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否したため実行されていません"
          }
        }
      }
    },
    "confirmationCard.tool.root": {
      "comment": "Tool privilege warning on a confirmation card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs as root on this machine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个操作会以 root 身份在这台机器上运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個操作會以 root 身分在這台機器上執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はこのマシン上で root として実行されます"
          }
        }
      }
    },
    "confirmationCard.running": {
      "comment": "Status line on an approval request card while the action is being carried out, next to a spinner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中"
          }
        }
      }
    },
    "confirmationCard.requests": {
      "comment": "Heading and compact room entry for confirmation requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認リクエスト"
          }
        }
      }
    },
    "confirmationCard.tool.source": {
      "comment": "Provider of the tool. Argument: localized provider display name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@での操作"
          }
        }
      }
    },
    "confirmationCard.stopWindow": {
      "comment": "Button on an approval request card: stop the approval window during which further actions run without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "confirmationCard.unavailable": {
      "comment": "Shown when room confirmation records are no longer available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmation requests here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有确认请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有確認請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここには確認リクエストがありません"
          }
        }
      }
    },
    "confirmationCard.uncertainResult": {
      "comment": "Status line on an approval request card: the action ran, but whether it worked is unknown. Argument: the home server's result message, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's unclear whether it worked: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を確認できません：%1$@"
          }
        }
      }
    },
    "confirmationCard.tool.unknownImpact": {
      "comment": "The provider has not specified what the tool changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The effect on data is unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还不知道这个操作会怎样影响数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還不知道這個操作會怎樣影響資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データへの影響は不明です"
          }
        }
      }
    },
    "confirmationCard.tool.destructiveUnknown": {
      "comment": "Deletion target is unknown; never infer it from tool arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot see which item will be deleted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看不到要删的是哪一条"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不到要刪的是哪一筆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの項目が削除されるか確認できません"
          }
        }
      }
    },
    "confirmationCard.answeredBy": {
      "comment": "Status line on an administrators-only approval request already handled by another administrator. Argument: user ID.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Handled by %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已由 %1$@ 处理" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "已由 %1$@ 處理" } },
        "ja": { "stringUnit": { "state": "translated", "value": "%1$@ が対応しました" } }
      }
    },
    "confirmationCard.windowUntil": {
      "comment": "Line on an approval request card: further actions run without asking until the approval window closes. Argument: the closing time, already formatted as a time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved until %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许至 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許至 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@まで許可"
          }
        }
      }
    }
  }
}
