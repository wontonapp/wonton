{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "confirmationCard.expired": {
      "comment": "Status line on an approval request card: the request expired, so nothing was carried out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expired, not carried out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期，没有执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已過期，沒有執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れのため実行されていません"
          }
        }
      }
    },
    "confirmationCard.failedResult": {
      "comment": "Status line on an approval request card: the action ran but failed. Argument: the home server's result message, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't go through: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有成功：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有成功：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行できませんでした：%1$@"
          }
        }
      }
    },
    "confirmationCard.rejected": {
      "comment": "Status line on an approval request card: it was denied, so nothing was carried out.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied, not carried out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝，没有执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕，沒有執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否したため実行されていません"
          }
        }
      }
    },
    "confirmationCard.running": {
      "comment": "Status line on an approval request card while the action is being carried out, next to a spinner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中"
          }
        }
      }
    },
    "confirmationCard.stopWindow": {
      "comment": "Button on an approval request card: stop the approval window during which further actions run without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "confirmationCard.uncertainResult": {
      "comment": "Status line on an approval request card: the action ran, but whether it worked is unknown. Argument: the home server's result message, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's unclear whether it worked: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を確認できません：%1$@"
          }
        }
      }
    },
    "confirmationCard.windowUntil": {
      "comment": "Line on an approval request card: further actions run without asking until the approval window closes. Argument: the closing time, already formatted as a time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved until %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允許至 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許至 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@まで許可"
          }
        }
      }
    }
  }
}
