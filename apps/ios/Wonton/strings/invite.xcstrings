{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "invite.expired": {
      "comment": "Notice title when the pairing code ran out of time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code has expired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个码过期了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個配對碼已過期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードの有効期限が切れています。"
          }
        }
      }
    },
    "invite.expiresIn": {
      "comment": "Under the QR code: how long the code is still valid. Argument: the remaining time as m:ss.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires in %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %1$@ 过期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 後過期"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効期限まで残り%1$@"
          }
        }
      }
    },
    "invite.failedTitle": {
      "comment": "Notice title when the pairing code couldn't be fetched; the core's reason is shown below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get a pairing code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没要到配对码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードを取得できませんでした"
          }
        }
      }
    },
    "invite.instructions": {
      "comment": "Explanation under the QR code: what the new device's owner should do. The code works only once.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton on the new device and scan this code to add it. The code works only once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新设备上打开云吞 App 扫这个码，它就成为你的设备。码只能用一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新裝置上開啟雲吞並掃描這個 QR 碼，就能新增這台裝置。QR 碼只能使用一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいデバイスでWontonを開いてこのコードをスキャンすると、デバイスを追加できます。コードは1回だけ使えます。"
          }
        }
      }
    },
    "invite.pasteFallback": {
      "comment": "Label above the pairing code as text, for when the QR code can't be scanned.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can't scan, paste this text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能扫码时粘贴这段文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法掃描時，請貼上這段文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンできない場合はこのテキストを貼り付けてください"
          }
        }
      }
    },
    "invite.qrLabel": {
      "comment": "Accessibility label of the QR code image with the pairing code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing QR code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对二维码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對 QR 碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング用QRコード"
          }
        }
      }
    },
    "invite.renew": {
      "comment": "Button under the expired notice: get a new code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a New Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一个码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生新的配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいコードを発行"
          }
        }
      }
    },
    "invite.requesting": {
      "comment": "Shown next to a spinner while the pairing code is being requested.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asking your home server for a pairing code…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在向家里的服务器要配对码…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在向家用伺服器取得配對碼…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバにペアリングコードを要求しています…"
          }
        }
      }
    },
    "invite.title": {
      "comment": "Title of the Add Device page, where a new device gets a pairing code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを追加"
          }
        }
      }
    },
    "invite.tryAgain": {
      "comment": "Button under the failed notice: request a pairing code again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再试一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        }
      }
    }
  }
}
