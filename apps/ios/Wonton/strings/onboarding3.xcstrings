{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.done": {
      "comment": "Primary button that finishes setup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "onboarding.model.form.apiKey": {
      "comment": "Label of the password field for the provider's API key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        }
      }
    },
    "onboarding.problem.model.providerUnreachable.next": {
      "comment": "Line under the problem title: check the provider before retrying.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the provider's address and your network, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查服务商地址和网络后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查供應商位址和網路後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダのアドレスとネットワークを確認してから再試行してください。"
          }
        }
      }
    },
    "onboarding.problem.model.unauthorized.next": {
      "comment": "Line under the problem title: pair the device again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code to pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新扫码配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新掃描 QR 碼配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードをスキャンしてもう一度ペアリングしてください。"
          }
        }
      }
    },
    "onboarding.problem.store.invalidIndex": {
      "comment": "Problem title in setup: the recommendation list can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read the recommendations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不懂推荐清单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不懂推薦清單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを読み取れません"
          }
        }
      }
    },
    "onboarding.problem.store.other": {
      "comment": "Problem title in setup: recommendations are unavailable for another reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations are unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐清单不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦清單不可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを利用できません"
          }
        }
      }
    },
    "onboarding.replacedAgent.title": {
      "comment": "Dialog title when a new agent replaces an installed one. The argument is the old agent's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要卸掉“%@”吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要解除安裝「%@」嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をアンインストールしますか？"
          }
        }
      }
    },
    "onboarding.review.preparing": {
      "comment": "Label next to a spinner while an install task is being prepared.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中"
          }
        }
      }
    },
    "onboarding.review.unreachable": {
      "comment": "Row description in the review step: the model couldn't be reached during the test.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreachable when tested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试时没连上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試時沒連上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト時に接続できませんでした"
          }
        }
      }
    },
    "onboarding.step.review": {
      "comment": "Card title at the top of the review step in setup: check everything before finishing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        }
      }
    },
    "onboarding.gatewayMissing.nextStep": {
      "comment": "Next step under the gateway problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, then open it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试后再打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試後再開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してから開いてください。"
          }
        }
      }
    }
  }
}
