{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.done": {
      "comment": "Primary button that finishes setup and starts the installs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install these apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装这些应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝這些應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリをインストール"
          }
        }
      }
    },
    "onboarding.problem.store.invalidIndex": {
      "comment": "Problem title in setup: the recommendation list can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read the recommendations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不懂推荐清单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不懂推薦清單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを読み取れません"
          }
        }
      }
    },
    "onboarding.problem.store.other": {
      "comment": "Problem title in setup: recommendations are unavailable for another reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations are unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐清单不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦清單不可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを利用できません"
          }
        }
      }
    },
    "onboarding.review.intro": {
      "comment": "Sentence above the review list: finishing saves the settings and installs in the background with the listed permissions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saves these settings and installs the apps below with the access listed. You can leave while they install."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点下面的按钮会保存这些设置，并按下面的权限装这些应用。装的时候可以离开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點下面的按鈕會儲存這些設定，並按下面的權限安裝這些應用程式。安裝時可以離開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押すと、これらの設定を保存し、下に書いた権限で以下のアプリをインストールします。インストール中はそのまま離れていてもかまいません。"
          }
        }
      }
    },
    "onboarding.review.preparing": {
      "comment": "Label next to a spinner while an install task is being prepared.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中"
          }
        }
      }
    },
    "onboarding.review.sectionModel": {
      "comment": "Kind label of the model row in the review step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model for replies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复用的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆用的模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信に使うモデル"
          }
        }
      }
    },
    "onboarding.step.review": {
      "comment": "Card title at the top of the review step in setup: check everything before finishing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost there"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快好了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快好了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと少し"
          }
        }
      }
    },
    "onboarding.step.assistant": {
      "comment": "Setup step title: name the default Bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Assistant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアシスタント"
          }
        }
      }
    },
    "onboarding.assistant.name": {
      "comment": "Label of the assistant's name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    }
  }
}
