{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.done": {
      "comment": "Primary button that finishes setup and starts the installs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install these apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装这些应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝這些應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリをインストール"
          }
        }
      }
    },
    "onboarding.gatewayMissing.nextStep": {
      "comment": "Next step under the gateway problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, then open it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试后再打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試後再開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してから開いてください。"
          }
        }
      }
    },
    "onboarding.problem.model.providerUnreachable.next": {
      "comment": "Line under the problem title: check the provider before retrying.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the provider's address and your network, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查服务商地址和网络后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查供應商位址和網路後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダのアドレスとネットワークを確認してから再試行してください。"
          }
        }
      }
    },
    "onboarding.problem.model.unauthorized.next": {
      "comment": "Line under the problem title: pair the device again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code to pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新扫码配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新掃描 QR 碼配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードをスキャンしてもう一度ペアリングしてください。"
          }
        }
      }
    },
    "onboarding.problem.store.invalidIndex": {
      "comment": "Problem title in setup: the recommendation list can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read the recommendations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不懂推荐清单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不懂推薦清單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを読み取れません"
          }
        }
      }
    },
    "onboarding.problem.store.other": {
      "comment": "Problem title in setup: recommendations are unavailable for another reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations are unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐清单不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦清單不可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを利用できません"
          }
        }
      }
    },
    "onboarding.review.intro": {
      "comment": "Sentence above the review list: finishing saves the settings and installs in the background with the listed permissions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saves these settings and installs the apps below with the access listed. You can leave while they install."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点下面的按钮会保存这些设置，并按下面的权限装这些应用。装的时候可以离开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點下面的按鈕會儲存這些設定，並按下面的權限安裝這些應用程式。安裝時可以離開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押すと、これらの設定を保存し、下に書いた権限で以下のアプリをインストールします。インストール中はそのまま離れていてもかまいません。"
          }
        }
      }
    },
    "onboarding.review.preparing": {
      "comment": "Label next to a spinner while an install task is being prepared.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中"
          }
        }
      }
    },
    "onboarding.review.sectionModel": {
      "comment": "Kind label of the model row in the review step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model for replies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复用的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆用的模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信に使うモデル"
          }
        }
      }
    },
    "onboarding.review.unreachable": {
      "comment": "Row description in the review step: the model couldn't be reached during the test.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreachable when tested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试时没连上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試時沒連上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト時に接続できませんでした"
          }
        }
      }
    },
    "onboarding.step.review": {
      "comment": "Card title at the top of the review step in setup: check everything before finishing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost there"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快好了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快好了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと少し"
          }
        }
      }
    }
  }
}
