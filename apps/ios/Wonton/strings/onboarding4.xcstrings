{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.agent.connectionLogins": {
      "comment": "Description of an agent row in setup: how it connects to a model. The argument is the account-login names, already formatted as a list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ or an API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@或 key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@或 API 金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、またはAPIキー"
          }
        }
      }
    },
    "onboarding.app.installed": {
      "comment": "Trailing label on a recommended app row that is already installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み"
          }
        }
      }
    },
    "onboarding.model.getKey": {
      "comment": "Button that opens the provider's website to get an API key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get API Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拿 key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得 API 金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーを取得"
          }
        }
      }
    },
    "onboarding.model.unreachable": {
      "comment": "Warning under a model provider row: testing couldn't reach the provider, but it's saved anyway when setup finishes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the provider. It will still be saved when you finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务商，完成时照样保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上供應商，完成時照樣儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダに接続できませんが、完了時に保存されます。"
          }
        }
      }
    },
    "onboarding.model.useCurrent": {
      "comment": "Row title: keep the models already configured in the model gateway.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Current"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用现在的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のモデルを使用"
          }
        }
      }
    },
    "onboarding.problem.model.keyRejected": {
      "comment": "Problem title in setup: the provider rejected the API key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected this API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商不接受这个 key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商不接受這個 API 金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがこのAPIキーを受け付けません"
          }
        }
      }
    },
    "onboarding.problem.model.protocol": {
      "comment": "Problem title in setup: the app and the home server versions don't work together.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton and your home server versions don't match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和家里的服务器版本对不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和家用伺服器的版本對不上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonと自宅サーバのバージョンが一致していません"
          }
        }
      }
    },
    "onboarding.problem.store.disabled": {
      "comment": "Problem title in setup: the recommendation source is turned off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommendation source is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐来源已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦來源已關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの提供元が無効になっています"
          }
        }
      }
    },
    "onboarding.review.blocked": {
      "comment": "Fallback when the core gives no reason why an app can't be installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't Install"
