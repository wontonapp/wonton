  "strings": {
    "onboarding.app.installed": {
      "comment": "Trailing label on a recommended app row that is already installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み"
          }
        }
      }
    },
    "onboarding.problem.store.disabled": {
      "comment": "Problem title in setup: the recommendation source is turned off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommendation source is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐来源已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦來源已關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの提供元が無効になっています"
          }
        }
      }
    },
    "onboarding.review.blocked": {
      "comment": "Fallback when the core gives no reason why an app can't be installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't install this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装不了这个应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝不了這個應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはインストールできません"
          }
        }
      }
    },
    "onboarding.review.unchanged": {
      "comment": "Second line of a review row the user did not change: finishing will not touch it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep as is"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不改动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不改動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更しません"
          }
        }
      }
    },
