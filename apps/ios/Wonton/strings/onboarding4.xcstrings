{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.app.installed": {
      "comment": "Trailing label on a recommended app row that is already installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み"
          }
        }
      }
    },
    "onboarding.model.useCurrent": {
      "comment": "Row title: keep the models already configured in the model gateway.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your current model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用现在的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用現在的模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のモデルを使う"
          }
        }
      }
    },
    "onboarding.problem.model.keyRejected": {
      "comment": "Problem title in setup: the provider rejected the API key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected this API key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商不接受这个 key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商不接受這個 API 金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがこのAPIキーを受け付けません"
          }
        }
      }
    },
    "onboarding.problem.model.protocol": {
      "comment": "Problem title in setup: the app and the home server versions don't work together.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton and your home server versions don't match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和家里的服务器版本对不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和家用伺服器的版本對不上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonと自宅サーバのバージョンが一致していません"
          }
        }
      }
    },
    "onboarding.problem.store.disabled": {
      "comment": "Problem title in setup: the recommendation source is turned off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommendation source is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐来源已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦來源已關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの提供元が無効になっています"
          }
        }
      }
    },
    "onboarding.review.blocked": {
      "comment": "Fallback when the core gives no reason why an app can't be installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't install this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装不了这个应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝不了這個應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはインストールできません"
          }
        }
      }
    },
    "onboarding.review.unchanged": {
      "comment": "Second line of a review row the user did not change: finishing will not touch it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep as is"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不改动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不改動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更しません"
          }
        }
      }
    },
    "onboarding.review.waiting": {
      "comment": "Label while an install task waits for others to finish.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting its turn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等前面的装完"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等前面的裝完"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のアプリの完了待ち"
          }
        }
      }
    },
    "onboarding.step.other": {
      "comment": "Card title fallback in setup when the step is unknown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初始設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップ"
          }
        }
      }
    },
    "onboarding.step.profile": {
      "comment": "Card title at the top of the profile step in setup.",
