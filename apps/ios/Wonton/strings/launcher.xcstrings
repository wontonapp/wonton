{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "launcher.defaultAgent": {
      "comment": "Title of the default agent picker, opened from Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Agent"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 Agent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのエージェント"
          }
        }
      }
    },
    "launcher.menu": {
      "comment": "Accessibility action on an app icon that opens the long-press menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー"
          }
        }
      }
    },
    "launcher.empty": {
      "comment": "Shown on the launcher when no apps are installed yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有装应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはまだありません"
          }
        }
      }
    },
    "launcher.title": {
      "comment": "Title of the launcher screen with the installed apps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        }
      }
    },
    "launcher.goToStore": {
      "comment": "Button under it that opens the Store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去应用商店"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往商店"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアを開く"
          }
        }
      }
    },
    "launcher.updatesAvailable": {
      "comment": "Badge in the Store entry row: how many installed apps have updates. Argument: the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "1 update available"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld updates available"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 个可更新"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 個可更新"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "アップデート%lld件あり"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "launcher.pinToBar": {
      "comment": "Menu item and page action that pins the page to the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Tab Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定到底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加到標籤列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに追加"
          }
        }
      }
    },
    "launcher.openWeb": {
      "comment": "Action-sheet item that opens the app's web page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Web Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开网页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟網頁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webページを開く"
          }
        }
      }
    },
    "launcher.upgradeTo": {
      "comment": "Action-sheet item that updates the app. Argument: the new version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级到 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にアップデート"
          }
        }
      }
    },
    "launcher.badgeDegraded": {
      "comment": "Accessibility label of the warning badge on an app icon in the launcher: the app has a problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題があります"
          }
        }
      }
    },
    "launcher.badgeNeedsConfiguration": {
      "comment": "Accessibility label of the wrench badge on an app icon in the launcher: the app is installed but its required keys are not filled in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs setup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要設定"
          }
        }
      }
    }
  }
}
