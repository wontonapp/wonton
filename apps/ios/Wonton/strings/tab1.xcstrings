{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "tab.open": {
      "comment": "Small button on an approval request card: open the app that was just installed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く"
          }
        }
      }
    },
    "tab.addMore": {
      "comment": "Button in the tab settings: pick another page to add.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add More"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加更多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增更多"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに追加"
          }
        }
      }
    },
    "tab.addToBar": {
      "comment": "Menu item that puts the current page into the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Tab Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定到底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加到標籤列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに追加"
          }
        }
      }
    },
    "tab.removeFromBar": {
      "comment": "Page menu item that takes the page out of the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from Tab Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从底栏移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從標籤列移除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーから削除"
          }
        }
      }
    },
    "tab.starting": {
      "comment": "Skeleton caption while the app behind the page starts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在啟動…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動しています…"
          }
        }
      }
    },
    "tab.loading": {
      "comment": "Skeleton accessibility label while the page loads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中"
          }
        }
      }
    },
    "tab.uninstalling": {
      "comment": "Caption while the app behind the page is uninstalled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalling…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在卸载…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在解除安裝…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストールしています…"
          }
        }
      }
    },
    "tab.settingsUnreadable": {
      "comment": "Notice when the tab settings couldn't be read and the defaults are used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read tab settings. Using the default tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底栏设置读不了，已使用默认底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取標籤列設定，已使用預設標籤列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの設定を読み込めませんでした。デフォルトのタブを使います。"
          }
        }
      }
    },
    "tab.selectChat": {
      "comment": "Hint above the chat list when a draft is waiting for a chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a chat for your draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个聊天放入草稿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選一個聊天放入草稿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを入れるチャットを選んでください"
          }
        }
      }
    },
    "tab.failure.transport": {
      "comment": "Load failure label when the home server can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続できません"
          }
        }
      }
    },
    "tab.failure.upstream": {
      "comment": "Load failure label when the app returned an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app returned an error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用返回了错误"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 傳回了錯誤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがエラーを返しました"
          }
        }
      }
    },
    "tab.failedTitle": {
      "comment": "Failure title above the reason a page's app failed. Argument: the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 出了问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 出了問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で問題が発生しました"
          }
        }
      }
    },
    "tab.media.promptCamera": {
      "comment": "Title of the prompt asking to let a page's app use the camera. Argument: the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@ to use your camera?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 %@ 使用摄像头吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 %@ 使用相機嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にカメラの使用を許可しますか？"
          }
        }
      }
    },
    "tab.callRelayHint": {
      "comment": "Light hint at the top of a call page when the connection only goes through the public relay; the call still works. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected only through the public relay. Video may stutter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只连上了公共中继，画面可能卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只連上了公共中繼，畫面可能卡頓。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公共リレー経由でしか接続できていません。映像が途切れることがあります。"
          }
        }
      }
    }
  }
}
