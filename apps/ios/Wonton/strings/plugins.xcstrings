    "ownerSecrets.empty": {
      "comment": "Empty state after successfully listing owner-visible generated keys.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No generated keys to show." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "没有可显示的生成密钥。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "沒有可顯示的產生金鑰。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "表示できる生成済みキーはありません。" } }
      }
    },
    "ownerSecrets.hide": {
      "comment": "Button that hides one generated key and clears its value.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Hide" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "隐藏" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "隱藏" } },
        "ja": { "stringUnit": { "state": "translated", "value": "非表示" } }
      }
    },
    "ownerSecrets.problem.crossSite": {
      "comment": "The server rejected the key request because its origin was not allowed.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The server blocked this request for security reasons." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "服务器出于安全原因拦截了此请求。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "伺服器基於安全考量封鎖了此請求。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "セキュリティ上の理由でサーバがリクエストを拒否しました。" } }
      }
    },
    "ownerSecrets.problem.notFound": {
      "comment": "The requested key is missing or is not declared for owner viewing.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This key is no longer available to view." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此密钥已无法查看。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此金鑰已無法檢視。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このキーは表示できなくなりました。" } }
      }
    },
    "ownerSecrets.problem.notInstalled": {
      "comment": "The plugin is not installed, distinct from a missing generated key.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This app is no longer installed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此应用已卸载。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此 App 已解除安裝。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このアプリはすでにアンインストールされています。" } }
      }
    },
    "ownerSecrets.problem.notReady": {
      "comment": "The plugin generated key is not ready to be read yet.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This key is not ready yet. Try again later." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此密钥尚未就绪，请稍后重试。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此金鑰尚未就緒，請稍後重試。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このキーはまだ準備できていません。しばらくしてから再試行してください。" } }
      }
    },
    "ownerSecrets.problem.other": {
      "comment": "Unknown failure while listing or showing owner-visible generated keys.",
      "extractionState": "manual",
      "localizations": {
