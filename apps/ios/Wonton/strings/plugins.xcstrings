    "secret.sectionTitle": {
      "comment": "Section title for the keys a plugin asks its owner to fill in. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys this app needs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要填的密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要填的密鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリに必要な鍵"
          }
        }
      }
    },
    "secret.optional": {
      "comment": "Tag on a secret input the plugin doesn't require. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional"
          }
        },
        "zh-Hans": {
          "stringUnit": {
