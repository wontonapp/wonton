    "portMapping.reasonPluginUnreachable": {
      "comment": "Reason the declared ports could not be mapped on this device. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server can't reach this app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器连不上这个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器連不上這個應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバーからこのアプリに接続できません。"
          }
        }
      }
    },
    "portMapping.reasonOther": {
      "comment": "Reason the declared ports could not be mapped on this device. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port mapping ran into a problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "映射出错了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "映射出錯了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マッピングで問題が発生しました。"
          }
        }
      }
    },
    "portMapping.warningPublicRelayBandwidth": {
      "comment": "Informational warning below the local port mapping; mapping still works. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected only through the public relay — not enough bandwidth for streaming."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只连上了公共中继，带宽不够传画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只連上了公共中繼，頻寬不夠傳畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公共リレー経由でしか接続できておらず、映像を送る帯域が足りません。"
          }
        }
      }
    },
    "portMapping.title": {
      "comment": "Section title listing the ports a plugin maps to this device (ADR-0072). No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map to this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "映射到本机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "映射到本機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にマッピング"
          }
        }
      }
    },
    "portMapping.portLine": {
      "comment": "One mapped port: the loopback address with the port number and protocol. Arguments: %1$lld is the port number, %2$@ the protocol name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:%1$lld · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:%1$lld · %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:%1$lld · %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1:%1$lld · %2$@"
          }
        }
      }
    },
    "portMapping.protocolOther": {
      "comment": "Label for a port whose protocol the app doesn't know. No arguments.",
