          "stringUnit": {
            "state": "translated",
            "value": "可選"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意"
          }
        }
      }
    },
    "secret.getOne": {
      "comment": "Link text under a secret input pointing to where to get one. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where to get one"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去哪里拿"
