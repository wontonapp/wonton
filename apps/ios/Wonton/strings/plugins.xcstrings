        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去哪裡拿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得先"
          }
        }
      }
    },
    "secret.show": {
      "comment": "Accessibility label of the button that reveals a masked secret value. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show value"
          }
        },
        "zh-Hans": {
