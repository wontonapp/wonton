    "secret.unfilled": {
      "comment": "State line of a secret the owner hasn't filled yet. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not ready: paste a token first"
