          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力する"
          }
        }
      }
    },
    "secret.filled": {
      "comment": "State line of a filled secret on the detail page; the change date is appended. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
