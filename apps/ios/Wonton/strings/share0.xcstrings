{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "share.cancel": {
      "comment": "Button that dismisses the share editor without saving changes. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "share.custom": {
      "comment": "Expiration choice that opens a date and time picker. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose date and time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日期和时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇日期與時間"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日時を選択"
          }
        }
      }
    },
    "share.identity.mismatch": {
      "comment": "Identity verification detail when the verified user ID belongs to a different server. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verified user ID does not match the identity server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证的用户 ID 与身份服务器不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證的使用者 ID 與身分伺服器不符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認されたユーザー ID が認証サーバーと一致しません。"
          }
        }
      }
    },
    "share.identity.userinfo": {
      "comment": "Identity verification detail when the identity server could not confirm the user. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity server could not confirm your identity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份服务器无法确认你的身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分伺服器無法確認你的身分。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証サーバーで本人確認ができませんでした。"
          }
        }
      }
    },
    "share.indefinite": {
      "comment": "Expiration choice that keeps access until the owner revokes it. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until revoked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直有效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直到收回為止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消すまで"
          }
        }
      }
    },
    "share.problem.expired": {
      "comment": "Shared app problem when the access grant has expired. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share has expired"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享已到期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享已到期"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有の有効期限が切れました"
          }
        }
      }
    },
    "share.problem.identity": {
      "comment": "Shared app problem when the sharing friend's server cannot verify the current user. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This friend’s server cannot recognize you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这位好友的服务器认不出你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這位好友的伺服器無法辨識你的身分"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちのサーバーがあなたを認識できません"
          }
        }
      }
    },
    "share.problem.other": {
      "comment": "Shared app problem for an unavailable source not covered by a more specific category. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared apps are unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取分享的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得分享的應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有アプリを利用できません"
          }
        }
      }
    },
    "share.problem.required": {
      "comment": "Shared app problem when the current user has no grant for the app. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This friend has not shared this app with you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这位好友没有把这个应用分享给你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這位好友沒有將這個應用程式分享給你"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは友だちから共有されていません"
          }
        }
      }
    },
    "share.problem.revoked": {
      "comment": "Shared app problem when the owner has revoked access. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This friend stopped sharing this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这位好友已停止分享这个应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這位好友已停止分享這個應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちがこのアプリの共有を停止しました"
          }
        }
      }
    }
  }
}
