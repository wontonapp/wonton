{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "problem.notReady.title": {
      "comment": "Problem title when the core says the action can't run yet; the core's own reason is shown as the next step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在还做不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還無法執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ実行できません"
          }
        }
      }
    },
    "problem.plugin.lanUnavailable.title": {
      "comment": "Problem title: no local network address could be picked for the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local network address available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选不出局域网地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可用的區域網路位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークのアドレスを選べません"
          }
        }
      }
    },
    "problem.plugin.notFound.nextStep": {
      "comment": "Next step: refresh the store and try again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the store and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新应用商店后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理商店後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアを更新してからもう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.protocol.nextStep": {
      "comment": "Next step: update the app or the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Wonton or your home server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 App 或家里的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新雲吞或家用伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonか自宅サーバをアップデートしてください。"
          }
        }
      }
    },
    "problem.plugin.protocol.title": {
      "comment": "Problem title: the app and the home server versions don't match.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton and your home server aren't compatible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和家里的服务器版本对不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞和家用伺服器的版本不相符"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonと自宅サーバのバージョンが合っていません"
          }
        }
      }
    },
    "problem.plugin.recordUnusable.nextStep": {
      "comment": "Problem next step: reinstall the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall this app and install it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载这个应用（数据可以保留）后重新安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝這個應用程式（資料可以保留）後重新安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリをアンインストール（データは残せます）して、もう一度インストールしてください。"
          }
        }
      }
    },
    "problem.plugin.recordUnusable.title": {
      "comment": "Problem title: the app's install record can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app's install record is unusable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的安装记录不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式的安裝記錄不可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのインストール記録が壊れています"
          }
        }
      }
    },
    "problem.plugin.sourceUnavailable.nextStep": {
      "comment": "Next step: the home server can't reach the app's source, try later.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server can't reach the app's source. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器连不上应用的来源，稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器連不上 App 的來源，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバからアプリの提供元に接続できません。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "problem.pluginSave.invalid.title": {
      "comment": "Problem title when the proxy settings were rejected as invalid; the core's own reason is shown as the next step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This doesn't look right"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样填不对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填寫的內容不正確"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容が正しくありません"
          }
        }
      }
    },
    "problem.store.disabled.title": {
      "comment": "Problem title: the community source is switched off, so its apps are missing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The community source is turned off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区应用已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "社群來源已關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティの提供元が無効になっています"
          }
        }
      }
    },
    "problem.store.invalidIndex.title": {
      "comment": "Problem title: the store's index can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app list can't be read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用列表读不懂"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 App 清單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの一覧を読み込めません"
          }
        }
      }
    },
    "problem.store.other.title": {
      "comment": "Problem title: the app list may be incomplete for an unknown reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app list may be incomplete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用列表可能不完整"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 清單可能不完整"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの一覧が不完全な可能性があります"
          }
        }
      }
    },
    "problem.store.timeout.title": {
      "comment": "Problem title: the app's source answered too slowly, the list may be stale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's source is too slow. The list may be out of date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的来源太慢了，列表可能不是最新的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 的來源回應太慢，清單可能不是最新的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの提供元の応答が遅すぎます。一覧が最新でない可能性があります"
          }
        }
      }
    },
    "problem.transport.next": {
      "comment": "What to do when the home server is unreachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络，连上后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查網路，連上後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信状態を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "problem.upgradeServer.nextStep": {
      "comment": "Next step: update the home server first. Used when the server is too old.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your home server first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先升级家里的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先更新家用伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず自宅サーバをアップデートしてください。"
          }
        }
      }
    }
  }
}
