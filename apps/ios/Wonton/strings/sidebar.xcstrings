{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "sidebar.openWindow": {
      "comment": "iPad context-menu action opening a conversation or page in its own window.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open in New Window" } },
        "ja": { "stringUnit": { "state": "translated", "value": "新しいウインドウで開く" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在新窗口打开" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在新視窗打開" } }
      }
    },
    "sidebar.windowClosed": {
      "comment": "Empty content window after the user closes its page without closing the OS window.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Page closed" } },
        "ja": { "stringUnit": { "state": "translated", "value": "ページを閉じました" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "页面已关闭" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "頁面已關閉" } }
      }
    },
    "sidebar.windowDifferentServer": {
      "comment": "A restored content target belongs to another server; do not silently open it with the current account.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Switch to this window’s server in the main window to continue." } },
        "ja": { "stringUnit": { "state": "translated", "value": "続けるには、メインウインドウでこのウインドウのサーバーに切り替えてください。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请在主窗口切回这个窗口所属的服务器后继续。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請在主視窗切回這個視窗所屬的伺服器後繼續。" } }
      }
    },
    "sidebar.windowUnavailable": {
      "comment": "The restored content window has no supported conversation or page target.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This window’s content is unavailable." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このウインドウの内容を開けません。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法打开这个窗口的内容。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法打開這個視窗的內容。" } }
      }
    },
    "sidebar.all": {
      "comment": "Button next to the section title: opens the grid of all apps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "sidebar.allApps": {
      "comment": "Row shown when more apps are installed than the sidebar lists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部應用程式"
          }
        }
      }
    },
    "sidebar.collapse": {
      "comment": "Accessibility label of the exposed strip that closes the sidebar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse sidebar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーを閉じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起侧边栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起側邊欄"
          }
        }
      }
    },
    "sidebar.myApps": {
      "comment": "Section title for the installed apps that open with a tap.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイアプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的應用程式"
          }
        }
      }
    },
    "sidebar.needsAttention": {
      "comment": "Accessibility label of the red dot on the settings button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs your attention"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有要处理的事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有要處理的事"
          }
        }
      }
    },
    "sidebar.open": {
      "comment": "Accessibility label of the top-left button that opens the sidebar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側邊欄"
          }
        }
      }
    },
    "sidebar.pinned": {
      "comment": "Accessibility label of the pin shown on a row pinned to the bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned to the navigation bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーに固定済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定到底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已釘選到底欄"
          }
        }
      }
    },
    "sidebar.title": {
      "comment": "Title at the top of the sidebar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞"
          }
        }
      }
    },
    "sidebar.updatable": {
      "comment": "Accessibility label of the red dot on a row with an update.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートあり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可更新"
          }
        }
      }
    },
    "sidebar.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has a problem"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページに問題あり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面出了问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面出了問題"
          }
        }
      }
    }
  }
}
