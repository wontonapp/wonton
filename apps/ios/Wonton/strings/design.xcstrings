          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "design.ok": {
      "comment": "Default single button of the app's dialog, which just closes it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "design.skip": {
      "comment": "Button on setup steps: skip this step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跳過"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        }
      }
    },
    "design.stepBack": {
      "comment": "Accessibility label of the back arrow on setup steps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous Step"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前へ"
          }
        }
      }
    },
    "design.stepProgress": {
      "comment": "Accessibility label of the step counter on setup steps, shown as 2/4. Arguments: the current step and the total.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$lld of %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 步，共 %2$lld 步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 步，共 %2$lld 步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ%1$lld／%2$lld"
          }
        }
      }
    },
    "design.switchOff": {
      "comment": "Accessibility value of the drawn switch when it's off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "design.switchOn": {
      "comment": "Accessibility value of the drawn switch when it's on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "design.updateBadge": {
      "comment": "Accessibility state of a list row with the update badge dot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートあり"
          }
        }
      }
    },
    "design.actionRunning": {
      "comment": "Accessibility value of an action button while the action is in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        }
      }
    },
    "design.actionUncertain": {
      "comment": "Shown under an action button when no result came back in time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure it worked. Check again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定成没成，过一会儿再看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定成功了沒有，過一會兒再看看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいったか分かりません。少し待ってからもう一度確認してください。"
          }
        }
      }
    },
    "design.actionFailedTransport": {
      "comment": "Shown under an action button that failed because the home server is unreachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上家里的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上家裡的伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーに接続できません。"
          }
        }
      }
    },
    "design.actionFailedPermission": {
      "comment": "Shown under an action button that failed for lack of permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有权限做这件事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有權限做這件事。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作を行う権限がありません。"
          }
        }
      }
    },
    "design.actionFailedNotReady": {
      "comment": "Shown under an action button that failed because the app is not installed or not ready.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app isn't ready yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个应用还没准备好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個應用程式還沒準備好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはまだ準備ができていません。"
          }
        }
      }
    },
    "design.actionFailedUpstream": {
      "comment": "Shown under an action button that failed with an error on the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on your home server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器出错了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡的伺服器出錯了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーでエラーが発生しました。"
          }
        }
      }
    },
    "design.actionFailedStill": {
      "comment": "Shown under a retry button when the retry ran but the problem is still there.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tried again. Still not working."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试过了，还是不行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試過了，還是不行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試しましたが、まだ直りません。"
          }
        }
      }
    },
    "design.actionFailedInvalid": {
      "comment": "Shown under an action button that failed because the request was not valid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be done."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这件事做不了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這件事做不了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作はできません。"
          }
        }
      }
    },
    "design.actionFailedOther": {
      "comment": "Shown under an action button that failed for a reason this app version does not know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没做成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有成功。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。"
          }
        }
      }
    }
  }
}
