{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "design.back": {
      "comment": "Accessibility label of the back button in pushed pages' top bars.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        }
      }
    },
    "design.clear": {
      "comment": "Accessibility label of the button that empties the search field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "zh-Hans": {
