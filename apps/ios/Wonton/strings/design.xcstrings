            "value": "消去"
          }
        }
      }
    },
    "design.close": {
      "comment": "Accessibility label of the close button in modal pages' top bars.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
