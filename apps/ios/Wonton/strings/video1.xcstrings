    "video.problem.noService.title": {
      "comment": "Problem title: no video service is installed or it isn't running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No video service is running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的影视服务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的影視服務"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できる動画サービスがありません"
          }
        }
      }
    },
    "video.problem.noService.nextStep": {
      "comment": "Next step for the problem above.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or start a video plugin such as Jellyfin on your server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务器上安装或启动一个影视插件（如 Jellyfin）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在伺服器上安裝或啟動一個影視外掛（如 Jellyfin）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーで Jellyfin などの動画プラグインをインストールまたは起動してください。"
          }
        }
      }
    },
    "video.problem.manySources.title": {
      "comment": "Problem title: more than one video service and none is the default.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one video service"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有不止一个影视服务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有不只一個影視服務"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画サービスが複数あります"
          }
        }
      }
    },
    "video.problem.signIn.title": {
      "comment": "Problem title: the video service doesn't accept this person's account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video service doesn't recognize your account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影视服务不认你的账号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影視服務不認你的帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画サービスがアカウントを認識できません"
          }
        }
      }
    },
    "video.problem.phoneFull.nextStep": {
      "comment": "Next step for the problem above.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up some space, then download again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腾出一些空间后再下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "騰出一些空間後再下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量を増やしてから、もう一度ダウンロードしてください。"
          }
        }
      }
    }
  }
