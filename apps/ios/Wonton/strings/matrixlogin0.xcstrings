{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "matrixLogin.entry": {
      "comment": "Row in the server list that opens signing in with an existing Matrix account. No arguments; short label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In with a Matrix Account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Matrix 账号登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Matrix 帳號登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix アカウントでログイン"
          }
        }
      }
    },
    "matrixLogin.server": {
      "comment": "Field label for the Matrix server to sign in to, a server name like matrix.org or an https URL. No arguments; short label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ"
          }
        }
      }
    },
    "matrixLogin.continue": {
      "comment": "Button that asks the core to check the server and list the ways to sign in. No arguments; short button label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次へ"
          }
        }
      }
    },
    "matrixLogin.method.oidc": {
      "comment": "Button for the server's own sign-in page, which opens in a browser sheet. No arguments; short button label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue in Browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器里继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器裡繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで続行"
          }
        }
      }
    },
    "matrixLogin.userId": {
      "comment": "Field label for the full Matrix user ID, like @user:example.org. No arguments; short label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix User ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix 用户 ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix 使用者 ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix ユーザ ID"
          }
        }
      }
    },
    "matrixLogin.password": {
      "comment": "Field label for the account password. No arguments; short label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード"
          }
        }
      }
    },
    "matrixLogin.saving": {
      "comment": "Progress line while the core stores the signed-in session on this phone. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the session…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存会话…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存工作階段…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを保存中…"
          }
        }
      }
    },
    "matrixLogin.finishInBrowser": {
      "comment": "Progress line while the user finishes signing in on the server's page in the browser sheet. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish signing in in the browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器里完成登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器裡完成登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでログインを完了してください"
          }
        }
      }
    },
    "matrixLogin.openBrowser": {
      "comment": "Button that opens the browser sheet again for the pending sign-in. No arguments; short button label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开浏览器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟瀏覽器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザを開く"
          }
        }
      }
    },
    "matrixLogin.browserFailed": {
      "comment": "Notice when the system browser sheet for signing in couldn't be opened. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the sign-in page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打不开登录页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟登入頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインページを開けません"
          }
        }
      }
    },
    "matrixLogin.failed.invalidHomeserver": {
      "comment": "Failure title: the server name or URL doesn't point to a Matrix homeserver. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t find a Matrix server at this address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个地址上找不到 Matrix 服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個位址上找不到 Matrix 伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスに Matrix サーバが見つかりません"
          }
        }
      }
    },
    "matrixLogin.failed.unsupportedMethod": {
      "comment": "Failure title: the server offers none of the sign-in methods this app supports. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server has no supported way to sign in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器没有可用的登录方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器沒有可用的登入方式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバには利用できるログイン方法がありません"
          }
        }
      }
    },
    "matrixLogin.failed.transport": {
      "comment": "Failure title: the network is unavailable. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路無法使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できません"
          }
        }
      }
    },
    "matrixLogin.failed.invalidCredentials": {
      "comment": "Failure title: the server rejected the user ID or password. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user ID or password is wrong"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户 ID 或密码不对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者 ID 或密碼不正確"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザ ID またはパスワードが違います"
          }
        }
      }
    },
    "matrixLogin.failed.invalidCallback": {
      "comment": "Failure title: the browser came back with a result that doesn't belong to this sign-in. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in result from the browser doesn’t match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器带回的登录结果对不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器帶回的登入結果對不上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザから戻ったログイン結果が一致しません"
          }
        }
      }
    },
    "matrixLogin.failed.expired": {
      "comment": "Failure title: the sign-in took too long and expired. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in expired"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入已過期"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインの有効期限が切れました"
          }
        }
      }
    },
    "matrixLogin.unknownState": {
      "comment": "Notice when the core reports a sign-in state the app doesn't know. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in can’t continue right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录暂时无法继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入暫時無法繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在ログインを続けられません"
          }
        }
      }
    }
  }
}
