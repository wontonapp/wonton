{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "matrixLogin.title": {
      "comment": "Navigation title of the Matrix sign-in page. No arguments; fits a phone navigation bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In with Matrix"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Matrix 账号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 Matrix 帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix にログイン"
          }
        }
      }
    },
    "matrixLogin.contacting": {
      "comment": "Progress line while the core contacts the server to discover the sign-in methods. Argument: the server name or URL the user chose.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacting %@…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在联系 %@…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連上 %@…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続中…"
          }
        }
      }
    },
    "matrixLogin.method.password": {
      "comment": "Button for the password method in the list of ways the server supports. No arguments; short button label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In with Password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用密码登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用密碼登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードでログイン"
          }
        }
      }
    },
    "matrixLogin.signIn": {
      "comment": "Button that submits the user ID and password to the server. No arguments; short button label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン"
          }
        }
      }
    },
    "matrixLogin.signingIn": {
      "comment": "Progress line while the core signs in. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在登录…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在登入…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン中…"
          }
        }
      }
    },
    "matrixLogin.failed.discovery": {
      "comment": "Failure title: the server couldn't be reached to discover the sign-in methods. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach the server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続できません"
          }
        }
      }
    },
    "matrixLogin.failed.oidcRejected": {
      "comment": "Failure title: the server's sign-in page refused or was declined. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn’t allow the sign-in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这次登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了這次登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがログインを許可しませんでした"
          }
        }
      }
    },
    "matrixLogin.failed.storage": {
      "comment": "Failure title: signing in worked but saving the session on this phone failed. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the sign-in on this phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录没能保存在这台手机上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入沒能儲存在這支手機上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインをこのスマートフォンに保存できませんでした"
          }
        }
      }
    },
    "matrixLogin.failed.upstream": {
      "comment": "Failure title: the Matrix server or its sign-in service returned an error. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server ran into a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバでエラーが発生しました"
          }
        }
      }
    },
    "matrixLogin.failed.other": {
      "comment": "Failure title for every category the app doesn't know. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインに失敗しました"
          }
        }
      }
    }
  }
}
