{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "friends.add.help": {
      "comment": "Keep the fictional example with the address instructions in wrapping text, not in the single-line prompt.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask them for their full friend address; in Wonton, once the Friends page loads successfully, they can copy their link from Add Friend → My QR Code.\nFormat only, not a real account: @bob:example.org"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请对方把完整好友地址发给你；用云吞时，可在好友页加载成功后从“加好友 → 我的二维码”复制链接。\n仅为格式示例，非真实账号：@bob:example.org"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請對方把完整好友地址傳給你；使用雲吞時，可在好友頁載入成功後從「加好友 → 我的QR碼」複製連結。\n僅為格式範例，非真實帳號：@bob:example.org"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手に完全な友だちアドレスを送ってもらいましょう（Wontonでは、友だちページの読み込みが成功した後、「友だちを追加 → 自分のQRコード」からリンクをコピーできます）。\n形式の例（実在のアカウントではありません）：@bob:example.org"
          }
        }
      }
    },
    "friends.add.submit": {
      "comment": "Sends the friend request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを送信"
          }
        }
      }
    },
    "friends.received": {
      "comment": "Second line of a received friend request. Argument: the relative time it arrived, like “5 minutes ago”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信：%@"
          }
        }
      }
    },
    "friends.remove.title": {
      "comment": "Confirmation to remove a friend. Argument: the friend's name or user ID.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%@” from friends?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把“%@”删掉好友？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把「%@」刪掉好友？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を友だちから削除しますか"
          }
        }
      }
    },
    "friends.remove.message": {
      "comment": "Removing a friend revokes their plugin access; the chat stays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their plugin access is revoked. The chat stays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会收回这个人的插件访问，私聊保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會收回這個人的外掛存取權，私聊保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人のプラグインアクセスは取り消されます。チャットは残ります。"
          }
        }
      }
    },
    "friends.block.server": {
      "comment": "Blocks the server typed above it for invitations.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉黑整台服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖整個伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーをブロック"
          }
        }
      }
    },
    "friends.undo": {
      "comment": "Reverts one block.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        }
      }
    },
    "friends.error.invalidUserId": {
      "comment": "Title when the typed Matrix ID is not valid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a Matrix ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Matrix ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Matrix ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix ID ではありません"
          }
        }
      }
    },
    "friends.block": {
      "comment": "Blocks invitations from this friend; reversible in the Blocked list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block invitations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽邀请"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖邀請"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待をブロック"
          }
        }
      }
    },
    "friends.myCode": {
      "comment": "Row in the add-friend sheet and title of the panel that shows my own matrix.to QR code; also the QR image's accessibility label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My QR Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的二维码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的QR碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のQRコード"
          }
        }
      }
    },
    "friends.status.publicAccessOffDetail": {
      "comment": "Explanation under the banner: friends on other servers can't reach this home until it is turned back on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends on other servers can't reach this home right now. They'll get through after public access is turned back on and they retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别的服务器上的好友暂时联系不到这台；重新打开公网访问后，对方重试就能到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別的伺服器上的好友暫時聯絡不到這台；重新打開公網訪問後，對方重試就能到。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーの友達とは今つながりません。外部からのアクセスをオンに戻せば、相手の再試行で届きます。"
          }
        }
      }
    }
  }
}
