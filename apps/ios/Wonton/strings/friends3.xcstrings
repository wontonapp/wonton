{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "friends.add.submit": {
      "comment": "Sends the friend request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを送信"
          }
        }
      }
    },
    "friends.received": {
      "comment": "Second line of a received friend request. Argument: the relative time it arrived, like “5 minutes ago”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信：%@"
          }
        }
      }
    },
    "friends.groups.delete.message": {
      "comment": "Deleting a group revokes the access shared through it, but keeps the friends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access shared through this group is revoked. The friends stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会收回经这个组分享的访问，好友保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會收回經這個組分享的存取權，好友保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループ経由の共有アクセスは取り消されます。友だちは残ります。"
          }
        }
      }
    },
    "friends.remove.title": {
      "comment": "Confirmation to remove a friend. Argument: the friend's name or user ID.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%@” from friends?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把“%@”删掉好友？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把「%@」刪掉好友？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を友だちから削除しますか"
          }
        }
      }
    },
    "friends.remove.message": {
      "comment": "Removing a friend revokes their plugin access; the chat stays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their plugin access is revoked. The chat stays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会收回这个人的插件访问，私聊保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會收回這個人的外掛存取權，私聊保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人のプラグインアクセスは取り消されます。チャットは残ります。"
          }
        }
      }
    },
    "friends.block.server": {
      "comment": "Blocks the server typed above it for invitations.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉黑整台服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖整個伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーをブロック"
          }
        }
      }
    },
    "friends.undo": {
      "comment": "Reverts one block.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        }
      }
    },
    "friends.error.invalidUserId": {
      "comment": "Title when the typed Matrix ID is not valid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a Matrix ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Matrix ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是 Matrix ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrix ID ではありません"
          }
        }
      }
    },
    "friends.block": {
      "comment": "Blocks invitations from this friend; reversible in the Blocked list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block invitations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽邀请"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封鎖邀請"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待をブロック"
          }
        }
      }
    }
  }
}
