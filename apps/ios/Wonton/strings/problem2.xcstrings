{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "problem.invalidInput.title": {
      "comment": "Problem title when the core rejected the input; the core's own reason goes into Details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个操作做不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法執行這個操作"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は実行できません"
          }
        }
      }
    },
    "problem.notPaired.title": {
      "comment": "Problem title: this phone has no home server paired yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paired with your home server yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没配对家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒配對家裡的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバーとまだペアリングしていません"
          }
        }
      }
    },
    "problem.pagesInvalid.nextStep": {
      "comment": "Next step for unreadable local page settings; avoid replacing the user's data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Details and contact support to avoid overwriting your settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看详情并联系支持人员，避免覆盖原有设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請查看詳細資訊並聯絡支援人員，避免覆蓋原本的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の設定を上書きしないよう、詳細を確認してサポートにお問い合わせください。"
          }
        }
      }
    },
    "problem.plugin.coreUpgrading.nextStep": {
      "comment": "Next step: try after the update finishes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again after the update finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级结束后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新完成後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが終わってからもう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.egressProxyWaiting.nextStep": {
      "comment": "Next step: retry once it is up; open the proxy app's install page if it stays stuck.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry once it is up. If it stays stuck, look at the proxy app's logs on its install page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等它起来后重试；一直不动，去代理插件的安装页看日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等它起來後重試；一直不動，去代理應用程式的安裝頁看記錄檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動を待ってから再試行します。進まない場合は、プロキシアプリのインストールページでログを確認してください。"
          }
        }
      }
    },
    "problem.plugin.healthTimeout.title": {
      "comment": "The app was still not ready at the install health deadline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not ready yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用还没就绪"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式還沒就緒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはまだ準備できていません"
          }
        }
      }
    },
    "problem.plugin.inUse.title": {
      "comment": "Uninstall failed: other apps still require a capability this app provides.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other apps still need it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有应用在用它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有應用程式在用它"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ使っているアプリがあります"
          }
        }
      }
    },
    "problem.plugin.invalid.title": {
      "comment": "Problem title: the app's package is broken.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app's package has a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个应用的安装包有问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 的安裝套件有問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのパッケージに問題があります"
          }
        }
      }
    },
    "problem.plugin.lanPortTaken.nextStep": {
      "comment": "Next step: stop the container or program using this port, then try again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the container or program using this port, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停掉占着这个端口的容器或程序再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停掉佔著這個連接埠的容器或程式再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このポートを使っているコンテナかプログラムを止めてから、もう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.lanPortTaken.title": {
      "comment": "Problem title: a port the app opens on the local network is used by another container or program.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port in use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口被占用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠被佔用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートが使用中です"
          }
        }
      }
    },
    "problem.plugin.notFound.title": {
      "comment": "Problem title: the app is gone from its source.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app wasn't found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到这个应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這個 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリが見つかりません"
          }
        }
      }
    },
    "problem.plugin.unsupported.title": {
      "comment": "Problem title: the home server is too old for this app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server doesn't support this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器不支持这个应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器不支援這個 App"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバはこのアプリに対応していません"
          }
        }
      }
    },
    "problem.pluginSave.uncertain.nextStep": {
      "comment": "Next step: look at the proxy settings again once the server is reachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check it again once your home server is reachable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连上家里的服务器后再看一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連上家用伺服器後再檢查一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続してからもう一度確認してください。"
          }
        }
      }
    },
    "problem.serverNotPaired.title": {
      "comment": "Problem title when a chat can't start because the other server isn't paired with this one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other server isn't paired"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方服务器还没配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方伺服器還沒配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のサーバーはまだペアリングされていません"
          }
        }
      }
    },
    "problem.slowLoading": {
      "comment": "Shown after a few seconds under a spinner: the network is slow, loading still goes on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still loading — this can take a while on a slow network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还在加载，网络慢时要多等一会儿"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在載入，網路慢時要多等一會兒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中です。ネットワークが遅いと時間がかかります"
          }
        }
      }
    },
    "problem.transportUnavailable.title": {
      "comment": "Problem title used for plugin, chat and connection failures: the home server can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続できません"
          }
        }
      }
    },
    "problem.unauthorized.nextStep": {
      "comment": "Next step under the not-recognized problem: pair again by scanning the code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the pairing code again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新扫码配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新掃描配對碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードをもう一度スキャンしてください。"
          }
        }
      }
    },
    "problem.upstream.nextStep": {
      "comment": "Next step under the server-error problem. Also used for other problems that only say to try later.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "problem.upstream.title": {
      "comment": "Problem title used for plugin, chat and connection failures: the home server itself reported an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server ran into a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバでエラーが発生しました"
          }
        }
      }
    }
  }
}
