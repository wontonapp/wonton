{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.enterChat": {
      "comment": "Primary button after setup finished: leave setup and open chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットへ"
          }
        }
      }
    },
    "onboarding.model.collapsed": {
      "comment": "Accessibility value of the provider-list toggle while the list is collapsed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapsed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已收起"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみ済み"
          }
        }
      }
    },
    "onboarding.next": {
      "comment": "Primary button that advances to the next setup step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次へ"
          }
        }
      }
    },
    "onboarding.problem.model.transportUnavailable.next": {
      "comment": "Line under the problem title: reconnect before retrying.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network, then try again once you're connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络，连上后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查網路，連上後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを確認して、接続してから再試行してください。"
          }
        }
      }
    },
    "onboarding.problem.model.unauthorized": {
      "comment": "Problem title in setup: the home server doesn't recognize this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server doesn't recognize this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器不认这台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器不認得這部裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバがこのデバイスを認識していません"
          }
        }
      }
    },
    "onboarding.problem.store.timeout": {
      "comment": "Problem title in setup: the recommendation source responds too slowly.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommendations are taking too long"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐清单加载太慢了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦清單載入太慢了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの読み込みに時間がかかっています"
          }
        }
      }
    },
    "onboarding.problem.store.upstream": {
      "comment": "Problem title in setup: the recommendation source hit an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommendation source hit an error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐清单的来源出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦清單的來源出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの提供元でエラーが発生しました"
          }
        }
      }
    },
    "onboarding.review.keepCurrent": {
      "comment": "Row description in the review step: the already-configured models are kept.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Current"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用现在的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のものを使用"
          }
        }
      }
    },
    "onboarding.review.unreachableModel": {
      "comment": "Row description in the review step. The argument is the model's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Unreachable when tested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 测试时没连上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 測試時沒連上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · テスト時に接続できませんでした"
          }
        }
      }
    },
    "onboarding.running": {
      "comment": "Busy label while a setup step or an install task is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        }
      }
    },
    "onboarding.skipAnyway": {
      "comment": "Secondary button on the setup error screen: leave setup without finishing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip for Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先跳過"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        }
      }
    }
  }
}
