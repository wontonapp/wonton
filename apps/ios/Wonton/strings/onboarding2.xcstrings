    "onboarding.enterChat": {
      "comment": "Primary button after setup finished: leave setup and open chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
