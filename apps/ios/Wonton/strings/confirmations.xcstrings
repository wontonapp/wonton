{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "confirmations.empty": {
      "comment": "Empty state of the awaiting-approval list: no card is waiting and none ended recently.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing needs your confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有要你确认的事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有要你確認的事"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要なものはありません"
          }
        }
      }
    },
    "confirmations.moreCards": {
      "comment": "Line under the first card in a room when several cards are waiting. Argument: how many besides the first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 more waiting"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%d more waiting"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "还有 %d 张待确认"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "還有 %d 張待確認"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "他%d件"
                }
              }
            }
          }
        }
      }
    },
    "confirmations.stateFailed": {
      "comment": "Collapsed card row: the action ran but failed. The full result is on the card itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't go through"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有成功"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有成功"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行できませんでした"
          }
        }
      }
    },
    "confirmations.stateSucceeded": {
      "comment": "Collapsed card row: the action was carried out. The full result is on the card itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "confirmations.stateUncertain": {
      "comment": "Collapsed card row: the action ran but whether it worked is unknown. The full note is on the card itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncertain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は不明"
          }
        }
      }
    },
    "confirmations.title": {
      "comment": "Title of the awaiting-approval list screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ち"
          }
        }
      }
    },
    "confirmations.until": {
      "comment": "Collapsed pending card row. Argument: remaining time formatted as a localized relative interval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@到期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@到期"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に期限切れ"
          }
        }
      }
    }
  }
}
