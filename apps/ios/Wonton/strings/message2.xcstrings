{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "message.codeCopied": {
      "comment": "Accessibility label of that copy button right after the code was copied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました"
          }
        }
      }
    },
    "message.linkUpdateApp": {
      "comment": "Shown when a message links to a wonton:// page this app version doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the app to open this link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新 App 后才能打开这个链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新 App 後才能開啟這個連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを開くにはアプリを更新してください"
          }
        }
      }
    },
    "message.copy": {
      "comment": "Item in the message menu: copy the message text. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "message.quoteRedacted": {
      "comment": "The quoted original message was deleted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message deleted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤回的消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已收回的訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されたメッセージ"
          }
        }
      }
    },
    "message.quoteUnavailable": {
      "comment": "The quoted original message can't be shown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original message unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原消息不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原訊息無法顯示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のメッセージを表示できません"
          }
        }
      }
    },
    "message.quoteUndecryptable": {
      "comment": "The quoted original message can't be decrypted on this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't decrypt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解密"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号できません"
          }
        }
      }
    },
    "message.redactMessage": {
      "comment": "Explanation under the redaction confirmation: it happens on every device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It turns into a deleted message on everyone's devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人那里都会变成已撤回的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有人那裡都會變成已收回的訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員の端末で削除されたメッセージに変わります。"
          }
        }
      }
    },
    "message.redactOthers": {
      "comment": "Item in the message menu on someone else's message: delete it for everyone. Argument: the sender's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@'s Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@ 的消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %@ 的訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のメッセージを削除"
          }
        }
      }
    },
    "message.redactOthersTitle": {
      "comment": "Title of the confirmation before deleting someone else's message for everyone. Argument: the sender's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@'s message for everyone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@ 的这条消息？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %@ 的這則訊息？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のメッセージを全員から削除しますか？"
          }
        }
      }
    },
    "message.replyCancel": {
      "comment": "Remove the reply quote above the composer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消回复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消回覆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信をやめる"
          }
        }
      }
    },
    "message.edited": {
      "comment": "Marker on a message that was edited.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edited"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已编辑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已編輯"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集済み"
          }
        }
      }
    },
    "message.sending": {
      "comment": "Footer label of a message saved on this device but not yet confirmed delivered by the server (queued or in flight).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved, not delivered yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存，等待送达"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存，等待送達"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み、未配信"
          }
        }
      }
    },
    "message.read": {
      "comment": "Small line under your own message that the other side has read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已讀"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既読"
          }
        }
      }
    },
    "message.delivered": {
      "comment": "Small line under your own latest message: the server has it, nobody has read it yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivered"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已送达"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已送達"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信済み"
          }
        }
      }
    },
    "message.undecryptableNotice": {
      "comment": "Notice above the composer while some messages can't be decrypted; the button under it gets the keys back.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier encrypted messages can't be read on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备读不了之前的加密消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置讀不了先前的加密訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは以前の暗号化メッセージを読めません。"
          }
        }
      }
    },
    "message.redacted": {
      "comment": "Placeholder for a message that was withdrawn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message withdrawn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已撤回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息已收回"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは取り消されました"
          }
        }
      }
    },
    "message.sendFailedRetrying": {
      "comment": "Send state that retries by itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent, retrying"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败，会自动重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送失敗，會自動重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信に失敗しました。自動で再試行します"
          }
        }
      }
    },
    "message.photo": {
      "comment": "Accessibility label of an image message; double-tapping opens the viewer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        }
      }
    },
    "message.sendingProgress": {
      "comment": "Footer of a message still uploading its attachments. Argument: percent done, already formatted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送中 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送中 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信中 %@"
          }
        }
      }
    },
    "message.cancelSend": {
      "comment": "Menu item on a message that is still uploading: drop it and stop the upload.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Sending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消傳送"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信を取り消す"
          }
        }
      }
    },
    "message.sendFailure.tooLarge": {
      "comment": "Send failed because the file is over the server's upload limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too large, send it as a file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太大了，改用文件发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太大了，改送檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きすぎます。ファイルで送ってください"
          }
        }
      }
    },
    "message.sendFailure.unsupportedType": {
      "comment": "Send failed because the server doesn't know the file type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format can't be sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个格式发不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個格式送不了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形式は送れません"
          }
        }
      }
    },
    "message.sendFailure.upstream": {
      "comment": "Send failed because the server had a problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの問題"
          }
        }
      }
    },
    "message.sendFailure.other": {
      "comment": "Send failed for a reason the shell doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした"
          }
        }
      }
    },
    "message.editTitle": {
      "comment": "Title of the bar above the input while editing a message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを編集"
          }
        }
      }
    }
  }
}
