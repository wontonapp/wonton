{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "peers.received": {
      "comment": "Second line of a pairing request. Argument: the relative time it arrived, like “5 minutes ago”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信：%@"
          }
        }
      }
    },
    "peers.conflict": {
      "comment": "Warning line of a pairing request whose reported name matches a paired server but is a different server. Argument: the paired server’s display name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same name as paired “%@”, not the same server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和已配对的“%@”重名，不是同一台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和已配對的「%@」重名，不是同一台"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みの「%@」と同名ですが、同じサーバではありません"
          }
        }
      }
    },
    "peers.reset": {
      "comment": "Button on the pairing code panel and confirm button: replace the code, which invalidates the old one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置配对码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重設配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをリセット"
          }
        }
      }
    },
    "peers.error.codeRevoked": {
      "comment": "Error below the paste field: the pasted pairing code was reset before it was used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code was reset. Ask them for a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张码已经作废，请对方重新发一张"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張碼已經作廢，請對方重新出一張"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは無効になりました。新しいコードをもらってください。"
          }
        }
      }
    },
    "peers.notice.requestNotFound": {
      "comment": "Light notice: the request acted on was already handled elsewhere, so the list refreshes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request was already handled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条请求已经处理过了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條請求已經處理過了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストはすでに処理済みです"
          }
        }
      }
    },
    "peers.showCode.title": {
      "comment": "Title of the panel that shows this server's pairing QR code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show My Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出示我的码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出示我的碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のコードを表示"
          }
        }
      }
    },
    "peers.status.removed": {
      "comment": "Status line of a paired server row: the other side removed the pairing, so the connection was refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected by the other server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方已断开连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方已中斷連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が接続を切断しました"
          }
        }
      }
    },
    "peers.status.awaiting": {
      "comment": "Status line of a row added by scanning their code: they haven't approved the pairing yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for their approval"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等对方同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等對方同意"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の承認待ち"
          }
        }
      }
    },
    "peers.remove.title": {
      "comment": "Destructive confirmation title for removing a paired server, phrased like the server list's remove dialog. Argument: the other owner's display name, or their server name if the display name is missing. May wrap.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        }
      }
    },
    "peers.error.peerUnreachable": {
      "comment": "Title of a failed scan: this server couldn't reach the server that showed the code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach their server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上对方的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上對方的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のサーバに接続できません"
          }
        }
      }
    },
    "peers.error.selfPairing": {
      "comment": "Title of a failed scan: the scanned code is from this very server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own server's code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你自己服务器的码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你自己伺服器的配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは自分のサーバのコードです"
          }
        }
      }
    },
    "peers.error.other": {
      "comment": "Title of a failed operation when nothing more specific applies (protocol or unknown errors).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请稍后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了點問題，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "peers.camera.denied": {
      "comment": "Scanner page when camera access was denied: scanning can't work. Point to the system settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton doesn't have camera access, so it can't scan. You can allow it in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞没有相机权限，扫不了码。可以在设置里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞沒有相機權限，無法掃碼。可以在設定裡開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonにカメラへのアクセス権がなく、スキャンできません。設定で許可できます。"
          }
        }
      }
    },
    "peers.status.checking": {
      "comment": "Status line of a paired server row: just paired, the first reachability probe hasn't returned yet, so it is neither connected nor unreachable. Shown in the secondary text color.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中"
          }
        }
      }
    }
  }
}
