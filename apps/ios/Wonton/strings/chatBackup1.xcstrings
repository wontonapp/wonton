{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "chatBackup.authUnavailable": {
      "comment": "Error under the reveal button when the system identity verification can't run; the user's own cancel shows nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity verification isn't available right now. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统验证暂时用不了，稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統驗證暫時用不了，稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま本人確認を利用できません。のちほどお試しください。"
          }
        }
      }
    },
    "chatBackup.copy": {
      "comment": "Button that copies the recovery key to the local clipboard only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピー"
          }
        }
      }
    },
    "chatBackup.detail.unknown": {
      "comment": "Explanation when the backup status can't be confirmed because the server isn't reachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your home server to confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连上家里的服务器后才能确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連上家用伺服器後才能確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続すると確認できます。"
          }
        }
      }
    },
    "chatBackup.recover": {
      "comment": "Primary button under the recovery key field: fetch past messages with the entered key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Past Messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取回以前的消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取回以前的訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去のメッセージを復元"
          }
        }
      }
    },
    "chatBackup.reminder.enterKey": {
      "comment": "Banner in the chat list asking for the recovery key to restore past messages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your recovery key to restore past messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入恢复密钥，取回以前的消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入復原金鑰，取回以前的訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを入力すると過去のメッセージを復元できます"
          }
        }
      }
    },
    "chatBackup.reset": {
      "comment": "Button that opens the reset confirmation; it replaces the recovery key with a new one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置備份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップをリセット"
          }
        }
      }
    },
    "chatBackup.resetConfirm": {
      "comment": "Danger button that confirms the reset in the dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセット"
          }
        }
      }
    },
    "chatBackup.resetTitle": {
      "comment": "Title of the reset confirmation dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Chat Backup?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置聊天记录备份？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置聊天記錄備份？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのバックアップをリセットしますか？"
          }
        }
      }
    },
    "chatBackup.saved": {
      "comment": "Button that confirms the recovery key was saved somewhere safe; the app then forgets it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました"
          }
        }
      }
    },
    "chatBackup.status.disabled": {
      "comment": "Page heading when chat backup hasn't been set up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat Backup Isn't Set Up Yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有备份聊天记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有備份聊天記錄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはまだバックアップされていません"
          }
        }
      }
    },
    "chatBackup.status.inProgress": {
      "comment": "Page heading while backup or recovery runs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在處理…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中…"
          }
        }
      }
    },
    "chatBackup.status.unknown": {
      "comment": "Page heading when the backup status isn't known (offline).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup status isn't known yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还不知道备份的情况"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還無法確認備份狀態"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの状態はまだ不明です"
          }
        }
      }
    },
    "chatBackup.title": {
      "comment": "Title of the chat backup page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat Backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天记录备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天記錄備份"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのバックアップ"
          }
        }
      }
    },
    "chatBackup.value.disabled": {
      "comment": "Value on the Settings row: backup is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "chatBackup.value.enabled": {
      "comment": "Value on the Settings row for chat backup: backup is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "chatBackup.value.incomplete": {
      "comment": "Value on the Settings row: backup needs the recovery key on this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery key needed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要恢复密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要復原金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーが必要"
          }
        }
      }
    },
    "chatBackup.revealKey": {
      "comment": "Button that asks the system to verify the owner before showing the recovery key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View recovery key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看恢复密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看復原金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを表示"
          }
        }
      }
    },
    "chatBackup.verifyReason": {
      "comment": "Explains the system verification prompt shown before the recovery key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to view the recovery key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份后查看恢复密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證身分後查看復原金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを表示するには認証してください"
          }
        }
      }
    }
  }
}
