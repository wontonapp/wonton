{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "storeBatch.progress": {
      "comment": "Executing bulk update: completed count and total count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating apps · %1$lld/%2$lld completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新应用 · 已完成 %1$lld/%2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新應用程式 · 已完成 %1$lld/%2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを更新中 · %1$lld/%2$lld件完了"
          }
        }
      }
    },
    "storeBatch.summary": {
      "comment": "Finished bulk update counts: succeeded, failed, awaiting decision.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates: %1$lld succeeded · %2$lld failed · %3$lld awaiting decision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新结果：成功 %1$lld · 失败 %2$lld · 待处理 %3$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新結果：成功 %1$lld · 失敗 %2$lld · 待處理 %3$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新結果：成功 %1$lld件 · 失敗 %2$lld件 · 要確認 %3$lld件"
          }
        }
      }
    },
    "storeBatch.clear": {
      "comment": "Clears the entire finished batch and its retained per-app results.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear results"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除結果"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果を消去"
          }
        }
      }
    },
    "storeBatch.targetVersion": {
      "comment": "Target version shown with each app before and during bulk updates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target version: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标版本：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標版本：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新先バージョン：%@"
          }
        }
      }
    },
    "storeBatch.queued": {
      "comment": "An app waiting its turn in this bulk update.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新待ち"
          }
        }
      }
    },
    "storeBatch.checking": {
      "comment": "The core is fetching the real update preview for this app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認中"
          }
        }
      }
    },
    "storeBatch.needsDecision": {
      "comment": "This app needs explicit confirmation without blocking other updates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmation required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要です"
          }
        }
      }
    },
    "storeBatch.review": {
      "comment": "Opens the existing confirmation page for this app only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看并确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視並確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認"
          }
        }
      }
    },
    "storeBatch.reviewApp": {
      "comment": "Accessible review button naming the app whose confirmation opens.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review update for %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看并确认 %@ 的更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視並確認 %@ 的更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の更新内容を確認"
          }
        }
      }
    }
  }
}
