{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "photo.gifUnreadable": {
      "comment": "Detail of the photo problem: the GIF's header is invalid. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read this GIF"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认不出这张 GIF"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認不出這張 GIF"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGIFを読み込めません"
          }
        }
      }
    },
    "photo.tryAnother": {
      "comment": "Next step under a photo problem: pick a different photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一张试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換一張試試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の写真でお試しください。"
          }
        }
      }
    },
    "photo.unencodable": {
      "comment": "Title of the photo problem on iOS, detail on Android: the photo was decoded but couldn't be re-encoded for sending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't convert this photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片转码失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片轉換失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を変換できません"
          }
        }
      }
    },
    "photo.unreadable": {
      "comment": "Title of the photo problem: the picked photo can't be read or decoded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read this photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不出这张照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不出這張照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を読み込めません"
          }
        }
      }
    }
  }
}
