{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "photo.albumsShared": {
      "comment": "Group header in the album list: albums other family members shared with me.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared with Me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享给我"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與我共享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された項目"
          }
        }
      }
    },
    "photo.timeThisYear": {
