    "photo.actionRemoveFromAlbum": {
      "comment": "Action: remove the selected items from this album.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from Album"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移出相册"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相簿移除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムから削除"
          }
        }
      }
    },
    "photo.trashConfirm": {
      "comment": "Confirmation title before moving to trash when it can't be undone here. Argument: count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Move %lld item to the trash?"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Move %lld items to the trash?"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "把 %lld 项移到回收站？"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "將 %lld 項移到垃圾桶？"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld項目をゴミ箱に移動しますか？"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "photo.doneRemove": {
      "comment": "Result notice. Argument: count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Removed %lld item from the album"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Removed %lld items from the album"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已把 %lld 项移出相册"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已將 %lld 項從相簿移除"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld項目をアルバムから削除しました"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "photo.problemGoneTitle": {
      "comment": "Problem title: the item or album no longer exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is no longer there"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一项已经不在了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個項目已經不在了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はもうありません"
          }
        }
      }
    },
    "photo.sourceTitle": {
      "comment": "Problem title: more than one photo plugin is installed and no default is set.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's more than one photo app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里有不止一个相册应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡有不止一個相簿應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリが複数あります"
          }
        }
      }
    },
    "photo.sourceChoose": {
      "comment": "Title of the list for picking which photo plugin to use.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个相册应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個相簿應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリを選択"
          }
        }
      }
    },
    "photo.shareDenied": {
      "comment": "Next step in the share sheet when this person may not read the family member list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to see the family list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有看家人名单的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你沒有查看家人名單的權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族の一覧を見る権限がありません。"
          }
        }
      }
