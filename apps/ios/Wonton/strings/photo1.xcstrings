{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "photo.tryAnother": {
      "comment": "Next step under a photo problem: pick a different photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一张试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換一張試試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の写真でお試しください。"
          }
        }
      }
    },
    "photo.sectionSearch": {
      "comment": "Bottom switcher item: search photos.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
