        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片没取到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入這張照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を読み込めません"
          }
        }
      }
    },
