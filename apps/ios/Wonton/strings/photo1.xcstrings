    "photo.actionUnfavorite": {
      "comment": "Action: remove from favorites.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfavorite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
