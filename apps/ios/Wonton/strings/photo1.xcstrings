    "photo.problemPluginNext": {
      "comment": "Next step for the missing photo plugin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start it in Apps, or install one from the Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到“应用”里启动它，或者去商店装一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到「應用程式」啟動它，或到商店安裝一個。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリ」で起動するか、ストアからインストールしてください。"
          }
        }
      }
    },
    "photo.problemAuthTitle": {
      "comment": "Problem title: the plugin rejected the credential.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo app didn't accept this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册应用没认出这台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿應用程式沒有認出這部裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリがこのデバイスを認識できませんでした"
          }
        }
      }
    },
    "photo.liveFailed": {
      "comment": "Problem title: the Live Photo's motion can't be played.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't play the Live Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实况没放出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法播放原況照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photosを再生できません"
          }
        }
      }
    },
    "photo.imageFailed": {
      "comment": "Problem title: the photo can't be loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
