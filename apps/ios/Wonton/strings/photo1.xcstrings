    "photo.emptyTimeline": {
      "comment": "Shown when the library has no photos.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photos yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はまだありません"
          }
        }
      }
    },
    "photo.emptyAlbum": {
      "comment": "Shown inside an album without items.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album is empty"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个相册还是空的"
          }
        },
