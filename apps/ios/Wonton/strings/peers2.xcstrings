{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "peers.reject": {
      "comment": "Button on a pending pairing request: decline it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "peers.share": {
      "comment": "Button on the pairing code panel: open the system share sheet with the code text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "peers.reset.title": {
      "comment": "Title of the confirmation before resetting the pairing code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the pairing code?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置配对码？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重設配對碼？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードをリセットしますか？"
          }
        }
      }
    },
    "peers.reset.message": {
      "comment": "Message of the confirmation before resetting the pairing code: what happens to the old code and its requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old code stops working, and pending requests sent with it are cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧码会作废，用旧码发来的请求一并清掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊碼會作廢，用舊碼送來的請求一併清掉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いコードは使えなくなり、そのコードで届いたリクエストも消えます。"
          }
        }
      }
    },
    "peers.showCode.button": {
      "comment": "Button and action-sheet item: show this server's pairing QR code for the other owner to scan. Opens the next step, hence the ellipsis.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show My Code…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出示我的码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出示我的碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のコードを表示"
          }
        }
      }
    },
    "peers.scanCode.button": {
      "comment": "Button and action-sheet item: scan the other server's pairing QR code. Opens the scanner, hence the ellipsis.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Their Code…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫对方的码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描對方的碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコードをスキャン"
          }
        }
      }
    },
    "peers.scanCode.title": {
      "comment": "Title of the page that scans the other server's pairing QR code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Their Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫对方的码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描對方的碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコードをスキャン"
          }
        }
      }
    },
    "peers.status.offline": {
      "comment": "Status line of a paired server row: their server can't be reached right now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their server can't be reached"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方服务器连不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的伺服器連不上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のサーバに接続できません"
          }
        }
      }
    },
    "peers.lastConnected": {
      "comment": "Second status line of an offline row. Argument: the relative time of the last successful connection, like “5 minutes ago”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last connected %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次连上：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次連線：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終接続：%@"
          }
        }
      }
    },
    "peers.error.peerRejected": {
      "comment": "Title of a failed scan: the other owner declined the pairing request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They didn't approve the connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方没有同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方沒有同意"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が承認しませんでした"
          }
        }
      }
    },
    "peers.error.notPaired": {
      "comment": "Title of a failed operation: the other server isn't paired with this one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server isn't connected yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器还没连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器還沒有連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはまだ接続されていません"
          }
        }
      }
    },
    "peers.pasteSubmit": {
      "comment": "Button under the paste field on the scanner page: submit the pasted pairing code, same as scanning it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング"
          }
        }
      }
    }
  }
}
