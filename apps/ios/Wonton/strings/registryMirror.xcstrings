{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "registryMirror.custom": {
      "comment": "Radio option for typing a mirror address that isn't in the list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム"
          }
        }
      }
    },
    "registryMirror.dockerHubDirect": {
      "comment": "Row title for the speed test result of Docker Hub reached directly, without a mirror. Keep Docker Hub as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Hub (Direct)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Hub 直连"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Hub 直接連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Hub（直接接続）"
          }
        }
      }
    },
    "registryMirror.probe.available": {
      "comment": "Speed test result: the mirror works but no latency was measured.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能"
          }
        }
      }
    },
    "registryMirror.probe.digestMismatch": {
      "comment": "Speed test result: the mirror returned content whose digest doesn't match.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digest mismatch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要不符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要不符"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイジェスト不一致"
          }
        }
      }
    },
    "registryMirror.probe.other": {
      "comment": "Speed test result: some other failure; details are collapsed below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他错误"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他錯誤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他のエラー"
          }
        }
      }
    },
    "registryMirror.probe.rejected": {
      "comment": "Speed test result: the mirror refused the request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遭拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否されました"
          }
        }
      }
    },
    "registryMirror.probe.unknown": {
      "comment": "Speed test result when this address hasn't been tested.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明"
          }
        }
      }
    },
    "registryMirror.probe.unreachable": {
      "comment": "Speed test result: the mirror can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreachable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません"
          }
        }
      }
    },
    "registryMirror.recommended": {
      "comment": "Warning on the Download Mirror page when Docker Hub can't be reached directly. Keep Docker Hub as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach Docker Hub. Try turning on a download mirror."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Hub 连不上，建议打开镜像加速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上 Docker Hub，建議開啟下載鏡像站。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Hubに接続できません。ダウンロードミラーをオンにすることをおすすめします。"
          }
        }
      }
    },
    "registryMirror.risk": {
      "comment": "Explanation under the Download Mirror switch: the mirrors are run by third parties, can see what is downloaded, but can't tamper with it because every image is checked against its digest.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are free third-party services. They can see which images you download, but they can't change them: every image's digest is checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是第三方公益服务，能看到拉了哪些镜像，但改不了镜像内容，因为摘要会逐一核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是第三方的公益服務，能看到你下載了哪些映像檔，但無法修改映像檔的內容，因為每個映像檔的摘要都會逐一核對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは第三者が無料で提供しているサービスです。どのイメージをダウンロードしたかは見えますが、ダイジェストを1つずつ照合するため、内容を書き換えることはできません。"
          }
        }
      }
    },
    "registryMirror.saveFailed": {
      "comment": "Problem title when the typed mirror address is invalid and wasn't saved. The server's reason is in the collapsed details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror address wasn't saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像地址没有保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡像站位址沒有儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラーのアドレスは保存されていません"
          }
        }
      }
    },
    "registryMirror.test": {
      "comment": "Button that measures how fast each mirror and Docker Hub respond.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测速"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測速"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度をテスト"
          }
        }
      }
    },
    "registryMirror.title": {
      "comment": "Title of the Download Mirror settings page, its row in Settings > Home Server, and the switch that turns it on. A mirror makes the home server download apps faster.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Mirror"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像加速"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載鏡像站"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードミラー"
          }
        }
      }
    }
  }
}
