{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "composer.attach": {
      "comment": "Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付"
          }
        }
      }
    },
    "composer.chooseFailed": {
      "comment": "Title of the problem shown when the file picker fails. The detail is the system's reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't access that file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选不了这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法選擇這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを選択できません"
          }
        }
      }
    },
    "composer.file": {
      "comment": "Item in the composer's attachment menu: pick files to send.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル"
          }
        }
      }
    },
    "composer.message": {
      "comment": "Placeholder in the chat composer's empty text field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ"
          }
        }
      }
    },
    "composer.photo": {
      "comment": "Item in the composer's attachment menu: pick a photo to send.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        }
      }
    },
    "composer.send": {
      "comment": "Screen-reader label of the round send button at the right of the chat composer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信"
          }
        }
      }
    },
    "composer.trayFull": {
      "comment": "Shown when the attachment tray is full. Argument: the most attachments one message can carry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can send up to %lld attachments at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多发 %lld 个附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多傳送 %lld 個附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に送れる添付は %lld 個までです。"
          }
        }
      }
    },
    "composer.attachment.remove": {
      "comment": "Accessibility label of the button that takes an attachment out of the tray. Argument: file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を外す"
          }
        }
      }
    },
    "composer.attachment.paused": {
      "comment": "Accessibility label of an attachment whose upload waits for the connection to the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等连上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等連上家裡的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーへの接続を待っています"
          }
        }
      }
    },
    "composer.attachment.failed": {
      "comment": "An attachment could not be uploaded; also the fallback when the core gives an unknown reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传不上去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳不上去"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードできませんでした"
          }
        }
      }
    },
    "composer.attachment.retry": {
      "comment": "Button: upload a failed attachment again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上傳"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度アップロード"
          }
        }
      }
    },
    "composer.attachment.tooLarge": {
      "comment": "Upload failure: the photo is over the home server's limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is over your home server's size limit. Send it as a file instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片超过了家里服务器的大小上限，可以改用文件发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片超過了家裡伺服器的大小上限，可以改用檔案傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が自宅のサーバーのサイズ上限を超えています。ファイルとして送ってください。"
          }
        }
      }
    },
    "composer.attachment.sourceUnavailable": {
      "comment": "Upload failure: the original file on the phone can no longer be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file can't be read anymore. Choose it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件读不了了，请重新选一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原檔案讀不了了，請重新選一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを読み込めなくなりました。もう一度選んでください。"
          }
        }
      }
    },
    "composer.attachment.storageFull": {
      "comment": "Upload failure: the home server's disk is full.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server is out of space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里服务器的磁盘满了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡伺服器的磁碟滿了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーの容量がいっぱいです。"
          }
        }
      }
    },
    "composer.attachment.rejected": {
      "comment": "Upload failure: the home server refused the upload.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server refused this upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器拒收了这个附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡的伺服器拒收了這個附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーがこのアップロードを拒否しました。"
          }
        }
      }
    },
    "composer.attachment.upstream": {
      "comment": "Upload failure: the home server ran into an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server ran into a problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器出错了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡的伺服器出錯了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーでエラーが起きました。"
          }
        }
      }
    },
    "composer.attachment.localStorage": {
      "comment": "Upload failure: the phone has no room to keep the attachment.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough space on this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上存不下了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上存不下了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンの空き容量が足りません。"
          }
        }
      }
    }
  }
}
