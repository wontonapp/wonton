  "strings": {
    "composer.attach": {
      "comment": "Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付"
          }
        }
      }
    },
    "composer.chooseFailed": {
      "comment": "Title of the problem shown when the file picker fails. The detail is the system's reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't access that file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选不了这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法選擇這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを選択できません"
          }
        }
      }
    },
    "composer.file": {
      "comment": "Item in the composer's attachment menu: pick files to send.",
