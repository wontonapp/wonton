{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "composer.attachment.unsupportedType": {
      "comment": "Attachment failed because the server doesn't know the file type.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format can't be uploaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个格式传不上去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個格式傳不上去"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形式はアップロードできません"
          }
        }
      }
    },
    "composer.attachment.replyTarget": {
      "comment": "Attachment failed because the message being replied to is gone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quoted message is gone, drop the reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要回复的那条不在了，去掉回复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要回覆的那則不在了，去掉回覆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信元がありません。返信を外してください"
          }
        }
      }
    },
    "composer.attach": {
      "comment": "Icon button at the left of the chat composer: opens the attachment menu (photo or file). Also its screen-reader label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付"
          }
        }
      }
    },
    "composer.chooseFailed": {
      "comment": "Title of the problem shown when the file picker fails. The detail is the system's reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't access that file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选不了这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法選擇這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを選択できません"
          }
        }
      }
    },
    "composer.file": {
      "comment": "Item in the composer's attachment menu: pick files to send.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル"
          }
        }
      }
    },
    "composer.message": {
      "comment": "Placeholder in the chat composer's empty text field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ"
          }
        }
      }
    },
    "composer.photo": {
      "comment": "Item in the composer's attachment menu: pick a photo to send.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        }
      }
    },
    "composer.send": {
      "comment": "Screen-reader label of the round send button at the right of the chat composer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信"
          }
        }
      }
    },
    "composer.editConfirm": {
      "comment": "Screen-reader label of the check button that submits the edited text while a message is being edited.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定"
          }
        }
      }
    },
    "composer.trayFull": {
      "comment": "Shown when the attachment tray is full. Argument: the most attachments one message can carry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can send up to %lld attachments at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多发 %lld 个附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多傳送 %lld 個附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に送れる添付は %lld 個までです。"
          }
        }
      }
    },
    "composer.attachment.remove": {
      "comment": "Accessibility label of the button that takes an attachment out of the tray. Argument: file name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を外す"
          }
        }
      }
    },
    "composer.attachment.paused": {
      "comment": "Accessibility label of an attachment whose upload waits for the connection to the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等连上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等連上家裡的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーへの接続を待っています"
          }
        }
      }
    },
    "composer.attachment.failed": {
      "comment": "An attachment could not be uploaded; also the fallback when the core gives an unknown reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传不上去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳不上去"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードできませんでした"
          }
        }
      }
    },
    "composer.attachment.retry": {
      "comment": "Button: upload a failed attachment again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新上傳"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度アップロード"
          }
        }
      }
    },
    "composer.attachment.tooLarge": {
      "comment": "Upload failure: the photo is over the home server's limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo is over your home server's size limit. Send it as a file instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片超过了家里服务器的大小上限，可以改用文件发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片超過了家裡伺服器的大小上限，可以改用檔案傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が自宅のサーバーのサイズ上限を超えています。ファイルとして送ってください。"
          }
        }
      }
    },
    "composer.attachment.sourceUnavailable": {
      "comment": "Upload failure: the original file on the phone can no longer be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file can't be read anymore. Choose it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件读不了了，请重新选一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原檔案讀不了了，請重新選一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを読み込めなくなりました。もう一度選んでください。"
          }
        }
      }
    },
    "composer.attachment.storageFull": {
      "comment": "Upload failure: the home server's disk is full.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server is out of space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里服务器的磁盘满了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡伺服器的磁碟滿了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーの容量がいっぱいです。"
          }
        }
      }
    },
    "composer.attachment.rejected": {
      "comment": "Upload failure: the home server refused the upload.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server refused this upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器拒收了这个附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡的伺服器拒收了這個附件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーがこのアップロードを拒否しました。"
          }
        }
      }
    },
    "composer.attachment.upstream": {
      "comment": "Upload failure: the home server ran into an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server ran into a problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器出错了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家裡的伺服器出錯了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅のサーバーでエラーが起きました。"
          }
        }
      }
    },
    "composer.attachment.localStorage": {
      "comment": "Upload failure: the phone has no room to keep the attachment.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough space on this phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机上存不下了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機上存不下了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンの空き容量が足りません。"
          }
        }
      }
    },
    "composer.stop": {
      "comment": "Round button in the chat composer while the bot is working on a turn: stops that turn. Also its screen-reader label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "composer.stopping": {
      "comment": "Screen-reader label of the composer's stop button while the stop request is on its way; the button shows a spinner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止中"
          }
        }
      }
    },
    "composer.stopped": {
      "comment": "One-line note above the chat composer right after the home server confirmed the bot's turn was stopped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止しました"
          }
        }
      }
    },
    "composer.stopFailed": {
      "comment": "One-line note above the chat composer: the home server did not stop the bot's turn. The stop button stays for another try.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't stop it. You can try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没停下来，可以再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒停下來，可以再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "composer.stopForbidden": {
      "comment": "One-line note above the chat composer: this person isn't allowed to stop this bot's turn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to stop this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有权限停下这一轮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你沒有權限停下這一輪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを停止する権限がありません。"
          }
        }
      }
    },
    "composer.stopUncertain": {
      "comment": "One-line note above the chat composer: the stop request may not have reached the home server, so it is unknown whether the bot's turn stopped. The stop button stays for another try.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach your home server, so it's unclear whether it stopped. You can try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没连上家里的服务器，不确定停下没有。可以再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒連上家用伺服器，不確定停下沒有。可以再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続できず、停止できたか分かりません。もう一度お試しください。"
          }
        }
      }
    },
    "composer.photoAccessDenied": {
      "comment": "Shown in the attachment sheet when photo library access is denied, above the Open Settings button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton has no access to your photos. Allow it in Settings to pick photos here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞没有访问照片的权限。在设置里允许后，就能在这里选照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞沒有取用照片的權限。在設定裡允許後，就能在這裡選照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonに写真へのアクセス権がありません。設定で許可すると、ここで写真を選べます。"
          }
        }
      }
    },
    "composer.commands": {
      "comment": "Text and screen-reader label of the capsule button left of the attach button in the chat composer: opens the list of the bot's slash commands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー"
          }
        }
      }
    },
    "composer.commandsOmitted": {
      "comment": "Last line of the slash-command list when some commands were cut off. %lld is how many are not listed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more commands not listed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 条命令没列出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 條指令未列出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに %lld 件のコマンドがあります"
          }
        }
      }
    },
    "composer.attachOnlyMain": {
      "comment": "Shown above the composer in a side chat: photos go out right away, files belong in the main chat. ADR-0093, ADR-0109 §9.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos in a side chat are sent right away; files go in the main chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊里照片直接发，不进附件区；文件去主对话。"
