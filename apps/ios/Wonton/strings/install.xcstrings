{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "install.actionInstall": {
      "comment": "Confirm button and title of the page that installs an app from the Store or a file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール"
          }
        }
      }
    },
    "install.actionUpgrade": {
      "comment": "Confirm button and title of the page that updates an installed app to a newer version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート"
          }
        }
      }
    },
    "install.alwaysAllowedRisk": {
      "comment": "Warning under the Always Allow switches in the install preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These bots can use this app's tools without asking, including tools added in newer versions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Bot 用这个插件的工具不再问，新版本多出来的工具也算在内"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 Bot 用這個 App 的工具不再問，新版本多出來的工具也算在內"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのボットは、このアプリのツールを確認なしで使えます。新しいバージョンで追加されたツールも含まれます。"
          }
        }
      }
    },
    "install.audienceAdmin": {
      "comment": "Built-in role name in the app audience choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrators"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理員"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者"
          }
        }
      }
    },
    "install.audienceChild": {
      "comment": "Built-in role name in the app audience choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Children"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
