{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "install.actionInstall": {
      "comment": "Confirm button and title of the page that installs an app from the Store or a file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール"
          }
        }
      }
    },
    "install.actionUpgrade": {
      "comment": "Confirm button and title of the page that updates an installed app to a newer version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート"
          }
        }
      }
    },
    "install.alwaysAllowedRisk": {
      "comment": "Warning under the Always Allow switches in the install preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These bots can use this app's tools without asking, including tools added in newer versions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Bot 用这个插件的工具不再问，新版本多出来的工具也算在内"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 Bot 用這個 App 的工具不再問，新版本多出來的工具也算在內"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのボットは、このアプリのツールを確認なしで使えます。新しいバージョンで追加されたツールも含まれます。"
          }
        }
      }
    },
    "install.changeVersion": {
      "comment": "Title of the page that switches an installed app to a version from another source or a file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンを変更"
          }
        }
      }
    },
    "install.fillProfile": {
      "comment": "Button in the install preview when the app needs profile details you haven't filled in yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete Profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写资料"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填寫資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールを入力"
          }
        }
      }
    },
    "install.permissions": {
      "comment": "Section title above the permissions the app asks for, in the install preview and the detail page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限"
          }
        }
      }
    },
    "install.releaseNotes": {
      "comment": "Section title above the release notes in the install preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's New"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新说明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新說明"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新内容"
          }
        }
      }
    }
  }
}
