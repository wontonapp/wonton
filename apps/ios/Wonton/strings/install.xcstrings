    "install.requestAdmin": {
      "comment": "Install action for people whose role requires administrator approval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask an administrator to install"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请管理员安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請管理員安裝"
          }
        },
        "ja": {
