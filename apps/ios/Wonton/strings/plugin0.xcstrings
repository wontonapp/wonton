{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "plugin.deviceOther": {
      "comment": "Fallback name for an authorized host hardware device of an unrecognized kind. Keep short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他のデバイス"
          }
        }
      }
    },
    "plugin.permission.close": {
      "comment": "Turn the optional permission off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "plugin.permission.continue": {
      "comment": "Continue to the second confirmation step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "plugin.permission.host.root": {
      "comment": "What turning on the highest risk permission means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once it is on, the plugin manages this host's containers as root."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后它能以 root 身份管理这台主机上的容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後它能以 root 身分管理這台主機上的容器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、root としてこのホストのコンテナを操作します。"
          }
        }
      }
    },
    "plugin.permission.opened.bot": {
      "comment": "When a Bot turned this optional permission on. First %@ is the Bot name, second is the date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot %1$@ turned this on %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot %1$@ 在 %2$@ 打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot %1$@ 在 %2$@ 開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ に Bot %1$@ がオン"
          }
        }
      }
    },
    "plugin.permission.risk.high": {
      "comment": "Explicit permission risk level shown in previews and installed plugin details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High risk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高級風險"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高リスク"
          }
        }
      }
    },
    "plugin.permission.unsupported": {
      "comment": "Small tag next to a permission the core doesn't support.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非対応"
          }
        }
      }
    },
    "plugin.settings.updatesApp": {
      "comment": "Shown for a setting whose control or value type is newer than this App understands; submitting the whole form is blocked.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the App to edit this setting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更新 App 才能改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要更新 App 才能改"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定を変更するには App をアップデートしてください"
          }
        }
      }
    },
    "plugin.task.addedTools": {
      "comment": "Succeeded task line listing the tools the app gained. Argument: the tool names, formatted as a list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New tools: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增的工具：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增的工具：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加されたツール：%@"
          }
        }
      }
    },
    "plugin.task.uninstallFailed": {
      "comment": "Failed uninstall task line. Argument: the reason from the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载失败：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストールに失敗しました：%@"
          }
        }
      }
    },
    "plugin.task.upgradeDone": {
      "comment": "Status of a finished update task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已升級"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートしました"
          }
        }
      }
    },
    "plugin.task.upgradeFailed": {
      "comment": "Failed update task line. Argument: the reason from the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级失败：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートに失敗しました：%@"
          }
        }
      }
    },
    "plugin.trust.official": {
      "comment": "Small tag on a store row and the install preview: the app is reviewed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已审核"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已審核"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審査済み"
          }
        }
      }
    },
    "plugin.trust.system": {
      "comment": "Small tag: a system app that's always installed.",
      "extractionState": "manual",
      "localizations": {
