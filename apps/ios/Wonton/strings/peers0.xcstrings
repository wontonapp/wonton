{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "peers.rejectedAt": {
      "comment": "Second line of a declined request. Argument: the relative time it was declined.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝于：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕於：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否：%@"
          }
        }
      }
    },
    "peers.undo": {
      "comment": "Button on a declined request: undo the decline so the server can ask again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻す"
          }
        }
      }
    },
    "peers.error.tooManyRequests": {
      "comment": "Error: the other server currently accepts no more pairing requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can’t take requests right now. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方暂时收不了请求，稍后再试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方暫時收不了請求，稍後再試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手は今リクエストを受け取れません。しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "peers.empty": {
      "comment": "Empty list on the Other Servers page: no servers are paired yet. Followed by two buttons.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected to any other servers yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有连接其他服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有連線其他伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバとはまだ接続していません"
          }
        }
      }
    },
    "peers.remove.message": {
      "comment": "Body of the delete confirmation: after removing the pairing, the two servers stop exchanging messages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll stop exchanging messages with this server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除后不再和这台服务器互通消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除後不再和這台伺服器互通訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するとこのサーバとメッセージのやり取りができなくなります。"
          }
        }
      }
    },
    "peers.codeQrLabel": {
      "comment": "Accessibility label of the QR code image that carries this server's pairing code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server pairing QR code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器配对二维码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器配對 QR 碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバのペアリング用QRコード"
          }
        }
      }
    },
    "peers.error.codeInvalid": {
      "comment": "Title of a failed operation: the scanned text isn't a server pairing code, or it was tampered with.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a server pairing code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是服务器配对码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是伺服器配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはサーバのペアリングコードではありません"
          }
        }
      }
    },
    "peers.error.alreadyPaired": {
      "comment": "Title of a failed scan: the two servers are already paired.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already connected to this server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经和这台服务器连接过了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經和這台伺服器連線過了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバとはすでに接続済みです"
          }
        }
      }
    },
    "peers.error.unauthenticated": {
      "comment": "Title of a failed operation: only the server's owner (not another family member's device) can manage other servers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the server's owner can manage other servers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有服务器主人能管理其他服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有伺服器的主人能管理其他伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバのオーナーだけがほかのサーバを管理できます"
          }
        }
      }
    },
    "peers.pasteCode": {
      "comment": "Placeholder of the field under the camera on the scanner page: paste the other server's pairing code instead of scanning it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste Their Code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴配对码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上配對碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをペースト"
          }
        }
      }
    }
  }
}
