{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "connection.udp.flows": {
      "comment": "Collapsed UDP flow summary; argument is the number of flows. Tap to expand.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld UDP flow"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld UDP flows"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "UDP 流向 %lld 条"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "UDP 流向 %lld 條"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "UDP フロー%lld件"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "connection.udp.flow.traffic": {
      "comment": "One UDP flow: port number, localized received packet count, localized submitted packet count. Submission does not guarantee delivery.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "port %1$@ · recv %2$@ / sent %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %1$@ · 收 %2$@ / 发 %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠 %1$@ · 收 %2$@ / 傳 %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート%1$@ · 受信 %2$@ / 送信 %3$@"
          }
        }
      }
    },
    "connection.udp.flow.traffic.dropped": {
      "comment": "One UDP flow: port number, localized received count, localized submitted count, localized oversized packet drop count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "port %1$@ · recv %2$@ / sent %3$@ · %4$@ dropped as too large"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %1$@ · 收 %2$@ / 发 %3$@ · 超长丢弃 %4$@ 个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠 %1$@ · 收 %2$@ / 傳 %3$@ · 超長丟棄 %4$@ 個"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート%1$@ · 受信 %2$@ / 送信 %3$@ · 長すぎて%4$@件破棄"
          }
        }
      }
    },
    "connection.notice.connecting": {
      "comment": "Short connection status while connecting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しています…"
          }
        }
      }
    },
    "connection.notice.retrying": {
      "comment": "Connection progress while a real connection attempt or manual retry is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trying to reach your home server…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接家里的服务器…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連接家用伺服器…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバーに接続しています…"
          }
        }
      }
    },
    "connection.notice.deviceRejected": {
      "comment": "Status when the home server no longer recognizes this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone is no longer recognized by your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器已不认这台手机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台手機已不被家用伺服器認可"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは自宅サーバに認められていません"
          }
        }
      }
    },
    "connection.notice.poor": {
      "comment": "Short status when connected but the recent connection quality is poor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor connection, things may be slow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络较差，可能会卡"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路較差，可能會卡"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信が不安定です"
          }
        }
      }
    },
    "connection.pairAgain": {
      "comment": "Button when the server no longer recognizes this phone; also the settings row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ペアリング"
          }
        }
      }
    },
    "connection.cellular": {
      "comment": "Row in the connection page: what the phone's network is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone Network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机网络"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機網路"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルネットワーク"
          }
        }
      }
    },
    "connection.direct": {
      "comment": "Connection route straight to the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直连"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接接続"
          }
        }
      }
    },
    "connection.detail.path": {
      "comment": "Row in the connection details page: which route traffic takes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路径"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経路"
          }
        }
      }
    },
    "connection.detail.quality": {
      "comment": "Row in the connection details page: quality of the recent window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接质量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線品質"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続品質"
          }
        }
      }
    },
    "connection.quality.good": {
      "comment": "Row in the connection details page: quality of the recent window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "良好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "良好"
          }
        }
      }
    },
    "connection.quality.poor": {
      "comment": "Row in the connection details page: quality of the recent window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
