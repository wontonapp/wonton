{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "plugin.permission.added": {
      "comment": "Small tag next to a permission that's newly requested in this update.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "plugin.permission.close.title": {
      "comment": "Title of the dialog shown before turning an optional permission off. %@ is the permission text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をオフにしますか？"
          }
        }
      }
    },
    "plugin.permission.optional": {
      "comment": "Small tag next to a permission the owner may skip.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意"
          }
        }
      }
    },
    "plugin.permission.understand.title": {
      "comment": "Second confirmation step for the highest risk permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know this plugin can control the whole host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我知道这个插件能控制整台主机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我知道這個外掛能控制整台主機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインがホスト全体を操作できることを理解しました"
          }
        }
      }
    },
    "plugin.settings.emptyPrompt": {
      "comment": "Placeholder of a text setting whose empty value clears it back to the default.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to reset to the default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空恢复默认值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空恢復預設值"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄で既定値に戻ります"
          }
        }
      }
    },
    "plugin.settings.required": {
      "comment": "Shown next to a required setting that has neither a value nor a default.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必填"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必填"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必須"
          }
        }
      }
    },
    "plugin.task.installFailed": {
      "comment": "Failed install task line. Argument: the reason from the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装失败：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールに失敗しました：%@"
          }
        }
      }
    },
    "plugin.task.review": {
      "comment": "Button on a failed task whose app package changed after the confirmation: reopen the confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查看"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再確認"
          }
        }
      }
    },
    "plugin.task.uninstallDone": {
      "comment": "Status of a finished uninstall task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已卸载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已解除安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストールしました"
          }
        }
      }
    },
    "plugin.trust.unreviewed": {
      "comment": "Small tag: the app isn't reviewed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreviewed"
          }
        },
        "zh-Hans": {
