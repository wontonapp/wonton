            "state": "translated",
            "value": "未審査"
          }
        }
      }
    },
    "plugin.saveGrant.revoke": {
      "comment": "Button on a save-grant row: take the folder permission back.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        }
      }
    },
    "plugin.askEveryUpdate": {
      "comment": "Switch label: ask for approval on every update of this agent-written app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Every Time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次都问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次詢問"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回確認"
          }
        }
      }
    },
    "plugin.writtenByAgent": {
      "comment": "Caption under an app's name: the owner's agent wrote it. Argument: the agent's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Agent · %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Agent · %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのエージェント · %@"
          }
        }
      }
    },
    "plugin.requirements": {
      "comment": "Section title above what the app needs from the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requirements"
          }
        },
        "zh-Hans": {
