    "plugin.info.homepage": {
      "comment": "Information row: link to the app's home page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homepage"
          }
        },
        "zh-Hans": {
