    "plugin.uninstall.action": {
      "comment": "Action-sheet item that uninstalls the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
