    "music.albumCount": {
      "comment": "How many albums an artist or genre has. Argument: the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld album"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld albums"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张专辑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 張專輯"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚のアルバム"
          }
        }
      }
    },
    "music.minutes": {
      "comment": "How long an album or playlist plays. Argument: whole minutes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分鐘"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分"
          }
        }
      }
    },
    "music.summary": {
      "comment": "Line under an album or playlist. Arguments: the song count text and the minutes text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@"
          }
        }
      }
    },
    "music.disc": {
      "comment": "Section title for one disc of a multi-disc album. Argument: the disc number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disc %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 张碟"
