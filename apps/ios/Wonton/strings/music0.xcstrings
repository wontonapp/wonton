    "music.playback.failed.title": {
      "comment": "Problem title: playing the song failed for a reason this app does not know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't play this song"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能放这首歌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能播放這首歌"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲を再生できませんでした"
          }
        }
