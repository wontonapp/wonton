    "music.problem.notReady.nextStep": {
      "comment": "Next step under the not-ready problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again once it has started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等它启动完再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等它啟動完再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動が終わってからもう一度お試しください。"
          }
        }
      }
    },
    "music.problem.notSignedIn.title": {
      "comment": "Problem title: the music library did not accept who this person is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music library didn't recognize you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐库没认出你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂庫沒認出你"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリがあなたを認識できませんでした"
          }
        }
      }
    },
    "music.problem.notSignedIn.nextStep": {
      "comment": "Next step under the not-recognized problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask whoever manages the home server to check the music library's accounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请管家里服务器的人看看音乐库的账号设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請管家裡伺服器的人看看音樂庫的帳號設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームサーバーの管理者にミュージックライブラリのアカウント設定を確認してもらってください。"
          }
        }
      }
    },
    "music.problem.notFound.title": {
      "comment": "Problem title: the album, artist or playlist is no longer in the library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is no longer in the music library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐库里没有这一项了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂庫裡沒有這一項了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はミュージックライブラリにありません"
          }
        }
      }
    },
    "music.problem.notFound.nextStep": {
      "comment": "Next step under the not-found problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have been deleted. Go back and refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能已经被删掉了，返回刷新看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能已經被刪掉了，返回重新整理看看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された可能性があります。戻って更新してください。"
          }
        }
      }
    },
    "music.problem.unknown.title": {
      "comment": "Problem title: the music library returned an error code this app does not know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music library returned an unfamiliar error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐库回了一个没见过的错误"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂庫回了一個沒見過的錯誤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリから不明なエラーが返されました"
          }
        }
      }
    },
    "music.problem.protocol.title": {
      "comment": "Problem title: the music library's reply could not be understood.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the music library's reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看不懂音乐库的回复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不懂音樂庫的回覆"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリの応答を読み取れません"
          }
        }
      }
    },
