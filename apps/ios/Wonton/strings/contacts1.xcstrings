{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "contacts.add.kindBot": {
      "comment": "Choice in the add-contact sheet: the other side is a bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボット"
          }
        }
      }
    },
    "contacts.add.placeholder": {
      "comment": "Placeholder of the Matrix ID field in the add-contact sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@someone:example.org"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@someone:example.org"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@someone:example.org"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@someone:example.org"
          }
        }
      }
    },
    "contacts.section.active": {
      "comment": "Section heading for contacts both sides approved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加済み"
          }
        }
      }
    },
    "contacts.section.sent": {
      "comment": "Section heading for requests I sent that aren't in effect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已送出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信済み"
          }
        }
      }
    },
    "contacts.incoming.warning": {
      "comment": "Shown on an incoming contact request: what approving means.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its messages will be handled like messages to your bot, and sensitive tools will ask you every time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方 Bot 的话，你的 Bot 会当作给它的话处理；敏感工具每次都要你确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方 Bot 的話，你的 Bot 會當作給它的話處理；敏感工具每次都要你確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のボットの発言は、あなたのボットへの発言として扱われます。重要なツールは毎回あなたの確認が必要になります。"
          }
        }
      }
    },
    "contacts.approveRemote.message": {
      "comment": "Confirmation body: what approving a request from another server means (ADR-0050).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After approving, this bot can only chat with them. It won't use your other tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意后，这个 Bot 只和对方聊天，不再使用家里的其他工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意後，這個 Bot 只和對方聊天，不再使用家裡的其他工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、このボットは相手とのチャットだけを行い、ほかのツールは使わなくなります。"
          }
        }
      }
    },
    "contacts.approveRemote.title": {
      "comment": "Confirmation title for approving a request from another server. Argument: the requester's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve “%@” from another server?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意来自其他服务器的“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意來自其他伺服器的「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のサーバーの「%@」を承認しますか？"
          }
        }
      }
    },
    "contacts.approve": {
      "comment": "Approve button on an incoming contact request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認"
          }
        }
      }
    },
    "contacts.remote.from": {
      "comment": "On a contact from another server: which server they're on. Argument: the server name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から"
          }
        }
      }
    },
    "contacts.reject": {
      "comment": "Reject button on an incoming contact request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "contacts.withdraw": {
      "comment": "Button that withdraws a request I sent and they haven't answered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        }
      }
    },
    "contacts.clear": {
      "comment": "Button that clears a declined or failed request row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "contacts.remove.message": {
      "comment": "Confirmation body: what removing a contact does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bot stops handling their messages. Existing chats stay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Bot 不再处理对方的话，已有的聊天留着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Bot 不再處理對方的話，已有的聊天會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットは相手の発言を処理しなくなります。既存のチャットは残ります。"
          }
        }
      }
    },
    "contacts.status.declined": {
      "comment": "Row status: they declined.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They declined"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方拒绝了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方拒絕了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が拒否しました"
          }
        }
      }
    },
    "contacts.status.notFound": {
      "comment": "Row status: no such user on that server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No such user"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有这个人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有這個人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当するユーザーがいません"
          }
        }
      }
    },
    "contacts.empty": {
      "comment": "Empty contacts page: the one sentence above the add button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacts yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有联系人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有聯絡人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先はまだありません"
          }
        }
      }
    },
    "contacts.error.alreadyContact": {
      "comment": "Failure title: already a contact or already requested.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already a contact, or the request was already sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经是联系人，或者请求已经发出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經是聯絡人，或請求已經送出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに連絡先か、リクエストを送信済みです"
          }
        }
      }
    },
    "contacts.error.notKeeper": {
      "comment": "Failure title: only the bot's keeper can manage contacts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this bot's keeper can manage its contacts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这个 Bot 的归属人能管它的联系人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有這個 Bot 的歸屬人能管理它的聯絡人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットの連絡先は持ち主だけが管理できます"
          }
        }
      }
    },
    "contacts.error.unauthenticated": {
      "comment": "Failure title: this device isn't a paired device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device isn't allowed to do this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备不能做这件事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置不能做這件事"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではこの操作はできません"
          }
        }
      }
    },
    "contacts.error.upstream": {
      "comment": "Failure title: the home server failed to save it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server couldn't save this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器没能记下这件事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器沒能記下這件事"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバーが保存できませんでした"
          }
        }
      }
    }
  }
}
