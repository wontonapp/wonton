  "strings": {
    "video.searchPrompt": {
      "comment": "Placeholder in the video search field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movies, shows, people"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片名、剧名、演员"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "片名、劇名、演員"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画、番組、出演者"
          }
        }
      }
    },
    "video.sort": {
      "comment": "Title of the sort picker on the poster wall.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort By"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序"
          }
        },
        "zh-Hant": {
          "stringUnit": {
