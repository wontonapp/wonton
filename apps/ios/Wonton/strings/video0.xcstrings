          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開日"
          }
        }
      }
    },
    "video.genre": {
      "comment": "Title of the genre picker on the poster wall.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Genre"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
