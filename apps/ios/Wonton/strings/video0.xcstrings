            "value": "排序"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替え"
          }
        }
      }
    },
    "video.sort.released": {
      "comment": "Sort option: newest release first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release Date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上映时间"
          }
        },
        "zh-Hant": {
