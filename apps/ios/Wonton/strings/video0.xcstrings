          "stringUnit": {
            "state": "translated",
            "value": "ジャンル"
          }
        }
      }
    },
    "video.markPlayed": {
      "comment": "Accessibility label: mark as watched.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as Watched"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标为看过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標為看過"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴済みにする"
          }
        }
      }
    },
    "video.download": {
      "comment": "Accessibility label: download to this phone for offline watching.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    },
    "video.removeDownload": {
      "comment": "Menu action: delete the downloaded copy from this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを削除"
          }
        }
      }
    },
    "video.keepAppOpen": {
      "comment": "Under the download progress: downloads only continue while the app is open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Wonton open until the download finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载完之前请保持 Wonton 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載完成前請保持 Wonton 開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが終わるまで Wonton を開いたままにしてください。"
          }
        }
      }
    },
    "video.audio": {
      "comment": "Title of the audio track picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音轨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音軌"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声"
          }
        }
      }
    },
    "video.subtitles": {
      "comment": "Title of the subtitle picker.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtitles"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕"
          }
        }
      }
    },
    "video.paused": {
      "comment": "Label next to the progress bar of a download someone paused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已暂停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載已暫停"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを一時停止中"
          }
        }
      }
    },
    "video.resumeDownload": {
      "comment": "Button that continues a paused download.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開"
          }
        }
      }
    },
    "video.downloadFailed": {
      "comment": "Above the reason a download stopped for good, next to a retry button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download didn't finish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载没完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載沒完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが完了しませんでした"
          }
        }
      }
    },
    "video.episodes": {
      "comment": "In the facts line of a season: how many episodes. Argument: the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld episode"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld episodes"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 集"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 集"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld エピソード"
          }
        }
      }
    },
    "video.problem.manySources.nextStep": {
      "comment": "Next step for the problem above.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the owner to pick a default one in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请主人在设置里选一个默认的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請主人在設定裡選一個預設的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーナーに設定でデフォルトを選んでもらってください。"
          }
        }
      }
    },
    "video.problem.unsupported.title": {
      "comment": "Problem title: this phone can't play the file and the server can't convert it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone can't play this file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机放不了这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台手機放不了這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではこのファイルを再生できません"
          }
        }
      }
    }
  }
