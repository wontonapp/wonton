{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "servers.add": {
      "comment": "Server list button that opens pairing to add another server. No arguments; short button label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Server…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバを追加"
          }
        }
      }
    },
    "servers.add.title": {
      "comment": "Navigation title while pairing an additional server. No arguments; fits a phone navigation bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバを追加"
          }
        }
      }
    },
    "servers.default.first": {
      "comment": "Default display name for server number 1 in the server list and Settings. No arguments; keep it short enough for a settings row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバ"
          }
        }
      }
    },
    "servers.default.numbered": {
      "comment": "Default server name in the server list and Settings. Argument: the stable server number, not the number of servers. Keep it short enough for a settings row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Server %lld"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Server %lld"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "服务器 %lld"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "伺服器 %lld"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "サーバ%lld"
                }
              }
            }
          }
        }
      }
    },
    "servers.name": {
      "comment": "Text field label in the server rename dialog. The value is the owner's editable server name. No format arguments; short label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ名"
          }
        }
      }
    },
    "servers.remove.message": {
      "comment": "Body of the server removal confirmation. Only this phone's chat history and files are deleted; data on the server is unaffected. No arguments; wraps in a dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes its chat history and files from this phone. Data on the server isn’t affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机上它的聊天记录和文件会删掉，服务器上的不受影响"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除這支手機上這台伺服器的聊天記錄和檔案，不會影響伺服器上的資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンに保存されたチャット履歴とファイルが削除されます。サーバ上のデータは削除されません。"
          }
        }
      }
    },
    "servers.remove.title": {
      "comment": "Destructive confirmation title for removing a server from this phone. Argument: the server's displayed name, including a localized default or the owner's unmodified name. May wrap.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        }
      }
    }
  }
}
