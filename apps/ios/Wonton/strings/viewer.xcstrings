{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "viewer.savePhoto": {
      "comment": "Icon button in the image viewer's toolbar: save the photo to the system photo library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储图像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を保存"
          }
        }
      }
    },
    "viewer.share": {
      "comment": "Icon button in the image viewer's toolbar: open the system share sheet for the photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "viewer.photoPermission": {
      "comment": "Notice when adding to the photo library is not allowed: the permission is missing or was denied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't save to your photo library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有存储到相册的权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有儲存到相簿的權限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリに保存する権限がありません"
          }
        }
      }
    },
    "viewer.photoPermissionHint": {
      "comment": "Line under the photo-permission notice: what to do next.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow saving photos in Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到系统设置里允许存储图片，再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到系統設定裡允許儲存圖片，再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で写真の保存を許可してから、もう一度お試しください。"
          }
        }
      }
    },
    "viewer.saveFailed": {
      "comment": "Notice when the system photo library rejects saving the photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を保存できませんでした"
          }
        }
      }
    },
    "viewer.shareFailed": {
      "comment": "Notice when the photo can't be handed to the share sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't share the photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を共有できませんでした"
          }
        }
      }
    }
  }
}
