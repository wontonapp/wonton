{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "verification.cancelled.acceptedElsewhere": {
      "comment": "Result: another of the user's devices took over the verification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another of your devices took over the verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次确认由你的另一台设备接手了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次確認由你的另一部裝置接手了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスがこの確認を引き継ぎました。"
          }
        }
      }
    },
    "verification.cancelled.byOther": {
      "comment": "Result: the user cancelled on the other device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device cancelled the verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备取消了确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一部裝置取消了確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスが確認を取り消しました。"
          }
        }
      }
    },
    "verification.cancelled.concurrentRequest": {
      "comment": "Result: a second verification request arrived at the same time and both were cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another verification request arrived at the same time. Both were cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时收到了另一个确认请求，两个都取消了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時收到另一個確認請求，兩個都取消了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に別の確認リクエストが届いたため、両方取り消しました。"
          }
        }
      }
    },
    "verification.cancelled.failed": {
      "comment": "Result: the verification failed for another reason; the details are in the problem dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification didn't finish because of a problem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认没有完成，出了点问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認沒有完成，出了點問題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生したため、確認が完了しませんでした。"
          }
        }
      }
    },
    "verification.cancelled.keysMissing": {
      "comment": "Result: not all keys came through from the other device (it may not have them, or a request got lost), so older messages stay locked. Verify again or enter the recovery key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not all keys came through from the other device, so older messages stay locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能从另一台设备取全密钥，以前的消息还是解不开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能從另一部裝置取全金鑰，以前的訊息還是解不開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスから鍵をすべて受け取れなかったため、以前のメッセージは開けません。"
          }
        }
      }
    },
    "verification.cancelled.timeout": {
      "comment": "Result: the other device didn't respond within 10 minutes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device didn't respond in time. The verification was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备太久没有回应，确认已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一部裝置太久沒有回應，確認已取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスが時間内に応答しなかったため、確認を取り消しました。"
          }
        }
      }
    },
    "verification.different": {
      "comment": "Button saying the emoji (or numbers) differ: the other device is not trusted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不同"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "違う"
          }
        }
      }
    },
    "verification.done.here": {
      "comment": "Shown on the new device when verification finished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified. Older messages are readable now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证，以前的消息可以查看了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已驗證，以前的訊息可以查看了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できました。以前のメッセージも読めます。"
          }
        }
      }
    },
    "verification.fetchingKeys": {
      "comment": "Status after both confirmed, while the keys travel over.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetching keys…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取回密钥…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在取回金鑰…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を取得しています…"
          }
        }
      }
    },
    "verification.requested": {
      "comment": "Status while waiting for the other device to accept the request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your other device to accept…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一台设备接受…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一部裝置接受…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスの承認を待っています…"
          }
        }
      }
    },
    "verification.retry": {
      "comment": "Button that starts the verification again after it was cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開始"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        }
      }
    },
    "verification.title": {
      "comment": "Title of the device verification dialog and screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Verification"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの確認"
          }
        }
      }
    },
    "verification.useRecoveryKey": {
      "comment": "Button that switches to entering the recovery key instead of verifying.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter Recovery Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入恢复密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入復原金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを入力"
          }
        }
      }
    },
    "verification.verifyWithOtherDevice": {
      "comment": "Choice on the backup screen: let another device confirm this one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify with Another Device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用另一台设备确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用另一部裝置確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで確認"
          }
        }
      }
    },
    "verification.waitingForOther": {
      "comment": "Status while this device already confirmed and waits for the other one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your other device to confirm…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一台设备确认…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待另一部裝置確認…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスの確認を待っています…"
          }
        }
      }
    }
  }
}
