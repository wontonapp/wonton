{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "botProfile.web.title": {
      "comment": "Section title for the webpage belonging to a Bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Bot webpage"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "Bot 网页"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "Bot 網頁"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Bot のウェブページ"}}
      }
    },
    "botProfile.web.permissionDenied": {
      "comment": "The current identity is not allowed to open a Bot webpage.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This identity is not allowed to open Bot webpages."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此身份无权打开 Bot 网页。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此身分無權開啟 Bot 網頁。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "このユーザーは Bot のウェブページを開くことができません。"}}
      }
    },
    "botProfile.web.notFound": {
      "comment": "The Bot webpage or Bot no longer exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Bot no longer exists."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此 Bot 已不存在。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此 Bot 已不存在。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Bot は存在しません。"}}
      }
    },
    "botProfile.web.unknown": {
      "comment": "The Bot webpage availability is not known, so it cannot be opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This Bot’s webpage availability is unknown. No webpage can be opened."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确定此 Bot 的网页是否可用，不能打开网页。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法確定此 Bot 的網頁是否可用，不能開啟網頁。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "この Bot のウェブページが利用可能か不明なため、開くことはできません。"}}
      }
    },
    "botProfile.web.disclosure.message": {
      "comment": "Disclosure that the server owner can manage the webpage login state.",
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The server owner can view and manage the login state here."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "服务器主人可以查看、管理这里的登录状态。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "伺服器主人可以查看、管理這裡的登入狀態。"}},
        "ja": {"stringUnit": {"state": "translated", "value": "サーバーの所有者は、ここでのログイン状態を確認・管理できます。"}}
      }
    },
    "botProfile.name.hint": {
      "comment": "Accessibility hint on the Bot's name in the profile section: activating it starts editing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits the name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更名字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更します"
          }
        }
      }
    },
    "botProfile.pick.add": {
      "comment": "Text inside an empty state-avatar cell.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "botProfile.pick.remove": {
      "comment": "Button or action that clears an avatar (the static one, or one status's).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "botProfile.pick.useVideo": {
      "comment": "Shown when an animated image doesn't fit the limits and a video would. Argument: the maximum duration, already formatted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a video of %@ or less instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成不超过%@的视频试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成不超過%@的影片試試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@以内の動画にしてみてください。"
          }
        }
      }
    },
    "botProfile.problem.media.other": {
      "comment": "The file was rejected for an unrecognized reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file won't work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件不行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案不行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは使用できません"
          }
        }
      }
    },
    "botProfile.problem.media.tooBig": {
      "comment": "The photo's dimensions are over the limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is too large"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片尺寸太大了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片尺寸太大了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像のサイズが大きすぎます"
          }
        }
      }
    },
    "botProfile.problem.media.tooLarge": {
      "comment": "The file is over the size limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file is too large"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件太大了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案太大了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは大きすぎます"
          }
        }
      }
    },
    "botProfile.problem.media.tooLong": {
      "comment": "The animation or video is over the duration limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video is too long"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频太长了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片太長了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画が長すぎます"
          }
        }
      }
    },
    "botProfile.problem.name.controlCharacters": {
      "comment": "The server rejected the name because it has line breaks or control characters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name has characters that aren't allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字里有不能用的字符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字裡有不能用的字元"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に使えない文字が含まれています"
          }
        }
      }
    },
    "botProfile.problem.name.reserved": {
      "comment": "Bots can't be named like the core account or the owner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is taken by Wonton or by you. Pick a different one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个名字和云吞或你的名字一样了，换一个吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個名字和雲吞或你的名字一樣了，換一個吧。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前はWontonやあなたの名前と重複しています。別の名前にしてください。"
          }
        }
      }
    },
    "botProfile.problem.name.tooLong": {
      "comment": "The server rejected the name because it is longer than the limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name is too long"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字太长了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字太長了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前が長すぎます"
          }
        }
      }
    },
    "botProfile.problem.other.title": {
      "comment": "Saving the profile failed for an unrecognized reason; the technical detail is in Details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the changes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料没有存上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料沒有存上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした"
          }
        }
      }
    }
  }
}
