{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "takeover.end": {
      "comment": "Button that hands control of the plugin page back to the bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return Control"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交还"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交還"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を返す"
          }
        }
      }
    },
    "takeover.start": {
      "comment": "Button that takes control of the plugin page from the bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take Control"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我来操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我來操作"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で操作"
          }
        }
      }
    },
    "takeover.dismiss": {
      "comment": "Button that closes the takeover notice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got It"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解"
          }
        }
      }
    },
    "takeover.failed.title": {
      "comment": "Notice title when control couldn't be taken. Argument: the core's problem title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't take control: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有开始操作：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開始操作：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を開始できませんでした：%@"
          }
        }
      }
    },
    "takeover.lost.transport": {
      "comment": "Notice title when control ended because the connection dropped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control returned. The connection dropped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已交还，连接断了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已交還，連線中斷了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を返しました。接続が切れました。"
          }
        }
      }
    },
    "takeover.lost.title": {
      "comment": "Notice title when control ended for another reason. Argument: the core's problem title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control returned: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已交还：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已交還：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を返しました：%@"
          }
        }
      }
    }
  }
}
