{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "toolPolicy.allowAll.risk": {
      "comment": "Warning under the allow-all switches.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot can use every app's tools without asking, including apps installed later. A prompt injection could make it change data, delete things, or send content out without your approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Bot 用所有插件的工具都不再问，以后装的也算。提示注入能让它不经确认改数据、删东西、往外发内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Bot 用所有 App 的工具都不再問，以後裝的也算。提示注入能讓它不經確認改資料、刪東西、往外發內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットは、すべてのアプリのツールを確認なしで使えます。あとからインストールしたアプリも含まれます。プロンプトインジェクションによって、確認なしでデータの変更や削除、外部への送信が行われるおそれがあります。"
          }
        }
      }
    },
    "toolPolicy.allowAll.title": {
      "comment": "Section title for bots that may use every app's tools without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow (All Apps)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一律允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に許可（すべてのアプリ）"
          }
        }
      }
    },
    "toolPolicy.always.risk": {
      "comment": "Warning under the Always Allow switches.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot can use this app's tools without asking, including tools that change data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Bot 用这个插件的工具不再问，包括会改数据的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Bot 用這個 App 的工具不再問，包括會改資料的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットは、このアプリのツールを確認なしで使えます。データを変更するツールも含まれます。"
          }
        }
      }
    },
    "toolPolicy.always.title": {
      "comment": "Section title for bots that may use this app's tools without asking; also in the install preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Allow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に許可"
          }
        }
      }
    },
    "toolPolicy.readOnlyHint": {
      "comment": "Explanation shown when the tool list is expanded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools switched on here count as read-only. Every bot can call them without asking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开的工具算只读，所有 Bot 调它都不再问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟的工具算唯讀，所有 Bot 呼叫它都不再問"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしたツールは読み取り専用として扱われ、すべてのボットが確認なしで呼び出せます"
          }
        }
      }
    },
    "toolPolicy.readOnlyTag": {
      "comment": "Caption in place of the switch for tools the app itself marks read-only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用"
          }
        }
      }
    },
    "toolPolicy.stop": {
      "comment": "Button that ends a bot's open time window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "toolPolicy.tools.title": {
      "comment": "Collapsible section title for the app's tools.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール"
          }
        }
      }
    },
    "toolPolicy.unreadable.next": {
      "comment": "Next step under that problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every tool call will ask you, and these settings can't be changed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在每次调用都会问你，这里也改不了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在每次呼叫都會問你，這裡也改不了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在は毎回確認を求められ、ここでは変更できません。"
          }
        }
      }
    },
    "toolPolicy.unreadable.title": {
      "comment": "Problem title when the tool policy can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't load these settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放宽的设置读不出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放寬的設定讀不出來"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込めません"
          }
        }
      }
    },
    "toolPolicy.windowUntil": {
      "comment": "Row for an open time window. Arguments: the bot's name, the time it ends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ allowed until %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 放行到 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 允許至 %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@まで許可"
          }
        }
      }
    },
    "toolPolicy.windows.title": {
      "comment": "Section title for the time windows during which a bot may act without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed for Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放行中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的に許可"
          }
        }
      }
    }
  }
}
