{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "connection.udp.flow.dropped": {
      "comment": "Connection-level datagrams evicted by a full send buffer. Argument is the localized unsigned 64-bit count; shown only when known and greater than zero.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send-buffer drops: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送缓冲满时丢弃 %@ 个数据报"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送緩衝區滿時丟棄 %@ 個資料報"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信バッファが満杯で%@件のデータグラムを破棄"
          }
        }
      }
    },
    "connection.addressesStale": {
      "comment": "Connection details row: the stored server address may be out of date; the app keeps fetching it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's address may be out of date; it will be fetched again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的地址可能已经过时，会自动再取"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器的位址可能已經過時，會自動再取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバのアドレスが古い可能性があります。自動で取り直します"
          }
        }
      }
    },
    "connection.notPaired": {
      "comment": "Connection state before this phone is paired.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not paired"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ペアリング"
          }
        }
      }
    },
    "connection.notice.waitingForNetwork": {
      "comment": "Short connection status: the phone has no network yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for network…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待网络…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待網路…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを待っています…"
          }
        }
      }
    },
    "connection.notice.updating": {
      "comment": "Short connection status while the server updates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートしています…"
          }
        }
      }
    },
    "connection.notice.unreachable": {
      "comment": "Status when the home server can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続できません"
          }
        }
      }
    },
    "connection.notice.poorRelay": {
      "comment": "Short status when connected but the recent connection quality is poor and traffic goes through a relay. One complete sentence, not assembled from parts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poor connection, going through a relay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络较差，正在经中转连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路較差，正在經中繼連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー経由のため通信が不安定です"
          }
        }
      }
    },
    "connection.viewConnection": {
      "comment": "Button next to a connection problem: open the connection page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を表示"
          }
        }
      }
    },
    "connection.detail.latency": {
      "comment": "Row in the connection details page: round-trip time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latency"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "延迟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "延遲"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遅延"
          }
        }
      }
    },
    "connection.detail.lastHandshake": {
      "comment": "Row in the connection details page: time of the last handshake in milliseconds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Handshake"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次握手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次交握"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のハンドシェイク"
          }
        }
      }
    },
    "connection.detail.disconnects": {
      "comment": "Row in the connection details page: how often the tunnel dropped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnects"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开次数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷次數"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切断回数"
          }
        }
      }
    },
    "connection.check.ok": {
      "comment": "Device network check result that matches the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正常"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正常"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正常"
          }
        }
      }
    }
  }
}
