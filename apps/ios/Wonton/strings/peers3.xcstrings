{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "peers.title": {
      "comment": "Title of the Other Servers page and the settings row that opens it: servers this server is paired with for cross-server chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other Servers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバ"
          }
        }
      }
    },
    "peers.requests": {
      "comment": "Section header above the pending pairing requests on the Other Servers page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエスト"
          }
        }
      }
    },
    "peers.approve": {
      "comment": "Button on a pending pairing request: accept it and pair with that server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同意"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認"
          }
        }
      }
    },
    "peers.rejected": {
      "comment": "Section header (collapsed by default) for requests the owner declined and can undo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否済み"
          }
        }
      }
    },
    "peers.status.declined": {
      "comment": "Status line of a paired server row: they declined this server’s pairing request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They declined"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方拒绝了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方拒絕了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が拒否しました"
          }
        }
      }
    },
    "peers.add": {
      "comment": "Accessibility label of the add button (a plus icon) at the top right of the Other Servers page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "peers.status.unknown": {
      "comment": "Status line of a row whose status this App version doesn't know (a newer server reported something new).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态未知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態未知"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態不明"
          }
        }
      }
    },
    "peers.camera.waiting": {
      "comment": "Shown on the scanner page while waiting for the user to answer the camera permission dialog.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for camera access…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待相机权限…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待相機權限…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの権限を待っています…"
          }
        }
      }
    },
    "peers.camera.reopen": {
      "comment": "Button under a notice that says scanning stopped mid-way: try starting the camera again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Camera Back On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开相机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟相機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを再度オンにする"
          }
        }
      }
    },
    "peers.status.publicAccessOff": {
      "comment": "Status line of a paired server row: our own public access switch is off, so other servers can't reach us until it is back on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public access is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公网访问已关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公網訪問已關"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部からのアクセスはオフです"
          }
        }
      }
    }
  }
}
