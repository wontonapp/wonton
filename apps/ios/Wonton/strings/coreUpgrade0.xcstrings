{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "coreUpgrade.canceled": {
      "comment": "Stage line after the owner cancelled the update.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update canceled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートをキャンセルしました"
          }
        }
      }
    },
    "coreUpgrade.check.checking": {
      "comment": "Channel state while the check is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking for a new version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查新版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンを確認中"
          }
        }
      }
    },
    "coreUpgrade.check.other": {
      "comment": "Channel state: the home server reported something this app doesn't understand.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server reported a status Wonton doesn't recognize. Update Wonton and check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器给了这个 App 不认识的状态，更新 App 后再看"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器回報了雲吞不認得的狀態，請更新雲吞後再檢查"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバからWontonが認識できない状態が返されました。Wontonをアップデートしてから確認してください"
          }
        }
      }
    },
    "coreUpgrade.check.pinned": {
      "comment": "Channel state: this installation is pinned to one version and doesn't follow the channel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This installation is pinned to one version and doesn't follow the channel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次安装固定在一个版本上，不跟渠道"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次安裝固定在某個版本，不會隨版本類型更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールは特定のバージョンに固定されているため、アップデートチャンネルに従いません"
          }
        }
      }
    },
    "coreUpgrade.checkAgain": {
      "comment": "Secondary button when the update's outcome is unknown: ask the home server again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再查一次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度確認"
          }
        }
      }
    },
    "coreUpgrade.checkForUpdate": {
      "comment": "Button on the update page that checks the channel for a new version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for Updates"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認"
          }
        }
      }
    },
    "coreUpgrade.compat.notChecked": {
      "comment": "Light notice on the update offer: it couldn't check which installed apps would be affected. Tapping checks again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check which apps would be affected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没查到哪些应用会受影响"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒查到哪些應用會受影響"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリが影響を受けるか確認できませんでした"
          }
        }
      }
    },
    "coreUpgrade.completedTo": {
      "comment": "Stage line after the update finished. Argument: the version now running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated to %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已升级到 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新到 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にアップデートしました"
          }
        }
      }
    },
    "coreUpgrade.confirmUpgrade": {
      "comment": "Primary button in the confirm step: start the update.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート"
          }
        }
      }
    },
    "coreUpgrade.declineUpgrade": {
      "comment": "Secondary button in the confirm step: don't update now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再說"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        }
      }
    },
    "coreUpgrade.detail.channel": {
      "comment": "Collapsed details row: the update channel's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渠道"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本類型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートチャンネル"
          }
        }
      }
    },
    "coreUpgrade.failedNoChanges": {
      "comment": "Stage line after the update failed early, before anything was changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update didn't finish. Nothing was changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没升级成，什么都没动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新沒有完成，沒有做任何變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートは失敗しました。何も変更されていません"
          }
        }
      }
    },
    "coreUpgrade.newVersion": {
      "comment": "Heading of the offer card while the new version is shown for review. Argument: the new version, like 1.2.3 or a short digest.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New version %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョン%1$@"
          }
        }
      }
    },
    "coreUpgrade.phase.observing": {
      "comment": "Update phase: watching the new version for a few minutes to make sure it is healthy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking that the new version is stable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察新版本是否稳定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認新版本是否穩定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの安定性を確認中"
          }
        }
      }
    },
    "coreUpgrade.phase.other": {
      "comment": "Update phase for a step this app doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處理中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中"
          }
        }
      }
    },
    "coreUpgrade.phase.starting": {
      "comment": "Update phase: waiting for the new core to start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the new version to start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等新版本启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等新版本啟動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの起動を待っています"
          }
        }
      }
    },
    "coreUpgrade.reconnecting": {
      "comment": "Detail under the updating stage line: the app lost its connection and is reconnecting.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时连不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時連不上家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、自宅サーバに接続できません"
          }
        }
      }
    },
    "coreUpgrade.upgrading": {
      "comment": "Stage line while the update runs and the target version is unknown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート中"
          }
        }
      }
    },
    "coreUpgrade.upgradingTo": {
      "comment": "Stage line while the update runs. Argument: the target version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating to %1$@…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在升级到 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新到 %1$@…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にアップデート中"
          }
        }
      }
    }
  }
}
