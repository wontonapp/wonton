{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "problem.forbidden.nextStep": {
      "comment": "Next step under the refused problem: the sign-in is fine; the server refused this one action.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're still signed in. You may not have permission for this, they may have blocked you, or their server can't reach yours yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录没有问题。可能是没有权限、对方屏蔽了你，或者对方的服务器还不能和家里的服务器互通。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入沒有問題。可能是沒有權限、對方封鎖了你，或者對方的伺服器還不能和家用伺服器互通。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインは有効です。権限がないか、相手にブロックされているか、相手のサーバがまだ自宅サーバとつながっていない可能性があります。"
          }
        }
      }
    },
    "problem.forbidden.title": {
      "comment": "Problem title: the server refused an action although this device is still signed in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was refused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求被拒绝了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求被拒絕了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが拒否されました"
          }
        }
      }
    },
    "problem.invalidInput.nextStep": {
      "comment": "Next step under the invalid-input problem; the core's own reason goes into Details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the input and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查输入后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查輸入後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を確認して、もう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.changed.title": {
      "comment": "Problem title: the app changed after the owner approved the install.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app changed after you approved it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用在确认之后变了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 在你確認後有變動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは確認後に変更されました"
          }
        }
      }
    },
    "problem.plugin.conflict.nextStep": {
      "comment": "Next step: the app is installed or installing, updating or uninstalling; wait for that to finish.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's already installed, or installing, updating or uninstalling. Wait for that to finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已经装了，或者正在安装、升级、卸载，等那边做完。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它已經安裝了，或正在安裝、更新、解除安裝，請等它完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みか、インストール・アップデート・アンインストールの途中です。終わるまでお待ちください。"
          }
        }
      }
    },
    "problem.plugin.coreUpgrading.title": {
      "comment": "Problem title: the home server is updating itself right now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server is updating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器正在升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器正在更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバはアップデート中です"
          }
        }
      }
    },
    "problem.plugin.deviceUnavailable.nextStep": {
      "comment": "Next step: look at the devices again and choose one that's available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your devices and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查看设备后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查看裝置後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを確認してからもう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.egressProxyUnavailable.title": {
      "comment": "Problem title: the internet proxy is not working.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proxy is broken"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理用不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理用不了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロキシが使えません"
          }
        }
      }
    },
    "problem.plugin.invalid.nextStep": {
      "comment": "Next step: read the reason in Details; a key the app must write being missing needs the app's author.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See Details for the reason; if the reason is a key the app must write being missing, contact the app's author."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看「详情」里的原因；如果缺的是应用要写的密钥，联系应用的作者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看「詳細資訊」裡的原因；如果缺的是 App 要寫的密鑰，聯絡 App 的作者。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「詳細」に理由が出ます。アプリが書くべき鍵が無い場合は、アプリの作者に連絡してください。"
          }
        }
      }
    },
    "problem.plugin.serverTooOld.title": {
      "comment": "Problem title: the home server is older than this app needs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server is too old"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器版本太旧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器版本太舊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバのバージョンが古すぎます"
          }
        }
      }
    },
    "problem.storage.title": {
      "comment": "Problem title: this device failed to read or write its own data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device couldn't read or write its data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备读写数据出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置讀寫資料時出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでデータの読み書きに失敗しました"
          }
        }
      }
    },
    "problem.store.indexTooNew.title": {
      "comment": "Problem title: the store's index is newer than the home server understands.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app list is newer than your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用列表比家里的服务器新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 清單比家用伺服器新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの一覧が自宅サーバより新しくなっています"
          }
        }
      }
    },
    "problem.store.unreachable.title": {
      "comment": "Problem title shown above the store list: the app's source can't be reached, the list may be stale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the app's source. The list may be out of date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上应用的来源，列表可能不是最新的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上 App 的來源，清單可能不是最新的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの提供元に接続できません。一覧が最新でない可能性があります"
          }
        }
      }
    },
    "problem.store.upstream.title": {
      "comment": "Problem title: the app's source itself reported a problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's source ran into a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的来源出了问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 的來源出了問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの提供元で問題が発生しました"
          }
        }
      }
    },
    "problem.transportUnavailable.nextStep": {
      "comment": "Next step under the can't-reach-the-server problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your network and try again once you're connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查网络，连上后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查網路，連上後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを確認して、接続後にもう一度お試しください。"
          }
        }
      }
    },
    "problem.unauthorized.title": {
      "comment": "Problem title: the home server no longer accepts this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server doesn't recognize this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器不认这台设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器不認得這台裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバがこのデバイスを認識していません"
          }
        }
      }
    },
    "problem.pagesRead.title": {
      "comment": "Page settings could not be read from this device.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn't read page settings on this device" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这台设备读不了页面设置" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "這台裝置無法讀取頁面設定" } },
        "ja": { "stringUnit": { "state": "translated", "value": "このデバイスのページ設定を読み込めません" } }
      }
    },
    "problem.pagesAction.nextStep": {
      "comment": "Next step when a page operation is invalid or its target is missing.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check Details and try the action again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "请查看详情后重新操作。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請查看詳細資訊後再重新操作。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "詳細を確認してから、もう一度操作してください。" } }
      }
    },
    "problem.pagesResponse.title": {
      "comment": "Page data returned by the home server cannot be parsed.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The page data from your home server couldn't be understood" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "家里服务器返回的页面数据无法识别" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法識別家用伺服器傳回的頁面資料" } },
        "ja": { "stringUnit": { "state": "translated", "value": "自宅サーバからのページデータを認識できません" } }
      }
    },
    "problem.pagesResponse.nextStep": {
      "comment": "Next step for an invalid response when reading bot-pinned pages.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Wonton will try again. If the problem continues, check Details." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "稍后会自动重试；如果还是不行，请查看详情。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "稍後會自動重試；如果問題持續，請查看詳細資訊。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "自動的に再試行します。問題が続く場合は詳細を確認してください。" } }
      }
    },
    "problem.pagesProtocol.title": {
      "comment": "Communication with the home server encountered a protocol error.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "There was a problem communicating with your home server" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "与家里的服务器通信时出了问题" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "與家用伺服器通訊時發生問題" } },
        "ja": { "stringUnit": { "state": "translated", "value": "自宅サーバとの通信でエラーが発生しました" } }
      }
    },
    "problem.pagesProtocol.nextStep": {
      "comment": "Next step for a tunnel protocol error during a page operation.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check for app and server updates. If the problem continues, check Details." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "检查 App 和服务器是否有更新；如果还是不行，请查看详情。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "請檢查雲吞和伺服器是否有更新；如果問題持續，請查看詳細資訊。" } },
        "ja": { "stringUnit": { "state": "translated", "value": "アプリとサーバの更新を確認し、問題が続く場合は詳細を確認してください。" } }
      }
    },
    "problem.serverNotPaired.nextStep": {
      "comment": "What to do when the other server isn't paired: pair it first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair it under Other servers, then open the chat again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在“其他服务器”里配对，再打开聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在「其他伺服器」裡配對，再打開聊天。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「他のサーバー」でペアリングしてから、チャットを開いてください。"
          }
        }
      }
    },
    "problem.peerPublicAccessOff.title": {
      "comment": "Problem title when a chat can't start because the other server turned its public access off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other server's public access is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方服务器的公网访问已关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方伺服器的公網訪問已關"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のサーバーは外部からのアクセスがオフです"
          }
        }
      }
    }
  }
}
