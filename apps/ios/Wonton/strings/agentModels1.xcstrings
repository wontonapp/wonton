{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "agentModels.test.run": {
      "comment": "Button: send a short real request to check the current model works.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测一下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測一下"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト"
          }
        }
      }
    },
    "agentModels.test.note": {
      "comment": "Caption under the Test button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Testing sends one short real request. The provider may charge for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试会发一条很短的真实请求，服务商可能计费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試會送出一則很短的真實請求，服務商可能計費。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストでは短い実際のリクエストを 1 回送信します。料金がかかる場合があります。"
          }
        }
      }
    },
    "agentModels.test.rejected": {
      "comment": "Test result: the provider refused the key or sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the key or sign-in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商不认这份 key 或登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商不接受這份 key 或登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーがキーまたはサインインを拒否しました"
          }
        }
      }
    },
    "agentModels.test.upstream": {
      "comment": "Test result: the provider returned an error (quota, missing model…).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider returned an error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーでエラーが発生しました"
          }
        }
      }
    },
    "agentModels.test.noModel": {
      "comment": "Test result: no model has been chosen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model chosen yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没选模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒選模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが選択されていません"
          }
        }
      }
    },
    "agentModels.providers.search": {
      "comment": "Search field placeholder above the provider list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search providers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索服务商"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋服務商"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーを検索"
          }
        }
      }
    },
    "agentModels.providers.noMatch": {
      "comment": "Shown when the search matches no provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching providers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到服务商"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到服務商"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当するプロバイダーがありません"
          }
        }
      }
    },
    "agentModels.provider.disconnect": {
      "comment": "Button: remove this provider's key or sign-in from the Bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斷開"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続解除"
          }
        }
      }
    },
    "agentModels.login.code.hint": {
      "comment": "Under the large device code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code on the sign-in page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录页输入这个码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在登入頁輸入這組代碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインページでこのコードを入力してください。"
          }
        }
      }
    },
    "agentModels.login.code.copyOpen": {
      "comment": "Button: copy the device code and open the provider's sign-in page in the in-app browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Code and Open Sign-In Page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制并打开登录页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製並開啟登入頁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしてサインインページを開く"
          }
        }
      }
    },
    "agentModels.login.expired": {
      "comment": "Sign-in outcome: took too long.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in timed out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录超时了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入逾時了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインがタイムアウトしました"
          }
        }
      }
    },
    "agentModels.key.rejected": {
      "comment": "The provider refused the key when saving.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected this key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商不认这把 key"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商不接受這把 key"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーがこのキーを拒否しました"
          }
        }
      }
    },
    "agentModels.key.rejected.next": {
      "comment": "What to do after a rejected key.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It wasn't saved. Check that you copied all of it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有保存。看看是不是没复制完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有儲存。看看是不是沒有複製完整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていません。キー全体をコピーしたか確認してください。"
          }
        }
      }
    },
    "agentModels.problem.notInstalled": {
      "comment": "Error: the Agent plugin or this Bot is gone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This assistant isn't installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个助手没有装好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個助手沒有裝好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントはインストールされていません"
          }
        }
      }
    },
    "agentModels.problem.unsupported": {
      "comment": "Error: this Agent plugin has no in-app model setup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This assistant can't set up models in the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个助手不能在 App 里接模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個助手不能在 App 裡接模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントはアプリ内でモデルを設定できません"
          }
        }
      }
    },
    "agentModels.problem.invalidInput": {
      "comment": "Error: what was typed isn't acceptable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look right"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填的内容不对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填的內容不對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容が正しくありません"
          }
        }
      }
    },
    "agentModels.problem.other": {
      "comment": "Error of a kind this app version doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没做成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有成功"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした"
          }
        }
      }
    }
  }
}
