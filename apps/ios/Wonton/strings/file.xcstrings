{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "file.bookmarkUnreadable": {
      "comment": "Reason in the collapsed details of an upload problem: the file's saved bookmark can't be read again. iOS only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't read the file's bookmark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书签读不懂"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "書籤讀不懂"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークを読み取れません"
          }
        }
      }
    },
    "file.downloadAndOpen": {
      "comment": "Button in the video player's failure view: download the file, then open it in another app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and Open in Another App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载后用其他 App 打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載後用其他 App 開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしてほかのアプリで開く"
          }
        }
      }
    },
    "file.noAppOpensIt": {
      "comment": "Title of the problem shown when no installed app can open a downloaded file. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app on this phone can open this file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机上没有能打开这个文件的 App"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機上沒有 App 可以開啟這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを開けるアプリがありません"
          }
        }
      }
    },
    "file.openElsewhere": {
      "comment": "Link under a file card: open the downloaded file with another app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Another App"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他 App 打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用其他 App 開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリで開く"
          }
        }
      }
    },
    "file.openFailed": {
      "comment": "Title of the problem shown when a picked file can't be reopened for uploading. Argument: the system's reason. iOS only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open that file: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选的文件打不开：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選的檔案打不開：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルを開けません：%1$@"
          }
        }
      }
    },
    "file.paused": {
      "comment": "Line under a file card while its download is paused. Argument: the home server's reason, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止：%1$@"
          }
        }
      }
    },
    "file.pausedWaiting": {
      "comment": "Line under a file card while its download is paused without a reason: it resumes when the connection recovers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes downloading when the connection is back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等连接恢复后接着下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等連線恢復後接著下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の回復後にダウンロードを再開"
          }
        }
      }
    },
    "file.playbackUnsupported": {
      "comment": "Title of the video player's failure view, above the home server's reason. iOS only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't Play This File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法播放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生できません"
          }
        }
      }
    },
    "file.sourceBot": {
      "comment": "Caption under a file card: which bot sent the file. First argument: the bot's name; second: the plugin's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From %1$@ (%2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %1$@（%2$@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %1$@（%2$@）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）から"
          }
        }
      }
    },
    "file.sourceUnknown": {
      "comment": "Caption under a file card: the sender is unknown.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源不明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源不明"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元不明"
          }
        }
      }
    },
    "file.systemNoFile": {
      "comment": "Reason in the collapsed details of an upload problem: the system didn't provide the picked file. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system didn't provide this file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有给出这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統沒有給出這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがこのファイルを提供しませんでした"
          }
        }
      }
    },
    "file.systemNoRead": {
      "comment": "Reason in the collapsed details of an upload problem: the system refused to let the App read the file. iOS only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system didn't let Wonton read this file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有让 App 读这个文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統沒有讓 App 讀這個檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがこのファイルの読み取りを許可しませんでした"
          }
        }
      }
    },
    "file.unnamed": {
      "comment": "Fallback name for an uploaded file when the system doesn't provide one. Shown as the file's name. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル"
          }
        }
      }
    }
  }
}
