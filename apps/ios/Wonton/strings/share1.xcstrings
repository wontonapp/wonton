{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "share.acknowledge": {
      "comment": "Explicit acknowledgement of the warning about sharing an app without declared friend support. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand and accept this risk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解并接受此风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我瞭解並接受此風險"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリスクを理解し、同意します"
          }
        }
      }
    },
    "share.empty": {
      "comment": "Empty state when no friends or groups can be selected for sharing. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No friends or groups available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可选的好友或分组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可選的好友或群組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択できる友だち・グループがありません"
          }
        }
      }
    },
    "share.expires": {
      "comment": "Label of the share expiration picker. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期時間"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効期限"
          }
        }
      }
    },
    "share.identity.discovery": {
      "comment": "Identity verification detail when secure discovery of the identity server failed. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity server could not be discovered securely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全发现身份服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全探索身分伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証サーバーを安全に検出できませんでした。"
          }
        }
      }
    },
    "share.identity.invalid": {
      "comment": "Identity verification detail for an invalid OpenID identity token. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity token is invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份令牌无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分權杖無效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証トークンが無効です。"
          }
        }
      }
    },
    "share.identity.other": {
      "comment": "Identity verification detail for an unrecognized failure category. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity verification failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分驗證失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認に失敗しました。"
          }
        }
      }
    },
    "share.problem.plugin": {
      "comment": "Shared app problem when the app is not running; recipients cannot start it. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个应用未在运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個應用程式未在執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは停止しています"
          }
        }
      }
    },
    "share.received": {
      "comment": "Apps page section title for apps shared by other people. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared with me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别人分享给我的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別人分享給我的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分と共有されたアプリ"
          }
        }
      }
    },
    "share.recipient": {
      "comment": "Label of the friend or group picker for an app share. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friend or group"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友或分组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好友或群組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だち・グループ"
          }
        }
      }
    },
    "share.refresh": {
      "comment": "Button or accessibility label that refreshes apps shared by friends. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh shares"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を更新"
          }
        }
      }
    },
    "share.save": {
      "comment": "Button that saves a new or edited app share. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を保存"
          }
        }
      }
    },
    "share.title": {
      "comment": "Plugin detail section and share management page title. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享给好友"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享給好友"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちと共有"
          }
        }
      }
    },
    "share.today": {
      "comment": "Expiration choice that grants access until the end of today. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日中"
          }
        }
      }
    }
  }
}
