{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "agentRun.waiting": {
      "comment": "Status line while the bot waits for the owner to answer its confirmation card. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ち"
          }
        }
      }
    },
    "agentRun.steps": {
      "comment": "Small summary line under a finished run; tapping it shows the bot's own summary. Argument: how many steps it took.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld step"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld steps"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 步"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ステップ"
          }
        }
      }
    },
    "agentRun.cancelled": {
      "comment": "Status line when the owner interrupted the run. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打断了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被打斷了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断しました"
          }
        }
      }
    },
    "agentRun.uncertain": {
      "comment": "Status line when the core cannot tell how the run ended, or the bot is offline mid-run. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result uncertain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は不明です"
          }
        }
      }
    },
    "agentRun.asking": {
      "comment": "Source line above the bot's own choices. Argument: the bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is asking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在問"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が質問しています"
          }
        }
      }
    }
  }
}
