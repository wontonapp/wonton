{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "agentRun.waiting": {
      "comment": "Status line while the bot waits for the owner to answer its confirmation card. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ち"
          }
        }
      }
    },
    "agentRun.done": {
      "comment": "Status line when a run finished; only when the bot gave no step count. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "agentRun.doneSteps": {
      "comment": "Status line when a run finished. Argument: how many steps it took.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ steps · done"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld step · done"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld steps · done"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ 步 · 完成"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 步 · 完成"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ 步 · 完成"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 步 · 完成"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ ステップ · 完了"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld ステップ · 完了"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "agentRun.cancelled": {
      "comment": "Status line when the owner interrupted the run. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打断了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被打斷了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断しました"
          }
        }
      }
    },
    "agentRun.uncertain": {
      "comment": "Status line when the core cannot tell how the run ended, or the bot is offline mid-run. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result uncertain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は不明です"
          }
        }
      }
    },
    "agentRun.asking": {
      "comment": "Source line above the bot's own choices. Argument: the bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is asking"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在問"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が質問しています"
          }
        }
      }
    }
  }
}
