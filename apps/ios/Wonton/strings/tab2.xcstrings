{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "tab.pinToBar": {
      "comment": "Small button on an approval request card: put the installed app's page into the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin to Tab Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放到底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放到標籤列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに追加"
          }
        }
      }
    },
    "tab.chat": {
      "comment": "Tab bar entry with the chat list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット"
          }
        }
      }
    },
    "tab.settings": {
      "comment": "Tab bar entry with the settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "tab.bottomPanel": {
      "comment": "Title of the settings page that edits the tab bar and the main chat panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab Bar and Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底栏和面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列和面板"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーとパネル"
          }
        }
      }
    },
    "tab.showLabels": {
      "comment": "Tab settings switch: show the page names under the icons.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Labels"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルを表示"
          }
        }
      }
    },
    "tab.replace": {
      "comment": "Title of the picker shown when the tab bar is full. Asks which tab to replace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab Bar Full. Replace Which Tab?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底栏已满，换掉哪一项？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列已滿，要換掉哪一項？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーがいっぱいです。どのタブを置き換えますか？"
          }
        }
      }
    },
    "tab.fullscreen": {
      "comment": "Menu item that opens the page fullscreen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Full Screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面で開く"
          }
        }
      }
    },
    "tab.more": {
      "comment": "Accessibility label of the button with the additional page actions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        }
      }
    },
    "tab.upgrading": {
      "comment": "Caption while the app behind the page is updated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在更新…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートしています…"
          }
        }
      }
    },
    "tab.pageRemoved": {
      "comment": "Failure title when the new version of the app dropped this page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page is no longer available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本不再提供这个页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本不再提供這個頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは新バージョンで提供されなくなりました"
          }
        }
      }
    },
    "tab.stateUnknown": {
      "comment": "Failure title when the app's status can't be determined.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app's status is unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认应用的状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認 App 的狀態"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの状態を確認できません"
          }
        }
      }
    },
    "tab.start": {
      "comment": "Button on a stopped page that starts the app again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動"
          }
        }
      }
    },
    "tab.uninstalled": {
      "comment": "Failure title for an app that was uninstalled and dropped from the tab bar. Argument: the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was uninstalled and removed from the tab bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已卸载，已从底栏移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已解除安裝，已從標籤列移除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はアンインストールされ、タブバーから削除されました"
          }
        }
      }
    },
    "tab.failure.pluginNotReady": {
      "comment": "Load failure label when the app behind the page isn't ready.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app isn't ready yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用还没准备好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 還沒準備好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの準備ができていません"
          }
        }
      }
    }
  }
}
