    "onboarding.step.finished": {
      "comment": "Card title after setup finished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished"
          }
        },
        "zh-Hans": {
          "stringUnit": {
