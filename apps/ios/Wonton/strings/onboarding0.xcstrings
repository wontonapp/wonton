            "value": "模型名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル名"
          }
        }
      }
    },
    "onboarding.pendingCard.many": {
      "comment": "Banner when several approval cards are waiting. The argument is the number of cards.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@cards@"
          },
          "substitutions": {
            "cards": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld card needs your approval"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld cards need your approval"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@cards@"
          },
          "substitutions": {
            "cards": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 张卡片等你确认"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@cards@"
          },
          "substitutions": {
            "cards": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 張卡片等你確認"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@cards@"
          },
          "substitutions": {
            "cards": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "確認待ちのカードが%lld枚あります"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "onboarding.problem.model.gatewayNotReady": {
      "comment": "Problem title in setup: the model gateway on the home server isn't ready.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model gateway isn't ready yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型网关还没准备好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型閘道還沒準備好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルゲートウェイの準備がまだできていません"
          }
        }
      }
    },
    "onboarding.problem.model.gatewayNotReady.next": {
      "comment": "Line under the problem title: the gateway may need time or the step can be skipped.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again later, or skip this step for now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后重试，也可以先跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再試，也可以先跳過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後でもう一度試すか、先にスキップしてください。"
          }
        }
      }
    },
    "onboarding.problem.model.providerUnreachable": {
      "comment": "Problem title in setup: the provider's address can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the provider"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务商"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上供應商"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダに接続できません"
          }
        }
      }
    },
    "onboarding.problem.model.upstream.next": {
      "comment": "Line under the problem title: the server may recover by itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてから再試行してください。"
          }
        }
      }
    },
    "onboarding.problem.store.incomplete": {
      "comment": "Problem title in setup: some recommendations didn't load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some recommended apps didn't load"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分推荐应用没加载出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分推薦 App 沒載入出來"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のおすすめアプリを読み込めませんでした"
          }
        }
      }
    },
    "onboarding.problem.store.indexTooNew": {
      "comment": "Problem title in setup: the recommendation list needs a newer home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recommendations need a newer home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐清单需要更新的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推薦清單需要更新的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの表示には新しい自宅サーバが必要です"
          }
        }
      }
    },
    "onboarding.problem.store.next": {
      "comment": "Line under a recommendation problem: the apps step can be skipped and redone in the Store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this and install apps from the Store later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以跳过，之后在应用商店安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以跳過，之後在商店安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップして、後でストアからインストールできます。"
          }
        }
      }
    },
