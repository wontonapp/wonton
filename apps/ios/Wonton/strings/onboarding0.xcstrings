          }
        }
      }
    },
    "onboarding.model.form.modelName": {
      "comment": "Label of the field for the model's name (like gpt-4o).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型名"
          }
        },
        "zh-Hant": {
