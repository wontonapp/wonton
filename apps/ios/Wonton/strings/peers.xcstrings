            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "camera.waiting": {
      "comment": "Shown while waiting for the camera permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for camera permission…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待相机权限…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待相機權限…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの権限を待っています…"
          }
        }
