{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "lanClient.address": {
      "comment": "Label before an address a third-party client uses to connect to the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス"
          }
        }
      }
    },
