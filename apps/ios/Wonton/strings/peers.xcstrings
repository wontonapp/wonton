    "lanWebui.ports": {
      "comment": "Note under the Open on Local Network switch. First argument: number of ports; second: the port numbers, comma-separated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@ %2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Port"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Ports"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@ %2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "端口"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@ %2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "連接埠"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@ports@%2$@"
          },
          "substitutions": {
            "ports": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "ポート："
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "lanWebui.toggle": {
      "comment": "Switch on an app's page: make the app's web page reachable from other devices on the local network. The ports are listed below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open on Local Network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在局域网开放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在區域網路開放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークに公開"
          }
        }
      }
    },
