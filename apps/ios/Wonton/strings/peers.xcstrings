    "qrScanner.cameraRestricted": {
      "comment": "Reason shown when the camera can't scan: it is restricted, for example by Screen Time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is restricted (for example by Screen Time)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机被限制使用（比如“屏幕使用时间”的限制）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機被限制使用（例如「螢幕使用時間」的限制）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラが制限されています（スクリーンタイムなど）"
          }
        }
      }
    },
    "qrScanner.stopped": {
      "comment": "Reason shown when scanning stopped unexpectedly. Argument: the system's own error description, shown after it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning stopped: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描停了：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描已停止：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンが停止しました：%1$@"
          }
        }
      }
    },
    "qrScanner.unsupported": {
      "comment": "Reason shown when this device can't scan codes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't scan codes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备不支持扫码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置無法掃描 QR 碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではコードをスキャンできません"
          }
        }
      }
    },
    "qrScanner.unsupportedPaste": {
      "comment": "Scanner page when this device can't scan at all: paste the pairing code instead. The device pairing page shows the same sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't scan codes. Paste the code instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备不能扫码，请粘贴配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置不能掃碼，請貼上配對碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではコードをスキャンできません。コードをペーストしてください。"
          }
        }
      }
    },
    "camera.settings": {
      "comment": "Button that opens the app's page in system settings.",
      "extractionState": "manual",
      "localizations": {
