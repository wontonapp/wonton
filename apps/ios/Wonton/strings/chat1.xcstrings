{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "chat.pluginStopped": {
      "comment": "Stopped agent notice above the conversation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent is stopped. Start it to receive replies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 已停止，启动后才能回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Agent 已停止，啟動後才能回覆。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントは停止しています。返信を受け取るには起動してください。"
          }
        }
      }
    },
    "chat.profile.avatarChanged": {
      "comment": "Timeline note when someone changed their avatar without renaming.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed their profile photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 换了头像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 換了大頭貼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がアイコンを変更しました"
          }
        }
      }
    },
    "chat.newChat": {
      "comment": "Accessibility label of the round button that starts a new chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャット"
          }
        }
      }
    },
    "chat.loggingIn": {
      "comment": "Status line while signing in to the chat account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在登录…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在登入…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしています…"
          }
        }
      }
    },
    "chat.empty": {
      "comment": "Empty chat list after sync finished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No chats yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはまだありません"
          }
        }
      }
    },
    "chat.previewOwn": {
      "comment": "Chat list preview of a message you sent. Argument: the message text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分：%@"
          }
        }
      }
    },
    "chat.invite.room": {
      "comment": "Invitation row: someone invites you to a room. Argument: their name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invited you to a room"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀请你加入房间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀請你加入房間"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんからルームへの招待"
          }
        }
      }
    },
    "chat.invite.decline": {
      "comment": "Button on an invitation row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "chat.install.stage.pullingImages": {
      "comment": "Subtitle of an app install row while its images are downloaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulling images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拉取镜像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在拉取映像"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージを取得中"
          }
        }
      }
    },
    "chat.install.openPage": {
      "comment": "Button on an install row when the source is unknown or the result is uncertain; opens the app's page. Short label.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open app page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去应用页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往應用程式頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのページを開く"
          }
        }
      }
    },
    "chat.start.title": {
      "comment": "Navigation title of the page that starts a direct chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a Chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发起私聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發起私訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを開始"
          }
        }
      }
    },
    "chat.time.yesterday": {
      "comment": "Timestamp in the chat list for a message from yesterday.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日"
          }
        }
      }
    }
  }
}
