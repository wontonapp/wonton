{
  "sourceLanguage": "en",
  "strings": {
    "appLock.lockedTitle": {
      "comment": "锁定页的标题。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton is locked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton はロックされています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞已锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞已鎖定"
          }
        }
      }
    },
    "appLock.needDeviceLock": {
      "comment": "设置页：设备没有设备密码时开关开不了的原因。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a screen lock on this device to turn the app lock on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックが設定されていないため、App ロックをオンにできません。システム設定で設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没设置锁屏，开不了 App 锁。去系统设置设一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有設定螢幕鎖定，無法開啟 App 鎖。請到系統設定設定一個。"
          }
        }
      }
    },
    "appLock.noDeviceLock": {
      "comment": "锁定页：设备密码被关掉时停在锁页的原因。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no screen lock. Set one up in the system settings to unlock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックが設定されていません。システム設定で設定するとロックを解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没设置锁屏。去系统设置设一个就能解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有設定螢幕鎖定。請到系統設定設定一個就能解鎖。"
          }
        }
      }
    },
    "appLock.openSettings": {
      "comment": "Button that opens the system settings (App lock needs a device passcode; the language alert before the jump).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去系统设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系統設定"
          }
        }
      }
    },
    "appLock.timeout": {
      "comment": "宽限档位上面的一行说明。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock after leaving the app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離れてからロックするまで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开后多久锁上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開後多久鎖上"
          }
        }
      }
    },
    "appLock.timeoutFifteenMinutes": {
      "comment": "宽限档位：15 分钟。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 15 minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分後"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分钟后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分鐘後"
          }
        }
      }
    },
    "appLock.timeoutFiveMinutes": {
      "comment": "宽限档位：5 分钟。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 5 minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分後"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分钟后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分鐘後"
          }
        }
      }
    },
    "appLock.timeoutImmediate": {
      "comment": "宽限档位：立即。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right away"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即"
          }
        }
      }
    },
    "appLock.timeoutOneMinute": {
      "comment": "宽限档位：1 分钟。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 1 minute"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分後"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分钟后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分鐘後"
          }
        }
      }
    },
    "appLock.title": {
      "comment": "设置里 App 锁这一项、设置页标题和开关行。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App lock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App ロック"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 鎖"
          }
        }
      }
    },
    "appLock.unlock": {
      "comment": "锁定页的解锁按钮。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖"
          }
        }
      }
    },
    "appLock.verifyReason": {
      "comment": "系统验证弹窗里的一句话。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to keep using Wonton"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton を使い続けるには認証してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份后继续使用云吞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證身分後繼續使用雲吞"
          }
        }
      }
    },
    "notification.allowed": {
      "comment": "Status on the system notification row: notifications are allowed in the system.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み"
          }
        }
      }
    },
    "notification.push": {
      "comment": "Title of the push row on the notification settings page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュ通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送"
          }
        }
      }
    },
    "notification.denied": {
      "comment": "Status on the system notification row: notifications are not allowed (never asked yet counts too).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可なし"
          }
        }
      }
    },
    "notification.systemSettings": {
      "comment": "Row that opens the system notification settings of Wonton.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Notifications"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統通知"
          }
        }
      }
    },
    "notification.title": {
      "comment": "Navigation title and settings row for notifications.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "push.keysUnavailable": {
      "comment": "Push unavailability line: the shared keychain holding the push keys can't be read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push keys can't be read on this device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではプッシュの鍵を読めません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备读不到推送密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置讀不到推播金鑰"
          }
        }
      }
    },
    "push.noPermission": {
      "comment": "Push unavailability line: notification permission was denied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notification permission: new messages can't show while Wonton is closed or the screen is locked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の権限がありません。Wontonが終了していたり画面がロックされていると、新着メッセージを表示できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有通知权限：云吞被杀或锁屏时弹不出新消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有通知權限：雲吞被關閉或螢幕鎖定時彈不出新訊息"
          }
        }
      }
    },
    "push.noRelayDetail": {
      "comment": "Reason recorded in the core when the push relay isn't configured.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version doesn't have a push service configured yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンにはプッシュサービスが設定されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本还没有配置推送服务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本還沒有配置推送服務"
          }
        }
      }
    },
    "push.noService": {
      "comment": "Push unavailability line: there is no push service (relay) for this build, or the system can't register remote notifications.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push isn't set up yet (no push service)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュ通知はまだ使えません（プッシュサービスなし）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送还没开通（缺推送服务）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推播還沒開通（缺推送服務）"
          }
        }
      }
    },
    "push.registerRejected": {
      "comment": "Push unavailability line: the core rejected the registration on the spot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push registration was rejected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュの登録が完了しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送登记没有成功"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送登記沒有成功"
          }
        }
      }
    },
    "push.relayUnreachable": {
      "comment": "Push unavailability line: the push service (relay) can't be reached right now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the push service right now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュサービスに一時的に接続できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送服务暂时连不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推送服務暫時連不上"
          }
        }
      }
    },
    "push.status.failed.forbidden": {
      "comment": "Push status line when registering failed because the home server refused it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed. Your home server refused it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録に失敗しました。自宅サーバーに拒否されました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册失败，家里的服务器拒绝了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊失敗，家用伺服器拒絕了"
          }
        }
      }
    },
    "push.status.failed.invalidInput": {
      "comment": "Push status line when registering failed because the push address is invalid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed. The push address is invalid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録に失敗しました。プッシュアドレスが正しくありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册失败，推送地址无效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊失敗，推送位址無效"
          }
        }
      }
    },
    "push.status.failed.notReady": {
      "comment": "Push status line when registering failed because the chat connection isn't ready.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed. Wait until the chat connection is ready"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録に失敗しました。チャットの接続が整うまでお待ちください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册失败，请等聊天连接就绪"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊失敗，請等聊天連線就緒"
          }
        }
      }
    },
    "push.status.failed.transport": {
      "comment": "Push status line when registering failed because the home server can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed. Try again once the home server is reachable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録に失敗しました。自宅サーバーに接続できたらもう一度お試しください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册失败，连上家里的服务器后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊失敗，連上家用伺服器後重試"
          }
        }
      }
    },
    "push.status.failed.unauthorized": {
      "comment": "Push status line when registering failed because this device isn't recognized.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed. Pair again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録に失敗しました。ペアリングをやり直してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册失败，请重新配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊失敗，請重新配對"
          }
        }
      }
    },
    "push.status.failed.upstream": {
      "comment": "Push status line when registering failed because the home server hit an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration failed. Your home server hit an error"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録に失敗しました。自宅サーバーでエラーが発生しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册失败，家里的服务器出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊失敗，家用伺服器出錯了"
          }
        }
      }
    },
    "push.status.notSet": {
      "comment": "Push status line: no push address is registered yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
