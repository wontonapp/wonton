{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "appLock.lockedTitle": {
      "comment": "锁定页的标题。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton is locked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞已锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞已鎖定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton はロックされています"
          }
        }
      }
    },
    "appLock.needDeviceLock": {
      "comment": "设置页：设备没有设备密码时开关开不了的原因。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a screen lock on this device to turn the app lock on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没设置锁屏，开不了 App 锁。去系统设置设一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有設定螢幕鎖定，無法開啟 App 鎖。請到系統設定設定一個。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックが設定されていないため、App ロックをオンにできません。システム設定で設定してください。"
          }
        }
      }
    },
    "appLock.noDeviceLock": {
      "comment": "锁定页：设备密码被关掉时停在锁页的原因。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no screen lock. Set one up in the system settings to unlock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没设置锁屏。去系统设置设一个就能解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有設定螢幕鎖定。請到系統設定設定一個就能解鎖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ロックが設定されていません。システム設定で設定するとロックを解除できます。"
          }
        }
      }
    },
    "appLock.openSettings": {
      "comment": "去系统设置（设备密码 / 锁屏）的按钮。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去系统设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往系統設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開く"
          }
        }
      }
    },
    "appLock.timeout": {
      "comment": "宽限档位上面的一行说明。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock after leaving the app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开后多久锁上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開後多久鎖上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離れてからロックするまで"
          }
        }
      }
    },
    "appLock.timeoutFifteenMinutes": {
      "comment": "宽限档位：15 分钟。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 15 minutes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分钟后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分鐘後"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分後"
          }
        }
      }
    },
    "appLock.timeoutFiveMinutes": {
      "comment": "宽限档位：5 分钟。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 5 minutes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分钟后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分鐘後"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 分後"
          }
        }
      }
    },
    "appLock.timeoutImmediate": {
      "comment": "宽限档位：立即。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right away"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ"
          }
        }
      }
    },
    "appLock.timeoutOneMinute": {
      "comment": "宽限档位：1 分钟。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After 1 minute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分钟后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分鐘後"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分後"
          }
        }
      }
    },
    "appLock.title": {
      "comment": "设置里 App 锁这一项、设置页标题和开关行。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App lock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 鎖"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App ロック"
          }
        }
      }
    },
    "appLock.unlock": {
      "comment": "锁定页的解锁按钮。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除"
          }
        }
      }
    },
    "appLock.verifyReason": {
      "comment": "系统验证弹窗里的一句话。",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to keep using Wonton"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份后继续使用云吞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證身分後繼續使用雲吞"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton を使い続けるには認証してください"
          }
        }
      }
    },
    "notification.systemSettings": {
      "comment": "Row that opens the system notification settings of Wonton.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Notifications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統通知"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム通知"
          }
        }
      }
    },
    "notification.title": {
      "comment": "Navigation title and settings row for notifications.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "notification.unsupported": {
      "comment": "Explanation under the row while this platform gets no push.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Wonton can't receive push notifications yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本的云吞还收不到推送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本的雲吞還收不到推播"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのWontonはまだプッシュ通知を受け取れません"
          }
        }
      }
    },
    "settings.about": {
      "comment": "Settings row and navigation title for the About page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonについて"
          }
        }
      }
    },
    "settings.language": {
      "comment": "Row title on the Settings home page. Tapping opens this app's page in the system settings, where the app language is changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        }
      }
    },
    "settings.restartOnboarding": {
      "comment": "Settings row that shows the setup steps again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo Setup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重看引导"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重看初始設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップをやり直す"
          }
        }
      }
    },
    "settings.myApps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイアプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的應用"
          }
        }
      }
    }
  }
}
