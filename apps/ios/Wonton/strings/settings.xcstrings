    },
    "settings.languageChangeSteps": {
      "comment": "Message of the language alert: where the language row lives in the system settings, and that the app restarts afterwards. Destination on purpose: the jump lands wherever the system Settings opens, not always on this app's page (wonton#686, iOS 26 lands at the Settings root).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Language on Wonton’s page in system Settings. Wonton restarts with the new language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の Wonton ページで「言語」をタップしてください。変更後、Wonton は再起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的「云吞」页点「语言」，改完云吞会重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定的「雲吞」頁點「語言」，改完雲吞會重新啟動。"
          }
        }
      }
    },
