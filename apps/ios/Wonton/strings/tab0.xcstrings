{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "tab.bottomBar": {
      "comment": "Settings row that edits which pages sit in the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバー"
          }
        }
      }
    },
    "tab.pageFailed": {
      "comment": "Failure title when the page didn't load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open this page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面打不开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面打不開"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを開けません"
          }
        }
      }
    },
    "tab.hasProblem": {
      "comment": "Second half of a failure title: the page's app name comes first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "has a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "で問題が発生しました"
          }
        }
      }
    },
    "tab.stopped": {
      "comment": "Failure title for a stopped app. Argument: the page's app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は停止しています"
          }
        }
      }
    },
    "tab.openLinkFailed": {
      "comment": "Problem title when a link from inside a page can't be opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open this link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打不开这个链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打不開這個連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを開けません"
          }
        }
      }
    },
    "tab.proxyPortInvalid": {
      "comment": "Core error reason when the local proxy port isn't a valid port.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local proxy port isn't valid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地代理端口无效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機代理連接埠無效"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルプロキシのポートが無効です"
          }
        }
      }
    },
    "tab.viewDetails": {
      "comment": "Menu item and button that open the page's technical details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看详情"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看詳細資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細を表示"
          }
        }
      }
    },
    "tab.menu.alwaysFullscreen": {
      "comment": "Fullscreen capsule menu item with the switch that keeps opening this page fullscreen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Full Screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是全屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總是全螢幕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に全画面"
          }
        }
      }
    },
    "tab.menu.reload": {
      "comment": "Fullscreen capsule menu item that reloads the page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み"
          }
        }
      }
    },
    "tab.widgetUnsupported": {
      "comment": "Shown in place of a room's plugin page (a Matrix widget) that this app version can't open yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the app can't open this page yet. Update the app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本的 App 还打不开这个页面，更新 App 后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本的 App 還打不開這個頁面，更新 App 後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのアプリではまだこのページを開けません。アプリを更新してもう一度お試しください。"
          }
        }
      }
    },
    "tab.media.promptMicrophone": {
      "comment": "Title of the prompt asking to let a page's app use the microphone. Argument: the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@ to use your microphone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 %@ 使用麦克风吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 %@ 使用麥克風嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にマイクの使用を許可しますか？"
          }
        }
      }
    },
    "tab.media.allow": {
      "comment": "Button to let a page's app use the camera or microphone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可"
          }
        }
      }
    },
    "tab.media.systemDeniedTitle": {
      "comment": "Title saying media capture was refused because the system permission is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera or microphone unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头或麦克风用不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機或麥克風用不了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラまたはマイクが使えません"
          }
        }
      }
    },
    "tab.media.systemDenied": {
      "comment": "Said when the page was denied because Wonton lacks the system camera or microphone permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton doesn't have camera or microphone permission in system settings, so the page was denied. You can allow it in system settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置里没有允许云吞使用摄像头或麦克风，这次不给网页。可以到系统设置里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定裡沒有允許雲吞使用相機或麥克風，這次不給網頁。可以到系統設定裡打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で雲吞にカメラまたはマイクの権限がないため、このページは拒否されました。システム設定で許可できます。"
          }
        }
      }
    },
    "tab.media.systemSettings": {
      "comment": "Button to open the system settings for the camera or microphone permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    }
  }
}
