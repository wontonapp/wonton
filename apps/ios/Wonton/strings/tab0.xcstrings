{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "tab.bottomBar": {
      "comment": "Settings row that edits which pages sit in the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバー"
          }
        }
      }
    },
    "tab.pageFailed": {
      "comment": "Failure title when the page didn't load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open this page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面打不开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面打不開"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを開けません"
          }
        }
      }
    },
    "tab.hasProblem": {
      "comment": "Second half of a failure title: the page's app name comes first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "has a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "で問題が発生しました"
          }
        }
      }
    },
    "tab.stopped": {
      "comment": "Failure title for a stopped app. Argument: the page's app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is stopped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已停止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は停止しています"
          }
        }
      }
    },
    "tab.openLinkFailed": {
      "comment": "Problem title when a link from inside a page can't be opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open this link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打不开这个链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打不開這個連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを開けません"
          }
        }
      }
    },
    "tab.proxyPortInvalid": {
      "comment": "Core error reason when the local proxy port isn't a valid port.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local proxy port isn't valid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地代理端口无效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機代理連接埠無效"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルプロキシのポートが無効です"
          }
        }
      }
    },
    "tab.viewDetails": {
      "comment": "Menu item and button that open the page's technical details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看详情"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看詳細資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細を表示"
          }
        }
      }
    },
    "tab.menu.alwaysFullscreen": {
      "comment": "Fullscreen capsule menu item with the switch that keeps opening this page fullscreen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always Full Screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是全屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總是全螢幕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に全画面"
          }
        }
      }
    },
    "tab.menu.reload": {
      "comment": "Fullscreen capsule menu item that reloads the page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新載入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再読み込み"
          }
        }
      }
    },
    "tab.widgetUnsupported": {
      "comment": "Shown in place of a room's plugin page (a Matrix widget) that this app version can't open yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the app can't open this page yet. Update the app and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本的 App 还打不开这个页面，更新 App 后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本的 App 還打不開這個頁面，更新 App 後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのアプリではまだこのページを開けません。アプリを更新してもう一度お試しください。"
          }
        }
      }
    }
  }
}
