{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "verification.accept": {
      "comment": "Button that starts confirming the other device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Verification"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認を開始"
          }
        }
      }
    },
    "verification.cancelled.byMe": {
      "comment": "Result: the user cancelled on this device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled the verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你取消了确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你取消了確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認を取り消しました。"
          }
        }
      }
    },
    "verification.cancelled.mismatch": {
      "comment": "Result: the two devices showed different emoji, so the verification was cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The devices showed different emoji. The verification was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备上的表情对不上，确认已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩部裝置上的表情對不上，確認已取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスで絵文字が一致しなかったため、確認を取り消しました。"
          }
        }
      }
    },
    "verification.cancelled.other": {
      "comment": "Result: the verification didn't finish, for an unknown reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification didn't finish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认没有完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認沒有完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が完了しませんでした。"
          }
        }
      }
    },
    "verification.compare.title": {
      "comment": "Question above the emoji or numbers both devices show.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do both devices show the same?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备上显示的一样吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩部裝置上顯示的一樣嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスに同じものが表示されていますか？"
          }
        }
      }
    },
    "verification.deny": {
      "comment": "Button that refuses the confirmation request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deny"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "verification.done.other": {
      "comment": "Shown on the device that handed out the keys when verification finished.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification Complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が完了しました"
          }
        }
      }
    },
    "verification.incoming.message": {
      "comment": "Body of the confirmation prompt on the already-verified device. Argument: the other device's name, or its ID when it has none.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify “%@” with this device?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这台设备确认「%@」？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用這部裝置確認「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで「%@」を確認しますか？"
          }
        }
      }
    },
    "verification.requested.hint": {
      "comment": "Shown under the waiting status: the other phone only sees the request when its app is open.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Wonton on your other phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你另一台手机上的云吞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開你另一支手機上的雲吞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のスマホでWontonを開いてください。"
          }
        }
      }
    },
    "verification.same": {
      "comment": "Button confirming the emoji (or numbers) match on both devices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ"
          }
        }
      }
    },
    "verification.starting": {
      "comment": "Status while the two devices negotiate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing verification…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备确认…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備確認…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認を準備しています…"
          }
        }
      }
    }
  }
}
