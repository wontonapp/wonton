{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "photo.title": {
      "comment": "Sidebar entry and screen name of the native photo library.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        }
      }
    },
    "photo.albumName": {
      "comment": "Placeholder of the album name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム名"
          }
        }
      }
    },
    "photo.emptySearch": {
      "comment": "Shown when a search has no results.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing found. Try different words."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没搜到，换个说法试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到，換個說法試試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかりません。別の言葉でお試しください。"
          }
        }
      }
    },
    "photo.place": {
      "comment": "Placeholder of the place filter and label of the place line in photo info.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地點"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所"
          }
        }
      }
    },
    "photo.favorites": {
      "comment": "Filter chip: favorites only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorites"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喜好項目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り"
          }
        }
      }
    },
    "photo.actionFavorite": {
      "comment": "Action: mark as favorite.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入喜好項目"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加"
          }
        }
      }
    },
    "photo.actionShare": {
      "comment": "Action and sheet title: share the album with family members.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with Family"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享给家人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與家人共享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族と共有"
          }
        }
      }
    },
    "photo.actionInfo": {
      "comment": "Action: show the photo's info panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Info"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        }
      }
    },
    "photo.doneRestore": {
      "comment": "Result notice. Argument: count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Restored %lld item"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Restored %lld items"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已恢复 %lld 项"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已還原 %lld 項"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld項目を復元しました"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "photo.failedEdit": {
      "comment": "Result notice when the whole change failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change didn't go through"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次改动没成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次變更沒有成功"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更できませんでした"
          }
        }
      }
    },
    "photo.openStore": {
      "comment": "Button: open the app store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去商店"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往商店"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアを開く"
          }
        }
      }
    },
    "photo.problemDeniedTitle": {
      "comment": "Problem title: this person isn't allowed to open the photo plugin.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have access to this photo app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还不能用这个相册应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你還不能使用這個相簿應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真アプリを使う権限がありません"
          }
        }
      }
    },
    "photo.problemDeniedNext": {
      "comment": "Next step when access is denied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the owner to give you access to this app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请主人给你开通这个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請擁有者為你開通這個應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーナーにこのアプリの利用を許可してもらってください。"
          }
        }
      }
    },
    "photo.problemUpstreamTitle": {
      "comment": "Problem title: the plugin's upstream failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo app ran into a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册应用出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿應用程式發生錯誤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリで問題が発生しました"
          }
        }
      }
    },
    "photo.sourceNext": {
      "comment": "Next step under the more-than-one-photo-app problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the owner to pick which one to use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请主人定一个默认用的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請擁有者指定一個預設使用的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーナーに既定のアプリを決めてもらってください。"
          }
        }
      }
    },
    "photo.sourceNotInstalled": {
      "comment": "Shown when this person has no photo plugin to use; not an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photo app is installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有装相册应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有安裝相簿應用程式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリがインストールされていません"
          }
        }
      }
    },
    "photo.videoFailed": {
      "comment": "Problem title: the video can't be played.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't play this video"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段视频放不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段影片無法播放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオを再生できません"
          }
        }
      }
    },
    "photo.infoFile": {
      "comment": "Accessibility label of the file line in photo info.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル"
          }
        }
      }
    },
    "photo.shareUnavailable": {
      "comment": "Shown in the share sheet when the family member list can't be loaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load family members"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家人名单没取到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入家人名單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族の一覧を読み込めませんでした"
          }
        }
      }
    }
  }
}
