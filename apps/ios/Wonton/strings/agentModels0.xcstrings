    "agentModels.problem.forbidden": {
      "comment": "Error: no permission to manage this Bot's models.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't change this assistant's models"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能改这个助手的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能更改這個助手的模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントのモデルは変更できません"
          }
        }
      }
    },
    "agentModels.problem.invalidInput.next": {
      "comment": "Next step for the invalid-input error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改一下再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改一下再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正してもう一度お試しください。"
          }
        }
      }
    },
    "agentModels.problem.upstream": {
      "comment": "Error: the Agent failed while handling the request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant ran into a problem"
