{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "agentModels.current.none": {
      "comment": "Model page, top card: the Bot has no main model yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model connected yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没接模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒接模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルはまだ接続されていません"
          }
        }
      }
    },
    "agentModels.test.running": {
      "comment": "Test in progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Testing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在测试…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在測試…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト中…"
          }
        }
      }
    },
    "agentModels.test.ok": {
      "comment": "Test result: the model replied.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できます"
          }
        }
      }
    },
    "agentModels.provider.disconnect.title": {
      "comment": "Confirmation title; %@ is the provider name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 %@？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斷開 %@？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の接続を解除しますか？"
          }
        }
      }
    },
    "agentModels.provider.disconnect.message": {
      "comment": "Confirmation body for disconnecting a provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its key or sign-in will be removed from this assistant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 key 或登录会从这个助手里删掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 key 或登入會從這個助手中刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントからキーまたはサインイン情報が削除されます。"
          }
        }
      }
    },
    "agentModels.login.oneTap": {
      "comment": "Button: sign in through the browser and come straight back to the app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-Tap Sign-In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一鍵登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップでサインイン"
          }
        }
      }
    },
    "agentModels.login.again": {
      "comment": "Button after a sign-in was declined, expired or failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度サインイン"
          }
        }
      }
    },
    "agentModels.login.waiting": {
      "comment": "While the sign-in page is open and the app waits for approval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval on the sign-in page…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你在登录页批准…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你在登入頁核准…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインページでの承認を待っています…"
          }
        }
      }
    },
    "agentModels.login.denied": {
      "comment": "Sign-in outcome: declined on the provider's side.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in was declined on the provider's page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在服务商那边拒绝了登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在服務商那邊拒絕了登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダー側でサインインが拒否されました"
          }
        }
      }
    },
    "agentModels.login.failed": {
      "comment": "Sign-in outcome: failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in didn't go through"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录没成功"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入沒有成功"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインできませんでした"
          }
        }
      }
    },
    "agentModels.login.cannotOpen": {
      "comment": "The app can't open this kind of sign-in page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't open the sign-in page"
