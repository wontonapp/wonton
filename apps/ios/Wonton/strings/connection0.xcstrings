{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "connection.connected": {
      "comment": "Connection state when the tunnel is up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        }
      }
    },
    "connection.notice.serverOffline": {
      "comment": "Status when the home server appears to be offline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server seems offline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器好像离线了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器好像離線了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバはオフラインのようです"
          }
        }
      }
    },
    "connection.notice.versionMismatch": {
      "comment": "Status when app and server speak different versions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton or your home server needs an update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞或家里的服务器需要更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞或家用伺服器需要更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonか自宅サーバのアップデートが必要です"
          }
        }
      }
    },
    "connection.relay": {
      "comment": "Connection route through the relay; also a row in the connection page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relayed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中继"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經由中繼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレー経由"
          }
        }
      }
    },
    "connection.lan": {
      "comment": "Connection route inside the local network.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局域网"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域網路"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク"
          }
        }
      }
    },
    "connection.detail.lossRate": {
      "comment": "Row in the connection details page: window packet loss as a percentage; a dash when there aren't enough samples.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loss Rate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢包率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封包遺失率"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パケット損失率"
          }
        }
      }
    },
    "connection.detail.lastConnected": {
      "comment": "Row in the connection details page: when the tunnel last came up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后连上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後連上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に接続した日時"
          }
        }
      }
    },
    "connection.detail.lastFailure": {
      "comment": "Row in the connection details page: the last failure the core reported.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Failure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次失敗"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の失敗"
          }
        }
      }
    },
    "connection.check.failing": {
      "comment": "Device network check result that doesn't match the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreachable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不通"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不通"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続不可"
          }
        }
      }
    }
  }
}
