{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "contacts.title": {
      "comment": "Title of a bot's contacts page and the entry row on the bot's detail page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联系人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯絡人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先"
          }
        }
      }
    },
    "contacts.add": {
      "comment": "Toolbar button and sheet title for adding a contact to this bot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加联系人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加聯絡人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先を追加"
          }
        }
      }
    },
    "contacts.add.kindPerson": {
      "comment": "Choice in the add-contact sheet: the other side is a person.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人"
          }
        }
      }
    },
    "contacts.add.submit": {
      "comment": "Button that sends the contact request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを送信"
          }
        }
      }
    },
    "contacts.section.requests": {
      "comment": "Section heading for contact requests waiting for me.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエスト"
          }
        }
      }
    },
    "contacts.remove": {
      "comment": "Content description of the button that removes an added contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除联系人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除聯絡人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先を削除"
          }
        }
      }
    },
    "contacts.remove.title": {
      "comment": "Confirmation title for removing a contact. Argument: the contact's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        }
      }
    },
    "contacts.status.waitingBot": {
      "comment": "Row status: waiting for the other bot's keeper to approve.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for them to approve"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等对方同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等對方同意"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の承認待ち"
          }
        }
      }
    },
    "contacts.status.waitingPerson": {
      "comment": "Row status: waiting for the person to accept the chat invite.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for them to accept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等对方接受"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等對方接受"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の承諾待ち"
          }
        }
      }
    },
    "contacts.status.unknown": {
      "comment": "Row status this version doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态未知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態未知"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態不明"
          }
        }
      }
    },
    "contacts.keeper": {
      "comment": "Under a bot contact's name: whose bot it is. Argument: the keeper's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 Bot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 Bot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のボット"
          }
        }
      }
    },
    "contacts.remote.unpaired": {
      "comment": "On a contact from another server whose pairing was removed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That server isn't connected anymore, so messages won't get through"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和那台服务器的配对已移除，消息过不去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和那台伺服器的配對已移除，訊息傳不過去"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサーバーとの接続が解除されたため、メッセージは届きません"
          }
        }
      }
    },
    "contacts.error.invalidUserId": {
      "comment": "Failure title: not a full Matrix ID, or the bot itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a valid Matrix ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是有效的 Matrix ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是有效的 Matrix ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な Matrix ID ではありません"
          }
        }
      }
    },
    "contacts.error.notPaired": {
      "comment": "Failure title: their server isn't paired with mine.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their server isn't connected to yours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的服务器没和你的配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的伺服器沒和你的配對"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のサーバーはあなたのサーバーと接続されていません"
          }
        }
      }
    },
    "contacts.error.notPairedNext": {
      "comment": "Next step under that failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect it in Other Servers first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在“其他服务器”里配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在「其他伺服器」裡配對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「ほかのサーバ」で接続してください。"
          }
        }
      }
    },
    "contacts.error.botNotFound": {
      "comment": "Failure title: the bot was uninstalled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot is no longer installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 Bot 已经不在了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 Bot 已經不在了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットはもうインストールされていません"
          }
        }
      }
    },
    "contacts.error.contactNotFound": {
      "comment": "Failure title: that row was already handled elsewhere.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was already handled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一条已经处理过了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一則已經處理過了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに処理済みです"
          }
        }
      }
    },
    "contacts.error.peerUnreachable": {
      "comment": "Failure title: their server can't be reached; nothing was sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach their server. Nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上对方的服务器，这次没发出去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上對方的伺服器，這次沒有送出"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のサーバーに接続できません。送信されていません。"
          }
        }
      }
    }
  }
}
