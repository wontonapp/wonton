{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "coreUpgrade.cancelUpgrade": {
      "comment": "Danger button while the update is running and can still be cancelled: nothing was touched yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートをキャンセル"
          }
        }
      }
    },
    "coreUpgrade.check.downloading": {
      "comment": "Channel state while the new version downloads; a progress bar with sizes is shown below.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading the new version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下載新版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンをダウンロード中"
          }
        }
      }
    },
    "coreUpgrade.currentVersion": {
      "comment": "Row label in the update page and in the collapsed details: the core version currently running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョン"
          }
        }
      }
    },
    "coreUpgrade.failure.busy": {
      "comment": "Update failure summary: an update is already running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update is already running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经在升级了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經在更新了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにアップデート中です"
          }
        }
      }
    },
    "coreUpgrade.failure.protocol": {
      "comment": "Update failure summary for the protocol and unknown reasons: the app and the home server version don't match.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton and your home server aren't compatible"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 和家里的服务器版本对不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞和家用伺服器的版本不相符"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonと自宅サーバのバージョンが合っていません"
          }
        }
      }
    },
    "coreUpgrade.failure.updaterFailed": {
      "comment": "Update failure summary: the updater itself stopped working.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The updater ran into a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级器出了问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新程式出了問題"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデータに問題が発生しました"
          }
        }
      }
    },
    "coreUpgrade.migratesWarning": {
      "comment": "Warning in the confirm step of the update: this version migrates data and the update can't be undone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version migrates data. You can't go back after updating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本会迁移数据，升级后退不回去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本會遷移資料，更新後無法退回舊版。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンはデータを移行します。アップデート後は元に戻せません。"
          }
        }
      }
    },
    "coreUpgrade.phase.backingUp": {
      "comment": "Update phase: backing up data before switching.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backing up data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在備份資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データをバックアップ中"
          }
        }
      }
    },
    "coreUpgrade.phase.pulling": {
      "comment": "Update phase shown under the stage line: pulling the new image. Nothing was touched yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading the new version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下載新版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンをダウンロード中"
          }
        }
      }
    },
    "coreUpgrade.phase.switching": {
      "comment": "Update phase: switching the services to the new version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching to the new version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在切換到新版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンに切り替え中"
          }
        }
      }
    },
    "coreUpgrade.requestingUpgrade": {
      "comment": "Stage line right after the owner confirmed: the request is on its way.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the update…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在发起升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在開始更新…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを開始しています"
          }
        }
      }
    },
    "coreUpgrade.title": {
      "comment": "Title of the home server update page, shown in the top bar while it is pushed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Home Server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバをアップデート"
          }
        }
      }
    }
  }
}
