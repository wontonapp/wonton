{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "problem.appearance.title": {
      "comment": "Problem title when the appearance settings couldn't be saved on the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance settings weren't saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观设置没有存上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存外觀設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観設定を保存できませんでした"
          }
        }
      }
    },
    "problem.generic.title": {
      "comment": "Problem title for an unexpected error that has no category.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生錯誤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーが発生しました"
          }
        }
      }
    },
    "problem.loading": {
      "comment": "Accessibility label of the skeleton list placeholder while content loads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中"
          }
        }
      }
    },
    "problem.plugin.changed.nextStep": {
      "comment": "Next step: look at the app again and approve it again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and approve it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新查看、确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新查看並確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容をもう一度確認してください。"
          }
        }
      }
    },
    "problem.plugin.conflict.title": {
      "comment": "Problem title: the app is busy with another task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is busy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个应用正忙"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 正忙"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは処理中です"
          }
        }
      }
    },
    "problem.plugin.deviceUnavailable.title": {
      "comment": "Problem title: the device the app should run on isn't available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device you chose isn't available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择的设备不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇的裝置無法使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したデバイスを利用できません"
          }
        }
      }
    },
    "problem.plugin.egressProxyUnavailable.nextStep": {
      "comment": "Next step: check the proxy on the home server, or change the address in the internet proxy settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the proxy on your home server, or change the address in the Internet proxy settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查家里服务器上的代理，或者在出网代理设置里改地址后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查家用伺服器上的代理伺服器，或在代理伺服器設定裡修改位址後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバ上のプロキシを確認するか、プロキシ設定でアドレスを変えてから、もう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.lanUnavailable.nextStep": {
      "comment": "Next step: choose an interface or address in the local network settings, then try again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an interface or address in the local network settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在局域网设置里选好网卡或地址后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在區域網路設定裡選好網卡或位址後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークの設定でインターフェースかアドレスを選んでから、もう一度お試しください。"
          }
        }
      }
    },
    "problem.plugin.sourceUnavailable.title": {
      "comment": "Problem title: the app's information can't be fetched from its source right now.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't fetch the app's details right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时取不到应用的信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法取得 App 的資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの情報を今は取得できません"
          }
        }
      }
    },
    "problem.pluginSave.uncertain.title": {
      "comment": "Problem title after saving the internet proxy while offline: whether it saved isn't known.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm it was saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定改好了没有"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確定是否已儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたかどうか不明です"
          }
        }
      }
    },
    "problem.storage.nextStep": {
      "comment": "Next step under the storage problem. Also used when settings couldn't be saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your storage and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查存储空间后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查儲存空間後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージを確認して、もう一度お試しください。"
          }
        }
      }
    },
    "problem.store.incomplete.title": {
      "comment": "Problem title: some apps couldn't be loaded into the list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps didn't load"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几个应用没加载出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有幾個 App 沒有載入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のアプリが読み込まれていません"
          }
        }
      }
    },
    "problem.store.rateLimited.nextStep": {
      "comment": "Next step: wait a few minutes and try again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait a few minutes and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过几分钟再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過幾分鐘再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分待ってからもう一度お試しください。"
          }
        }
      }
    },
    "problem.store.rateLimited.title": {
      "comment": "Problem title: the source is answering too many requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求太頻繁了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます"
          }
        }
      }
    },
    "problem.transport.title": {
      "comment": "A change didn't save because the home server is unreachable. Shared by every feature's problem notice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上家裡的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバーに接続できません"
          }
        }
      }
    },
    "problem.upstream.next": {
      "comment": "What to do after a home server error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてからもう一度お試しください。"
          }
        }
      }
    }
  }
}
