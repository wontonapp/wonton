{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "transfer.cleanupTitle": {
      "comment": "Title of the cleanup dialog for a downloaded transfer. Argument: the file's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “%1$@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理“%1$@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理「%1$@」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を削除"
          }
        }
      }
    },
    "transfer.downloadedCount": {
      "comment": "Caption button above the chat composer: opens the list of downloaded transfers. Argument: their count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@files@ downloaded"
          },
          "substitutions": {
            "files": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "1 file"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld files"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载 %#@files@ 个"
          },
          "substitutions": {
            "files": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載 %#@files@ 個"
          },
          "substitutions": {
            "files": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@files@件ダウンロード済み"
          },
          "substitutions": {
            "files": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "transfer.open": {
      "comment": "Icon button on a downloaded transfer: open the file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開く"
          }
        }
      }
    },
    "transfer.pausedProgress": {
      "comment": "Line under a paused transfer. First argument: the transferred size, already formatted as a byte count; second: the home server's reason, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused at %1$@: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停，已传 %1$@：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停，已傳 %1$@：%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止、%1$@転送済み：%2$@"
          }
        }
      }
    },
    "transfer.pausedWaiting": {
      "comment": "Line under a paused transfer without a reason. Argument: the transferred size, already formatted as a byte count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumes when the connection is back, %1$@ transferred"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等连接恢复后接着传，已传 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等連線恢復後接著傳，已傳 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の回復後に転送を再開、%1$@転送済み"
          }
        }
      }
    },
    "transfer.resendLink": {
      "comment": "Text button on a finished upload whose link wasn't sent: send the link again.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend Link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重发链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重發連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを再送"
          }
        }
      }
    },
    "transfer.upload": {
      "comment": "Accessibility label of the direction icon on an upload.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード"
          }
        }
      }
    }
  }
}
