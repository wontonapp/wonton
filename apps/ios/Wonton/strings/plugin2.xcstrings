{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "plugin.dependencyConnect": {
      "comment": "Button that connects to the suggested provider app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        }
      }
    },
    "plugin.dependencyNoProvider": {
      "comment": "No app in the store provides this capability.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No provider in the store"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商店里没有提供方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店裡沒有提供方"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアに提供元がありません"
          }
        }
      }
    },
    "plugin.dependencyNotConnected": {
      "comment": "$provider is the app title, $capability the capability name. The owner can connect it here.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't connected yet, so %2$@ doesn't work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没接上「%1$@」，「%2$@」用不了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒接上「%1$@」，「%2$@」用不了。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」にまだ接続していないため、「%2$@」は使えません。"
          }
        }
      }
    },
    "plugin.dependencyOptional": {
      "comment": "An optional capability that has no provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：「%1$@」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選：「%1$@」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：「%1$@」"
          }
        }
      }
    },
    "plugin.deviceSerial": {
      "comment": "Fallback name for an authorized host serial device when no name is supplied. Keep short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serial device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串口设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "序列埠裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シリアルデバイス"
          }
        }
      }
    },
    "plugin.info.version": {
      "comment": "Information row: the app's version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        }
      }
    },
    "plugin.permission.open": {
      "comment": "Turn the optional permission on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "plugin.permission.open.title": {
      "comment": "Title of the dialog that explains an optional permission before turning it on. %@ is the permission text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をオンにしますか？"
          }
        }
      }
    },
    "plugin.permission.risk.unknown": {
      "comment": "Explicit permission risk level shown in previews and installed plugin details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown risk · treated as highest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知风险（按最高级处理）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知風險（按最高級處理）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なリスク（最高リスクとして扱います）"
          }
        }
      }
    },
    "plugin.permission.risk.veryHigh": {
      "comment": "Explicit permission risk level shown in previews and installed plugin details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very high risk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很高级风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很高級風險"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に高いリスク"
          }
        }
      }
    },
    "plugin.settings.restartHint": {
      "comment": "Shown after saving when the app will restart to apply the new values. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will restart to apply this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会重新启动一下"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用會重新啟動一下"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを一度再起動します"
          }
        }
      }
    },
    "plugin.task.addedToolsUnknown": {
      "comment": "Succeeded task line when the core couldn't compare the app's tools.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't tell which tools were added this time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不知道这次多了哪些工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不知道這次多了哪些工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回追加されたツールは確認できません"
          }
        }
      }
    },
    "plugin.task.checkInstalled": {
      "comment": "Button on an uncertain task that opens the installed list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查已安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みを確認"
          }
        }
      }
    },
    "plugin.task.installRunning": {
      "comment": "Status of a running install task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール中"
          }
        }
      }
    },
    "plugin.task.uncertain": {
      "comment": "Task whose result the core couldn't confirm. Argument: the core's message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が不確定です：%@"
          }
        }
      }
    },
    "plugin.task.uninstallRunning": {
      "comment": "Status of a running uninstall task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在卸载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在解除安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストール中"
          }
        }
      }
    },
    "plugin.task.upgradeRunning": {
      "comment": "Status of a running update task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在升級"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート中"
          }
        }
      }
    },
    "plugin.uninstall.title": {
      "comment": "Uninstall dialog title. Argument: the app's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をアンインストールしますか？"
          }
        }
      }
    },
    "plugin.uninstallUnusedProviders": {
      "comment": "Heading over the providers nothing else uses; the owner may uninstall them together.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else uses these:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些也没人用了："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些也沒人用了："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに使っているアプリはありません："
          }
        }
      }
    }
  }
}
