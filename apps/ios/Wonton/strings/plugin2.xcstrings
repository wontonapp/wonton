{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "plugin.permission.open": {
      "comment": "Turn the optional permission on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "plugin.permission.open.title": {
      "comment": "Title of the dialog that explains an optional permission before turning it on. %@ is the permission text.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をオンにしますか？"
          }
        }
      }
    },
    "plugin.permission.risk.unknown": {
      "comment": "Explicit permission risk level shown in previews and installed plugin details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown risk · treated as highest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知风险（按最高级处理）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知風險（按最高級處理）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なリスク（最高リスクとして扱います）"
          }
        }
      }
    },
    "plugin.permission.risk.veryHigh": {
      "comment": "Explicit permission risk level shown in previews and installed plugin details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very high risk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很高级风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很高級風險"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に高いリスク"
          }
        }
      }
    },
    "plugin.task.addedToolsUnknown": {
      "comment": "Succeeded task line when the core couldn't compare the app's tools.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't tell which tools were added this time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不知道这次多了哪些工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不知道這次多了哪些工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回追加されたツールは確認できません"
          }
        }
      }
    },
    "plugin.task.installRunning": {
      "comment": "Status of a running install task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール中"
          }
        }
      }
    },
    "plugin.task.uncertain": {
      "comment": "Task whose result the core couldn't confirm. Argument: the core's message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is uncertain: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が不確定です：%@"
          }
        }
      }
    },
    "plugin.task.checkInstalled": {
      "comment": "Button on an uncertain task that opens the installed list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查已安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みを確認"
          }
        }
      }
    },
    "plugin.task.uninstallRunning": {
      "comment": "Status of a running uninstall task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalling"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在卸载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在解除安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストール中"
          }
        }
      }
    },
    "plugin.task.upgradeRunning": {
      "comment": "Status of a running update task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在升級"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート中"
          }
        }
      }
    },
    "plugin.info.version": {
      "comment": "Information row: the app's version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        }
      }
    },
    "plugin.uninstall.title": {
      "comment": "Uninstall dialog title. Argument: the app's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をアンインストールしますか？"
          }
        }
      }
    }
  }
}
