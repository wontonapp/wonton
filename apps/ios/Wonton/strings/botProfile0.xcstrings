{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "botProfile.name": {
      "comment": "Label for the Bot's name field when editing it in the profile section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    },
    "botProfile.pick.addState": {
      "comment": "Accessibility label of an empty state-avatar cell. Argument: the status's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add %@ photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加%@头像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增%@頭像"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のアイコンを追加"
          }
        }
      }
    },
    "botProfile.pick.image": {
      "comment": "Button that opens the photo picker for the static avatar; the ellipsis follows the iOS convention for buttons that open another step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Photo…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選圖片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを選択"
          }
        }
      }
    },
    "botProfile.pick.imageOrVideo": {
      "comment": "Action in the sheet on a set status-avatar cell: pick a new photo or video. The ellipsis follows the iOS convention for buttons that open another step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Photo or Video…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选图片或视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選圖片或影片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンや動画を選択"
          }
        }
      }
    },
    "botProfile.problem.media.format": {
      "comment": "The file's contents don't match one of the supported image or video formats.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file isn't a supported photo or video"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个文件不是支持的图片或视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個檔案不是支援的圖片或影片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは対応している写真や動画ではありません"
          }
        }
      }
    },
    "botProfile.problem.media.notSquare": {
      "comment": "The photo isn't square.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo has to be square"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片要正方形的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片要正方形的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は正方形にしてください"
          }
        }
      }
    },
    "botProfile.problem.media.unreadable": {
      "comment": "The core couldn't read the file's format, dimensions or duration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the file's details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读不出这个文件的信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀不出這個檔案的資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの情報を読み取れませんでした"
          }
        }
      }
    },
    "botProfile.problem.name.empty": {
      "comment": "The server rejected the name because it is empty after trimming.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name can't be empty"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字不能是空的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字不能是空的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前が空です"
          }
        }
      }
    },
    "botProfile.problem.name.other": {
      "comment": "The server rejected the name for an unrecognized reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name isn't allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个名字不行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個名字不行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前は使用できません"
          }
        }
      }
    },
    "botProfile.problem.notReady.next": {
      "comment": "The app needs to finish installing or signing in first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app isn't ready yet. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用还没准备好，稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用還沒準備好，稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの準備が整うまで、しばらくお待ちください。"
          }
        }
      }
    },
    "botProfile.problem.notReady.title": {
      "comment": "The Bot profile can't be changed yet: the app isn't installed properly or Matrix isn't signed in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't change it right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在还改不了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在還改不了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は変更できません"
          }
        }
      }
    },
    "botProfile.problem.ownerOnly.title": {
      "comment": "The Bot profile can only be changed by the home owner, and this device belongs to a family member.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the home owner can change a Bot's profile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットのプロフィールを変更できるのはホームのオーナーだけです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有主人能改 Bot 的资料"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有主人能改 Bot 的資料"
          }
        }
      }
    },
    "botProfile.problem.ownerOnly.next": {
      "comment": "Ask the owner to change the Bot profile from their own device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the home owner to change it on their device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームのオーナーの端末から変更してもらってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请主人用自己的设备改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請主人用自己的裝置改。"
          }
        }
      }
    },
    "botProfile.title": {
      "comment": "Section title on an installed Agent app's detail page: the Bot's name, photo and status avatars.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール"
          }
        }
      }
    },
    "botProfile.readOnly": {
      "comment": "Nondefault Bot profile editing is not supported by the existing default-only actions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Bot’s profile is read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bot 的资料为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bot 的資料為唯讀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Bot のプロフィールは読み取り専用です。"
          }
        }
      }
    }
  }
}
