{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "chat.pluginStarting": {
      "comment": "Agent startup progress in a conversation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting agent…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动 Agent…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在啟動 Agent…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントを起動中…"
          }
        }
      }
    },
    "chat.profile.renamed": {
      "comment": "Timeline note when someone renamed themselves. First argument: the old name, second: the new name. Shown even when the avatar changed at the same time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed their name to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 改名为 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 改名為 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の名前が%@に変わりました"
          }
        }
      }
    },
    "chat.notSignedIn": {
      "comment": "Notice when the chat account isn't connected to the home server yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected to your home server yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有连上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒連上家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバにまだ接続していません"
          }
        }
      }
    },
    "chat.encrypted": {
      "comment": "Accessibility label of the lock icon on an encrypted chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加密"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加密"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化済み"
          }
        }
      }
    },
    "chat.unread": {
      "comment": "Accessibility label of the unread badge on a chat row. Argument: the number of unread messages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld unread"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "1 unread"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 条未读"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 則未讀"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld件の未読"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "chat.invite.direct": {
      "comment": "Invitation row: someone asks you to start a direct chat. Argument: their name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to chat with you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀请你私聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀請你私訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんからダイレクトチャットの招待"
          }
        }
      }
    },
    "chat.invite.accept": {
      "comment": "Button on an invitation row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加"
          }
        }
      }
    },
    "chat.start.field": {
      "comment": "Placeholder of the field that takes a username or Matrix ID.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username or Matrix ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名或 Matrix ID"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者名稱或 Matrix ID"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザ名またはMatrix ID"
          }
        }
      }
    },
    "chat.install.stage.preparing": {
      "comment": "Subtitle of an app install row while networks, volumes and data folders are set up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中"
          }
        }
      }
    },
    "chat.install.stage.starting": {
      "comment": "Subtitle of an app install row while its containers start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在啟動"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動中"
          }
        }
      }
    },
    "chat.install.stage.waitingForBot": {
      "comment": "Subtitle of an app install row while health checks pass and the bot comes online.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the bot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Bot 就绪"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Bot 就緒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot の準備を待っています"
          }
        }
      }
    },
    "chat.start.submit": {
      "comment": "Button under the username field: start the chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發起"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始"
          }
        }
      }
    },
    "chat.summary.other": {
      "comment": "Chat list placeholder for an attachment kind this version doesn't know. Argument: the kind.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@]"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@]"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@]"
          }
        }
      }
    }
  }
}
