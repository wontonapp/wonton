{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "coreUpgrade.check.upToDate": {
      "comment": "Channel state: the server already runs the newest version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经是最新版"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經是最新版"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新です"
          }
        }
      }
    },
    "coreUpgrade.detail.migrates": {
      "comment": "Collapsed details row: the data kinds this version migrates, as a localized list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Migrated data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会迁移的数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會遷移的資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移行されるデータ"
          }
        }
      }
    },
    "coreUpgrade.detail.newVersion": {
      "comment": "Collapsed details row: the new version's full digest.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョン"
          }
        }
      }
    },
    "coreUpgrade.devVersion": {
      "comment": "Version label when the core reports no version and no digest: a development build.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development build"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发版"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發版"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発版"
          }
        }
      }
    },
    "coreUpgrade.failure.crashed": {
      "comment": "Update failure summary: the new version crashed after it started.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new version crashed after starting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本启动后崩了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本啟動後當掉了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンが起動後にクラッシュしました"
          }
        }
      }
    },
    "coreUpgrade.failure.notReady": {
      "comment": "Update failure summary: the new version hasn't finished downloading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new version isn't downloaded yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本还没下载好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本還沒下載好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがまだダウンロードされていません"
          }
        }
      }
    },
    "coreUpgrade.failure.registryUnavailable": {
      "comment": "Update failure summary: the image registry can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the image registry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上镜像仓库"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到映像檔倉庫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージレジストリに接続できません"
          }
        }
      }
    },
    "coreUpgrade.failure.tooLate": {
      "comment": "Update failure summary: cancelling came too late, the update already started changing things.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update already started and can't be cancelled"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经开始动东西了，不能取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已經開始，無法取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに処理が始まっているためキャンセルできません"
          }
        }
      }
    },
    "coreUpgrade.failure.upstream": {
      "comment": "Update failure summary: Docker reported an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker reported an error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 發生錯誤"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockerでエラーが発生しました"
          }
        }
      }
    },
    "coreUpgrade.uncertain": {
      "comment": "Stage line when the connection dropped mid-update and the outcome is not known yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outcome unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不确定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不確定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は不明"
          }
        }
      }
    }
  }
}
