    "video.empty": {
      "comment": "Shown when a library or the video page has nothing in it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还没有内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡還沒有內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません"
          }
        }
      }
    },
