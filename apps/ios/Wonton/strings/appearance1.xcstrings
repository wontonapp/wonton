    "appearance.hexInvalid": {
      "comment": "Error under the color input field when the text isn't a valid #RRGGBB value.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the color as #RRGGBB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色要写成 #RRGGBB"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏色要寫成 #RRGGBB"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色は #RRGGBB の形式で入力してください"
          }
        }
      }
    },
