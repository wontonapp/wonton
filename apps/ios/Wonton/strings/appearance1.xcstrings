          "stringUnit": {
            "state": "translated",
            "value": "今晚吃什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚吃什麼？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜の夕飯、何にする？"
          }
        }
      }
    },
