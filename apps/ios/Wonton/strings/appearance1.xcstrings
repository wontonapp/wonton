    "appearance.previewMessage": {
      "comment": "Sample chat bubble on the appearance page, hidden from accessibility; it shows how the theme looks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's for dinner tonight?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚吃什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚吃什麼？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜の夕飯、何にする？"
          }
        }
      }
    },
