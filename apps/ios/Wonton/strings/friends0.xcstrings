{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "friends.friend.badge": {
      "comment": "Marks a received request as a friend request; plain direct-chat invitations have no such line.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friend request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好友請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちリクエスト"
          }
        }
      }
    },
    "friends.outgoing": {
      "comment": "Section of requests this account sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出的请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發出的請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送ったリクエスト"
          }
        }
      }
    },
    "friends.outgoing.waiting": {
      "comment": "Status of a sent friend request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for them to accept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等对方同意"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等對方同意"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の承認待ち"
          }
        }
      }
    },
    "friends.sent": {
      "comment": "Second line of a sent friend request. Argument: the relative time it was sent, like “5 minutes ago”.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发出：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發出：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信：%@"
          }
        }
      }
    },
    "friends.decline": {
      "comment": "Rejects the invite.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絕"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        }
      }
    },
    "friends.cancel": {
      "comment": "Withdraws a sent friend request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを取り消す"
          }
        }
      }
    },
    "friends.groups.join": {
      "comment": "Separator between the names of the groups of one friend.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、"
          }
        }
      }
    },
    "friends.groups.new": {
      "comment": "Starts a new group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Group"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建分组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增分組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作成"
          }
        }
      }
    },
    "friends.groups.delete.title": {
      "comment": "Confirmation to delete a group. Argument: the group name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete group “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除分组“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除分組「%@」？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ「%@」を削除しますか"
          }
        }
      }
    },
    "friends.block.server.field": {
      "comment": "Label of the server name field used to block a whole server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー名"
          }
        }
      }
    },
    "friends.error.invalidUserId.nextStep": {
      "comment": "Shows the shape of a Matrix ID.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the full ID, like @bob:example.org."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用完整 ID，比如 @bob:example.org。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用完整 ID，例如 @bob:example.org。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な ID（例：@bob:example.org）を使ってください。"
          }
        }
      }
    },
    "friends.error.requestNotFound": {
      "comment": "Title when the request was already handled or cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request is gone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条请求已经不在了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條請求已經不在了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのリクエストはもうありません"
          }
        }
      }
    },
    "friends.error.requestNotFound.nextStep": {
      "comment": "Explains what to do about a vanished request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other side may have cancelled it. Refresh to update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方可能已经取消，刷新看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方可能已經取消，重新整理看看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が取り消した可能性があります。更新してください。"
          }
        }
      }
    },
    "friends.error.rateLimited": {
      "comment": "Title when the server rate limited friend invitations.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求太頻繁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます"
          }
        }
      }
    },
    "friends.error.rateLimited.nextStep": {
      "comment": "Tells how long to wait after a rate limit. Argument: seconds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in %lld s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请 %lld 秒后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請 %lld 秒後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒後にやり直してください。"
          }
        }
      }
    },
    "friends.botContact.badge": {
      "comment": "Label on an incoming chat invite from a bot that asks you to be its contact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot contact request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot 联系人请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot 聯絡人請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットの連絡先リクエスト"
          }
        }
      }
    }
  }
}
