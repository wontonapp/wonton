{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "share.add": {
      "comment": "Button that creates an app share for a friend or group. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を追加"
          }
        }
      }
    },
    "share.count": {
      "comment": "Plugin detail badge showing how many friends can access this app. Argument: count, an integer; use native plural rules.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Shared with %lld friend"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Shared with %lld friends"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已分享给 %lld 个好友"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已分享給 %lld 位好友"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 人の友だちと共有中"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "share.edit": {
      "comment": "Title of the editor for an existing app share. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を編集"
          }
        }
      }
    },
    "share.friends": {
      "comment": "Section title for individual friends in the share recipient picker. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だち"
          }
        }
      }
    },
    "share.hour": {
      "comment": "Expiration choice that grants access for one hour from now. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 hour"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小時"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 時間"
          }
        }
      }
    },
    "share.problem.unreachable": {
      "comment": "Shared app problem when the sharing friend's server cannot be reached. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot connect to this friend’s server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上这位好友的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上這位好友的伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちのサーバーに接続できません"
          }
        }
      }
    },
    "share.revoke": {
      "comment": "Destructive action that immediately removes access granted by an app share. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收回分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收回分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を取り消す"
          }
        }
      }
    },
    "share.risk": {
      "comment": "Prominent warning before sharing an app without declared friend support. Explain account creation and possible access to the owner's data. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your friend will sign in to this app with their own username. The app may create an account for them and let them see your data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友会以自己的用户名登录这个应用，应用可能给他建账号、让他看到你的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好友會以自己的使用者名稱登入這個應用程式，應用程式可能為他建立帳號，讓他看到你的資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちは自分のユーザー名でこのアプリにログインします。アプリが友だちのアカウントを作成し、あなたのデータを閲覧できるようにする可能性があります。"
          }
        }
      }
    },
    "share.unknown": {
      "comment": "Recipient label when the saved friend or group is no longer available. No arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown recipient"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知接收方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知對象"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な共有相手"
          }
        }
      }
    }
  }
}
