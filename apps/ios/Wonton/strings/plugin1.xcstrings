{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "plugin.permission.opened.owner": {
      "comment": "When the owner turned this optional permission on. %@ is the date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You turned this on %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %@ 打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %@ 開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にあなたがオン"
          }
        }
      }
    },
    "plugin.permission.risk.highest": {
      "comment": "Explicit permission risk level shown in previews and installed plugin details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest risk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高级风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最高級風險"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高リスク"
          }
        }
      }
    },
    "plugin.root.permission.badge": {
      "comment": "Accessibility label of the lock on a plugin tile whose root permission is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plugin can control the whole host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个插件能控制整台主机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個外掛能控制整台主機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインはホスト全体を操作できます"
          }
        }
      }
    },
    "plugin.task.installDone": {
      "comment": "Status of a finished install task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールしました"
          }
        }
      }
    },
    "plugin.saveGrant.title": {
      "comment": "Section title above the folders the bot may save files into.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders It Can Save To"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能存文件的文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能存檔案的資料夾"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できるフォルダ"
          }
        }
      }
    },
    "plugin.info.stars": {
      "comment": "Information row: the repository's star count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stars"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "星标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "星號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スター"
          }
        }
      }
    },
    "plugin.uninstall.keepData": {
      "comment": "Uninstall dialog action: remove the app but keep its data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall and Keep Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载，保留数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝，保留資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストール（データを残す）"
          }
        }
      }
    },
    "plugin.uninstall.deleteData": {
      "comment": "Uninstall dialog action: remove the app and its data. This cannot be undone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstall and Delete Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载并删除数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解除安裝並刪除資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストール（データも削除）"
          }
        }
      }
    },
    "plugin.uninstall.deleteDataWarning": {
      "comment": "Message of the uninstall confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting data also removes its keys and bot accounts. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除数据会一并删掉它的密钥和 Bot 账号，不能恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除資料會一併刪掉它的金鑰和 Bot 帳號，無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを削除すると、鍵とボットのアカウントも一緒に削除され、元に戻せません。"
          }
        }
      }
    },
    "plugin.screenshot": {
      "comment": "Accessibility label of a screenshot on the app detail page, including its placeholder while it loads.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショット"
          }
        }
      }
    }
  }
}
