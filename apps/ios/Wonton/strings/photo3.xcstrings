{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "photo.sectionTimeline": {
      "comment": "Bottom switcher item: the timeline of all photos.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        }
      }
    },
    "photo.albumsMine": {
      "comment": "Group header in the album list: albums I own.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分"
          }
        }
      }
    },
    "photo.searchPrompt": {
      "comment": "Placeholder of the search field: describe the picture.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the photo, like “sunset at the beach”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述画面，比如“海边的日落”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述畫面，例如「海邊的日落」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の内容を入力（例：海辺の夕日）"
          }
        }
      }
    },
    "photo.kindVideo": {
      "comment": "Filter chip and accessibility name: videos.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ"
          }
        }
      }
    },
    "photo.trashConfirmHint": {
      "comment": "Under the trash confirmation: where to restore.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can restore them from the photo app's trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后可以在相册应用的回收站里恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以在相簿應用程式的垃圾桶還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで写真アプリのゴミ箱から復元できます。"
          }
        }
      }
    },
    "photo.doneTrash": {
      "comment": "Result notice. Argument: count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Moved %lld item to the trash"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Moved %lld items to the trash"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已把 %lld 项移到回收站"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "已將 %lld 項移到垃圾桶"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld項目をゴミ箱に移動しました"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "photo.doneCreate": {
      "comment": "Result notice after creating an album.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album created"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册建好了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿已建立"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを作成しました"
          }
        }
      }
    },
    "photo.partFailed": {
      "comment": "Second sentence of a result notice when some items failed. Argument: count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld item couldn't be changed"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld items couldn't be changed"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 项没成"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 項沒有成功"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld項目は変更できませんでした"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "photo.problemRetryNext": {
      "comment": "Next step: try again later.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过一会儿再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてからもう一度お試しください。"
          }
        }
      }
    },
    "photo.shareEmpty": {
      "comment": "Shown in the share sheet when there is nobody to share with.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other family members yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有其他家人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有其他家人"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの家族はまだいません"
          }
        }
      }
    }
  }
}
