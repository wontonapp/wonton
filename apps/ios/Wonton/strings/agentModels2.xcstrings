{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "agentModels.test.okIn": {
      "comment": "Test result: the model replied; %@ is the time in seconds, already formatted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working · %@ s"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能用 · %@ 秒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以用 · %@ 秒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できます · %@ 秒"
          }
        }
      }
    },
    "agentModels.test.unreachable": {
      "comment": "Test result: the provider could not be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the provider"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务商"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上服務商"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーに接続できません"
          }
        }
      }
    },
    "agentModels.test.other": {
      "comment": "Test result: failed for a reason this app version doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test didn't pass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没测通"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試沒通過"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストに失敗しました"
          }
        }
      }
    },
    "agentModels.providers.more": {
      "comment": "Toggle that reveals the providers the plugin didn't mark as recommended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        }
      }
    },
    "agentModels.providers.connected": {
      "comment": "A provider that already has a key or sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已接好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        }
      }
    },
    "agentModels.login.start": {
      "comment": "Button: start a device-code sign-in with the provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン"
          }
        }
      }
    },
    "agentModels.key.unverified": {
      "comment": "The key was saved but this provider has no way to check it in advance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. This provider can't check keys in advance, so run a test to see if it works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存。这家没法提前验证 key，能不能用要测一下才知道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存。這家無法提前驗證 key，能不能用要測一下才知道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。このプロバイダーはキーを事前に確認できないため、テストで確かめてください。"
          }
        }
      }
    },
    "agentModels.models.use": {
      "comment": "Primary button: make the selected model the Bot's main model.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use This Model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用這個"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルを使う"
          }
        }
      }
    },
    "agentModels.models.inUse": {
      "comment": "Tag on the model the Bot currently uses.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中"
          }
        }
      }
    },
    "agentModels.models.empty": {
      "comment": "The provider is connected but lists no models.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider has no models to choose from"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这家没有可选的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這家沒有可選的模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択できるモデルがありません"
          }
        }
      }
    },
    "agentModels.confirm.use": {
      "comment": "Dialog button: use the expensive model anyway.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use It"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する"
          }
        }
      }
    },
    "agentModels.problem.forbidden.next": {
      "comment": "Next step for the forbidden error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the owner for permission to manage models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请主人给你开通模型设置的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請主人為你開通模型設定的權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーナーにモデル設定の権限を依頼してください。"
          }
        }
      }
    },
    "agentModels.problem.notInstalled.next": {
      "comment": "Next step for the not-installed error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in Apps that it's still installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到应用里看看它还在不在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到應用程式裡看看它還在不在。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ一覧でインストール状況を確認してください。"
          }
        }
      }
    },
    "agentModels.problem.notReady": {
      "comment": "Error: the Bot's container isn't up yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant is still starting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手还没启动好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手還沒啟動好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはまだ起動中です"
          }
        }
      }
    },
    "agentModels.problem.notReady.next": {
      "comment": "Next step for the not-ready error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a moment, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等一会儿再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等一下再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく待ってからもう一度お試しください。"
          }
        }
      }
    },
    "agentModels.problem.unsupported.next": {
      "comment": "Next step for the unsupported error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update its app, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新它的应用后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新它的應用程式後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを更新してからもう一度お試しください。"
          }
        }
      }
    },
    "agentModels.problem.notFound": {
      "comment": "Error: the provider or sign-in no longer exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is no longer available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一项已经不在了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一項已經不在了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はもうありません"
          }
        }
      }
    },
    "agentModels.problem.notFound.next": {
      "comment": "Next step for the not-found error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back and start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回后重新来一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回後重新來一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻ってやり直してください。"
          }
        }
      }
    }
  }
}
