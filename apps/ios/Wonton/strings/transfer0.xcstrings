{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "transfer.cleanUp": {
      "comment": "Icon button on a downloaded transfer: opens the dialog asking what to clean up.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "transfer.cleanupDeleteFile": {
      "comment": "Destructive action in the cleanup dialog: remove the record and also delete the downloaded file on this phone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also Delete the File on This Phone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连手机上的文件一起删"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連手機上的檔案一起刪"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上のファイルも削除"
          }
        }
      }
    },
    "transfer.cleanupRecordOnly": {
      "comment": "Action in the cleanup dialog: remove the transfer record, keep the downloaded file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Record Only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只清記錄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録だけ削除"
          }
        }
      }
    },
    "transfer.clear": {
      "comment": "Icon button on a transfer: remove it from the strip without deleting anything.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリア"
          }
        }
      }
    },
    "transfer.downloaded": {
      "comment": "Title of the sheet listing downloaded transfers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済み"
          }
        }
      }
    },
    "transfer.linkNotSent": {
      "comment": "Line under an upload: it finished, but the link never reached the room. Argument: the home server's reason, shown as is.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded, but the link wasn't sent: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已传完，链接没发出：%1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已傳完，連結沒發出：%1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードは完了しましたが、リンクを送信できませんでした：%1$@"
          }
        }
      }
    },
    "transfer.roomMissing": {
      "comment": "Line under a transfer that lives in another room: that room isn't in the home server's room list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target room isn't in the home server's list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标房间不在这台服务器的列表里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標房間不在這台伺服器的清單裡"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信先のルームが自宅サーバのリストにありません"
          }
        }
      }
    },
    "transfer.sentTo": {
      "comment": "Caption under a transfer that was sent to another room. Argument: that room's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发到 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送到 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に送信"
          }
        }
      }
    },
    "transfer.share": {
      "comment": "Icon button on a downloaded transfer: share the file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "transfer.stopSending": {
      "comment": "Text button on an upload whose link hasn't been sent: cancel it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Sending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不发了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止傳送"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信を中止"
          }
        }
      }
    },
    "transfer.download": {
      "comment": "Accessibility label of the direction icon on a download.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    }
  }
}
