{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "pluginSources.add": {
      "comment": "Button that adds the typed source address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "pluginSources.address": {
      "comment": "Label for the text field where you type a source address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス"
          }
        }
      }
    },
    "pluginSources.continue": {
      "comment": "Button that proceeds with the typed source address when changing versions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "pluginSources.fileTooLarge": {
      "comment": "Reason shown when the picked archive is bigger than the server accepts. Argument: the size limit, formatted as a file size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File is too large. The limit is %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件太大了，最多 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案太大了，最多 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎます。最大 %@ です。"
          }
        }
      }
    },
    "pluginSources.installFromFile": {
      "comment": "Button that opens the file picker to install from an archive.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install from File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從檔案安裝"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルからインストール"
          }
        }
      }
    },
    "pluginSources.mine": {
      "comment": "Section title above the sources you added, in the store list and on the Add Source page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Sources"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我添加的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我新增的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加した提供元"
          }
        }
      }
    },
    "pluginSources.title": {
      "comment": "Title of the page where you add a source by address or install from a file.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加来源"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增來源"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元を追加"
          }
        }
      }
    },
    "pluginSources.unreviewedWarning": {
      "comment": "Warning at the top of the Add Source page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps and files added here aren't reviewed. Install only what you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里添加的应用和文件都没有经过审核，只装你信任的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡新增的 App 和檔案都沒有經過審核，只裝你信任的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに追加したアプリとファイルは審査されていません。信頼できるものだけをインストールしてください。"
          }
        }
      }
    }
  }
}
