{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "coreUpgrade.check.notInstalled": {
      "comment": "Channel state on the update page: the server wasn't installed with the install script, so one-tap updates aren't available.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server wasn't installed with the install script, so it can't update itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台服务器不是用安装脚本装的，不能一键升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台伺服器不是用安裝腳本安裝的，無法一鍵更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはインストールスクリプトで導入されていないため、ワンタップではアップデートできません"
          }
        }
      }
    },
    "coreUpgrade.checking": {
      "comment": "Button on the update page while the channel check is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中"
          }
        }
      }
    },
    "coreUpgrade.confirmVersion": {
      "comment": "Heading of the offer card in the confirm step. Argument: the new version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update to %1$@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级到 %1$@？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 %1$@？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にアップデートしますか？"
          }
        }
      }
    },
    "coreUpgrade.detail.reason": {
      "comment": "Collapsed details row on the update page: the core's own reason for the failed update, shown verbatim.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reason"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原因"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原因"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由"
          }
        }
      }
    },
    "coreUpgrade.failure.changed": {
      "comment": "Update failure summary: the version on the channel changed since the owner approved it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version on the channel changed. Review it again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渠道上的版本变了，要重新确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的新版本變了，請重新確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルのバージョンが変わりました。もう一度確認してください"
          }
        }
      }
    },
    "coreUpgrade.failure.initFailed": {
      "comment": "Update failure summary: the new version rejected the update, for example because it needs an older core first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new version rejected this update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本拒绝了这次升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本拒絕了這次更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがこのアップデートを拒否しました"
          }
        }
      }
    },
    "coreUpgrade.failure.noSpace": {
      "comment": "Update failure summary: the computer is out of disk space.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough disk space"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘不够"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟空間不足"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空きが足りません"
          }
        }
      }
    },
    "coreUpgrade.failure.timedOut": {
      "comment": "Update failure summary: a step of the update exceeded its time limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update timed out"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过了时限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新逾時"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限時間を超えました"
          }
        }
      }
    },
    "coreUpgrade.failure.unhealthy": {
      "comment": "Update failure summary: the new version didn't pass the health check.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new version didn't pass the health check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本没通过健康检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新版本沒通過健康檢查"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンがヘルスチェックに合格しませんでした"
          }
        }
      }
    },
    "coreUpgrade.phase.rollingBack": {
      "comment": "Update phase: restoring the old version after a failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolling back to the old version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退回旧版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在退回舊版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧バージョンにロールバック中"
          }
        }
      }
    },
    "coreUpgrade.rolledBackTo": {
      "comment": "Stage line after the update failed and the old version was restored. Argument: the version now running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolled back to %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退回 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已退回 %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@にロールバックしました"
          }
        }
      }
    },
    "coreUpgrade.skipVersion": {
      "comment": "Secondary button on the offer card: skip this version and don't ask again until the channel changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip This Version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过这个版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跳過這個版本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンをスキップ"
          }
        }
      }
    },
    "coreUpgrade.skipped": {
      "comment": "Note on the offer card after the owner skipped this version.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳過"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ済み"
          }
        }
      }
    },
    "coreUpgrade.upgrade": {
      "comment": "Primary button on the offer card: open the confirm step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート"
          }
        }
      }
    }
  }
}
