{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.model.expanded": {
      "comment": "Accessibility value of the provider-list toggle while the list is expanded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已展开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已展開"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開済み"
          }
        }
      }
    },
    "onboarding.pendingCard.one": {
      "comment": "Banner when one approval card is waiting. The argument is the card's title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs your approval"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の確認待ちです"
          }
        }
      }
    },
    "onboarding.problem.model.upstream": {
      "comment": "Problem title in setup: the home server hit an error answering the request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home server hit an error"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家里的服务器出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家用伺服器出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバでエラーが発生しました"
          }
        }
      }
    },
    "onboarding.review.signInAfterSetup": {
      "comment": "Row description in the review step: the agent signs in from chat after setup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in from chat after setup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装好后在聊天里登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝好後在聊天裡登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップ後にチャットでログイン"
          }
        }
      }
    },
    "onboarding.step.agent": {
      "comment": "Card title at the top of the agent step in setup: pick the agent to use.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选 Agent"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Agent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの選択"
          }
        }
      }
    },
    "onboarding.step.model": {
      "comment": "Card title at the top of the model step in setup: connect a model provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの接続"
          }
        }
      }
    },
    "onboarding.tip.confirmationCard": {
      "comment": "Dismissable tip above the chat input: confirm approval requests on the card in chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve requests from the card in chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认时，在聊天里的卡片上点确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要確認時，在聊天裡的卡片上點確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要なときは、チャットのカードで確認してください。"
          }
        }
      }
    },
    "onboarding.gatewayMissing.title": {
      "comment": "Problem title when the model gateway's web page can't be found among the installed apps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find the model gateway's page"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到模型网关的网页"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到模型閘道的網頁"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルゲートウェイのページが見つかりません"
          }
        }
      }
    }
  }
}
