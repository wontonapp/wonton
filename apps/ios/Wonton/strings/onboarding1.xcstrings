{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.pendingCard.one": {
      "comment": "Banner when one approval card is waiting. The argument is the card's title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs your approval"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の確認待ちです"
          }
        }
      }
    },
    "onboarding.step.model": {
      "comment": "Card title at the top of the model step in setup: connect a model provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Model"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接模型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの接続"
          }
        }
      }
    },
    "onboarding.tip.confirmationCard": {
      "comment": "Dismissable tip above the chat input: confirm approval requests on the card in chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve requests from the card in chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认时，在聊天里的卡片上点确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要確認時，在聊天裡的卡片上點確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要なときは、チャットのカードで確認してください。"
          }
        }
      }
    }
  }
}
