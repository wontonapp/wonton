            "value": "查看協議"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "契約を読む"
          }
        }
      }
    },
    "clients.domain.certificate": {
      "comment": "Heading of the certificate section.",
      "extractionState": "manual",
      "localizations": {
