          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に期限切れ"
          }
        }
      }
    },
    "clients.domain.cert.renewing": {
      "comment": "Renewal failed; the old certificate is still in use.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renewal failed; the old certificate is still in use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续期失败，还在用旧证书"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "續期失敗，還在用舊憑證"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新に失敗しました。古い証明書を使い続けています"
          }
        }
      }
    },
    "clients.domain.cert.expired": {
      "comment": "The certificate expired; connections fail.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate expired; connections fail"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
