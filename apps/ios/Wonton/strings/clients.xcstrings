    "clients.domain.terms": {
      "comment": "Checkbox for the Let's Encrypt subscriber agreement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I accept the Let's Encrypt subscriber agreement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意 Let's Encrypt 的订户协议"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我同意 Let's Encrypt 的訂戶協議"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's Encrypt の加入者契約に同意します"
          }
        }
