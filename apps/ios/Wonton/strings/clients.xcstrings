          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去 desec.io 註冊，再建一個只能寫 _acme-challenge 和 _acme-challenge.lan 兩個 TXT 記錄的權杖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "desec.io で登録し、_acme-challenge と _acme-challenge.lan の 2 つの TXT レコードだけを書けるトークンを作ります。"
          }
        }
      }
