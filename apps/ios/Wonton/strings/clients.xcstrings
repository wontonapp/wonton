{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "clients.domain.title": {
      "comment": "Title of the HTTPS and domain settings page and its settings row.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS and domain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 和域名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 和網域"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS とドメイン"
          }
        }
      }
    },
    "clients.domain.suffix": {
      "comment": "Label of the domain field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Domain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "域名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網域"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメイン"
          }
        }
      }
    },
    "clients.domain.suffix.note": {
      "comment": "Shown under a changeable domain: third-party apps must re-enter the address.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-party apps must re-enter the address after a change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改了以后第三方 App 都要重填地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改了以後第三方 App 都要重填地址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更後はサードパーティのアプリでアドレスを入れ直してください"
          }
        }
      }
    },
    "clients.domain.provider": {
      "comment": "Heading of the DNS provider choice list.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
