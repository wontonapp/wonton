{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "message.sendFailure.offline": {
      "comment": "Send failed because the phone can't reach the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません"
          }
        }
      }
    },
    "message.sendFailure.replyTarget": {
      "comment": "Send failed because the message being replied to is gone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quoted message is gone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要回复的那条不在了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要回覆的那則不在了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信元のメッセージがありません"
          }
        }
      }
    },
    "message.keyNoticeRecovery": {
      "comment": "One-line hint beside undecryptable history: the account has a key backup.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your recovery key in Chat Backup to read these earlier messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「聊天记录备份」输入恢复密钥，解开这些旧消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「聊天記錄備份」輸入復原金鑰，解開這些舊訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チャットのバックアップ」で復旧キーを入力すると、以前のメッセージが読めます。"
          }
        }
      }
    },
    "message.keyNoticeVerify": {
      "comment": "One-line hint beside undecryptable history: no backup, another verified device must confirm.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify this device from your other device to receive the keys. Start in Chat Backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「聊天记录备份」用另一台设备确认这台设备，取回密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「聊天記錄備份」用另一部裝置確認這台裝置，取回金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チャットのバックアップ」で別のデバイスからこのデバイスを確認し、鍵を受け取ります。"
          }
        }
      }
    },
    "message.linkOpenBrowser": {
      "comment": "Action in a message link's long-press menu; opens the link in the system browser.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器開啟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで開く"
          }
        }
      }
    },
    "message.forward": {
      "comment": "Item in the message menu: send a copy to another room.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉發"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送"
          }
        }
      }
    },
    "message.originalUnavailable": {
      "comment": "Title of the failure notice in the original-image preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't load the original"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取不到原图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得原圖"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像を読み込めません"
          }
        }
      }
    },
    "message.quoteOther": {
      "comment": "The quoted message is a card or a type the app can't preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一則訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ"
          }
        }
      }
    },
    "message.redact": {
      "comment": "Item in the message menu: delete this message for everyone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for Everyone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收回"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員に送信取消"
          }
        }
      }
    },
    "message.redactTitle": {
      "comment": "Title of the confirmation before redacting a message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回这条消息？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收回這則訊息？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員のメッセージを送信取消にしますか？"
          }
        }
      }
    },
    "message.sentAt": {
      "comment": "Label of the send time shown at the bottom of a message's context menu.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent at %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送时间 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送時間 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信日時 %@"
          }
        }
      }
    },
    "message.undecryptable": {
      "comment": "Placeholder when this device has no key for the message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't decrypt: this device has no key for this message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密：本设备还没有这条消息的密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解密：這台裝置還沒有這則訊息的金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号できません：このデバイスにはこのメッセージの鍵がありません"
          }
        }
      }
    },
    "message.unsupported": {
      "comment": "Placeholder for a message kind this version doesn't show. Argument: the kind.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported message (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持显示的消息（%@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援顯示的訊息（%@）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未対応のメッセージ（%@）"
          }
        }
      }
    },
    "message.resend": {
      "comment": "Menu item on a failed message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重傳"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再送信"
          }
        }
      }
    }
  }
}
