{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "message.forward": {
      "comment": "Item in the message menu: send a copy to another room.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉發"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送"
          }
        }
      }
    },
    "message.originalUnavailable": {
      "comment": "Title of the failure notice in the original-image preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't load the original"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取不到原图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得原圖"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像を読み込めません"
          }
        }
      }
    },
    "message.quoteOther": {
      "comment": "The quoted message is a card or a type the app can't preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一則訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ"
          }
        }
      }
    },
    "message.redact": {
      "comment": "Item in the message menu: delete this message for everyone.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for Everyone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收回"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員に送信取消"
          }
        }
      }
    },
    "message.redactTitle": {
      "comment": "Title of the confirmation before redacting a message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回这条消息？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收回這則訊息？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員のメッセージを送信取消にしますか？"
          }
        }
      }
    },
    "message.undecryptable": {
      "comment": "Placeholder when this device has no key for the message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't decrypt: this device has no key for this message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密：本设备还没有这条消息的密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解密：這台裝置還沒有這則訊息的金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号できません：このデバイスにはこのメッセージの鍵がありません"
          }
        }
      }
    },
    "message.unsupported": {
      "comment": "Placeholder for a message kind this version doesn't show. Argument: the kind.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported message (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持显示的消息（%@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援顯示的訊息（%@）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未対応のメッセージ（%@）"
          }
        }
      }
    },
    "message.sendFailed": {
      "comment": "Send state that needs a decision. Argument: the core's reason.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信に失敗しました：%@"
          }
        }
      }
    },
    "message.resend": {
      "comment": "Menu item on a failed message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重傳"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再送信"
          }
        }
      }
    }
  }
}
