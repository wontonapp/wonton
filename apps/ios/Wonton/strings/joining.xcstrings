    "joining.failure.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An admin declined your request to join"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员拒绝了加入请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理員拒絕了加入請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者が参加リクエストを断りました"
          }
        }
      }
    },
    "joining.failure.codeUsed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation code has already been used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个邀请码已经用过了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個邀請碼已經用過了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この招待コードは使用済みです"
          }
        }
      }
    },
    "joining.nextStep.invite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask an admin for a new invitation code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请管理员重新发一个邀请码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請管理員重新發一個邀請碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者に新しい招待コードを発行してもらってください。"
          }
