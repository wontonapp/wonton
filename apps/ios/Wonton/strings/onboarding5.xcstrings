{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.keep": {
      "comment": "Button that keeps the agent that a new one replaces.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す"
          }
        }
      }
    },
    "onboarding.model.custom": {
      "comment": "Row title: type a model provider by hand instead of picking a recommended one.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム"
          }
        }
      }
    },
    "onboarding.model.more": {
      "comment": "Button that expands the list of less common model providers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Providers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多服务商"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多供應商"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他のプロバイダ"
          }
        }
      }
    },
    "onboarding.model.openSettings": {
      "comment": "Button that opens the model gateway's settings page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Model Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开模型设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟模型設定"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル設定を開く"
          }
        }
      }
    },
    "onboarding.model.test": {
      "comment": "Button that checks the typed API key against the model provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "測試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト"
          }
        }
      }
    },
    "onboarding.model.useLogin": {
      "comment": "Row title: sign in to a model provider with an account. The argument is the login's name (like \"ChatGPT account\").",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を使用"
          }
        }
      }
    },
    "onboarding.problem.model.keyRejected.next": {
      "comment": "Line under the problem title: the rejected key wasn't saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key wasn't saved. Fix it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "key 没有保存，改好后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰沒有儲存，改好後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーは保存されていません。修正してから再試行してください。"
          }
        }
      }
    },
    "onboarding.problem.model.protocol.next": {
      "comment": "Line under the problem title: update the app or the home server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Wonton or your home server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 App 或家里的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請更新 App 或家用伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonか自宅サーバを更新してください。"
          }
        }
      }
    },
    "onboarding.problem.model.transportUnavailable": {
      "comment": "Problem title in setup: the home server can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach your home server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上家里的服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上家用伺服器"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに接続できません"
          }
        }
      }
    },
    "onboarding.problem.store.rateLimited": {
      "comment": "Problem title in setup: too many requests to the recommendation source.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求太頻繁了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます"
          }
        }
      }
    },
    "onboarding.problem.store.unreachable": {
      "comment": "Problem title in setup: the recommendation source can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't load the recommendations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取不到推荐清单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得推薦清單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを読み込めません"
          }
        }
      }
    },
    "onboarding.review.setDefault": {
      "comment": "Row description in the review step: the item is set as the default agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set as Default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为默认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設為預設"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトに設定"
          }
        }
      }
    },
    "onboarding.review.uncertain": {
      "comment": "Problem title in the review step: it's unknown whether the app installed. The reason is in the collapsed details.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Result Unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定装好没有"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定裝好沒有"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされたか確認できません"
          }
        }
      }
    },
    "onboarding.review.uncertainNext": {
      "comment": "Line under the problem title: the result shows on the app's page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the app's page for the install result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到应用页查看安装结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 App 頁面查看安裝結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのページでインストール結果を確認してください。"
          }
        }
      }
    },
    "onboarding.tip.appInstalled": {
      "comment": "Dismissable tip after an app installed: it can be added to the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add an installed app to the Tab Bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用装好后，可以把它放到底栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 安裝好後，可以把它加到標籤列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをインストールしたら、タブバーに追加できます。"
          }
        }
      }
    },
    "onboarding.agentPlaceholder": {
      "comment": "Placeholder of a field that takes the agent's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 名称"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント名"
          }
        }
      }
    }
  }
}
