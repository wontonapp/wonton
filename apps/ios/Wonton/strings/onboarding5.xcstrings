{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.problem.store.rateLimited": {
      "comment": "Problem title in setup: too many requests to the recommendation source.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求太頻繁了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます"
          }
        }
      }
    },
    "onboarding.problem.store.unreachable": {
      "comment": "Problem title in setup: the recommendation source can't be reached.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't load the recommendations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取不到推荐清单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得推薦清單"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを読み込めません"
          }
        }
      }
    },
    "onboarding.review.uncertain": {
      "comment": "Title when it's unknown whether the app installed; the next line says to check the app's page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure whether it installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定装好了没有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不確定裝好了沒有。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールできたか分かりません。"
          }
        }
      }
    },
    "onboarding.review.uncertainNext": {
      "comment": "Line under the problem title: the result shows on the app's page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the app's page for the install result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到应用页查看安装结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到 App 頁面查看安裝結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのページでインストール結果を確認してください。"
          }
        }
      }
    },
    "onboarding.tip.appInstalled": {
      "comment": "Dismissable tip after an app installed: it can be added to the tab bar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add an installed app to the Tab Bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用装好后，可以把它放到底栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 安裝好後，可以把它加到標籤列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをインストールしたら、タブバーに追加できます。"
          }
        }
      }
    },
    "onboarding.review.sectionAssistant": {
      "comment": "Review page: category label above the assistant's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタント"
          }
        }
      }
    },
    "onboarding.review.modelNotTested": {
      "comment": "Review page, model row: the model hasn't been tested.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not tested yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没测试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒測試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだテストしていません"
          }
        }
      }
    }
  }
}
