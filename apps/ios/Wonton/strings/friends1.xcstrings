{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "friends.add": {
      "comment": "Toolbar button that opens the add-friend field, and the sheet title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Friend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加好友"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加好友"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちを追加"
          }
        }
      }
    },
    "friends.empty": {
      "comment": "Empty state of the Friends page when there are no friends and no requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No friends yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有好友"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有好友"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ友だちがいません"
          }
        }
      }
    },
    "friends.requests": {
      "comment": "Header of the friend request section on the Other Servers page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friend Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好友請求"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちリクエスト"
          }
        }
      }
    },
    "friends.list": {
      "comment": "Section of friends.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好友"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だち"
          }
        }
      }
    },
    "friends.groups.choose": {
      "comment": "Title of the sheet for picking the groups of one friend.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ"
          }
        }
      }
    },
    "friends.groups.empty": {
      "comment": "Shown when there are no groups, in the group picker and on a friend without groups.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No groups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有分组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有分組"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループなし"
          }
        }
      }
    },
    "friends.groups.name": {
      "comment": "Label of the group name field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分組名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ名"
          }
        }
      }
    },
    "friends.error.forbidden": {
      "comment": "Title when the server refused a friend action although the sign-in is valid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was refused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求被拒绝了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求被拒絕了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが拒否されました"
          }
        }
      }
    },
    "friends.error.forbidden.nextStep": {
      "comment": "Explains why a friend action was refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They may have blocked you, or their server can't reach your home server yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方可能屏蔽了你，或者对方的服务器还不能和家里的服务器互通。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方可能封鎖了你，或者對方的伺服器還不能和家裡的伺服器互通。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手にブロックされているか、相手のサーバーがまだ自宅のサーバーとつながっていない可能性があります。"
          }
        }
      }
    },
    "friends.shared.none": {
      "comment": "Shown on a friend with no shared plugins.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No plugins shared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有分享插件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有分享外掛"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有しているプラグインなし"
          }
        }
      }
    },
    "friends.shared": {
      "comment": "How many plugins are shared with one friend. Argument: the number of plugins.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld plugin shared"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld plugins shared"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "分享 %lld 个插件"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "分享 %lld 個外掛"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 個のプラグインを共有"
                }
              }
            }
          }
        }
      }
    }
  }
}
