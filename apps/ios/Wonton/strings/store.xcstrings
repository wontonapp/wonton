            "value": "開く"
          }
        }
      }
    },
    "store.problemFromSource": {
      "comment": "Problem title in the store with the source it came from. Arguments: the provider's name, the problem title from the core.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
