        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在載入 %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を読み込み中…"
          }
        }
      }
    },
