          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@"
          }
        }
      }
    },
    "store.reading": {
      "comment": "Placeholder under an added source whose list hasn't been fetched yet. Argument: the source's provider name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading %@…"
