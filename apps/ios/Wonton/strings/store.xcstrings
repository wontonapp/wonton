{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "store.addSource": {
      "comment": "Toolbar button that opens the Add Source page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Source…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加来源"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增來源"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元を追加"
          }
        }
      }
    },
    "store.get": {
      "comment": "Button on a store row to install an app you don't have.",
      "extractionState": "manual",
      "localizations": {
