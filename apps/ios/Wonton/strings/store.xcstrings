          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つかりません"
          }
        }
      }
    },
    "store.open": {
      "comment": "Button on a store row to open an installed app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
