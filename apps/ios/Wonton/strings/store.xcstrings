        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入手"
          }
        }
      }
    },
    "store.highPermissions": {
      "comment": "Small tag on a store row for an app that asks for risky permissions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
