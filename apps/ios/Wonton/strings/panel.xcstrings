{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "panel.open": {
      "comment": "Accessibility action that opens the chat pull panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟面板"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルを開く"
          }
        }
      }
    },
    "panel.addPages": {
      "comment": "Empty panel button, also the accessibility label of its plus.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Pages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを追加"
          }
        }
      }
    },
    "panel.edit": {
      "comment": "Menu item and sheet title for editing the panel pages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯面板"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルを編集"
          }
        }
      }
    },
    "panel.inPanel": {
      "comment": "Section title of the pages already in the panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板里的页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板裡的頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネル内のページ"
          }
        }
      }
    },
    "panel.canAdd": {
      "comment": "Section title of the pages that can be added to the panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can Be Added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以放进面板的页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以放進面板的頁面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルに追加できるページ"
          }
        }
      }
    },
    "panel.remove": {
      "comment": "Button that removes a page from the panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "panel.url": {
      "comment": "Label of the URL field in the panel editor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "panel.addUrl": {
      "comment": "Button that adds the typed URL to the panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加网址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增網址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL を追加"
          }
        }
      }
    },
    "panel.pin": {
      "comment": "Menu item that pins the current page to the main panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin to Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钉到面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘到面板"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルに固定"
          }
        }
      }
    },
    "panel.badUrl": {
      "comment": "Shown when the typed panel URL is not https.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL must start with https://"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网址要以 https:// 开头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網址要以 https:// 開頭"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL は https:// で始まる必要があります"
          }
        }
      }
    },
    "panel.attention": {
      "comment": "Accessibility label of the dot that says a panel page wants attention.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New in the Panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板有新内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板有新內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルに新着"
          }
        }
      }
