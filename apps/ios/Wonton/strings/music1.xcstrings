    "music.problem.notReady.title": {
      "comment": "Problem title: the music library plugin is not running yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music library isn't ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐库还没准备好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂庫還沒準備好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリの準備ができていません"
          }
        }
      }
    },
    "music.problem.forbidden.title": {
      "comment": "Problem title: the music library refused to show this to this person.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music library won't show this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐库不让看这些内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂庫不讓看這些內容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリがこの内容の表示を拒否しました"
          }
        }
      }
    },
    "music.problem.forbidden.nextStep": {
      "comment": "Next step under the refused problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask whoever manages the music library for access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请管音乐库的人给你开权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請管音樂庫的人給你開權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリの管理者にアクセス権を依頼してください。"
          }
        }
      }
    },
    "music.problem.upstream.title": {
      "comment": "Problem title: the music library itself returned an error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music library ran into a problem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐库出错了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂庫出錯了"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックライブラリでエラーが発生しました"
          }
        }
      }
    },
    "music.pause": {
      "comment": "Player button: pause.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "zh-Hans": {
          "stringUnit": {
