{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "message.clipLabel": {
      "comment": "Label of the clipboard entry when a message is copied. Rarely shown, but must not fall back to another language. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ"
          }
        }
      }
    },
    "message.codeCopy": {
      "comment": "Accessibility label of the copy button on a code block in a message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制代码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製程式碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをコピー"
          }
        }
      }
    },
    "message.forwardEmpty": {
      "comment": "Shown in the room picker when there is no room to forward to.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rooms yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可以转发的房间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有可以轉發的房間"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送できるルームがまだありません"
          }
        }
      }
    },
    "message.forwardTitle": {
      "comment": "Title of the room picker shown when forwarding a message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉發到"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送先"
          }
        }
      }
    },
    "message.imageFormatUnsupported": {
      "comment": "Fallback under an image message when it can't be decoded: the format isn't supported. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image format isn't supported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片格式不支持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片格式不支援"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像形式はサポートされていません"
          }
        }
      }
    },
    "message.imageUnavailable": {
      "comment": "Fallback under an image message when it can't be loaded and the error carries no reason. Android only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't load this image"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取不到图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得圖片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めません"
          }
        }
      }
    },
    "message.reply": {
      "comment": "Item in the message menu: reply to this message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
