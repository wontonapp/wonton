{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "bot.state.idle": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機"
          }
        }
      }
    },
    "bot.state.label": {
      "comment": "Accessibility label of the Bot's avatar. First argument: the Bot's name, second: its status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%@"
          }
        }
      }
    },
    "bot.state.offline": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン"
          }
        }
      }
    },
    "bot.state.waiting": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ち"
          }
        }
      }
    },
    "bot.state.working": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中"
          }
        }
      }
    },
    "chatStatus.reconnecting": {
      "comment": "Status line on the chat list: signing in failed for a temporary reason and the app is retrying by itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重连…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新連線…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続しています…"
          }
        }
      }
    },
    "timeline.renamed": {
      "comment": "Timeline notice when someone changed their display name. Arguments: the old name, the new name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changed their name to %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 改名为 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 改名為 %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんが%2$@に改名しました"
          }
        }
      }
    },
    "side.chat": {
      "comment": "Title of a side chat page while its title is loading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドチャット"
          }
        }
      }
    },
    "side.chat.new": {
      "comment": "Top bar button in a chat with an AI that supports side chats; also the title of the sheet it opens.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New side chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新旁聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新旁聊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいサイドチャット"
          }
        }
      }
    },
    "side.chat.noFiles": {
      "comment": "Shown when pasting a file inside a side chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files can't be sent in a side chat. Send them in the main chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊里发不了文件，请在主对话里发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊裡傳不了檔案，請在主對話裡傳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドチャットではファイルを送れません。メインのチャットで送ってください。"
          }
        }
      }
    },
    "side.chat.placeholder": {
      "comment": "Placeholder of the first message field when starting a side chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to talk about?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想聊点什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想聊點什麼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何について話しますか"
          }
        }
      }
    },
    "side.chat.replies": {
      "comment": "Card line for a side chat in the main chat. Argument: number of replies.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Side chat · 1 reply"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Side chat · %lld replies"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "旁聊 · %lld 条"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "旁聊 · %lld 則"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "サイドチャット · %lld 件"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "side.chat.resultLine": {
      "comment": "One-line result of a side chat in the main chat. Arguments: side chat title, its state (one of the side.chat.state* strings).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Side chat “%1$@”: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊「%1$@」：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旁聊「%1$@」：%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドチャット「%1$@」：%2$@"
          }
        }
      }
    },
    "side.chat.stateDone": {
      "comment": "Side chat state: the AI finished this round.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "side.chat.stateEnded": {
      "comment": "Side chat state: the side chat was closed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ended"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束"
          }
