        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中"
          }
        }
      }
    },
    "side.chat.stateOther": {
      "comment": "Side chat state this app version doesn't know.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态未知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態未知"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態不明"
          }
        }
      }
    },
    "side.chat.stateResultMissing": {
      "comment": "Side chat state: the AI replied but never reported a result.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No result received"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没收到结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒收到結果"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が届いていません"
          }
        }
      }
    },
    "side.chat.stateUntracked": {
      "comment": "Light hint on a side chat whose AI doesn't report results.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results won't come back to the main chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果不会带回主对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果不會帶回主對話"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果はメインのチャットに戻りません"
          }
        }
      }
    },
    "side.chat.unread": {
      "comment": "Accessibility label of the unread badge on a side chat card. Argument: unread count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "1 unread"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld unread"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 条未读"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 則未讀"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "未読 %lld 件"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "side.chat.unsupported": {
      "comment": "One-line hint when New chat picked an AI that can't start side chats and the main chat opened instead.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This AI doesn't support side chats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 AI 不支持旁聊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 AI 不支援旁聊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この AI はサイドチャットに対応していません"
          }
        }
      }
    },
    "timeline.avatarChanged": {
      "comment": "Timeline notice when someone changed their photo. Argument: their name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed their photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 换了头像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 換了大頭貼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんがアイコンを変更しました"
          }
        }
      }
    },
    "timeline.readMarker": {
      "comment": "Divider above the first unread message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages below"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是新消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是新訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから新着メッセージ"
          }
        }
      }
    },
    "room.scrollToBottom": {
      "comment": "Accessibility label of the scroll-to-bottom button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to bottom"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番下へ戻る"
          }
        }
      }
    },
    "room.scrollToBottom.count": {
      "comment": "Accessibility label of the scroll-to-bottom button with new messages. %1$@ is the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to bottom, %1$@ new messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部，还有 %1$@ 条新消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部，還有 %1$@ 條新訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番下へ戻る、新着 %1$@ 件"
