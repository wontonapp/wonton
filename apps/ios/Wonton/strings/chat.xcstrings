{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "bot.state.idle": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機"
          }
        }
      }
    },
    "bot.state.label": {
      "comment": "Accessibility label of the Bot's avatar. First argument: the Bot's name, second: its status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
