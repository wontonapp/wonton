        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已結束"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        }
      }
    },
    "side.chat.stateFailed": {
      "comment": "Side chat state: this round failed or was interrupted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't finish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没完成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
