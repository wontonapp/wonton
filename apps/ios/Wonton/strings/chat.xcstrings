            "value": "沒完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了できませんでした"
          }
        }
      }
    },
    "side.chat.stateOpen": {
      "comment": "Side chat state: no result yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
