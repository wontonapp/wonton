{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "bot.state.idle": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機"
          }
        }
      }
    },
    "bot.state.label": {
      "comment": "Accessibility label of the Bot's avatar. First argument: the Bot's name, second: its status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%@"
          }
        }
      }
    },
    "bot.state.offline": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン"
          }
        }
      }
    },
    "bot.state.waiting": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等你確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ち"
          }
        }
      }
    },
    "bot.state.working": {
      "comment": "Status name shown under the state-avatar cells and read by VoiceOver with the Bot's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中"
          }
        }
      }
    },
    "chatStatus.reconnecting": {
      "comment": "Status line on the chat list: signing in failed for a temporary reason and the app is retrying by itself.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重连…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新連線…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続しています…"
          }
        }
      }
    },
    "timeline.renamed": {
      "comment": "Timeline notice when someone changed their display name. Arguments: the old name, the new name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changed their name to %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 改名为 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 改名為 %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんが%2$@に改名しました"
          }
        }
      }
    },
    "timeline.avatarChanged": {
      "comment": "Timeline notice when someone changed their photo. Argument: their name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed their photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 换了头像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 換了大頭貼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんがアイコンを変更しました"
          }
        }
      }
    },
    "timeline.readMarker": {
      "comment": "Divider above the first unread message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages below"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是新消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是新訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから新着メッセージ"
          }
        }
      }
    },
    "room.scrollToBottom": {
      "comment": "Accessibility label of the scroll-to-bottom button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to bottom"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番下へ戻る"
          }
        }
      }
    },
    "room.scrollToBottom.count": {
      "comment": "Accessibility label of the scroll-to-bottom button with new messages. %1$@ is the count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to bottom, %1$@ new messages"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部，还有 %1$@ 条新消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到底部，還有 %1$@ 條新訊息"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番下へ戻る、新着 %1$@ 件"
          }
        }
      }
    },
    "timeline.start": {
      "comment": "Divider above the first message of a chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start of the chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上是聊天的开头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上是聊天的開頭"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットの先頭"
          }
        }
      }
    }
  }
}
