{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "App name under the icon on the Home Screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "System permission prompt for the camera, shown before scanning the pairing QR code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton uses the camera to scan the pairing QR code from your home server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞用相机扫家里服务器上的配对二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞需要使用相機，掃描家用伺服器上的配對 QR 碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅サーバに表示されたペアリング用のQRコードを読み取るために、カメラを使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "System permission prompt for adding to the photo library, shown the first time a chat photo is saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton saves photos from your chats to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞把聊天里的照片存储到你的相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞會把聊天中的照片儲存到你的相簿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wontonはチャットの写真を写真ライブラリに保存します。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "System permission prompt for local network access, shown the first time the app connects to the home server directly over the LAN.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wonton connects directly to your home server over the local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云吞经局域网直连你家里的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲吞會透過區域網路直接連線到你的家用伺服器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク経由で自宅サーバに直接接続します。"
          }
        }
      }
    }
  }
}
