# Hermes：云吞的默认 Agent。核心镜像带着同一份，核心第一次启动时自动装上；这个仓库让主人卸掉以后还能从商店装回来。
#
# Hermes 用自带的 Matrix 平台以 bot 身份登录 Tuwunel；模型用 Hermes 自带的供应商接入，主人在插件网页的
# Keys 页填 key 或登录订阅、Models 页选模型。不申请 models：不依赖云吞的模型网关，没装网关也照样装、照样用。
# 每个 Bot 一组 init + gateway + web 容器（x-wonton.bots）：Hermes 的 profile 不隔离文件系统，
# 不同人的 Bot 不能共用一个容器。
name: hermes

x-image: &image nousresearch/hermes-agent:v0.23.4@sha256:ef0650d523ee1b5ab32c779acabc446d9936869a9932591553688a62bcf0c42f

services:
  # 每次创建容器时（安装、升级、重建）把 Wonton 的 Hermes 插件（wonton/）放进这个 Bot 的数据目录，覆盖旧版本；包里的
  # config.yaml 只在首次启动前写入，已有配置时不覆盖（Hermes 自己也会改写它，比如 /model）。
  # 帮助 skill（skills/wonton-help/）同样每次都覆盖，内容从公开文档原样取来。
  # 上游 v0.22.5 只在数据根目录属主不匹配时修复子目录；核心已设好根目录属主，所以 init 要交接它写的目录。
  init:
    image: *image
    entrypoint:
      - /bin/sh
      - -c
      - >-
        mkdir -p /opt/data/plugins/wonton/locales /opt/data/plugins/wonton/dashboard /opt/data/hooks/wonton-language /opt/data/skills/wonton-help &&
        cp /seed/wonton/plugin.yaml /seed/wonton/*.py /opt/data/plugins/wonton/ &&
        cp /seed/wonton/dashboard/* /opt/data/plugins/wonton/dashboard/ &&
        cp /seed/wonton/locales/*.yaml /opt/data/plugins/wonton/locales/ &&
        cp /seed/wonton-language/HOOK.yaml /seed/wonton-language/handler.py /opt/data/hooks/wonton-language/ &&
        cp /seed/skills/wonton-help/SKILL.md /opt/data/skills/wonton-help/ &&
        { test -f /opt/data/config.yaml || cp /seed/config.yaml /opt/data/config.yaml; } &&
        /opt/hermes/.venv/bin/python /seed/init_config.py &&
        chown -R ${PUID}:${PGID} /opt/data/skills /opt/data/plugins /opt/data/hooks/wonton-language
    environment:
      # 平台 extra 里的 allow_admin_from 占位符由 init 换成这个值（Hermes 不展开 extra 的 ${VAR}）。
      WONTON_MATRIX_ALLOWED_USERS: ${WONTON_MATRIX_ALLOWED_USERS:?需要主人的 Matrix 用户 ID}
      # 国内 IM 渠道开关（插件设置，true/false）：init 据此在 config.yaml 里写或撤显式停用（见 init_config.py）。
      # 开关值单独注入是为了改开关时重建 init + gateway 容器，停用状态跟着走。
      FEISHU_WONTON_ENABLED: ${WONTON_SETTING_FEISHU_ENABLED:-}
      DINGTALK_WONTON_ENABLED: ${WONTON_SETTING_DINGTALK_ENABLED:-}
      WECOM_WONTON_ENABLED: ${WONTON_SETTING_WECOM_ENABLED:-}
      QQ_WONTON_ENABLED: ${WONTON_SETTING_QQ_ENABLED:-}
      WEIXIN_WONTON_ENABLED: ${WONTON_SETTING_WEIXIN_ENABLED:-}
    volumes:
      - ${WONTON_BOT_DATA}:/opt/data
    configs:
      - source: config
        target: /seed/config.yaml
      - source: wonton_manifest
        target: /seed/wonton/plugin.yaml
      - source: wonton_hooks
        target: /seed/wonton/__init__.py
      - source: wonton_side_chat
        target: /seed/wonton/side_chat.py
      - source: wonton_message_batch
        target: /seed/wonton/message_batch.py
      - source: wonton_commands
        target: /seed/wonton/commands.py
      - source: wonton_turn
        target: /seed/wonton/turn.py
      - source: wonton_pages
        target: /seed/wonton/pages.py
      - source: wonton_dashboard_api
        target: /seed/wonton/dashboard/api.py
      - source: wonton_dashboard_manifest
        target: /seed/wonton/dashboard/manifest.json
      - source: wonton_texts
        target: /seed/wonton/texts.py
      - source: wonton_locale
        target: /seed/wonton/locale.py
      - source: wonton_language_hook
        target: /seed/wonton-language/HOOK.yaml
      - source: wonton_language_handler
        target: /seed/wonton-language/handler.py
      - source: wonton_errors_en
        target: /seed/wonton/locales/en.yaml
      - source: wonton_errors_zh
        target: /seed/wonton/locales/zh.yaml
      - source: wonton_errors_zh_hant
        target: /seed/wonton/locales/zh-hant.yaml
      - source: wonton_errors_ja
        target: /seed/wonton/locales/ja.yaml
      - source: init_config
        target: /seed/init_config.py
      - source: wonton_help_skill
        target: /seed/skills/wonton-help/SKILL.md
    network_mode: none
    restart: "no"

  gateway:
    image: *image
    restart: unless-stopped
    command: ["gateway", "run"]
    depends_on:
      init:
        condition: service_completed_successfully
    environment:
      # 镜像启动时把内部用户改成这个 uid/gid，再修正数据目录属主。
      PUID: ${PUID}
      PGID: ${PGID}
      TZ: ${TZ}
      # 官方镜像的 s6 同时管理 gateway 和 dashboard；网页重启只替换 gateway，不退出容器。
      HERMES_DASHBOARD: "1"
      HERMES_DASHBOARD_HOST: 127.0.0.1
      HERMES_DASHBOARD_PORT: "9119"
      # gateway.trust_env 已关闭；Telegram 单独使用核心的出口代理，未配代理时为空。
      TELEGRAM_PROXY: ${WONTON_PROXY_URL}
      # 国内 IM 渠道：凭据来自插件设置（App ID）和插件密钥（Secret），空串表示没配，Hermes 不启用该渠道、不报错。
      # 变量名是 Hermes 认的（各平台 gateway_env 桥接，见上游文档）；飞书固定走 WebSocket 长连接，钉钉走 Stream，
      # 企业微信走智能机器人的 WebSocket，QQ 走官方 WebSocket，个人微信凭据只能扫码取得（见 README）。
      # 开关单独注入：改开关会重建容器，init 随之在 config.yaml 里写/撤显式停用，关着的渠道即使留着凭据也不启用。
      # 引用带 :- 空默认：核心离线校验（check / 索引 check-index）不给设置变量注值，裸引用会报未定义。
      FEISHU_APP_ID: ${WONTON_SETTING_FEISHU_APP_ID:-}
      FEISHU_APP_SECRET: ${WONTON_SECRET_FEISHU_APP_SECRET:-}
      FEISHU_WONTON_ENABLED: ${WONTON_SETTING_FEISHU_ENABLED:-}
      DINGTALK_CLIENT_ID: ${WONTON_SETTING_DINGTALK_CLIENT_ID:-}
      DINGTALK_CLIENT_SECRET: ${WONTON_SECRET_DINGTALK_CLIENT_SECRET:-}
      DINGTALK_WONTON_ENABLED: ${WONTON_SETTING_DINGTALK_ENABLED:-}
      WECOM_BOT_ID: ${WONTON_SETTING_WECOM_BOT_ID:-}
      WECOM_SECRET: ${WONTON_SECRET_WECOM_SECRET:-}
      WECOM_WONTON_ENABLED: ${WONTON_SETTING_WECOM_ENABLED:-}
      QQ_APP_ID: ${WONTON_SETTING_QQ_APP_ID:-}
      QQ_CLIENT_SECRET: ${WONTON_SECRET_QQ_CLIENT_SECRET:-}
      QQ_WONTON_ENABLED: ${WONTON_SETTING_QQ_ENABLED:-}
      WEIXIN_WONTON_ENABLED: ${WONTON_SETTING_WEIXIN_ENABLED:-}
      # matrix.bot：核心代这个 Bot 登录后签发的身份，只给令牌，不给密码。
      MATRIX_HOMESERVER: ${WONTON_MATRIX_HOMESERVER}
      MATRIX_USER_ID: ${WONTON_MATRIX_USER_ID}
      MATRIX_ACCESS_TOKEN: ${WONTON_MATRIX_ACCESS_TOKEN}
      # Bot 只听名单里的人；主房间是核心替主人建的加密私聊，定时任务结果发到这里。
      # 变量名是 MATRIX_HOME_ROOM，不是 Hermes 插件清单里写的 MATRIX_HOME_CHANNEL。
      MATRIX_ALLOWED_USERS: ${WONTON_MATRIX_ALLOWED_USERS:?需要主人的 Matrix 用户 ID}
      MATRIX_HOME_ROOM: ${WONTON_MATRIX_HOME_ROOM}
      # 主流客户端默认加密私聊；依赖缺失时直接失败，不静默退回明文。
      MATRIX_E2EE_MODE: required
      # 交叉签名的恢复密钥写在这里，核心收走保管（x-wonton.secrets.matrix_recovery_key）。
      MATRIX_RECOVERY_KEY_OUTPUT_FILE: /opt/data/platforms/matrix/recovery-key.txt
      # tools：核心的 MCP 总线（核心和其他插件的工具），config.yaml 的 mcp_servers.wonton 引用。
      WONTON_MCP_URL: ${WONTON_MCP_URL}
      # owner.identity：说话人是主人时不用再退一级问主人的语言。核心只在被引用时才注入。
      WONTON_OWNER_NAME: ${WONTON_OWNER_NAME:?核心没有注入用户名}
      # 默认放行 MEDIA: 发黑名单以外的任何文件，恢复密钥 platforms/matrix/recovery-key.txt 不在黑名单里。这样只放行缓存目录
      # 和刚产生的文件。
      HERMES_MEDIA_DELIVERY_STRICT: "1"
    volumes:
      - ${WONTON_BOT_DATA}:/opt/data
      # wonton__save_file 只从这里取文件：Agent 的数据目录里有密钥。
      - ${WONTON_APP_DATA}/outbox:/opt/data/outbox
    healthcheck:
      # Matrix 连上才算健康：用 Hermes 自己生成的本机 API 密钥查详细状态。
      test:
        - CMD-SHELL
        - >-
          k="$$(sed -n 's/^API_SERVER_KEY=//p' /opt/data/.env)" &&
          curl -fsS -H "Authorization: Bearer $$k" http://127.0.0.1:8642/health/detailed |
          python3 -c 'import json, sys; sys.exit(json.load(sys.stdin)["platforms"]["matrix"]["state"] != "connected")'
      interval: 30s
      timeout: 10s
      start_period: 3m
      start_interval: 2s

  web:
    image: nginx:1.30.2-alpine@sha256:5f979dcfed4ce6461873f087e8c980d6e29b084b9e8776d9704a7e989b5f4898
    restart: unless-stopped
    # Hermes 的回环监听还校验 WebSocket 对端地址，代理必须与它共用同一个 Bot 的网络命名空间。
    network_mode: service:gateway
    depends_on:
      gateway:
        condition: service_healthy
    configs:
      - source: dashboard_proxy
        target: /etc/nginx/conf.d/default.conf
    healthcheck:
      test: [CMD, wget, -Y, "off", -q, -O, /dev/null, http://127.0.0.1:8080/]
      interval: 30s
      timeout: 10s
      start_period: 30s
      start_interval: 2s

configs:
  config:
    file: ./config.yaml
  wonton_manifest:
    file: ./wonton/plugin.yaml
  wonton_hooks:
    file: ./wonton/__init__.py
  wonton_side_chat:
    file: ./wonton/side_chat.py
  wonton_message_batch:
    file: ./wonton/message_batch.py
  wonton_commands:
    file: ./wonton/commands.py
  wonton_turn:
    file: ./wonton/turn.py
  wonton_pages:
    file: ./wonton/pages.py
  wonton_dashboard_api:
    file: ./wonton/dashboard/api.py
  wonton_dashboard_manifest:
    file: ./wonton/dashboard/manifest.json
  wonton_texts:
    file: ./wonton/texts.py
  wonton_locale:
    file: ./wonton/locale.py
  wonton_language_hook:
    file: ./hooks/wonton-language/HOOK.yaml
  wonton_language_handler:
    file: ./hooks/wonton-language/handler.py
  wonton_errors_en:
    file: ./wonton/locales/en.yaml
  wonton_errors_zh:
    file: ./wonton/locales/zh.yaml
  wonton_errors_zh_hant:
    file: ./wonton/locales/zh-hant.yaml
  wonton_errors_ja:
    file: ./wonton/locales/ja.yaml
  init_config:
    file: ./init_config.py
  wonton_help_skill:
    file: ./skills/wonton-help/SKILL.md
  dashboard_proxy:
    file: ./dashboard-nginx.conf

x-wonton:
  spec: "0.12"
  id: com.nousresearch.hermes
  version: 0.8.2
  kind: agent
  title: { zh: AI 管家（Hermes）, en: All-Purpose Bot (Hermes) }
  description:
    zh: 像住在家里的万能管家：在 App 里和它私聊，它能上网查资料、用你装的应用提供的工具、读你允许它看的文件夹。云吞默认就带它，也能接到 Telegram、飞书、钉钉、企业微信、QQ 和个人微信上聊。
    en: "Like an all-round butler at home: chat with it privately in the app and it searches the web, uses the tools your apps provide and reads the folders you allow. It comes with Wonton by default and can also chat with you on Telegram, Feishu, DingTalk, WeCom, QQ or personal WeChat."
  icon: icon.png
  notices: [NOTICE]
  settings: settings.schema.json
  author: { name: geraldpeng6 }
  homepage: https://github.com/NousResearch/hermes-agent
  license: MIT
  tags: { zh: [AI], en: [AI] }
  about:
    zh: |
      Nous Research 家的通用 AI 助手：在 App 里和它私聊，它能上网查资料、用你装的应用提供的工具、读你允许它看的文件夹。

      消息走加密的 Matrix 私聊。模型用 Hermes 自带的接入：打开它的网页，在 Keys 页填 AI 服务商的 API key 或登录订阅，再在 Models 页选模型；没选好之前它会告诉你去哪里设，不会偷偷换成别的服务。key 和登录信息存在这个 Bot 自己的数据里。经云吞装卸插件这类操作要你在卡片上确认；Hermes 自带的终端、文件和浏览器工具在它自己的容器里直接运行，能读写这个 Bot 的数据（含密钥）、能联网，碰不到你的共享文件夹和别的插件的数据。

      国内办公 IM 渠道（飞书、钉钉、企业微信、QQ 机器人、个人微信）在插件详情页的「设置」里逐个启用：去对应平台的
      开放平台建一个机器人应用，把应用 ID 和密钥填进来、打开开关。这些聊天只出现在那个 IM 里，不进云吞 App 的聊天页；
      个人微信只支持私聊，而且要先在服务器的终端里扫码登录（步骤见插件 README）。Telegram 在 Hermes 网页的 Channels 页
      配置，使用云吞的出网代理。
    en: |
      An all-round AI assistant by Nous Research: chat with it privately in the app, and it can search the web, use the tools your apps provide and read the folders you allow.

      Messages travel in an encrypted Matrix chat. It uses Hermes's own model setup: open its web page, add an AI provider's API key or sign in under Keys, then pick a model under Models; until then it tells you where to set it up rather than silently switching services. Keys and sign-ins are stored in this Bot's own data. Actions through Wonton, such as installing plugins, wait for your confirmation card. Hermes's terminal, file and browser tools run directly in its container: they can read and write this Bot's data, including secrets, and access the network, but not your shared folders or other apps' data.

      CN office-IM channels (Feishu, DingTalk, WeCom, QQ bot, personal WeChat) are enabled one by one in the plugin's settings: create a bot app on the platform's console, fill in the app ID and secret, and turn the switch on. These chats live only in that IM, not in the Wonton app's chat page; personal WeChat supports direct messages only and needs a one-time scan login from a terminal on the server (steps in the plugin README). Telegram is configured on the Channels page of the Hermes web page and uses Wonton's outbound proxy.
  release_notes:
    zh: "升级到官方 Hermes v0.23.4：IM 适配器、审批卡片和 MCP 客户端跟着上游更新；回答问题的等待时间保持云吞原来的 1 小时（上游新版默认 90 秒）。"
    zh-Hant: "升級到官方 Hermes v0.23.4：IM 適配器、審批卡片和 MCP 客戶端跟著上游更新；回答問題的等待時間保持雲吞原來的 1 小時（上游新版預設 90 秒）。"
    en: "Upgrades to official Hermes v0.23.4: IM adapters, approval cards and the MCP client follow upstream; questions keep Wonton's one-hour wait (upstream's new default is 90 seconds)."
    ja: "公式 Hermes v0.23.4 に更新：IM アダプター、承認カード、MCP クライアントを上流に追従させました。質問への回答待ちは Wonton 従来の 1 時間のままです（上流の新しい既定は 90 秒）。"
  agent:
    protocol: matrix
  bot:
    display_name: { zh: Hermes, en: Hermes }
  # 原生回环 dashboard 不另建账号；主人会话由核心网关校验，不开放局域网端口。
  # 打开就落在 Models 页：装好后第一件事是选模型，没有可选的供应商时上游页面会指去 Keys。
  webui:
    service: gateway
    port: 8080
    path: /models
    sso: none
  # nginx 在 gateway 的命名空间监听 8080；入口指向 default Bot 的网络目标服务。
  bots:
    services: [init, gateway, web]
  secrets:
    # Hermes 只凭令牌就自动建好交叉签名，恢复密钥只写在数据目录里；交给核心保管，数据丢了还能恢复。
    matrix_recovery_key:
      collect: { service: gateway, path: /opt/data/platforms/matrix/recovery-key.txt }
    # 国内 IM 渠道的应用密钥：主人在各平台建应用后填写，以 WONTON_SECRET_<名字> 注入（compose 里引用）。
    # 都选填：没填的渠道不启用（对应开关也关着时更是显式停用）。
    feishu_app_secret:
      input:
        title: { zh: 飞书 App Secret, en: Feishu App Secret }
        url: https://open.feishu.cn/app
        required: false
    dingtalk_client_secret:
      input:
        title: { zh: 钉钉 Client Secret（AppSecret）, en: DingTalk Client Secret (AppSecret) }
        url: https://open-dev.dingtalk.com/
        required: false
    wecom_secret:
      input:
        title: { zh: 企业微信机器人 Secret, en: WeCom bot Secret }
        url: https://work.weixin.qq.com/
        required: false
    qq_client_secret:
      input:
        title: { zh: QQ 机器人 App Secret, en: QQ bot App Secret }
        url: https://q.qq.com/
        required: false
  permissions:
    - matrix.bot
    # 经核心的 MCP 总线用工具：装卸插件、在授权的文件夹里找文件等。
    - tools
    # 查家人的语言（wonton__user_locale）：Bot 跟好几个人说话，没有模型时的提示要按每个人自己的语言写；
    # 顺带拿到主用户名，判断说话人是不是主人，少问一次。
    - owner.identity
    # 网页搜索等工具。
    - network.egress
  requirements:
    arch: [amd64, arm64]
    memory: 1G
