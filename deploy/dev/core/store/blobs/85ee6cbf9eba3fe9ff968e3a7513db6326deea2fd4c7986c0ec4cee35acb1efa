# Codex Agent：bridge 说 ACP，agent 跑固定版本的 codex-acp 和 Codex CLI。两个服务只共享 ACP socket 所在的
# run/ 子目录；bridge 的 crypto store 和 Matrix 令牌不给 agent，agent 的 HOME 和工作区不给 bridge。
services:
  agent:
    image: ghcr.io/geraldpeng6/wonton-plugin-codex:0.1.0@sha256:2ee4298a419e6eeb6623eaef8564f14996564bfb806d4c7e9e54fcc62a878ad8
    # 镜像里固定用 65532，入口脚本不再降权；bridge 挂同一个 run/ 目录，两个服务的属主必须相同，否则核心拒绝安装。
    user: "65532:65532"
    restart: unless-stopped
    environment:
      HOME: /data/agent/home
      # 入口脚本把它们写进 Codex 的 config.toml（model_providers + model_catalog_json）；密钥只引用变量名。
      OPENAI_BASE_URL: ${WONTON_MODEL_BASE_URL:?需要模型网关地址}
      OPENAI_API_KEY: ${WONTON_MODEL_API_KEY:?需要模型网关凭据}
      OPENAI_MODEL: ${WONTON_MODEL_DEFAULT:?需要默认模型}
      WONTON_MCP_URL: ${WONTON_MCP_URL:?需要 MCP 总线地址}
      WONTON_ACP_SOCKET: /data/run/acp.sock
      WONTON_AGENT_WORKSPACE: /workspace
      # 无浏览器的容器：官方登录走设备码（codex login --device-auth），不用开网页。
      NO_BROWSER: "1"
      # 会话和 MCP 连接的日志进容器日志，出问题时能对着它排查。
      RUST_LOG: info
      # 出网代理由核心注入（ADR-0023）：登录和登录后的官方模型请求经它出去，内部地址核心已写进
      # NO_PROXY，不会绕道。这里不写代理变量，写了空值就会把核心的注入顶掉。
    volumes:
      - ${WONTON_BOT_DATA:?需要 Bot 数据目录}/agent:/data/agent
      - ${WONTON_BOT_DATA}/run:/data/run
      - ${WONTON_BOT_DATA}/workspace:/workspace
    healthcheck:
      # socket 是入口脚本建好 ACP 转发后才有的，有这个文件就说明 Agent 侧能接连接。
      test: ["CMD", "test", "-S", "/data/run/acp.sock"]
      interval: 30s
      timeout: 5s
      start_period: 120s
      start_interval: 2s

  bridge:
    image: ghcr.io/geraldpeng6/wonton-acp-bridge:0.1.0-beta.2@sha256:5b34b9dadd5548182034b972dfffce64ec62b31c26a65a97bf3fb7f5a318cb80
    user: "65532:65532"
    restart: unless-stopped
    depends_on:
      agent:
        condition: service_started
    environment:
      HOME: /data/bridge
      WONTON_BOT_DATA: /data
      WONTON_BRIDGE_DATA: /data/bridge
      WONTON_ACP_SOCKET: /data/run/acp.sock
      WONTON_AGENT_WORKSPACE: /workspace
      WONTON_MATRIX_HOMESERVER: ${WONTON_MATRIX_HOMESERVER:?需要 Matrix 地址}
      WONTON_MATRIX_ACCESS_TOKEN: ${WONTON_MATRIX_ACCESS_TOKEN:?需要 Bot 的 Matrix 访问令牌}
      WONTON_MATRIX_OWNER: ${WONTON_MATRIX_OWNER:?需要主人的 Matrix 用户 ID}
      WONTON_MATRIX_HOME_ROOM: ${WONTON_MATRIX_HOME_ROOM:?需要主人与 Bot 的主房间}
      WONTON_MCP_URL: ${WONTON_MCP_URL:?需要 MCP 总线地址}
      # Codex 最严格可用的模式（ADR-0035 实测 read-only）：只读工作区，改文件和出网都先经确认卡片问主人。
      # 它自带的沙箱在普通 Docker 容器里建不了命名空间，更宽的模式不可用。
      WONTON_ACP_MODE: read-only
    volumes:
      - ${WONTON_BOT_DATA}/bridge:/data/bridge
      - ${WONTON_BOT_DATA}/run:/data/run
    healthcheck:
      test: ["CMD", "test", "-S", "/data/run/acp.sock"]
      interval: 30s
      timeout: 5s
      start_period: 30s
      start_interval: 2s

x-wonton:
  spec: "0.6"
  id: ai.codex
  version: 0.1.0
  kind: agent
  title: { zh: Codex, en: Codex }
  description:
    zh: OpenAI 的 Codex 编程 Agent，在聊天里按你的确认动手
    en: OpenAI's Codex coding agent that acts in chat, asking before it acts
  icon: icon.svg
  screenshots: [screenshots/home.png]
  notices: [NOTICE, images/wonton-plugin-codex/LICENSE.codex-acp, images/wonton-plugin-codex/LICENSE.codex]
  author: { name: Wonton plugin authors }
  homepage: https://github.com/openai/codex
  # Codex 上游的许可证；插件包自己的许可证在 LICENSE。
  license: Apache-2.0
  tags: { zh: [AI, 开发], en: [AI, Development] }
  about:
    zh: |
      OpenAI Codex 以 Bot 的身份住进聊天：模型默认经模型网关走，不用账号，也不用填任何 key。
      它住在自己的容器里，用只读沙箱工作，改文件、跑会出沙箱的命令之前经确认卡片问你；
      Wonton 插件的工具也从聊天里调。要用 ChatGPT 订阅的话，在聊天里发 /wonton login 用设备码登录。
    en: |
      OpenAI Codex lives in the chat as a bot: the model goes through the model gateway by default,
      with no account and no key to fill in. It works in its own container under a read-only sandbox
      and asks through confirmation cards before editing files or running commands outside it; Wonton
      plugin tools are called from the chat too. To use a ChatGPT subscription, send /wonton login
      and sign in with a device code.
  release_notes: { zh: 首个版本。, en: First release. }
  agent:
    protocol: acp
    # 官方账号登录（ADR-0035）：登录在 Codex 自己的程序里完成，链接和设备码发进聊天。
    login:
      - id: chatgpt
        title: { zh: ChatGPT 账号, en: ChatGPT account }
  bot:
    display_name: { zh: Codex, en: Codex }
  bots:
    services: [agent, bridge]
  permissions:
    - matrix.bot
    - tools
    - models
    # 设备码登录和登录后的官方模型请求都要出网。
    - network.egress
  requirements:
    arch: [amd64, arm64]
    memory: 1G
