# Apex and www terminate here with the apex certificate lineage. The apex is
# no longer a copy of the personal site: a minimal 404 is enough.
server {
    listen 127.0.0.1:4080 proxy_protocol;
    server_name @DOMAIN@ www.@DOMAIN@;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:4443 ssl proxy_protocol http2;
    server_name @DOMAIN@ www.@DOMAIN@;

    ssl_certificate @WONTON_CERTS_DIR@/@DOMAIN@/fullchain.pem;
    ssl_certificate_key @WONTON_CERTS_DIR@/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }

    return 404 "wonton\n";
}
