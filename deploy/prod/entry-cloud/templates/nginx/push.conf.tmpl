# Web Push relay. nginx terminates TLS and forwards to the loopback wrapper;
# the wrapper still checks VAPID and per-key rate limits.
server {
    listen 127.0.0.1:4080 proxy_protocol;
    server_name @PUSH_HOST@;
    return 301 https://$host$request_uri;
}

server {
    listen 127.0.0.1:4443 ssl proxy_protocol http2;
    server_name @PUSH_HOST@;

    ssl_certificate @WONTON_CERTS_DIR@/@PUSH_HOST@/fullchain.pem;
    ssl_certificate_key @WONTON_CERTS_DIR@/@PUSH_HOST@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/@PUSH_HOST@.access.log;
    client_max_body_size 8k;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
    }
}
