# Copy to .env and replace every example.* / 203.0.113.10 value.
# The operator keeps the real .env off the public repo (see README, "只有我们自己能用").
WONTON_DOMAIN=example.com
WONTON_PUBLIC_IP=203.0.113.10
# NIC private address dnsdist binds (NAT public IP alone cannot receive).
WONTON_LISTEN_IP=172.16.0.10
WONTON_ACME_EMAIL=ops@example.com

# Fixed public vhosts. names is the install/bootstrap + home-control host.
WONTON_NAMES_HOST=names.example.com
WONTON_PUSH_HOST=push.example.com
WONTON_RELAY_HOST=relay.example.com
# omarchy lives in its own zone, but terminates TLS on this host.
WONTON_OMARCHY_HOST=omarchy.example.net
# In-zone alias for the site (HTTP-only).
WONTON_SITE_ALIAS=omarchy

# Images. `prepare.py` renders these into config; production must replace every
# tag with an @sha256: digest before the first start.
WONTON_HOME_IMAGE=wonton-home:prod
FRPS_IMAGE=fatedier/frps:v0.72.0
FRPC_IMAGE=fatedier/frpc:v0.72.0
PDNS_IMAGE=powerdns/pdns-auth-49:4.9.11
DNSDIST_IMAGE=powerdns/dnsdist-19:1.9.10
ACME_DNS_IMAGE=joohoi/acme-dns:v1.0

# Host paths (defaults match deploy/prod/entry-cloud/README.md).
# nginx-only cert copy; certbot writes /etc/letsencrypt and the deploy hook copies here.
WONTON_ENTRY_ROOT=/opt/wonton-home
WONTON_NGINX_SITES=/etc/nginx/sites-available

# Extra A records seeded next to apex/www/push/relay; comma list, may be empty.
WONTON_BOOTSTRAP_EXTRA_A=oma,omarchy

# Hook allowlist: every fixed system proxy domain must be here; includes WONTON_SITE_ALIAS.<domain>.
WONTON_HOME_SYSTEM_DOMAINS=push.example.com,relay.example.com,names.example.com,omarchy.example.net,example.com,www.example.com,omarchy.example.com

# Loopback ports. Only names (8082) is proxied by nginx; the rest are internal.
# The installer's WONTON_ACME_DIRECTORY is exported by /i/<code>, not read here.
WONTON_HOME_LISTEN=127.0.0.1:8082
WONTON_HOME_HOOK_LISTEN=127.0.0.1:8083
WONTON_ACME_DNS_API=127.0.0.1:8054
WONTON_PDNS_API=127.0.0.1:8084
WONTON_FRPS_METRICS=127.0.0.1:7500
WONTON_CERTS_DIR=/opt/wonton-home/certs
