#!/bin/sh
# 云吞服务器上的命令。`wonton-core init` 把它写进安装目录，安装脚本链接成 /usr/local/bin/wonton，要用 root 执行。
#
#   sudo wonton pair           发一个配对码（10 分钟内有效，只能用一次），已经有设备时也能用：设备都丢了时用它找回
#   sudo wonton pair --first   显示首次配对码（和局域网网页上的是同一个），第一台设备配上后退出；安装脚本最后执行它
set -eu

install_dir=$(dirname "$(readlink -f "$0")")
env_file="$install_dir/.env"

die() {
  echo "wonton：$*" >&2
  exit 1
}

usage() {
  sed -n 's/^#   //p' "$0" >&2
  exit 2
}

[ -r "$env_file" ] || die "读不到 $env_file：要用 root 执行（sudo wonton …），或者还没装好"
# 插件开发环境的核心换了容器名（compose.yaml），正式安装不设。
core=$(sed -n 's/^WONTON_CORE_CONTAINER=//p' "$env_file" | tail -n 1)

case "${1:-}" in
  pair)
    shift
    case "${1:-}" in
      '' | --first) ;;
      *) usage ;;
    esac
    # 终端里执行时给容器里的命令一个终端：按 Ctrl-C 退出时它跟着结束，不会留在容器里等配对。
    tty=
    [ -t 1 ] && tty=-t
    # shellcheck disable=SC2086 # $tty 为空时不能变成一个空参数
    # 直连地址不在这里猜：核心按宣告地址和局域网检测算，桌面虚拟机里也能给出宿主地址。
    exec docker exec $tty "${core:-wonton-core}" wonton-core pair "$@"
    ;;
  *) usage ;;
esac
