# install.sh 的可选设置；安装脚本会沿用安装目录 .env 里保存的值。
# 私有 IPv4 CIDR；每个插件、局域网和出口网络从中分配一个 /26。
WONTON_PLUGIN_NETWORK_POOL=10.213.0.0/16

# 中继表（ADR-0048）：档位之间用 ; 分开，前面的档优先；同一档里的中继用 , 分开。
# 令牌写在地址的 userinfo 里，解析后从地址里去掉；n0 代表 iroh 内置的 n0 公共中继那一组。
# 不设时等于 n0。
#WONTON_RELAYS=https://TOKEN@a.example,https://TOKEN@b.example;n0
