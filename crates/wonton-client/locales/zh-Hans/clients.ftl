clients-domain-terms = 先勾选 Let's Encrypt 的订户协议

clients-domain-suffix = 填一个域名

clients-domain-suffix-invalid = 只能用小写字母、数字、“-”和“.”

clients-domain-provider = 选一个 DNS 服务商

clients-domain-credentials = 填服务商要的凭据

clients-domain-other-line = 第 { $line } 行要写成“键=值”

clients-domain-other-empty = 至少填一项凭据

clients-domain-not-connected = 还没连上家里的服务器

clients-domain-timeout = 家里的服务器迟迟没有回话

clients-domain-transport = 连不上家里的服务器：{ $reason }

clients-domain-http = 家里的服务器回了 HTTP { $status }

clients-domain-read = 看不懂家里服务器的回答：{ $reason }

clients-domain-save = 请求没拼出来：{ $reason }
