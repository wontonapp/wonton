# Detail of a failed offline download: even a fresh start got mismatched bytes.
video-download-restart-mismatch = 从头下载时服务器给的数据也对不上。

# Detail of an interrupted offline download. $reason is the network library's error.
video-download-interrupted = 下载中断：{ $reason }

# Detail when the app passes back a malformed playback session ID. $value is what it passed.
video-session-unreadable = 播放会话号认不出来：{ $value }
