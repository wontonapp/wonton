# Detail of a failed offline download: even a fresh start got mismatched bytes.
video-download-restart-mismatch = The server's bytes didn't line up even when starting over.

# Detail of an interrupted offline download. $reason is the network library's error.
video-download-interrupted = Download interrupted: { $reason }

# Detail when the app passes back a malformed playback session ID. $value is what it passed.
video-session-unreadable = Can't read the playback session ID: { $value }

# Detail when retrying an offline download that the server hasn't marked as failed.
video-download-not-failed = There's no failed download of this to retry.
