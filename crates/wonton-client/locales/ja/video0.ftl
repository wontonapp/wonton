# Detail when resuming an offline download that the server hasn't marked as paused.
video-download-not-paused = 再開できる一時停止中のダウンロードはありません。

# Detail when the server's playback reply has no plan.
video-plan-missing = 再生の応答に再生プランがありません。

# Detail when the stream path is outside the media API. $value is the path.
video-stream-outside-api = ストリームのアドレスがサーバーのメディア API の外です：{ $value }
