# 固定的上游 iroh-relay 发布版本和官方 asset 的 sha256。
# 版本必须和仓库 Cargo.lock 里的 iroh 一致（大版本相同，见 ADR-0048），升级时和 Cargo.lock 一起改。
# sha256 取自 GitHub Release API 的 asset digest，install.sh 和 test/relay-e2e.sh 都校验。
IROH_RELAY_VERSION=1.5.0
IROH_RELAY_RELEASE_BASE=https://github.com/n0-computer/iroh/releases/download/v1.5.0
IROH_RELAY_SHA256_X86_64=935892e4ad570d694f7ad2780f800077b99fd72d9a56ac982792fdd04ef631b4
IROH_RELAY_SHA256_AARCH64=99a14d2ff541711f1b175a15e0c1571a45f46c171d655cda29849d91d90a5c9c
