# 固定的上游 iroh-relay 发布版本和官方 asset 的 sha256。
# 版本必须和仓库 Cargo.lock 里的 iroh 一致（大版本相同，见 ADR-0048），升级时和 Cargo.lock 一起改。
# sha256 取自 GitHub Release API 的 asset digest，install.sh 和 test/relay-e2e.sh 都校验。
IROH_RELAY_VERSION=1.4.1
IROH_RELAY_RELEASE_BASE=https://github.com/n0-computer/iroh/releases/download/v1.4.1
IROH_RELAY_SHA256_X86_64=75254641e3fad7fcbac6dee4d485556fbe06ef708340a9d8810469270ba626b8
IROH_RELAY_SHA256_AARCH64=3fc0c2d67c1cd66250bf82f3e2f17a985b7081a3d272186bad9d63e3f2347b38
